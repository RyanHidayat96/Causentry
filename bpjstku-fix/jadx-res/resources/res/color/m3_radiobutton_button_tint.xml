<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        state_enabled="false"
        color="?attr/colorOnSurface"
        alpha="@dimen/m3_comp_radio_button_disabled_unselected_icon_opacity"/>
    <item
        state_enabled="false"
        state_pressed="true"
        color="?attr/colorOnSurface"
        alpha="@dimen/m3_comp_radio_button_disabled_selected_icon_opacity"/>
    <item
        state_checked="true"
        state_pressed="true"
        color="?attr/colorPrimary"/>
    <item
        state_focused="true"
        state_checked="true"
        color="?attr/colorPrimary"/>
    <item
        state_checked="true"
        color="?attr/colorPrimary"
        state_hovered="true"/>
    <item
        state_checked="true"
        color="?attr/colorPrimary"/>
    <item
        state_checked="true"
        state_pressed="true"
        color="?attr/colorOnSurface"/>
    <item
        state_focused="true"
        state_checked="true"
        color="?attr/colorOnSurface"/>
    <item
        state_checked="true"
        color="?attr/colorOnSurface"
        state_hovered="true"/>
    <item
        state_checked="false"
        color="?attr/colorOnSurfaceVariant"/>
</selector>
