<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        state_checked="true"
        state_pressed="true"
        color="?attr/colorOnSurface"
        alpha="@dimen/m3_comp_radio_button_selected_pressed_state_layer_opacity"/>
    <item
        state_focused="true"
        state_checked="true"
        color="?attr/colorPrimary"
        alpha="@dimen/m3_comp_radio_button_selected_focus_state_layer_opacity"/>
    <item
        state_checked="true"
        color="?attr/colorPrimary"
        alpha="@dimen/m3_comp_radio_button_selected_hover_state_layer_opacity"
        state_hovered="true"/>
    <item
        state_checked="true"
        color="?attr/colorPrimary"
        alpha="@dimen/m3_ripple_default_alpha"/>
    <item
        state_pressed="true"
        color="?attr/colorPrimary"
        alpha="@dimen/m3_comp_radio_button_unselected_pressed_state_layer_opacity"/>
    <item
        state_focused="true"
        color="?attr/colorOnSurface"
        alpha="@dimen/m3_comp_radio_button_unselected_focus_state_layer_opacity"/>
    <item
        color="?attr/colorOnSurface"
        alpha="@dimen/m3_comp_radio_button_unselected_hover_state_layer_opacity"
        state_hovered="true"/>
    <item
        color="?attr/colorOnSurface"
        alpha="@dimen/m3_ripple_default_alpha"/>
</selector>
