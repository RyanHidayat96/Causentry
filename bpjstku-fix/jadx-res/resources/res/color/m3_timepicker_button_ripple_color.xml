<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        state_checked="true"
        state_pressed="true"
        color="?attr/colorOnTertiaryContainer"
        alpha="@dimen/m3_comp_time_picker_period_selector_pressed_state_layer_opacity"/>
    <item
        state_focused="true"
        state_checked="true"
        color="?attr/colorOnTertiaryContainer"
        alpha="@dimen/m3_comp_time_picker_period_selector_focus_state_layer_opacity"/>
    <item
        state_checked="true"
        color="?attr/colorOnTertiaryContainer"
        alpha="@dimen/m3_comp_time_picker_period_selector_hover_state_layer_opacity"
        state_hovered="true"/>
    <item
        state_checked="true"
        color="?attr/colorOnTertiaryContainer"
        alpha="@dimen/m3_ripple_default_alpha"/>
    <item
        state_checkable="true"
        state_pressed="true"
        color="?attr/colorOnTertiaryContainer"
        alpha="@dimen/m3_comp_time_picker_period_selector_pressed_state_layer_opacity"/>
    <item
        state_pressed="true"
        color="?attr/colorOnSurfaceVariant"
        alpha="@dimen/m3_comp_time_picker_period_selector_pressed_state_layer_opacity"/>
    <item
        state_focused="true"
        color="?attr/colorOnSurfaceVariant"
        alpha="@dimen/m3_comp_time_picker_period_selector_focus_state_layer_opacity"/>
    <item
        color="?attr/colorOnSurfaceVariant"
        alpha="@dimen/m3_comp_time_picker_period_selector_hover_state_layer_opacity"
        state_hovered="true"/>
    <item
        color="?attr/colorOnSurfaceVariant"
        alpha="@dimen/m3_ripple_default_alpha"/>
</selector>
