<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        state_checkable="false"
        state_pressed="true"
        color="?attr/colorOnContainer"
        alpha="@dimen/m3_comp_text_button_pressed_state_layer_opacity"/>
    <item
        state_focused="true"
        state_checkable="false"
        color="?attr/colorOnContainer"
        alpha="@dimen/m3_comp_text_button_focus_state_layer_opacity"/>
    <item
        state_checkable="false"
        color="?attr/colorOnContainer"
        alpha="@dimen/m3_comp_text_button_hover_state_layer_opacity"
        state_hovered="true"/>
    <item
        state_checkable="false"
        color="?attr/colorOnContainer"
        alpha="@dimen/m3_ripple_default_alpha"/>
    <item
        state_checked="true"
        state_pressed="true"
        color="?attr/colorOnSurface"
        alpha="@dimen/m3_comp_text_button_pressed_state_layer_opacity"/>
    <item
        state_focused="true"
        state_checked="true"
        color="?attr/colorOnSecondaryContainer"
        alpha="@dimen/m3_comp_text_button_focus_state_layer_opacity"/>
    <item
        state_checked="true"
        color="?attr/colorOnSecondaryContainer"
        alpha="@dimen/m3_comp_text_button_hover_state_layer_opacity"
        state_hovered="true"/>
    <item
        state_checked="true"
        color="?attr/colorOnSecondaryContainer"
        alpha="@dimen/m3_ripple_default_alpha"/>
    <item
        state_pressed="true"
        color="?attr/colorOnSecondaryContainer"
        alpha="@dimen/m3_comp_text_button_pressed_state_layer_opacity"/>
    <item
        state_focused="true"
        color="?attr/colorOnSurface"
        alpha="@dimen/m3_comp_text_button_focus_state_layer_opacity"/>
    <item
        color="?attr/colorOnSurface"
        alpha="@dimen/m3_comp_text_button_hover_state_layer_opacity"
        state_hovered="true"/>
    <item
        color="?attr/colorOnSurface"
        alpha="@dimen/m3_ripple_default_alpha"/>
</selector>
