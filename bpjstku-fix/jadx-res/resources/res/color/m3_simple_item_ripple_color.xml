<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        state_pressed="true"
        color="?attr/colorOnSurface"
        alpha="@dimen/m3_ripple_pressed_alpha"/>
    <item
        state_selected="true"
        state_pressed="false"
        color="?attr/colorOnSurface"
        alpha="@dimen/m3_simple_item_color_selected_alpha"/>
    <item
        state_pressed="false"
        color="?attr/colorOnSurface"
        alpha="@dimen/m3_simple_item_color_hovered_alpha"
        state_hovered="true"/>
</selector>
