<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        state_pressed="true"
        color="?attr/colorOnContainer"
        alpha="@dimen/m3_comp_fab_primary_pressed_state_layer_opacity"/>
    <item
        state_focused="true"
        color="?attr/colorOnContainer"
        alpha="@dimen/m3_comp_fab_primary_focus_state_layer_opacity"/>
    <item
        color="?attr/colorOnContainer"
        alpha="@dimen/m3_comp_fab_primary_hover_state_layer_opacity"
        state_hovered="true"/>
    <item
        color="?attr/colorOnContainer"
        alpha="@dimen/m3_ripple_default_alpha"/>
</selector>
