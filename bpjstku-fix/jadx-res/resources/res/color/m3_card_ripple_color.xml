<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        state_checked="true"
        state_pressed="true"
        color="?attr/colorOnSurfaceVariant"
        alpha="@dimen/m3_comp_filled_card_pressed_state_layer_opacity"/>
    <item
        state_focused="true"
        state_checked="true"
        color="?attr/colorSecondary"
        alpha="@dimen/m3_comp_filled_card_focus_state_layer_opacity"/>
    <item
        state_checked="true"
        color="?attr/colorSecondary"
        alpha="@dimen/m3_comp_filled_card_hover_state_layer_opacity"
        state_hovered="true"/>
    <item
        state_checked="true"
        color="?attr/colorSecondary"
        alpha="@dimen/m3_ripple_default_alpha"/>
    <item
        state_checkable="true"
        state_pressed="true"
        color="?attr/colorSecondary"
        alpha="@dimen/m3_comp_filled_card_pressed_state_layer_opacity"/>
    <item
        state_checkable="false"
        state_pressed="true"
        color="?attr/colorOnSurfaceVariant"
        alpha="@dimen/m3_comp_filled_card_pressed_state_layer_opacity"/>
    <item
        state_focused="true"
        color="?attr/colorOnSurfaceVariant"
        alpha="@dimen/m3_comp_filled_card_focus_state_layer_opacity"/>
    <item
        color="?attr/colorOnSurfaceVariant"
        alpha="@dimen/m3_comp_filled_card_hover_state_layer_opacity"
        state_hovered="true"/>
    <item
        color="?attr/colorOnSurfaceVariant"
        alpha="@dimen/m3_comp_filled_card_dragged_state_layer_opacity"/>
</selector>
