<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item state_pressed="true">
        <shape>
            <solid color="@color/colorGrey"/>
            <stroke
                width="@dimen/dimen_1dp"
                color="@color/colorPaleGreyFive"/>
            <corners radius="@dimen/dimen_8dp"/>
            <padding
                left="@dimen/dimen_2dp"
                top="@dimen/dimen_2dp"
                right="@dimen/dimen_2dp"
                bottom="@dimen/dimen_2dp"/>
        </shape>
    </item>
