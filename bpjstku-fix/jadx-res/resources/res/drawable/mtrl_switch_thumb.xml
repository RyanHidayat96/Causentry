<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    height="@dimen/mtrl_switch_thumb_size"
    width="@dimen/mtrl_switch_thumb_size">
    <item
        state_pressed="true"
        id="@+id/pressed"
        drawable="@drawable/mtrl_switch_thumb_pressed"/>
    <item
        state_checked="true"
        id="@+id/checked"
        drawable="@drawable/mtrl_switch_thumb_checked"/>
    <item
        id="@+id/with_icon"
        drawable="@drawable/mtrl_switch_thumb_checked"
        NOT_FOUND_0x8="true"/>
    <item
        id="@+id/unchecked"
        drawable="@drawable/mtrl_switch_thumb_unchecked"/>
    <transition
        drawable="@drawable/mtrl_switch_thumb_pressed_checked"
        toId="@+id/checked"
        fromId="@+id/pressed"/>
    <transition
        drawable="@drawable/mtrl_switch_thumb_pressed_checked"
        toId="@+id/with_icon"
        fromId="@+id/pressed"/>
    <transition
        drawable="@drawable/mtrl_switch_thumb_pressed_unchecked"
        toId="@+id/unchecked"
        fromId="@+id/pressed"/>
    <transition
        drawable="@drawable/mtrl_switch_thumb_checked_pressed"
        toId="@+id/pressed"
        fromId="@+id/checked"/>
    <transition
        drawable="@drawable/mtrl_switch_thumb_checked_unchecked"
        toId="@+id/unchecked"
        fromId="@+id/checked"/>
    <transition
        drawable="@drawable/mtrl_switch_thumb_checked_pressed"
        toId="@+id/pressed"
        fromId="@+id/with_icon"/>
    <transition
        drawable="@drawable/mtrl_switch_thumb_unchecked_pressed"
        toId="@+id/pressed"
        fromId="@+id/unchecked"/>
    <transition
        drawable="@drawable/mtrl_switch_thumb_unchecked_checked"
        toId="@+id/checked"
        fromId="@+id/unchecked"/>
</animated-selector>
