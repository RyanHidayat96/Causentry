<?xml version="1.0" encoding="utf-8"?>
<rotate xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromDegrees="0"
    android:toDegrees="1440"
    android:pivotX="50%"
    android:pivotY="50%">
    <shape
        shape="3"
        innerRadiusRatio="3"
        thicknessRatio="10"
        useLevel="false">
        <size
            height="@dimen/vida_layout_dim_60"
            width="@dimen/vida_layout_dim_60"/>
        <gradient
            startColor="?attr/vida_spinner_start_color"
            endColor="?attr/vida_spinner_end_color"
            useLevel="false"
            angle="0"
            type="2"
            centerY="0.5"
            centerColor="?attr/vida_spinner_center_color"/>
    </shape>
</rotate>
