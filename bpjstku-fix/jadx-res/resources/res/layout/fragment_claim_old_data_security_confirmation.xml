<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    orientation="1"
    background="@color/colorWhite"
    focusable="true"
    focusableInTouchMode="true"
    layout_width="-1"
    layout_height="-1"
    layout_weight="1">
    <ScrollView
        layout_width="-1"
        layout_height="0dp"
        layout_marginBottom="@dimen/dimen_16dp"
        fillViewport="true"
        layout_weight="1">
        <androidx.constraintlayout.widget.ConstraintLayout
            layout_width="-1"
            layout_height="-2"
            layout_marginBottom="@dimen/dimen_16dp">
            <com.google.android.material.textfield.TextInputLayout
                id="@+id/tilClaim"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_20dp"
                layout_marginTop="@dimen/dimen_18dp"
                layout_marginRight="@dimen/dimen_20dp"
                hint="@string/label_claim_type"
                layout_marginHorizontal="@dimen/dimen_20dp"
                NOT_FOUND_0x1d="0"
                NOT_FOUND_0x1e="0"
                NOT_FOUND_0x20="0"
                style="@style/BpjstkuTextInputLayoutUnderline.Disabled">
                <com.google.android.material.textfield.TextInputEditText
                    id="@+id/edtClaim"
                    inputType="0x1"
                    style="@style/BpjstkuTextInputEditTextUnderline"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                id="@+id/tilIdentityNumber"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                hint="@string/hint_number_identitiy_card"
                NOT_FOUND_0x1d="@+id/tilClaim"
                NOT_FOUND_0x1e="@+id/tilClaim"
                NOT_FOUND_0x1f="@+id/tilClaim"
                style="@style/BpjstkuTextInputLayoutUnderline.Disabled">
                <com.google.android.material.textfield.TextInputEditText
                    id="@+id/edtIdentityNumber"
                    inputType="0x2"
                    style="@style/BpjstkuTextInputEditTextUnderline"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                id="@+id/tilIdKpj"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                hint="@string/label_kpj_number"
                NOT_FOUND_0x1d="@+id/tilIdentityNumber"
                NOT_FOUND_0x1e="@+id/tilIdentityNumber"
                NOT_FOUND_0x1f="@+id/tilIdentityNumber"
                style="@style/BpjstkuTextInputLayoutUnderline.Disabled">
                <com.google.android.material.textfield.TextInputEditText
                    enabled="false"
                    id="@+id/edtIdKpj"
                    inputType="0x2"
                    style="@style/BpjstkuTextInputEditTextUnderline"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                id="@+id/tilFullName"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                hint="@string/hint_full_name"
                NOT_FOUND_0x1d="@+id/tilIdKpj"
                NOT_FOUND_0x1e="@+id/tilIdKpj"
                NOT_FOUND_0x1f="@+id/tilIdKpj"
                style="@style/BpjstkuTextInputLayoutUnderline.Disabled">
                <com.google.android.material.textfield.TextInputEditText
                    enabled="false"
                    id="@+id/edtFullname"
                    inputType="0x61"
                    style="@style/BpjstkuTextInputEditTextUnderline"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                id="@+id/tilNPWP"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                hint="@string/hint_npwp"
                NOT_FOUND_0x1d="@+id/tilFullName"
                NOT_FOUND_0x1e="@+id/tilFullName"
                NOT_FOUND_0x1f="@+id/tilFullName"
                style="@style/BpjstkuTextInputLayoutUnderline.Disabled">
                <com.google.android.material.textfield.TextInputEditText
                    enabled="false"
                    id="@+id/edtNPWP"
                    inputType="0x2"
                    style="@style/BpjstkuTextInputEditTextUnderline"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                id="@+id/tilPhoneNumber"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                hint="@string/hint_phone_number"
                NOT_FOUND_0x1d="@+id/tilNPWP"
                NOT_FOUND_0x1e="@+id/tilNPWP"
                NOT_FOUND_0x1f="@+id/tilNPWP"
                style="@style/BpjstkuTextInputLayoutUnderline.Disabled">
                <com.google.android.material.textfield.TextInputEditText
                    enabled="false"
                    id="@+id/edtPhoneNumber"
                    inputType="0x2"
                    style="@style/BpjstkuTextInputEditTextUnderline"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                id="@+id/tilEmail"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                hint="@string/hint_email"
                NOT_FOUND_0x1d="@+id/tilPhoneNumber"
                NOT_FOUND_0x1e="@+id/tilPhoneNumber"
                NOT_FOUND_0x1f="@+id/tilPhoneNumber"
                style="@style/BpjstkuTextInputLayoutUnderline.Disabled">
                <com.google.android.material.textfield.TextInputEditText
                    enabled="false"
                    id="@+id/edtEmail"
                    inputType="0x21"
                    style="@style/BpjstkuTextInputEditTextUnderline"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                textSize="@dimen/text_size_16sp"
                id="@+id/tvBpuMembership"
                layout_marginTop="@dimen/dimen_16dp"
                text="Data Kepesertaan BPU"
                NOT_FOUND_0x1e="@+id/tilEmail"
                NOT_FOUND_0x1f="@+id/tilEmail"
                style="@style/BpjstkuTextViewDmSans.CharcoalGrey.Bold"/>
            <com.google.android.material.textfield.TextInputLayout
                id="@+id/tilOccupationFirst"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                hint="Pekerjaan 1"
                NOT_FOUND_0x1d="@+id/tilEmail"
                NOT_FOUND_0x1e="@+id/tilEmail"
                NOT_FOUND_0x1f="@+id/tvBpuMembership"
                style="@style/BpjstkuTextInputLayoutUnderline.Disabled">
                <com.google.android.material.textfield.TextInputEditText
                    enabled="false"
                    id="@+id/edtOccupationFirst"
                    inputType="0x61"
                    style="@style/BpjstkuTextInputEditTextUnderline"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                id="@+id/tilOccupationSecond"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                hint="Pekerjaan 2"
                NOT_FOUND_0x1d="@+id/tilOccupationFirst"
                NOT_FOUND_0x1e="@+id/tilOccupationFirst"
                NOT_FOUND_0x1f="@+id/tilOccupationFirst"
                style="@style/BpjstkuTextInputLayoutUnderline.Disabled">
                <com.google.android.material.textfield.TextInputEditText
                    enabled="false"
                    id="@+id/edtOccupationSecond"
                    inputType="0x61"
                    style="@style/BpjstkuTextInputEditTextUnderline"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                id="@+id/tilCompanyLocation"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                hint="Lokasi Pekerjaan"
                NOT_FOUND_0x1d="@+id/tilOccupationSecond"
                NOT_FOUND_0x1e="@+id/tilOccupationSecond"
                NOT_FOUND_0x1f="@+id/tilOccupationSecond"
                style="@style/BpjstkuTextInputLayoutUnderline.Disabled">
                <com.google.android.material.textfield.TextInputEditText
                    enabled="false"
                    id="@+id/edtCompanyLocation"
                    inputType="0x61"
                    style="@style/BpjstkuTextInputEditTextUnderline"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                id="@+id/tilBpuFee"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                hint="Jumlah Bulan Iuran"
                NOT_FOUND_0x1d="@+id/tilCompanyLocation"
                NOT_FOUND_0x1e="@+id/tilCompanyLocation"
                NOT_FOUND_0x1f="@+id/tilCompanyLocation"
                style="@style/BpjstkuTextInputLayoutUnderline.Disabled">
                <com.google.android.material.textfield.TextInputEditText
                    enabled="false"
                    id="@+id/edtBpuFee"
                    inputType="0x61"
                    style="@style/BpjstkuTextInputEditTextUnderline"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                id="@+id/tilFamilyCardNumber"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                hint="Nomor Kartu Keluarga"
                NOT_FOUND_0x1d="@+id/tilBpuFee"
                NOT_FOUND_0x1e="@+id/tilBpuFee"
                NOT_FOUND_0x1f="@+id/tilBpuFee"
                style="@style/BpjstkuTextInputLayoutUnderline.Disabled">
                <com.google.android.material.textfield.TextInputEditText
                    enabled="false"
                    id="@+id/edtFamilyCardNumber"
                    inputType="0x61"
                    style="@style/BpjstkuTextInputEditTextUnderline"/>
            </com.google.android.material.textfield.TextInputLayout>
            <androidx.constraintlayout.widget.Group
                id="@+id/gbReactivation"
                visibility="2"
                layout_width="-2"
                layout_height="-2"
                NOT_FOUND_0x1b="tvBpuMembership,tilOccupationFirst,tilOccupationSecond,tilCompanyLocation,tilBpuFee,tilFamilyCardNumber"/>
            <TextView
                textSize="@dimen/text_size_16sp"
                id="@+id/tvTransferVia"
                layout_marginLeft="@dimen/dimen_20dp"
                layout_marginTop="@dimen/dimen_16dp"
                layout_marginRight="@dimen/dimen_20dp"
                layout_marginHorizontal="@dimen/dimen_20dp"
                NOT_FOUND_0x1e="0"
                NOT_FOUND_0x1f="@+id/tilFamilyCardNumber"
                style="@style/BpjstkuTextViewDmSans.CharcoalGrey.Bold"/>
            <com.google.android.material.textfield.TextInputLayout
                id="@+id/tilBankName"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                hint="@string/hint_bank_name"
                NOT_FOUND_0x1d="@+id/tilEmail"
                NOT_FOUND_0x1e="@+id/tilEmail"
                NOT_FOUND_0x1f="@+id/tvTransferVia"
                style="@style/BpjstkuTextInputLayoutUnderline.Disabled">
                <com.google.android.material.textfield.TextInputEditText
                    enabled="false"
                    id="@+id/edtBankName"
                    inputType="0x61"
                    style="@style/BpjstkuTextInputEditTextUnderline"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                id="@+id/tilBankAccountNumber"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                hint="@string/hint_bank_account_number"
                NOT_FOUND_0x1d="@+id/tilBankName"
                NOT_FOUND_0x1e="@+id/tilBankName"
                NOT_FOUND_0x1f="@+id/tilBankName"
                style="@style/BpjstkuTextInputLayoutUnderline.Disabled">
                <com.google.android.material.textfield.TextInputEditText
                    enabled="false"
                    id="@+id/edtBankAccountNumber"
                    inputType="0x2"
                    style="@style/BpjstkuTextInputEditTextUnderline"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                id="@+id/tilBankAccountName"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                hint="@string/hint_bank_account_name"
                NOT_FOUND_0x1d="@+id/tilBankAccountNumber"
                NOT_FOUND_0x1e="@+id/tilBankAccountNumber"
                NOT_FOUND_0x1f="@+id/tilBankAccountNumber"
                style="@style/BpjstkuTextInputLayoutUnderline.Disabled">
                <com.google.android.material.textfield.TextInputEditText
                    enabled="false"
                    id="@+id/edtBankAccountName"
                    inputType="0x61"
                    style="@style/BpjstkuTextInputEditTextUnderline"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                id="@+id/tilFinalBalance"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                hint="@string/hint_final_balance"
                NOT_FOUND_0x1d="@+id/tilBankAccountName"
                NOT_FOUND_0x1e="@+id/tilBankAccountName"
                NOT_FOUND_0x1f="@+id/tilBankAccountName"
                style="@style/BpjstkuTextInputLayoutUnderline.Disabled">
                <com.google.android.material.textfield.TextInputEditText
                    enabled="false"
                    id="@+id/edtFinalBalance"
                    inputType="0x61"
                    style="@style/BpjstkuTextInputEditTextUnderline"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                textSize="@dimen/text_size_12sp"
                id="@+id/tvTermConditions"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                layout_marginBottom="@dimen/dimen_16dp"
                text="@string/label_agree_term_condition"
                justificationMode="1"
                NOT_FOUND_0x1d="@+id/tilFinalBalance"
                NOT_FOUND_0x1e="@+id/tilFinalBalance"
                NOT_FOUND_0x1f="@+id/tilFinalBalance"
                style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
            <androidx.appcompat.widget.AppCompatCheckBox
                textSize="@dimen/text_size_12sp"
                gravity="0x11"
                id="@+id/cbAgreeTermCondition"
                paddingTop="@dimen/dimen_4dp"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                layout_marginBottom="@dimen/dimen_16dp"
                text="@string/label_agree_thickmark"
                translationX="-8dp"
                justificationMode="1"
                NOT_FOUND_0x1a="@color/colorDarkMint"
                NOT_FOUND_0x1c="0"
                NOT_FOUND_0x1d="@+id/tvTermConditions"
                NOT_FOUND_0x1e="@+id/tvTermConditions"
                NOT_FOUND_0x1f="@+id/tvTermConditions"
                style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <com.google.android.material.button.MaterialButton
        id="@+id/btnConfirmation"
        paddingTop="@dimen/dimen_14dp"
        paddingBottom="@dimen/dimen_14dp"
        layout_width="-1"
        layout_height="-2"
        layout_marginLeft="@dimen/dimen_20dp"
        layout_marginRight="@dimen/dimen_20dp"
        layout_marginBottom="@dimen/dimen_22dp"
        text="@string/action_confirmation"
        layout_marginHorizontal="@dimen/dimen_20dp"
        paddingVertical="@dimen/dimen_14dp"
        style="@style/BpjstkuButton.WhiteText"/>
</LinearLayout>
