<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    background="@android:color/white"
    fitsSystemWindows="true"
    layout_width="-1"
    layout_height="-1">
    <include layout="@layout/appbar_payment"/>
    <RelativeLayout
        orientation="1"
        layout_width="-1"
        layout_height="-2"
        NOT_FOUND_0xa="@string/appbar_scrolling_view_behavior">
        <ScrollView
            layout_width="-1"
            layout_height="-2"
            fillViewport="true"
            layout_above="@+id/container_item_details"
            layout_alignParentTop="true">
            <include layout="@layout/layout_gopay_status_tablet"/>
        </ScrollView>
        <View
            id="@+id/background_dim"
            background="@color/dim_background"
            visibility="2"
            layout_width="-1"
            layout_height="-2"
            layout_above="@+id/container_item_details"/>
        <LinearLayout
            orientation="1"
            id="@+id/container_item_details"
            layout_width="-1"
            layout_height="-2"
            layout_above="@+id/layout_primary_button">
            <androidx.recyclerview.widget.RecyclerView
                id="@+id/rv_transaction_detail"
                visibility="2"
                layout_width="-1"
                layout_height="-2"/>
            <View
                background="@color/light_gray"
                layout_width="-1"
                layout_height="@dimen/two_dp"/>
            <include layout="@layout/layout_total_amount"/>
        </LinearLayout>
        <View
            id="@+id/primary_button_separator"
            background="@color/light_gray"
            layout_width="-1"
            layout_height="@dimen/two_dp"
            layout_above="@+id/layout_primary_button"/>
        <include
            id="@+id/layout_primary_button"
            layout="@layout/layout_primary_button"/>
    </RelativeLayout>
    <include layout="@layout/layout_loading_and_badge"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
