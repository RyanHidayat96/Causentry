<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    orientation="0"
    paddingBottom="?attr/placesSpacingSmall"
    layout_width="-1"
    layout_height="-2">
    <ImageView
        id="@+id/ev_charging_icon"
        layout_width="@dimen/gmp_sys_measurement_icon_size_medium"
        layout_height="@dimen/gmp_sys_measurement_icon_size_medium"
        src="@drawable/gs_ev_station_vd_24"
        tint="?attr/placesColorPrimary"
        importantForAccessibility="2"
        NOT_FOUND_0x12="0"
        NOT_FOUND_0x16="0"
        NOT_FOUND_0x17="0"/>
    <TextView
        textAppearance="?attr/placesTextAppearanceBodyMedium"
        textColor="?attr/placesColorOnSurface"
        id="@+id/connector_name"
        layout_width="-2"
        layout_height="-2"
        layout_marginStart="?attr/placesSpacingLarge"
        NOT_FOUND_0x12="0"
        NOT_FOUND_0x15="@+id/ev_charging_icon"
        NOT_FOUND_0x17="0"/>
    <TextView
        textAppearance="?attr/placesTextAppearanceBodyMedium"
        textColor="?attr/placesColorOnSurfaceVariant"
        id="@+id/max_charge_rate"
        layout_width="0dp"
        layout_height="-2"
        NOT_FOUND_0x12="0"
        NOT_FOUND_0x14="@+id/chargers_available_card"
        NOT_FOUND_0x15="@+id/connector_name"
        NOT_FOUND_0x17="0"/>
    <androidx.cardview.widget.CardView
        id="@+id/chargers_available_card"
        paddingLeft="@dimen/ev_chargers_available_horizontal_padding"
        paddingTop="@dimen/ev_chargers_available_vertical_padding"
        paddingRight="@dimen/ev_chargers_available_horizontal_padding"
        paddingBottom="@dimen/ev_chargers_available_vertical_padding"
        layout_width="-2"
        layout_height="-2"
        paddingHorizontal="@dimen/ev_chargers_available_horizontal_padding"
        paddingVertical="@dimen/ev_chargers_available_vertical_padding"
        NOT_FOUND_0x10="@dimen/gmp_sys_shape_corner_extra_small_corner_size"
        NOT_FOUND_0x11="0dp"
        NOT_FOUND_0x12="0"
        NOT_FOUND_0x13="0"
        NOT_FOUND_0x17="0">
        <TextView
            textAppearance="?attr/placesTextAppearanceBodyMedium"
            textColor="?attr/placesColorOnSurface"
            id="@+id/chargers_available"
            paddingLeft="@dimen/ev_chargers_available_horizontal_padding"
            paddingTop="@dimen/ev_chargers_available_vertical_padding"
            paddingRight="@dimen/ev_chargers_available_horizontal_padding"
            paddingBottom="@dimen/ev_chargers_available_vertical_padding"
            layout_width="-2"
            layout_height="-2"
            paddingHorizontal="@dimen/ev_chargers_available_horizontal_padding"
            paddingVertical="@dimen/ev_chargers_available_vertical_padding"
            NOT_FOUND_0x12="0"
            NOT_FOUND_0x15="@+id/ev_charging_icon"
            NOT_FOUND_0x17="0"/>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
