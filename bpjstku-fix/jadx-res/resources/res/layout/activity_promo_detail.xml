<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    layout_width="-1"
    layout_height="-1"
    fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        layout_width="-1"
        layout_height="-2">
        <ImageView
            id="@+id/imgBackground"
            layout_width="@dimen/dimen_0dp"
            layout_height="@dimen/dimen_0dp"
            src="@drawable/img_background_infoprogram"
            scaleType="fitStart"
            NOT_FOUND_0x12="1:1"
            NOT_FOUND_0x13="0"
            NOT_FOUND_0x14="0"
            NOT_FOUND_0x16="0"/>
        <include
            id="@+id/layout_toolbar"
            NOT_FOUND_0x13="0"
            NOT_FOUND_0x14="0"
            NOT_FOUND_0x16="0"
            layout="@layout/layout_toolbar_center"/>
        <com.google.android.material.card.MaterialCardView
            id="@+id/cvPromoDetailImage"
            layout_width="@dimen/dimen_0dp"
            layout_height="@dimen/dimen_0dp"
            layout_marginLeft="@dimen/dimen_20dp"
            layout_marginTop="@dimen/dimen_24dp"
            layout_marginRight="@dimen/dimen_20dp"
            layout_marginHorizontal="@dimen/dimen_20dp"
            NOT_FOUND_0xe="@dimen/dimen_4dp"
            NOT_FOUND_0xf="@dimen/dimen_4dp"
            NOT_FOUND_0x10="true"
            NOT_FOUND_0x12="16:9"
            NOT_FOUND_0x13="0"
            NOT_FOUND_0x14="0"
            NOT_FOUND_0x15="@+id/layout_toolbar">
            <ImageView
                id="@+id/imgPromoDetail"
                layout_width="-1"
                layout_height="-1"
                scaleType="fitStart"/>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            textSize="@dimen/text_size_16sp"
            id="@+id/tvPromoTitle"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            text="@string/label_promo_title"
            NOT_FOUND_0x14="@+id/cvPromoDetailImage"
            NOT_FOUND_0x15="@+id/cvPromoDetailImage"
            style="@style/BpjstkuTextViewDmSans.Black.Bold"/>
        <TextView
            textSize="@dimen/text_size_12sp"
            id="@+id/tvPromoDate"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_6dp"
            text="@string/label_promo_date"
            NOT_FOUND_0x14="@+id/tvPromoTitle"
            NOT_FOUND_0x15="@+id/tvPromoTitle"
            style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
        <TextView
            id="@+id/tvPromoDescription"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            layout_marginBottom="@dimen/dimen_24dp"
            text="@string/sample_news_content"
            lineSpacingExtra="@dimen/text_size_10sp"
            NOT_FOUND_0x11="0"
            NOT_FOUND_0x13="@+id/cvPromoDetailImage"
            NOT_FOUND_0x14="@+id/cvPromoDetailImage"
            NOT_FOUND_0x15="@+id/tvPromoDate"
            NOT_FOUND_0x17="0"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
