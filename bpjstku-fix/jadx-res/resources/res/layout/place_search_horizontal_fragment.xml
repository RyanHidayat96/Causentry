<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    id="@+id/place_search_horizontal_card_view"
    layout_width="-1"
    layout_height="-2"
    NOT_FOUND_0x1a="?attr/placesCornerRadius"
    NOT_FOUND_0x1b="0dp">
    <LinearLayout
        orientation="1"
        background="?attr/placesColorSurface"
        layout_width="-1"
        layout_height="-2"
        foreground="@drawable/place_widgets_foreground">
        <include
            id="@+id/place_search_attribution_container_top"
            layout="@layout/place_search_google_maps_attribution"/>
        <View
            id="@+id/place_search_horizontal_top_gap"
            visibility="2"
            layout_width="-1"
            layout_height="?attr/placesSpacingLarge"/>
        <TextView
            id="@+id/place_search_text_top"
            paddingBottom="?attr/placesSpacingLarge"
            visibility="2"
            layout_width="-1"
            layout_height="-2"
            paddingStart="?attr/placesSpacingLarge"
            paddingEnd="?attr/placesSpacingLarge"/>
        <ProgressBar
            layout_gravity="0x1"
            id="@+id/loading_indicator"
            visibility="2"
            layout_width="@dimen/gmp_sys_measurement_icon_size_small"
            layout_height="@dimen/gmp_sys_measurement_icon_size_small"
            layout_marginTop="?attr/placesSpacingLarge"
            layout_marginBottom="?attr/placesSpacingLarge"
            indeterminate="true"
            layout_marginStart="?attr/placesSpacingLarge"
            layout_marginEnd="?attr/placesSpacingLarge"
            indeterminateTint="?attr/placesColorPrimary"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            id="@+id/place_search_list_recycler_view_container"
            clipChildren="false"
            layout_width="-1"
            layout_height="-2">
            <androidx.recyclerview.widget.RecyclerView
                orientation="0"
                id="@+id/place_search_list_recycler_view"
                clipToPadding="false"
                layout_width="-1"
                layout_height="-2"
                paddingStart="?attr/placesSpacingLarge"
                paddingEnd="?attr/placesSpacingLarge"
                NOT_FOUND_0x1c="0"
                NOT_FOUND_0x1d="0"
                NOT_FOUND_0x1e="0"
                NOT_FOUND_0x1f="0"/>
            <LinearLayout
                gravity="0x11"
                orientation="1"
                id="@+id/scroller_button"
                background="@drawable/place_search_button_background"
                visibility="2"
                layout_width="@dimen/gmp_sys_measurement_tap_target"
                layout_height="@dimen/gmp_sys_measurement_tap_target"
                layout_marginEnd="?attr/placesSpacingMedium"
                elevation="@dimen/place_search_widget_button_elevation"
                NOT_FOUND_0x1c="0"
                NOT_FOUND_0x1d="0"
                NOT_FOUND_0x1f="0">
                <ImageView
                    layout_width="@dimen/gmp_sys_measurement_icon_size_small"
                    layout_height="@dimen/gmp_sys_measurement_icon_size_small"
                    src="@drawable/gs_arrow_forward_ios_vd_20"
                    scaleType="fitStart"
                    tint="?attr/placesColorOnSurface"
                    contentDescription="@string/place_search_scroller_button_a11y_label"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            id="@+id/place_search_text_bottom"
            paddingTop="?attr/placesSpacingLarge"
            visibility="2"
            layout_width="-1"
            layout_height="-2"
            paddingStart="?attr/placesSpacingLarge"
            paddingEnd="?attr/placesSpacingLarge"/>
        <View
            id="@+id/place_search_horizontal_bottom_gap"
            visibility="2"
            layout_width="-1"
            layout_height="?attr/placesSpacingLarge"/>
        <include
            id="@+id/place_search_attribution_container_bottom"
            visibility="2"
            layout="@layout/place_search_google_maps_attribution"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
