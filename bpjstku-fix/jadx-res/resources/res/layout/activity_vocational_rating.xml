<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    layout_width="-1"
    layout_height="-1">
    <include
        id="@+id/layout_toolbar"
        layout="@layout/layout_toolbar"/>
    <com.kennyc.view.MultiStateView
        id="@+id/msvRating"
        layout_width="-1"
        layout_height="-1"
        layout_marginTop="?attr/actionBarSize"
        NOT_FOUND_0xf="0"
        NOT_FOUND_0x10="@layout/default_error_layout"
        NOT_FOUND_0x11="@layout/default_loading_layout">
        <androidx.core.widget.NestedScrollView
            layout_width="-1"
            layout_height="-1">
            <LinearLayout
                orientation="1"
                layout_width="-1"
                layout_height="-1">
                <TextView
                    id="@+id/tvRatingInstruction"
                    layout_width="-2"
                    layout_height="-2"
                    layout_marginTop="@dimen/dimen_36dp"
                    text="@string/label_pelase_rating_this_training"
                    layout_marginStart="@dimen/dimen_20dp"
                    NOT_FOUND_0xe="0"
                    NOT_FOUND_0xf="0"
                    style="@style/BpjstkuTextViewPoppins.CharcoalGrey.SemiBold"/>
                <androidx.recyclerview.widget.RecyclerView
                    id="@+id/rvVocationalRating"
                    layout_width="-1"
                    layout_height="-2"/>
                <Button
                    id="@+id/btnSendSurvey"
                    layout_width="-1"
                    layout_height="-2"
                    layout_marginLeft="@dimen/dimen_20dp"
                    layout_marginTop="@dimen/dimen_24dp"
                    layout_marginRight="@dimen/dimen_20dp"
                    layout_marginBottom="@dimen/dimen_24dp"
                    text="@string/action_send_rating"
                    layout_marginHorizontal="@dimen/dimen_20dp"
                    layout_marginVertical="@dimen/dimen_24dp"
                    NOT_FOUND_0xc="0"
                    NOT_FOUND_0xd="0"
                    NOT_FOUND_0xe="0"
                    style="@style/BpjstkuButton.WhiteText"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.kennyc.view.MultiStateView>
</androidx.constraintlayout.widget.ConstraintLayout>
