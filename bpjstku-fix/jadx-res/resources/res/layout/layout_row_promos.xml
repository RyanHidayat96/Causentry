<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    orientation="0"
    layout_width="-1"
    layout_height="-2">
    <com.midtrans.sdk.uikit.widgets.DefaultTextView
        textSize="16sp"
        textColor="@color/promoAmount"
        id="@+id/text_promo_amount"
        layout_width="-2"
        layout_height="-2"
        layout_marginTop="6dp"
        text="@string/amount"
        layout_alignParentRight="true"
        layout_alignParentEnd="true"/>
    <androidx.appcompat.widget.AppCompatCheckBox
        textSize="14sp"
        textColor="@color/dark_gray_primer"
        id="@+id/check_promo_name"
        paddingRight="@dimen/four_dp"
        layout_width="-1"
        layout_height="-2"
        text="@string/promo"
        layout_toLeftOf="@+id/text_promo_amount"
        layout_centerVertical="true"
        paddingEnd="@dimen/four_dp"
        layout_toStartOf="@+id/text_promo_amount"/>
</RelativeLayout>
