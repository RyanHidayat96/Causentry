            textSize="@dimen/secondary_text_size"
            textColor="@color/black"
            layout_width="-1"
            layout_height="-2"
            text="@string/indosat_instruction_step2"/>
    </LinearLayout>
    <LinearLayout
        background="@color/light_gray"
