<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    orientation="1"
    id="@+id/bottomSheetContainer"
    background="@drawable/bg_bottom_sheet"
    focusable="true"
    focusableInTouchMode="true"
    layout_width="-1"
    layout_height="-1">
    <View
        layout_gravity="0x1"
        id="@+id/viewTopLine"
        background="@drawable/bg_rounded_page_grey_ten"
        layout_width="@dimen/dimen_40dp"
        layout_height="@dimen/dimen_4dp"
        layout_marginTop="@dimen/dimen_15dp"/>
    <TextView
        textSize="@dimen/text_size_18sp"
        id="@+id/tvTitle"
        layout_marginLeft="@dimen/dimen_30dp"
        layout_marginTop="@dimen/dimen_22dp"
        layout_marginRight="@dimen/dimen_30dp"
        layout_marginHorizontal="@dimen/dimen_30dp"
        style="@style/BpjstkuTextViewPoppins.CharcoalGreyFour.SemiBold"/>
    <com.kennyc.view.MultiStateView
        id="@+id/msvGeneralList"
        paddingBottom="@dimen/dimen_16dp"
        layout_width="-1"
        layout_height="-1"
        NOT_FOUND_0x15="@layout/layout_default_empty"
        NOT_FOUND_0x16="@layout/layout_default_error"
        NOT_FOUND_0x17="@layout/default_loading_layout">
        <LinearLayout
            orientation="1"
            layout_width="-1"
            layout_height="-1">
            <androidx.appcompat.widget.SearchView
                theme="@style/BpjstkuSearchView"
                id="@+id/svSearchItem"
                background="@drawable/bg_search_view"
                layout_width="-1"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_30dp"
                layout_marginTop="@dimen/dimen_16dp"
                layout_marginRight="@dimen/dimen_30dp"
                inputType="0x1001"
                layout_marginHorizontal="@dimen/dimen_30dp"
                NOT_FOUND_0x14="false"
                NOT_FOUND_0x18="@null"
                NOT_FOUND_0x19="Cari Negara"/>
            <androidx.recyclerview.widget.RecyclerView
                id="@+id/rvItem"
                paddingLeft="@dimen/dimen_30dp"
                paddingRight="@dimen/dimen_30dp"
                layout_width="-1"
                layout_height="-1"
                layout_marginTop="@dimen/dimen_20dp"
                layout_marginBottom="@dimen/dimen_16dp"
                paddingHorizontal="@dimen/dimen_30dp"/>
        </LinearLayout>
    </com.kennyc.view.MultiStateView>
</LinearLayout>
