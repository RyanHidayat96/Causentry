<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    orientation="1"
    background="@color/colorWhite"
    focusable="true"
    focusableInTouchMode="true"
    layout_width="-1"
    layout_height="-1"
    layout_weight="1">
    <ScrollView
        layout_width="-1"
        layout_height="0dp"
        layout_marginBottom="@dimen/dimen_16dp"
        fillViewport="true"
        layout_weight="1">
        <androidx.constraintlayout.widget.ConstraintLayout
            layout_width="-1"
            layout_height="-2"
            layout_marginBottom="@dimen/dimen_16dp">
            <com.google.android.material.textfield.TextInputLayout
                id="@+id/tilIdentityNumber"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_20dp"
                layout_marginTop="@dimen/dimen_18dp"
                layout_marginRight="@dimen/dimen_20dp"
                hint="@string/hint_number_identitiy_card"
                layout_marginHorizontal="@dimen/dimen_20dp"
                NOT_FOUND_0x1a="0"
                NOT_FOUND_0x1b="0"
                NOT_FOUND_0x1d="0"
                style="@style/BpjstkuTextInputLayoutUnderline.Disabled">
                <com.google.android.material.textfield.TextInputEditText
                    id="@+id/edtIdentityNumber"
                    inputType="0x2"
                    style="@style/BpjstkuTextInputEditTextUnderline"/>
            </com.google.android.material.textfield.TextInputLayout>
            <LinearLayout
                orientation="1"
                id="@+id/kpjContainer"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_8dp"
                NOT_FOUND_0x1a="@+id/tilIdentityNumber"
                NOT_FOUND_0x1b="@+id/tilIdentityNumber"
                NOT_FOUND_0x1c="@+id/tilIdentityNumber"/>
            <com.google.android.material.textfield.TextInputLayout
                id="@+id/tilFullName"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                hint="@string/hint_full_name"
                NOT_FOUND_0x1a="@+id/kpjContainer"
                NOT_FOUND_0x1b="@+id/kpjContainer"
                NOT_FOUND_0x1c="@+id/kpjContainer"
                style="@style/BpjstkuTextInputLayoutUnderline.Disabled">
                <com.google.android.material.textfield.TextInputEditText
                    enabled="false"
                    id="@+id/edtFullname"
                    inputType="0x61"
                    style="@style/BpjstkuTextInputEditTextUnderline"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                id="@+id/tilNPWP"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                hint="@string/hint_npwp"
                NOT_FOUND_0x1a="@+id/tilFullName"
                NOT_FOUND_0x1b="@+id/tilFullName"
                NOT_FOUND_0x1c="@+id/tilFullName"
                style="@style/BpjstkuTextInputLayoutUnderline.Disabled">
                <com.google.android.material.textfield.TextInputEditText
                    enabled="false"
                    id="@+id/edtNPWP"
                    inputType="0x2"
                    style="@style/BpjstkuTextInputEditTextUnderline"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                id="@+id/tilPhoneNumber"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                hint="@string/hint_phone_number"
                NOT_FOUND_0x1a="@+id/tilNPWP"
                NOT_FOUND_0x1b="@+id/tilNPWP"
                NOT_FOUND_0x1c="@+id/tilNPWP"
                style="@style/BpjstkuTextInputLayoutUnderline.Disabled">
                <com.google.android.material.textfield.TextInputEditText
                    enabled="false"
                    id="@+id/edtPhoneNumber"
                    inputType="0x2"
                    style="@style/BpjstkuTextInputEditTextUnderline"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                id="@+id/tilEmail"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                hint="@string/hint_email"
                NOT_FOUND_0x1a="@+id/tilPhoneNumber"
                NOT_FOUND_0x1b="@+id/tilPhoneNumber"
                NOT_FOUND_0x1c="@+id/tilPhoneNumber"
                style="@style/BpjstkuTextInputLayoutUnderline.Disabled">
                <com.google.android.material.textfield.TextInputEditText
                    enabled="false"
                    id="@+id/edtEmail"
                    inputType="0x21"
                    style="@style/BpjstkuTextInputEditTextUnderline"/>
            </com.google.android.material.textfield.TextInputLayout>
            <androidx.appcompat.widget.AppCompatCheckBox
                textSize="@dimen/text_size_12sp"
                gravity="0x30"
                id="@+id/cbAgreeTermCondition"
                paddingTop="@dimen/dimen_4dp"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_21dp"
                layout_marginBottom="@dimen/dimen_16dp"
                text="@string/label_agree_asik_term_condition"
                translationX="-8dp"
                justificationMode="1"
                NOT_FOUND_0x19="@color/colorDarkMint"
                NOT_FOUND_0x1a="@+id/tilEmail"
                NOT_FOUND_0x1b="@+id/tilEmail"
                NOT_FOUND_0x1c="@+id/tilEmail"
                style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <com.google.android.material.button.MaterialButton
        id="@+id/btnConfirmation"
        paddingTop="@dimen/dimen_14dp"
        paddingBottom="@dimen/dimen_14dp"
        layout_width="-1"
        layout_height="-2"
        layout_marginLeft="@dimen/dimen_20dp"
        layout_marginRight="@dimen/dimen_20dp"
        layout_marginBottom="@dimen/dimen_22dp"
        text="@string/action_confirmation"
        layout_marginHorizontal="@dimen/dimen_20dp"
        paddingVertical="@dimen/dimen_14dp"
        style="@style/BpjstkuButton.WhiteText"/>
</LinearLayout>
