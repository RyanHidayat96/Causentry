<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    orientation="1"
    id="@+id/bottomSheetContainer"
    background="@drawable/bg_bottom_sheet"
    focusable="true"
    focusableInTouchMode="true"
    layout_width="-1"
    layout_height="-1">
    <ScrollView
        layout_width="-1"
        layout_height="-1">
        <androidx.constraintlayout.widget.ConstraintLayout
            paddingTop="@dimen/dimen_10dp"
            paddingBottom="@dimen/dimen_10dp"
            layout_width="-1"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_8dp"
            paddingVertical="@dimen/dimen_10dp">
            <View
                id="@+id/viewTopLine"
                background="@color/colorPaleGreyFour"
                layout_width="@dimen/dimen_50dp"
                layout_height="@dimen/dimen_4dp"
                NOT_FOUND_0x16="0"
                NOT_FOUND_0x18="0"
                NOT_FOUND_0x1a="0"/>
            <LinearLayout
                gravity="0x11"
                orientation="0"
                id="@+id/llPaymentItem"
                layout_width="-2"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_20dp"
                NOT_FOUND_0x16="0"
                NOT_FOUND_0x18="0"
                NOT_FOUND_0x19="@+id/viewTopLine">
                <ImageView
                    id="@+id/imgStatusPaymentHistory"
                    layout_width="@dimen/dimen_16dp"
                    layout_height="@dimen/dimen_16dp"
                    layout_marginEnd="@dimen/dimen_8dp"/>
                <TextView
                    textSize="@dimen/text_size_16sp"
                    id="@+id/tvStatusPaymentHistory"
                    layout_width="-2"
                    layout_height="-2"
                    style="@style/BpjstkuTextViewDmSans.Black.Bold"/>
            </LinearLayout>
            <TextView
                textSize="@dimen/text_size_14sp"
                id="@+id/tvDatePayment"
                layout_width="-2"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_6dp"
                NOT_FOUND_0x16="0"
                NOT_FOUND_0x18="0"
                NOT_FOUND_0x19="@+id/llPaymentItem"
                style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
            <TextView
                textSize="@dimen/text_size_16sp"
                id="@+id/tvTitleTransactionId"
                layout_width="-2"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_20dp"
                layout_marginTop="@dimen/dimen_60dp"
                layout_marginRight="@dimen/dimen_20dp"
                text="NIK"
                layout_marginHorizontal="@dimen/dimen_20dp"
                NOT_FOUND_0x18="0"
                NOT_FOUND_0x19="@+id/tvDatePayment"
                style="@style/BpjstkuTextViewDmSans.Black.Bold"/>
            <TextView
                textSize="@dimen/text_size_14sp"
                id="@+id/tvValueTransactionId"
                layout_width="-2"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_20dp"
                layout_marginTop="@dimen/dimen_6dp"
                layout_marginRight="@dimen/dimen_20dp"
                text="12312312321321"
                layout_marginHorizontal="@dimen/dimen_20dp"
                NOT_FOUND_0x18="0"
                NOT_FOUND_0x19="@+id/tvTitleTransactionId"
                style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
            <TextView
                textSize="@dimen/text_size_16sp"
                id="@+id/tvTitlePaymentHistory"
                layout_width="-2"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_20dp"
                layout_marginTop="@dimen/dimen_24dp"
                layout_marginRight="@dimen/dimen_20dp"
                text="Rincian Pembayaran"
                layout_marginHorizontal="@dimen/dimen_20dp"
                NOT_FOUND_0x18="0"
                NOT_FOUND_0x19="@+id/tvValueTransactionId"
                style="@style/BpjstkuTextViewDmSans.Black.Bold"/>
            <com.kennyc.view.MultiStateView
                id="@+id/msvDetailTuitionResult"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_8dp"
                layout_marginEnd="@dimen/dimen_20dp"
                NOT_FOUND_0x16="0"
                NOT_FOUND_0x18="@+id/tvTitlePaymentHistory"
                NOT_FOUND_0x19="@+id/tvTitlePaymentHistory"
                NOT_FOUND_0x1b="@layout/default_error_layout"
                NOT_FOUND_0x1c="@layout/default_error_layout"
                NOT_FOUND_0x1d="@layout/default_loading_layout">
                <androidx.recyclerview.widget.RecyclerView
                    id="@+id/rvDetailTuitionResult"
                    layout_width="-1"
                    layout_height="-1"
                    overScrollMode="2"/>
            </com.kennyc.view.MultiStateView>
            <TextView
                textSize="@dimen/text_size_16sp"
                id="@+id/tvMerchantPayment"
                layout_width="-2"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_20dp"
                layout_marginTop="@dimen/dimen_24dp"
                layout_marginRight="@dimen/dimen_20dp"
                text="Metode Pembayaran"
                layout_marginHorizontal="@dimen/dimen_20dp"
                NOT_FOUND_0x18="0"
                NOT_FOUND_0x19="@+id/msvDetailTuitionResult"
                style="@style/BpjstkuTextViewDmSans.Black.Bold"/>
            <ImageView
                gravity="0x11"
                id="@+id/imgMethodPayment"
                layout_width="@dimen/dimen_56dp"
                layout_height="@dimen/dimen_32dp"
                layout_marginTop="@dimen/dimen_8dp"
                NOT_FOUND_0x18="@+id/tvMerchantPayment"
                NOT_FOUND_0x19="@+id/tvMerchantPayment"/>
            <TextView
                textSize="@dimen/text_size_16sp"
                gravity="0x11"
                id="@+id/tvMerchantPaymentDescription"
                layout_width="-2"
                layout_height="-2"
                text="GoPay"
                layout_marginStart="@dimen/dimen_12dp"
                NOT_FOUND_0x15="@+id/imgMethodPayment"
                NOT_FOUND_0x17="@+id/imgMethodPayment"
                NOT_FOUND_0x1a="@+id/imgMethodPayment"
                style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
            <com.google.android.material.button.MaterialButton
                id="@+id/btnBack"
                layout_width="-1"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_20dp"
                layout_marginTop="@dimen/dimen_20dp"
                layout_marginRight="@dimen/dimen_20dp"
                layout_marginBottom="@dimen/dimen_20dp"
                text="@string/action_back"
                layout_marginHorizontal="@dimen/dimen_20dp"
                NOT_FOUND_0x15="0"
                NOT_FOUND_0x19="@+id/tvMerchantPaymentDescription"
                style="@style/BpjstkuTextButton.WhiteBackground"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</LinearLayout>
