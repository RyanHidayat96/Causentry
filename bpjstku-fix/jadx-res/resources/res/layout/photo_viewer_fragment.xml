<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    layout_width="-1"
    layout_height="-1">
    <ImageView
        id="@+id/blurred_background_image"
        layout_width="-1"
        layout_height="-1"
        scaleType="6"
        contentDescription="@null"
        alpha="0.8"
        NOT_FOUND_0xc="0"
        NOT_FOUND_0xd="0"
        NOT_FOUND_0x10="0"
        NOT_FOUND_0x11="0"/>
    <FrameLayout
        id="@+id/loading_failed_ui"
        background="@color/gmp_sys_color_light_disabled_surface"
        visibility="2"
        layout_width="-1"
        layout_height="-1"
        NOT_FOUND_0xc="0"
        NOT_FOUND_0xd="0"
        NOT_FOUND_0x10="0"
        NOT_FOUND_0x11="0">
        <TextView
            textAppearance="?attr/placesTextAppearanceLabelLarge"
            textColor="@color/gmp_sys_color_light_on_surface"
            layout_gravity="0x11"
            layout_width="-2"
            layout_height="-2"
            text="@string/place_photo_viewer_image_load_failed_message"/>
    </FrameLayout>
    <View
        background="@drawable/places_lightbox_top_gradient"
        layout_width="-1"
        layout_height="@dimen/lightbox_top_gradient_height"
        NOT_FOUND_0xd="0"
        NOT_FOUND_0x10="0"
        NOT_FOUND_0x11="0"/>
    <View
        background="@drawable/places_lightbox_bottom_gradient"
        layout_width="-1"
        layout_height="@dimen/lightbox_bottom_gradient_height"
        NOT_FOUND_0xc="0"
        NOT_FOUND_0xd="0"
        NOT_FOUND_0x10="0"/>
    <ImageView
        id="@+id/photo_viewer_image"
        layout_width="-1"
        layout_height="-1"
        contentDescription="@string/place_photo_viewer_photo_viewer_image_content_description"
        NOT_FOUND_0xc="0"
        NOT_FOUND_0xd="0"
        NOT_FOUND_0x10="0"
        NOT_FOUND_0x11="0"/>
    <View
        id="@+id/previous_image_button"
        layout_width="-2"
        layout_height="-2"
        contentDescription="@string/place_photo_viewer_previous_image_button_content_description"
        NOT_FOUND_0xc="0"
        NOT_FOUND_0xe="@+id/next_image_button"
        NOT_FOUND_0x10="0"
        NOT_FOUND_0x11="0"/>
    <View
        id="@+id/next_image_button"
        layout_width="-2"
        layout_height="-2"
        contentDescription="@string/place_photo_viewer_next_image_button_content_description"
        NOT_FOUND_0xc="0"
        NOT_FOUND_0xd="0"
        NOT_FOUND_0xf="@+id/previous_image_button"
        NOT_FOUND_0x11="0"/>
</androidx.constraintlayout.widget.ConstraintLayout>
