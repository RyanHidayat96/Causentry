<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    layout_width="-1"
    layout_height="-1">
    <FrameLayout
        layout_gravity="0x50"
        layout_width="-1"
        layout_height="-2">
        <androidx.constraintlayout.widget.ConstraintLayout
            background="@drawable/bg_rounded_white"
            paddingLeft="@dimen/dimen_25dp"
            paddingRight="@dimen/dimen_25dp"
            focusable="true"
            focusableInTouchMode="true"
            layout_width="-1"
            layout_height="-2"
            layout_margin="@dimen/dimen_16dp"
            paddingHorizontal="@dimen/dimen_25dp">
            <TextView
                id="@+id/tvNotificationTitle"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_20dp"
                NOT_FOUND_0x17="0"
                NOT_FOUND_0x1b="0"
                NOT_FOUND_0x1d="0"
                style="@style/BpjstkuTextViewPoppins.Dark.SemiBold"/>
            <TextView
                textSize="@dimen/text_size_12sp"
                gravity="0x800003"
                id="@+id/tvNotificationContent"
                layout_width="-1"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_12dp"
                NOT_FOUND_0x17="@+id/tvNotificationTitle"
                NOT_FOUND_0x1b="@+id/tvNotificationTitle"
                NOT_FOUND_0x1c="@+id/tvNotificationTitle"
                style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
            <androidx.constraintlayout.widget.Guideline
                orientation="1"
                id="@+id/guideline"
                layout_width="-2"
                layout_height="-2"
                NOT_FOUND_0x19="0.5"/>
            <Button
                id="@+id/btnOk"
                paddingTop="@dimen/dimen_14dp"
                paddingBottom="@dimen/dimen_14dp"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_8dp"
                layout_marginTop="@dimen/dimen_19dp"
                layout_marginBottom="@dimen/dimen_23dp"
                text="@string/action_dismiss"
                paddingVertical="@dimen/dimen_14dp"
                NOT_FOUND_0x16="0"
                NOT_FOUND_0x17="0"
                NOT_FOUND_0x1a="@+id/guideline"
                NOT_FOUND_0x1c="@+id/tvNotificationContent"
                NOT_FOUND_0x1e="0"
                style="@style/BpjstkuButton"/>
            <Button
                id="@+id/btnDeleteNotification"
                paddingTop="@dimen/dimen_14dp"
                paddingBottom="@dimen/dimen_14dp"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_19dp"
                layout_marginRight="@dimen/dimen_8dp"
                layout_marginBottom="@dimen/dimen_23dp"
                text="@string/action_delete"
                paddingVertical="@dimen/dimen_14dp"
                NOT_FOUND_0x16="0"
                NOT_FOUND_0x18="@+id/guideline"
                NOT_FOUND_0x1b="0"
                NOT_FOUND_0x1c="@+id/tvNotificationContent"
                NOT_FOUND_0x1e="0"
                style="@style/BpjstkuTextButton.Reddish.Medium"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</ScrollView>
