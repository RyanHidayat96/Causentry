<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    orientation="1"
    layout_width="-1"
    layout_height="-1">
    <com.midtrans.sdk.uikit.widgets.DefaultTextView
        id="@+id/text_expiry"
        layout_width="-1"
        layout_height="-2"
        style="@style/OtherVaNotification"/>
    <com.midtrans.sdk.uikit.widgets.DefaultTextViewWithLink
        textSize="@dimen/secondary_text_size"
        textColor="@color/black"
        gravity="0x3"
        layout_gravity="0x11"
        id="@+id/text_status_failed"
        background="@color/faint_pink"
        padding="@dimen/sixteen_dp"
        layout_width="-1"
        layout_height="-2"
        layout_marginLeft="@dimen/sixteen_dp"
        layout_marginTop="@dimen/sixteen_dp"
        layout_marginRight="@dimen/sixteen_dp"
        text="@string/klik_bca_continue"/>
    <androidx.appcompat.widget.AppCompatButton
        gravity="0x10"
        id="@+id/instruction_toggle"
        layout_width="-1"
        layout_height="-2"
        layout_marginLeft="@dimen/sixteen_dp"
        layout_marginTop="@dimen/sixteen_dp"
        layout_marginRight="@dimen/sixteen_dp"
        text="@string/show_instruction"
        style="@style/ButtonSecondaryExpandable"/>
    <LinearLayout
        orientation="1"
        id="@+id/instruction_layout"
        visibility="2"
        layout_width="-1"
        layout_height="-2">
        <LinearLayout
            background="@color/light_gray"
            paddingLeft="@dimen/sixteen_dp"
            paddingTop="@dimen/five_dp"
            paddingRight="@dimen/sixteen_dp"
            paddingBottom="@dimen/five_dp"
            layout_width="-1"
            layout_height="-2">
            <TextView
                layout_width="@dimen/twenty_four_dp"
                layout_height="-2"
                text="@string/number_instruction1"/>
            <com.midtrans.sdk.uikit.widgets.DefaultTextView
                textSize="@dimen/secondary_text_size"
                textColor="@color/black"
                layout_width="-1"
                layout_height="-2"
                text="@string/instruction_klikbca1"/>
        </LinearLayout>
        <LinearLayout
            paddingLeft="@dimen/sixteen_dp"
            paddingRight="@dimen/sixteen_dp"
            layout_width="-1"
            layout_height="-2"
            layout_marginTop="@dimen/eight_dp"
            layout_marginBottom="@dimen/sixteen_dp"
            lineSpacingExtra="2dp">
            <TextView
                layout_width="@dimen/twenty_four_dp"
                layout_height="-2"
                text="@string/number_instruction2"/>
            <com.midtrans.sdk.uikit.widgets.DefaultTextViewWithLink
                textSize="@dimen/secondary_text_size"
                textColor="@color/black"
                layout_width="-1"
                layout_height="-2"
                text="@string/instruction_klikbca2"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
