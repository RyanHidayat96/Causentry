<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    background="@color/colorWhite"
    layout_width="-1"
    layout_height="-1">
    <androidx.appcompat.widget.AppCompatTextView
        textSize="@dimen/text_size_18sp"
        id="@+id/tvTitleBottomSheet"
        layout_marginTop="@dimen/dimen_16dp"
        text="@string/label_branch_office_directory"
        layout_marginStart="@dimen/dimen_30dp"
        style="@style/BpjstkuTextViewPoppins.Black.SemiBold"/>
    <androidx.appcompat.widget.AppCompatImageView
        id="@+id/imgCollapseBottomSheetDirectory"
        layout_width="@dimen/dimen_30dp"
        layout_height="30dp"
        layout_marginTop="@dimen/dimen_16dp"
        src="@drawable/ic_arrow_down"
        layout_marginEnd="@dimen/dimen_24dp"
        layout_alignParentEnd="true"/>
    <View
        id="@+id/viewLineBottomSheet"
        background="@color/colorGrey"
        layout_width="-1"
        layout_height="1dp"
        layout_marginTop="@dimen/dimen_21dp"
        layout_below="@+id/imgCollapseBottomSheetDirectory"/>
    <com.kennyc.view.MultiStateView
        id="@+id/msvRegionalOffice"
        layout_width="-1"
        layout_height="-1"
        layout_below="@+id/viewLineBottomSheet"
        NOT_FOUND_0x12="@layout/layout_default_empty"
        NOT_FOUND_0x13="@layout/layout_default_error"
        NOT_FOUND_0x14="@layout/default_loading_layout">
        <RelativeLayout
            layout_width="-1"
            layout_height="-1">
            <androidx.appcompat.widget.SearchView
                theme="@style/BpjstkuSearchView"
                id="@+id/svSearchItem"
                background="@drawable/bg_search_view"
                focusable="false"
                layout_width="-1"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_25dp"
                layout_marginTop="@dimen/dimen_16dp"
                layout_marginRight="@dimen/dimen_25dp"
                layout_marginHorizontal="@dimen/dimen_25dp"
                NOT_FOUND_0x11="false"
                NOT_FOUND_0x15="@null"
                NOT_FOUND_0x16="@string/hint_search_regional_office"/>
            <androidx.recyclerview.widget.RecyclerView
                id="@+id/rvBranchOfficeDirectory"
                layout_width="-1"
                layout_height="-1"
                layout_marginLeft="@dimen/dimen_25dp"
                layout_marginRight="@dimen/dimen_25dp"
                layout_below="@+id/svSearchItem"
                layout_marginHorizontal="@dimen/dimen_25dp"/>
        </RelativeLayout>
    </com.kennyc.view.MultiStateView>
</RelativeLayout>
