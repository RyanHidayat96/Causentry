<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    orientation="1"
    id="@+id/bottomSheetContainer"
    background="@drawable/bg_bottom_sheet"
    focusable="true"
    focusableInTouchMode="true"
    layout_width="-1"
    layout_height="-1">
    <ScrollView
        layout_width="-1"
        layout_height="-1">
        <androidx.constraintlayout.widget.ConstraintLayout
            paddingTop="@dimen/dimen_10dp"
            paddingBottom="@dimen/dimen_10dp"
            layout_width="-1"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_8dp"
            paddingVertical="@dimen/dimen_10dp">
            <com.airbnb.lottie.LottieAnimationView
                id="@+id/animationView"
                layout_width="@dimen/dimen_48dp"
                layout_height="@dimen/dimen_48dp"
                layout_marginTop="@dimen/dimen_24dp"
                NOT_FOUND_0x15="1:1"
                NOT_FOUND_0x17="0"
                NOT_FOUND_0x18="0"
                NOT_FOUND_0x1b="0"
                NOT_FOUND_0x1c="0.25"
                NOT_FOUND_0x1d="true"
                NOT_FOUND_0x1e="true"
                NOT_FOUND_0x1f="@raw/successrecurring"/>
            <TextView
                textSize="@dimen/text_size_20sp"
                id="@+id/tvTitle"
                layout_width="-2"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_28dp"
                text="Layanan Autodebit Aktif"
                NOT_FOUND_0x16="0"
                NOT_FOUND_0x19="0"
                NOT_FOUND_0x1a="@+id/animationView"
                style="@style/BpjstkuTextViewPoppins.CharcoalGrey.SemiBold"/>
            <TextView
                textSize="@dimen/text_size_14sp"
                id="@+id/tvDescription"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_20dp"
                layout_marginTop="@dimen/dimen_22dp"
                layout_marginRight="@dimen/dimen_20dp"
                text="Pembayaran Iuran BPJS Ketenagakerjaan\10akan dibayarkan secara autodebit\10setiap bulannya,dengan metode pembayaran\10yang telah didaftarkan\10 Terima Kasih"
                textAlignment="4"
                layout_marginHorizontal="@dimen/dimen_20dp"
                NOT_FOUND_0x16="0"
                NOT_FOUND_0x19="0"
                NOT_FOUND_0x1a="@+id/tvTitle"
                style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
            <View
                id="@+id/viewSeparator"
                background="@color/colorPaleGrey"
                layout_width="-1"
                layout_height="@dimen/dimen_8dp"
                layout_marginTop="@dimen/dimen_24dp"
                NOT_FOUND_0x1a="@+id/tvDescription"/>
            <TextView
                textSize="@dimen/text_size_16sp"
                id="@+id/tvInfoAutoDebit"
                layout_width="-1"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_20dp"
                layout_marginTop="@dimen/dimen_22dp"
                layout_marginRight="@dimen/dimen_20dp"
                text="Informasi Auto Debit"
                layout_marginHorizontal="@dimen/dimen_20dp"
                NOT_FOUND_0x1a="@+id/viewSeparator"
                style="@style/BpjstkuTextViewPoppins.CharcoalGrey"/>
            <TextView
                textSize="@dimen/text_size_12sp"
                id="@+id/tvTitleName"
                layout_width="-2"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_18dp"
                text="Nama"
                layout_marginStart="@dimen/dimen_20dp"
                NOT_FOUND_0x19="0"
                NOT_FOUND_0x1a="@+id/tvInfoAutoDebit"
                style="@style/BpjstkuTextViewPoppins.CharcoalGrey"/>
            <TextView
                textSize="@dimen/text_size_12sp"
                id="@+id/tvTitleNameValue"
                layout_width="-2"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_18dp"
                layout_marginEnd="@dimen/dimen_20dp"
                NOT_FOUND_0x16="0"
                NOT_FOUND_0x1a="@+id/tvInfoAutoDebit"
                style="@style/BpjstkuTextViewPoppins.CharcoalGrey"/>
            <View
                id="@+id/viewSeparatorName"
                background="@color/colorPaleGrey"
                layout_width="-1"
                layout_height="@dimen/dimen_1dp"
                layout_marginLeft="@dimen/dimen_20dp"
                layout_marginTop="@dimen/dimen_8dp"
                layout_marginRight="@dimen/dimen_20dp"
                layout_marginHorizontal="@dimen/dimen_20dp"
                NOT_FOUND_0x1a="@+id/tvTitleNameValue"/>
            <TextView
                textSize="@dimen/text_size_12sp"
                id="@+id/tvTitleNik"
                layout_width="-2"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_12dp"
                text="NIK"
                layout_marginStart="@dimen/dimen_20dp"
                NOT_FOUND_0x19="0"
                NOT_FOUND_0x1a="@+id/viewSeparatorName"
                style="@style/BpjstkuTextViewPoppins.CharcoalGrey"/>
            <TextView
                textSize="@dimen/text_size_12sp"
                id="@+id/tvTitleNikValue"
                layout_width="-2"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_12dp"
                layout_marginEnd="@dimen/dimen_20dp"
                NOT_FOUND_0x16="0"
                NOT_FOUND_0x1a="@+id/viewSeparatorName"
                style="@style/BpjstkuTextViewPoppins.CharcoalGrey"/>
            <View
                id="@+id/viewSeparatorNik"
                background="@color/colorPaleGrey"
                layout_width="-1"
                layout_height="@dimen/dimen_1dp"
                layout_marginLeft="@dimen/dimen_20dp"
                layout_marginTop="@dimen/dimen_8dp"
                layout_marginRight="@dimen/dimen_20dp"
                layout_marginHorizontal="@dimen/dimen_20dp"
                NOT_FOUND_0x1a="@+id/tvTitleNikValue"/>
            <TextView
                textSize="@dimen/text_size_12sp"
                id="@+id/tvTitleProgram"
                layout_width="-2"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_12dp"
                text="Program"
                layout_marginStart="@dimen/dimen_20dp"
                NOT_FOUND_0x19="0"
                NOT_FOUND_0x1a="@+id/viewSeparatorNik"
                style="@style/BpjstkuTextViewPoppins.CharcoalGrey"/>
            <TextView
                textSize="@dimen/text_size_12sp"
                id="@+id/tvTitleProgramValue"
                layout_width="-2"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_12dp"
                layout_marginEnd="@dimen/dimen_20dp"
                NOT_FOUND_0x16="0"
                NOT_FOUND_0x1a="@+id/viewSeparatorNik"
                style="@style/BpjstkuTextViewPoppins.CharcoalGrey"/>
            <View
                id="@+id/viewSeparatorProgram"
                background="@color/colorPaleGrey"
                layout_width="-1"
                layout_height="@dimen/dimen_1dp"
                layout_marginLeft="@dimen/dimen_20dp"
                layout_marginTop="@dimen/dimen_8dp"
                layout_marginRight="@dimen/dimen_20dp"
                layout_marginHorizontal="@dimen/dimen_20dp"
                NOT_FOUND_0x1a="@+id/tvTitleProgramValue"/>
            <TextView
                textSize="@dimen/text_size_12sp"
                id="@+id/tvTuitionTitle"
                layout_width="-2"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_12dp"
                text="Total Iuran"
                layout_marginStart="@dimen/dimen_20dp"
                NOT_FOUND_0x19="0"
                NOT_FOUND_0x1a="@+id/viewSeparatorProgram"
                style="@style/BpjstkuTextViewPoppins.CharcoalGrey"/>
            <TextView
                textSize="@dimen/text_size_12sp"
                id="@+id/tvTuitionTitleValue"
                layout_width="-2"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_12dp"
                layout_marginEnd="@dimen/dimen_20dp"
                NOT_FOUND_0x16="0"
                NOT_FOUND_0x1a="@+id/viewSeparatorProgram"
                style="@style/BpjstkuTextViewPoppins.CharcoalGrey"/>
            <View
                id="@+id/viewSeparatorAmount"
                background="@color/colorPaleGrey"
                layout_width="-1"
                layout_height="@dimen/dimen_1dp"
                layout_marginLeft="@dimen/dimen_20dp"
                layout_marginTop="@dimen/dimen_8dp"
                layout_marginRight="@dimen/dimen_20dp"
                layout_marginHorizontal="@dimen/dimen_20dp"
                NOT_FOUND_0x1a="@+id/tvTuitionTitleValue"/>
            <TextView
                textSize="@dimen/text_size_12sp"
                id="@+id/tvRecurringChannelTitle"
                layout_width="-2"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_12dp"
                text="Metode Pembayaran"
                layout_marginStart="@dimen/dimen_20dp"
                NOT_FOUND_0x19="0"
                NOT_FOUND_0x1a="@+id/viewSeparatorAmount"
                style="@style/BpjstkuTextViewPoppins.CharcoalGrey"/>
            <TextView
                textSize="@dimen/text_size_12sp"
                id="@+id/tvRecurringChannelTitleValue"
                layout_width="-2"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_12dp"
                layout_marginEnd="@dimen/dimen_20dp"
                NOT_FOUND_0x16="0"
                NOT_FOUND_0x1a="@+id/viewSeparatorAmount"
                style="@style/BpjstkuTextViewPoppins.CharcoalGrey"/>
            <Button
                id="@+id/btnBack"
                layout_width="-1"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_20dp"
                layout_marginTop="@dimen/dimen_24dp"
                layout_marginRight="@dimen/dimen_20dp"
                layout_marginBottom="@dimen/dimen_18dp"
                text="Ok"
                layout_marginHorizontal="@dimen/dimen_20dp"
                NOT_FOUND_0x14="0"
                NOT_FOUND_0x1a="@+id/tvRecurringChannelTitleValue"
                style="@style/BpjstkuButton"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</LinearLayout>
