<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    orientation="1"
    layout_width="-1"
    layout_height="-2">
    <androidx.constraintlayout.widget.ConstraintLayout
        background="@drawable/bg_rounded_white"
        padding="@dimen/dimen_20dp"
        layout_width="-1"
        layout_height="-2"
        layout_margin="@dimen/dimen_16dp">
        <ImageView
            id="@+id/imgSuccess"
            layout_width="@dimen/dimen_72dp"
            layout_height="@dimen/dimen_72dp"
            src="@drawable/ic_error_process"
            NOT_FOUND_0x15="0"
            NOT_FOUND_0x19="0"
            NOT_FOUND_0x1b="0"/>
        <TextView
            textSize="@dimen/text_size_18sp"
            id="@+id/tvResultTitle"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_10dp"
            text="@string/label_code_sent_successfully"
            textAlignment="4"
            NOT_FOUND_0x15="0"
            NOT_FOUND_0x19="0"
            NOT_FOUND_0x1a="@+id/imgSuccess"
            style="@style/BpjstkuTextViewPoppins.CharcoalGrey.SemiBold"/>
        <TextView
            id="@+id/tvResultMessage"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_10dp"
            text="@string/label_check_email_for_verification"
            lineSpacingExtra="@dimen/text_size_6sp"
            textAlignment="4"
            NOT_FOUND_0x15="0"
            NOT_FOUND_0x19="0"
            NOT_FOUND_0x1a="@+id/tvResultTitle"
            NOT_FOUND_0x1c="@dimen/dimen_10dp"
            style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
        <com.google.android.material.button.MaterialButton
            id="@+id/btnSecondaryResultDialog"
            paddingTop="@dimen/dimen_14dp"
            paddingBottom="@dimen/dimen_14dp"
            visibility="2"
            layout_width="@dimen/dimen_0dp"
            layout_height="@dimen/dimen_0dp"
            layout_marginTop="@dimen/dimen_18dp"
            text="@string/action_ok_thanks"
            layout_marginEnd="4dp"
            paddingVertical="@dimen/dimen_14dp"
            NOT_FOUND_0x14="@+id/btnResultDialog"
            NOT_FOUND_0x16="@+id/btnResultDialog"
            NOT_FOUND_0x17="0"
            NOT_FOUND_0x19="@+id/tvResultMessage"
            NOT_FOUND_0x1a="@+id/tvResultMessage"
            style="@style/BpjstkuButton.CoolGreyBackground"/>
        <com.google.android.material.button.MaterialButton
            id="@+id/btnResultDialog"
            paddingTop="@dimen/dimen_14dp"
            paddingBottom="@dimen/dimen_14dp"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_18dp"
            minHeight="0dp"
            text="@string/action_ok_thanks"
            layout_marginStart="4dp"
            paddingVertical="@dimen/dimen_14dp"
            NOT_FOUND_0x15="@+id/tvResultMessage"
            NOT_FOUND_0x18="@+id/btnSecondaryResultDialog"
            NOT_FOUND_0x1a="@+id/tvResultMessage"
            style="@style/BpjstkuButton.WhiteText"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
