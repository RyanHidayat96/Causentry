<?xml version="1.0" encoding="utf-8"?>
<com.kennyc.view.MultiStateView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    id="@+id/msvContent"
    layout_width="-1"
    layout_height="-1"
    NOT_FOUND_0x34="@layout/layout_default_empty"
    NOT_FOUND_0x35="@layout/layout_default_error"
    NOT_FOUND_0x36="@layout/layout_default_loading">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        layout_width="-1"
        layout_height="-1">
        <com.google.android.material.appbar.AppBarLayout
            id="@+id/appbarNews"
            background="@android:color/transparent"
            fitsSystemWindows="true"
            layout_width="-1"
            layout_height="-2"
            NOT_FOUND_0x29="@dimen/dimen_0dp"
            NOT_FOUND_0x2a="true">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                background="@android:color/transparent"
                layout_width="-1"
                layout_height="-2"
                NOT_FOUND_0x33="0x3">
                <androidx.constraintlayout.widget.ConstraintLayout
                    orientation="1"
                    layout_width="-1"
                    layout_height="-2">
                    <ImageView
                        id="@+id/imgComar"
                        background="@drawable/ic_bg_comar"
                        layout_width="@dimen/dimen_0dp"
                        layout_height="@dimen/dimen_0dp"
                        scaleType="6"
                        NOT_FOUND_0x2e="4:3"
                        NOT_FOUND_0x2f="0"
                        NOT_FOUND_0x30="0"
                        NOT_FOUND_0x32="0"/>
                    <TextView
                        textSize="@dimen/text_size_16sp"
                        id="@+id/tvTitleDiscount"
                        layout_width="-1"
                        layout_height="-2"
                        layout_marginLeft="@dimen/dimen_20dp"
                        layout_marginTop="60dp"
                        layout_marginRight="@dimen/dimen_20dp"
                        layout_marginBottom="@dimen/dimen_7dp"
                        text="@string/label_title_discount"
                        layout_marginHorizontal="@dimen/dimen_20dp"
                        NOT_FOUND_0x30="0"
                        NOT_FOUND_0x32="0"
                        style="@style/BpjstkuTextViewPoppins.White.SemiBold"/>
                    <TextView
                        textSize="@dimen/text_size_12sp"
                        layout_width="-1"
                        layout_height="-2"
                        layout_marginLeft="@dimen/dimen_20dp"
                        layout_marginRight="@dimen/dimen_20dp"
                        text="@string/label_desc_discount"
                        layout_marginHorizontal="@dimen/dimen_20dp"
                        NOT_FOUND_0x30="0"
                        NOT_FOUND_0x31="@+id/tvTitleDiscount"
                        style="@style/BpjstkuTextViewDmSans.White"/>
                    <TextView
                        textSize="@dimen/text_size_14sp"
                        textColor="@color/colorCoolGrey"
                        gravity="0x10"
                        id="@+id/tvSearchMerchant"
                        paddingLeft="@dimen/dimen_10dp"
                        paddingTop="@dimen/dimen_15dp"
                        paddingRight="@dimen/dimen_10dp"
                        paddingBottom="@dimen/dimen_15dp"
                        layout_width="-1"
                        layout_height="-2"
                        layout_marginLeft="@dimen/dimen_20dp"
                        layout_marginTop="@dimen/dimen_18dp"
                        layout_marginRight="@dimen/dimen_20dp"
                        text="@string/label_search_merchant"
                        drawableEnd="@drawable/ic_search"
                        fontFamily="@font/dmsans_reguler"
                        drawableTint="@color/colorCoolGrey"
                        layout_marginHorizontal="@dimen/dimen_20dp"
                        paddingHorizontal="@dimen/dimen_10dp"
                        paddingVertical="@dimen/dimen_15dp"
                        NOT_FOUND_0x2f="0"
                        NOT_FOUND_0x30="0"
                        NOT_FOUND_0x31="@+id/imgComar"
                        style="@style/BpjstkuTextInputEditText"/>
                    <TextView
                        textSize="@dimen/text_size_18sp"
                        id="@+id/tvNewVoucher"
                        visibility="2"
                        layout_width="-2"
                        layout_height="-2"
                        layout_marginLeft="@dimen/dimen_20dp"
                        layout_marginTop="@dimen/dimen_10dp"
                        layout_marginRight="@dimen/dimen_20dp"
                        text="@string/label_new_voucher"
                        layout_marginHorizontal="@dimen/dimen_20dp"
                        NOT_FOUND_0x30="0"
                        NOT_FOUND_0x31="@+id/tvSearchMerchant"
                        style="@style/BpjstkuTextViewPoppins.CharcoalGrey.Bold"/>
                    <androidx.recyclerview.widget.RecyclerView
                        id="@+id/rvVoucher"
                        visibility="2"
                        layout_width="-1"
                        layout_height="-2"
                        layout_marginLeft="@dimen/dimen_20dp"
                        layout_marginTop="@dimen/dimen_10dp"
                        layout_marginRight="@dimen/dimen_20dp"
                        nestedScrollingEnabled="false"
                        layout_marginHorizontal="@dimen/dimen_20dp"
                        NOT_FOUND_0x30="0"
                        NOT_FOUND_0x31="@+id/tvNewVoucher"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.google.android.material.appbar.MaterialToolbar
                    gravity="0x10"
                    id="@+id/toolbarComar"
                    background="@color/colorBlue"
                    layout_width="-1"
                    layout_height="?attr/actionBarSize"
                    NOT_FOUND_0x27="@dimen/dimen_0dp"
                    NOT_FOUND_0x28="@dimen/dimen_0dp"
                    NOT_FOUND_0x2c="1"
                    NOT_FOUND_0x37="0x7f080143">
                    <TextView
                        textSize="@dimen/text_size_18sp"
                        ellipsize="3"
                        gravity="0x11"
                        id="@+id/tvToolbarTitle"
                        layout_width="-1"
                        layout_height="-2"
                        text="@string/appbar_co_marketing"
                        maxLines="1"
                        layout_marginEnd="@dimen/dimen_32dp"
                        style="@style/BpjstkuTextViewPoppins.White.SemiBold"/>
                </com.google.android.material.appbar.MaterialToolbar>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <LinearLayout
            orientation="1"
            layout_width="-1"
            layout_height="-2"
            NOT_FOUND_0x2b="@string/appbar_scrolling_view_behavior">
            <TextView
                textSize="@dimen/text_size_18sp"
                id="@+id/tvVision"
                visibility="2"
                layout_width="-2"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_20dp"
                layout_marginRight="@dimen/dimen_20dp"
                text="Promo Terbaru"
                layout_marginHorizontal="@dimen/dimen_20dp"
                style="@style/BpjstkuTextViewPoppins.CharcoalGrey.Bold"/>
            <com.google.android.material.card.MaterialCardView
                id="@+id/cvPromos"
                visibility="2"
                layout_width="-1"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_20dp"
                layout_marginTop="@dimen/dimen_10dp"
                layout_marginRight="@dimen/dimen_20dp"
                layout_marginHorizontal="@dimen/dimen_20dp"
                NOT_FOUND_0x22="@color/colorWhite"
                NOT_FOUND_0x23="@dimen/dimen_2dp"
                NOT_FOUND_0x24="@dimen/dimen_2dp"
                NOT_FOUND_0x25="true"
                NOT_FOUND_0x26="true">
                <androidx.constraintlayout.widget.ConstraintLayout
                    layout_width="-1"
                    layout_height="-1">
                    <ImageView
                        id="@+id/imgVoucherBanner"
                        background="@drawable/ic_placeholder_wide"
                        layout_width="@dimen/dimen_0dp"
                        layout_height="@dimen/dimen_0dp"
                        scaleType="6"
                        NOT_FOUND_0x2e="3:1"
                        NOT_FOUND_0x2f="0"
                        NOT_FOUND_0x30="0"
                        NOT_FOUND_0x32="0"/>
                    <LinearLayout
                        orientation="0"
                        layout_width="-1"
                        layout_height="-2"
                        layout_marginLeft="@dimen/dimen_14dp"
                        layout_marginTop="@dimen/dimen_10dp"
                        layout_marginRight="@dimen/dimen_14dp"
                        layout_marginBottom="@dimen/dimen_14dp"
                        layout_marginHorizontal="@dimen/dimen_14dp"
                        NOT_FOUND_0x2d="0"
                        NOT_FOUND_0x30="0"
                        NOT_FOUND_0x31="@+id/imgVoucherBanner">
                        <LinearLayout
                            orientation="1"
                            layout_width="0dp"
                            layout_height="-2"
                            layout_weight="1">
                            <TextView
                                textSize="@dimen/text_size_12sp"
                                ellipsize="3"
                                id="@+id/tvVoucherName"
                                layout_width="-1"
                                layout_height="-2"
                                text="Vision+ Promo"
                                maxLines="2"
                                textAllCaps="true"
                                style="@style/BpjstkuTextViewDmSans.CharcoalGrey.Bold"/>
                            <TextView
                                textSize="@dimen/text_size_12sp"
                                ellipsize="3"
                                id="@+id/tvVoucherCode"
                                layout_width="-2"
                                layout_height="-2"
                                layout_marginTop="@dimen/dimen_5dp"
                                text="Voucher Code: 38DAWIV"
                                maxLines="2"
                                style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton
                            textSize="@dimen/text_size_11sp"
                            gravity="0x11"
                            layout_gravity="0x800005"
                            id="@+id/btnUsePromo"
                            layout_width="-2"
                            layout_height="@dimen/dimen_40dp"
                            text="Gunakan Promo"
                            textAllCaps="false"
                            layout_marginStart="@dimen/dimen_14dp"
                            style="@style/BpjstkuButton.DarkMint01Background.DarkMint"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                textSize="@dimen/text_size_18sp"
                id="@+id/tvNewMerchant"
                visibility="2"
                layout_width="-2"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_20dp"
                layout_marginTop="@dimen/dimen_10dp"
                layout_marginRight="@dimen/dimen_20dp"
                text="@string/label_new_merchant"
                layout_marginHorizontal="@dimen/dimen_20dp"
                style="@style/BpjstkuTextViewPoppins.CharcoalGrey.Bold"/>
            <androidx.recyclerview.widget.RecyclerView
                id="@+id/rvMerchant"
                visibility="2"
                layout_width="-1"
                layout_height="-1"
                layout_marginLeft="@dimen/dimen_20dp"
                layout_marginTop="@dimen/dimen_10dp"
                layout_marginRight="@dimen/dimen_20dp"
                layout_marginHorizontal="@dimen/dimen_20dp"/>
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</com.kennyc.view.MultiStateView>
