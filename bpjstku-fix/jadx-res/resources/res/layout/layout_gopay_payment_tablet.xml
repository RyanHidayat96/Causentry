<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    orientation="1"
    layout_width="-1"
    layout_height="-2">
    <com.midtrans.sdk.uikit.widgets.DefaultTextView
        textSize="@dimen/primary_text_size"
        textColor="@color/dark_gray"
        paddingLeft="@dimen/sixteen_dp"
        paddingRight="@dimen/sixteen_dp"
        layout_width="-1"
        layout_height="-2"
        layout_marginTop="@dimen/sixteen_dp"
        text="@string/gopay_instruction"/>
    <LinearLayout
        background="@color/light_gray"
        paddingLeft="@dimen/sixteen_dp"
        paddingTop="@dimen/eight_dp"
        paddingRight="@dimen/sixteen_dp"
        paddingBottom="@dimen/eight_dp"
        layout_width="-1"
        layout_height="-2"
        layout_marginTop="@dimen/sixteen_dp">
        <TextView
            layout_width="@dimen/twenty_four_dp"
            layout_height="-2"
            text="@string/number_instruction1"/>
        <com.midtrans.sdk.uikit.widgets.DefaultTextView
            textSize="@dimen/secondary_text_size"
            textColor="@color/black"
            layout_width="-1"
            layout_height="-2"
            text="@string/gopay_instruction_tablet_step1"/>
    </LinearLayout>
    <LinearLayout
        paddingLeft="@dimen/sixteen_dp"
        paddingTop="@dimen/eight_dp"
        paddingRight="@dimen/sixteen_dp"
        paddingBottom="@dimen/eight_dp"
        layout_width="-1"
        layout_height="-2"
        lineSpacingExtra="2dp">
        <TextView
            layout_width="@dimen/twenty_four_dp"
            layout_height="-2"
            text="@string/number_instruction2"/>
        <com.midtrans.sdk.uikit.widgets.DefaultTextView
            textSize="@dimen/secondary_text_size"
            textColor="@color/black"
            layout_width="-1"
            layout_height="-2"
            text="@string/gopay_instruction_tablet_step2"/>
    </LinearLayout>
    <LinearLayout
        background="@color/light_gray"
        paddingLeft="@dimen/sixteen_dp"
        paddingTop="@dimen/eight_dp"
        paddingRight="@dimen/sixteen_dp"
        paddingBottom="@dimen/eight_dp"
        layout_width="-1"
        layout_height="-2"
        lineSpacingExtra="2dp">
        <TextView
            layout_width="@dimen/twenty_four_dp"
            layout_height="-2"
            text="@string/number_instruction3"/>
        <com.midtrans.sdk.uikit.widgets.DefaultTextView
            textSize="@dimen/secondary_text_size"
            textColor="@color/black"
            layout_width="-1"
            layout_height="-2"
            text="@string/gopay_instruction_tablet_step3"/>
    </LinearLayout>
    <LinearLayout
        paddingLeft="@dimen/sixteen_dp"
        paddingTop="@dimen/eight_dp"
        paddingRight="@dimen/sixteen_dp"
        paddingBottom="@dimen/eight_dp"
        layout_width="-1"
        layout_height="-2"
        lineSpacingExtra="2dp">
        <TextView
            layout_width="@dimen/twenty_four_dp"
            layout_height="-2"
            text="@string/number_instruction4"/>
        <com.midtrans.sdk.uikit.widgets.DefaultTextView
            textSize="@dimen/secondary_text_size"
            textColor="@color/black"
            layout_width="-1"
            layout_height="-2"
            text="@string/gopay_instruction_tablet_step4"/>
    </LinearLayout>
    <LinearLayout
        background="@color/light_gray"
        paddingLeft="@dimen/sixteen_dp"
        paddingTop="@dimen/eight_dp"
        paddingRight="@dimen/sixteen_dp"
        paddingBottom="@dimen/eight_dp"
        layout_width="-1"
        layout_height="-2"
        lineSpacingExtra="2dp">
        <TextView
            id="@+id/instruction_no_5"
            layout_width="@dimen/twenty_four_dp"
            layout_height="-2"
            text="@string/number_instruction5"/>
        <com.midtrans.sdk.uikit.widgets.DefaultTextView
            textSize="@dimen/secondary_text_size"
            textColor="@color/black"
            layout_width="-1"
            layout_height="-2"
            text="@string/gopay_instruction_tablet_step5"/>
    </LinearLayout>
</LinearLayout>
