<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    orientation="1"
    layout_width="-1"
    layout_height="-2">
    <com.midtrans.sdk.uikit.widgets.DefaultTextView
        id="@+id/text_validity"
        layout_width="-1"
        layout_height="-2"
        style="@style/OtherVaNotification"/>
    <ImageView
        layout_gravity="0x1"
        id="@+id/barcode_container"
        visibility="2"
        layout_width="-2"
        layout_height="-2"
        layout_marginTop="@dimen/sixteen_dp"
        scaleType="7"
        adjustViewBounds="true"/>
    <com.midtrans.sdk.uikit.widgets.DefaultTextView
        textSize="@dimen/va_number_size"
        layout_gravity="0x1"
        id="@+id/payment_code"
        layout_width="-2"
        layout_height="-2"
        layout_marginTop="@dimen/four_dp"
        layout_marginBottom="@dimen/sixteen_dp"/>
    <com.midtrans.sdk.uikit.widgets.DefaultTextView
        textSize="@dimen/secondary_text_size"
        textColor="@color/dark_gray"
        layout_width="-2"
        layout_height="-2"
        layout_marginLeft="@dimen/twenty_four_dp"
        layout_marginTop="@dimen/sixteen_dp"
        layout_marginRight="@dimen/sixteen_dp"
        text="@string/payment_code"/>
    <LinearLayout
        gravity="0x10"
        background="@color/light_gray"
        layout_width="-1"
        layout_height="-2"
        layout_marginLeft="@dimen/sixteen_dp"
        layout_marginRight="@dimen/sixteen_dp">
        <com.midtrans.sdk.uikit.widgets.DefaultTextView
            textSize="@dimen/va_number_size"
            layout_gravity="0x11"
            id="@+id/text_payment_code"
            background="@color/light_gray"
            padding="@dimen/eight_dp"
            layout_width="0dp"
            layout_height="-2"
            layout_marginRight="@dimen/four_dp"
            text="@string/payment_code"
            layout_weight="1"
            layout_marginEnd="@dimen/four_dp"/>
        <com.midtrans.sdk.uikit.widgets.FancyButton
            layout_gravity="0x10"
            id="@+id/btn_copy_va"
            paddingLeft="@dimen/sixteen_dp"
            paddingRight="@dimen/sixteen_dp"
            visibility="0"
            layout_width="-2"
            layout_height="-1"
            NOT_FOUND_0x19="@string/copy"
            style="@style/ButtonSecondaryTransparent"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatButton
        gravity="0x10"
        id="@+id/instruction_toggle"
        layout_width="-1"
        layout_height="-2"
        layout_marginLeft="@dimen/sixteen_dp"
        layout_marginTop="@dimen/sixteen_dp"
        layout_marginRight="@dimen/sixteen_dp"
        text="@string/show_instruction"
        style="@style/ButtonSecondaryExpandable"/>
    <ScrollView
        layout_width="-1"
        layout_height="-2">
        <LinearLayout
            orientation="1"
            id="@+id/instruction_layout"
            visibility="2"
            layout_width="-1"
            layout_height="-2">
            <LinearLayout
                background="@color/light_gray"
                paddingLeft="@dimen/sixteen_dp"
                paddingTop="@dimen/four_dp"
                paddingRight="@dimen/sixteen_dp"
                paddingBottom="@dimen/four_dp"
                layout_width="-1"
                layout_height="-2">
                <TextView
                    layout_width="@dimen/twenty_four_dp"
                    layout_height="-2"
                    text="@string/number_instruction1"/>
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    textSize="@dimen/secondary_text_size"
                    textColor="@color/black"
                    layout_width="-1"
                    layout_height="-2"
                    text="@string/indomaret_instruction_step1"/>
            </LinearLayout>
            <LinearLayout
                paddingLeft="@dimen/sixteen_dp"
                paddingTop="@dimen/four_dp"
                paddingRight="@dimen/sixteen_dp"
                paddingBottom="@dimen/four_dp"
                layout_width="-1"
                layout_height="-2"
                lineSpacingExtra="2dp">
                <TextView
                    layout_width="@dimen/twenty_four_dp"
                    layout_height="-2"
                    text="@string/number_instruction2"/>
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    textSize="@dimen/secondary_text_size"
                    textColor="@color/black"
                    layout_width="-1"
                    layout_height="-2"
                    text="@string/indomaret_instruction_step2"/>
            </LinearLayout>
            <LinearLayout
                background="@color/light_gray"
                paddingLeft="@dimen/sixteen_dp"
                paddingTop="@dimen/four_dp"
                paddingRight="@dimen/sixteen_dp"
                paddingBottom="@dimen/four_dp"
                layout_width="-1"
                layout_height="-2"
                lineSpacingExtra="2dp">
                <TextView
                    layout_width="@dimen/twenty_four_dp"
                    layout_height="-2"
                    text="@string/number_instruction3"/>
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    textSize="@dimen/secondary_text_size"
                    textColor="@color/black"
                    layout_width="-1"
                    layout_height="-2"
                    text="@string/indomaret_instruction_step3"/>
            </LinearLayout>
            <LinearLayout
                paddingLeft="@dimen/sixteen_dp"
                paddingTop="@dimen/four_dp"
                paddingRight="@dimen/sixteen_dp"
                paddingBottom="@dimen/four_dp"
                layout_width="-1"
                layout_height="-2"
                lineSpacingExtra="2dp">
                <TextView
                    layout_width="@dimen/twenty_four_dp"
                    layout_height="-2"
                    text="@string/number_instruction4"/>
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    textSize="@dimen/secondary_text_size"
                    textColor="@color/black"
                    layout_width="-1"
                    layout_height="-2"
                    text="@string/indomaret_instruction_step4"/>
            </LinearLayout>
            <LinearLayout
                background="@color/light_gray"
                paddingLeft="@dimen/sixteen_dp"
                paddingTop="@dimen/four_dp"
                paddingRight="@dimen/sixteen_dp"
                paddingBottom="@dimen/four_dp"
                layout_width="-1"
                layout_height="-2"
                lineSpacingExtra="2dp">
                <TextView
                    layout_width="@dimen/twenty_four_dp"
                    layout_height="-2"
                    text="@string/number_instruction5"/>
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    textSize="@dimen/secondary_text_size"
                    textColor="@color/black"
                    layout_width="-1"
                    layout_height="-2"
                    text="@string/indomaret_instruction_step5"/>
            </LinearLayout>
            <LinearLayout
                paddingLeft="@dimen/sixteen_dp"
                paddingTop="@dimen/four_dp"
                paddingRight="@dimen/sixteen_dp"
                paddingBottom="@dimen/four_dp"
                layout_width="-1"
                layout_height="-2"
                layout_marginBottom="@dimen/eight_dp"
                lineSpacingExtra="2dp">
                <TextView
                    layout_width="@dimen/twenty_four_dp"
                    layout_height="-2"
                    text="@string/number_instruction6"/>
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    textSize="@dimen/secondary_text_size"
                    textColor="@color/black"
                    layout_width="-1"
                    layout_height="-2"
                    text="@string/indomaret_instruction_step6"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
