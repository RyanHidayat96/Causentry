<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    layout_width="-1"
    layout_height="-1">
    <androidx.appcompat.widget.Toolbar
        theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        id="@+id/toolbar"
        background="?attr/colorPrimary"
        layout_width="0dp"
        layout_height="?attr/actionBarSize"
        NOT_FOUND_0x15="0"
        NOT_FOUND_0x16="0"
        NOT_FOUND_0x18="0"
        NOT_FOUND_0x19="?attr/homeAsUpIndicator"
        NOT_FOUND_0x1a="PDF Viewer"
        NOT_FOUND_0x1b="@android:color/white"/>
    <ScrollView
        id="@+id/scrollView"
        layout_width="0dp"
        layout_height="0dp"
        NOT_FOUND_0x14="@+id/layoutControls"
        NOT_FOUND_0x15="0"
        NOT_FOUND_0x16="0"
        NOT_FOUND_0x17="@+id/toolbar">
        <ImageView
            id="@+id/imageViewPdf"
            layout_width="-1"
            layout_height="-2"
            scaleType="fitStart"
            adjustViewBounds="true"
            contentDescription="PDF Page"/>
    </ScrollView>
    <ProgressBar
        id="@+id/progressBar"
        visibility="2"
        layout_width="-2"
        layout_height="-2"
        NOT_FOUND_0x13="@+id/scrollView"
        NOT_FOUND_0x15="@+id/scrollView"
        NOT_FOUND_0x16="@+id/scrollView"
        NOT_FOUND_0x18="@+id/scrollView"/>
    <LinearLayout
        orientation="0"
        id="@+id/layoutControls"
        background="?attr/colorSurface"
        padding="16dp"
        layout_width="0dp"
        layout_height="-2"
        elevation="4dp"
        NOT_FOUND_0x13="0"
        NOT_FOUND_0x15="0"
        NOT_FOUND_0x16="0">
        <Button
            id="@+id/btnPrevious"
            layout_width="0dp"
            layout_height="-2"
            text="Previous"
            layout_weight="1"
            layout_marginEnd="8dp"/>
        <TextView
            textSize="16sp"
            textStyle="0x1"
            layout_gravity="0x10"
            id="@+id/textPageInfo"
            layout_width="-2"
            layout_height="-2"
            text="1 / 1"
            layout_marginStart="8dp"
            layout_marginEnd="8dp"/>
        <Button
            id="@+id/btnNext"
            layout_width="0dp"
            layout_height="-2"
            text="Next"
            layout_weight="1"
            layout_marginStart="8dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
