            layout_width="-1"
            layout_height="-1"
            NOT_FOUND_0x1e="@string/appbar_scrolling_view_behavior">
            <androidx.viewpager.widget.ViewPager
                id="@+id/viewPagerComplaint"
                visibility="2"
                layout_width="-1"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_13dp"
                NOT_FOUND_0x20="0"
                NOT_FOUND_0x21="0"
                NOT_FOUND_0x23="0">
                <com.google.android.material.tabs.TabLayout
                    id="@+id/tabComplaintHistory"
                    layout_width="-1"
                    layout_height="-2"
                    NOT_FOUND_0x26="@color/colorWhite"
                    NOT_FOUND_0x27="@color/colorDarkMint"
                    NOT_FOUND_0x28="@color/colorDarkMint"
                    NOT_FOUND_0x29="@style/BpjstkuProgramDetailTabTextAppearance"
                    NOT_FOUND_0x2a="@color/colorCoolGrey"/>
            </androidx.viewpager.widget.ViewPager>
            <androidx.recyclerview.widget.RecyclerView
                id="@+id/rvTrackingComplaint"
                visibility="2"
                layout_width="-1"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_8dp"
                layout_marginTop="@dimen/dimen_16dp"
                layout_marginRight="@dimen/dimen_8dp"
                layout_marginHorizontal="@dimen/dimen_8dp"
                NOT_FOUND_0x20="0"
                NOT_FOUND_0x21="0"
                NOT_FOUND_0x22="@+id/viewPagerComplaint"/>
