                    <TextView
                        textSize="@dimen/text_size_16sp"
                        id="@+id/tvIdComplaint"
                        layout_width="-1"
                        layout_height="-2"
                        layout_marginLeft="@dimen/dimen_16dp"
                        layout_marginTop="@dimen/dimen_5dp"
                        layout_marginRight="@dimen/dimen_16dp"
                        layout_marginHorizontal="@dimen/dimen_16dp"
                        NOT_FOUND_0x20="0"
                        NOT_FOUND_0x21="0"
                        NOT_FOUND_0x22="@+id/tvLabelIdComplaint"
                        style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
                    <View
                        id="@+id/line1"
