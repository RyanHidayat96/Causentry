                        NOT_FOUND_0x21="0"
                        NOT_FOUND_0x22="@+id/tvMemberNumber"/>
                    <com.google.android.material.button.MaterialButton
                        textSize="@dimen/text_size_14sp"
                        id="@+id/btnDetailComplaint"
                        paddingTop="@dimen/dimen_9dp"
                        paddingBottom="@dimen/dimen_9dp"
                        visibility="2"
