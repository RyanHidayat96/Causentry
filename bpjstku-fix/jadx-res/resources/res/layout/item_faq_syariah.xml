<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    layout_width="-1"
    layout_height="-2"
    layout_marginBottom="@dimen/dimen_8dp"
    NOT_FOUND_0xd="@dimen/dimen_1dp"
    NOT_FOUND_0xe="@dimen/dimen_0dp">
    <LinearLayout
        orientation="1"
        id="@+id/llFaq"
        background="@drawable/border_grey"
        padding="@dimen/dimen_8dp"
        layout_width="-1"
        layout_height="-2">
        <TextView
            textSize="@dimen/text_size_14sp"
            id="@+id/questionFaqSyariah"
            layout_width="-1"
            layout_height="-2"
            drawablePadding="@dimen/dimen_4dp"
            drawableEnd="@drawable/ic_arrow_down"
            style="@style/BpjstkuTextViewDmSans.Black.Bold"/>
        <RelativeLayout
            id="@+id/expandableLayout"
            visibility="0"
            layout_width="-1"
            layout_height="-2">
            <TextView
                textSize="@dimen/text_size_14sp"
                id="@+id/answerFaqSyariah"
                padding="@dimen/dimen_8dp"
                layout_width="-2"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_2dp"
                justificationMode="1"
                style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        </RelativeLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
