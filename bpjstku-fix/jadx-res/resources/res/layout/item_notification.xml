<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    background="?attr/selectableItemBackground"
    layout_width="-1"
    layout_height="-2">
    <View
        id="@+id/viewUnreadIndicator"
        background="@color/colorLightBlueGrey25"
        layout_width="@dimen/dimen_0dp"
        layout_height="@dimen/dimen_0dp"
        NOT_FOUND_0xc="0"
        NOT_FOUND_0xd="0"
        NOT_FOUND_0x12="0"
        NOT_FOUND_0x14="0"/>
    <androidx.appcompat.widget.AppCompatImageView
        id="@+id/imgNotification"
        layout_width="@dimen/dimen_36dp"
        layout_height="@dimen/dimen_36dp"
        layout_marginStart="@dimen/dimen_21dp"
        NOT_FOUND_0xc="@+id/tvNotificationTime"
        NOT_FOUND_0x12="0"
        NOT_FOUND_0x14="@+id/tvTitleNotification"/>
    <androidx.appcompat.widget.AppCompatTextView
        id="@+id/tvTitleNotification"
        layout_width="@dimen/dimen_0dp"
        layout_marginTop="@dimen/dimen_18dp"
        layout_marginStart="@dimen/dimen_12dp"
        layout_marginEnd="@dimen/dimen_10dp"
        NOT_FOUND_0xe="@+id/imgUnreadIndicator"
        NOT_FOUND_0xf="0"
        NOT_FOUND_0x11="@+id/imgNotification"
        NOT_FOUND_0x14="0"
        style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
    <ImageView
        id="@+id/imgUnreadIndicator"
        visibility="2"
        layout_width="-2"
        layout_height="-2"
        layout_marginRight="@dimen/dimen_8dp"
        src="@drawable/ic_red_dot"
        NOT_FOUND_0xc="@+id/tvTitleNotification"
        NOT_FOUND_0xd="0"
        NOT_FOUND_0x10="@+id/tvTitleNotification"
        NOT_FOUND_0x14="@+id/tvTitleNotification"/>
    <androidx.appcompat.widget.AppCompatTextView
        textSize="@dimen/text_size_12sp"
        id="@+id/tvNotificationTime"
        layout_marginTop="@dimen/dimen_4dp"
        layout_marginBottom="@dimen/dimen_18dp"
        layout_marginStart="@dimen/dimen_12dp"
        NOT_FOUND_0xc="0"
        NOT_FOUND_0x11="@+id/imgNotification"
        NOT_FOUND_0x13="@+id/tvTitleNotification"
        style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
</androidx.constraintlayout.widget.ConstraintLayout>
