<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    layout_width="-1"
    layout_height="-1"
    fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        background="@color/colorWhite"
        focusable="true"
        focusableInTouchMode="true"
        layout_width="-1"
        layout_height="-2">
        <TextView
            textSize="@dimen/text_size_12sp"
            gravity="0x10"
            id="@+id/tvWarningPleaseFillYourVerificationNow"
            background="@drawable/bg_rounded_macaroni_and_cheese"
            padding="@dimen/dimen_14dp"
            layout_width="@dimen/dimen_0dp"
            layout_marginLeft="@dimen/dimen_20dp"
            layout_marginTop="@dimen/dimen_25dp"
            layout_marginRight="@dimen/dimen_20dp"
            text="@string/label_please_fill_your_verification"
            drawablePadding="@dimen/dimen_14dp"
            drawableStart="@drawable/ic_warning"
            layout_marginHorizontal="@dimen/dimen_20dp"
            NOT_FOUND_0x1e="0"
            NOT_FOUND_0x20="0"
            NOT_FOUND_0x22="0"
            style="@style/BpjstkuTextViewDmSans.White.Medium"/>
        <TextView
            textSize="@dimen/text_size_16sp"
            id="@+id/tvLivenessCheck"
            layout_marginTop="@dimen/dimen_24dp"
            text="@string/label_uploadSelfieWithIdCard"
            NOT_FOUND_0x20="@+id/tvWarningPleaseFillYourVerificationNow"
            NOT_FOUND_0x21="@+id/tvWarningPleaseFillYourVerificationNow"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey.Bold"/>
        <androidx.cardview.widget.CardView
            id="@+id/cvSelfieWithIdCard"
            layout_width="@dimen/dimen_0dp"
            layout_height="@dimen/dimen_100dp"
            layout_marginTop="@dimen/dimen_16dp"
            NOT_FOUND_0x19="@color/colorWhite"
            NOT_FOUND_0x1a="@dimen/dimen_4dp"
            NOT_FOUND_0x1b="@dimen/dimen_0dp"
            NOT_FOUND_0x1e="@+id/tvLivenessCheck"
            NOT_FOUND_0x1f="0"
            NOT_FOUND_0x20="@+id/tvLivenessCheck"
            NOT_FOUND_0x21="@+id/tvLivenessCheck"
            NOT_FOUND_0x24="0.42">
            <androidx.constraintlayout.widget.ConstraintLayout
                background="@drawable/selector_bordered_grey_blue"
                layout_width="-1"
                layout_height="-1">
                <ImageView
                    id="@+id/imgIdCardUpload"
                    layout_width="@dimen/dimen_20dp"
                    layout_height="@dimen/dimen_20dp"
                    src="@drawable/ic_camera"
                    NOT_FOUND_0x1c="0"
                    NOT_FOUND_0x1e="0"
                    NOT_FOUND_0x20="0"
                    NOT_FOUND_0x22="0"
                    NOT_FOUND_0x23="0.4"/>
                <TextView
                    textSize="@dimen/text_size_12sp"
                    id="@+id/tvIdCardUploadLabel"
                    text="@string/action_selfie_with_id_card"
                    layout_below="@+id/imgIdCardUpload"
                    NOT_FOUND_0x1e="0"
                    NOT_FOUND_0x20="0"
                    NOT_FOUND_0x21="@+id/imgIdCardUpload"
                    style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <TextView
            textSize="@dimen/text_size_14sp"
            id="@+id/tvFacialVerification"
            layout_marginTop="@dimen/dimen_24dp"
            text="@string/label_facial_biometric_verification"
            NOT_FOUND_0x20="@+id/cvSelfieWithIdCard"
            NOT_FOUND_0x21="@+id/cvSelfieWithIdCard"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey.Bold"/>
        <androidx.cardview.widget.CardView
            id="@+id/cvFacialVerification"
            layout_width="@dimen/dimen_0dp"
            layout_height="@dimen/dimen_100dp"
            layout_marginTop="@dimen/dimen_16dp"
            NOT_FOUND_0x19="@color/colorWhite"
            NOT_FOUND_0x1a="@dimen/dimen_4dp"
            NOT_FOUND_0x1b="@dimen/dimen_0dp"
            NOT_FOUND_0x1e="@+id/cvSelfieWithIdCard"
            NOT_FOUND_0x20="@+id/cvSelfieWithIdCard"
            NOT_FOUND_0x21="@+id/tvFacialVerification"
            NOT_FOUND_0x24="0.42">
            <androidx.constraintlayout.widget.ConstraintLayout
                background="@drawable/selector_bordered_grey_blue"
                layout_width="-1"
                layout_height="-1">
                <ImageView
                    id="@+id/imgFacialVerification"
                    layout_width="@dimen/dimen_20dp"
                    layout_height="@dimen/dimen_20dp"
                    src="@drawable/ic_camera"
                    NOT_FOUND_0x1c="0"
                    NOT_FOUND_0x1e="0"
                    NOT_FOUND_0x20="0"
                    NOT_FOUND_0x22="0"
                    NOT_FOUND_0x23="0.4"/>
                <TextView
                    textSize="@dimen/text_size_12sp"
                    id="@+id/tvFacialVerificationLabel"
                    text="@string/action_facial_verification"
                    NOT_FOUND_0x1e="0"
                    NOT_FOUND_0x20="0"
                    NOT_FOUND_0x21="@+id/imgFacialVerification"
                    style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <androidx.appcompat.widget.AppCompatCheckBox
            textSize="@dimen/text_size_12sp"
            gravity="0x30"
            id="@+id/cbAgreeTermCondition"
            paddingTop="@dimen/dimen_4dp"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_24dp"
            layout_marginBottom="@dimen/dimen_16dp"
            text="@string/label_agree_term_condition"
            translationX="-8dp"
            NOT_FOUND_0x18="@color/colorDarkMint"
            NOT_FOUND_0x1d="@+id/btnConfirmation"
            NOT_FOUND_0x1e="@+id/tvWarningPleaseFillYourVerificationNow"
            NOT_FOUND_0x20="@+id/tvWarningPleaseFillYourVerificationNow"
            NOT_FOUND_0x21="@+id/cvFacialVerification"
            NOT_FOUND_0x23="0"
            style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
        <com.google.android.material.button.MaterialButton
            id="@+id/btnConfirmation"
            paddingTop="@dimen/dimen_14dp"
            paddingBottom="@dimen/dimen_14dp"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginBottom="@dimen/dimen_22dp"
            text="@string/action_confirmation"
            paddingVertical="@dimen/dimen_14dp"
            NOT_FOUND_0x1c="0"
            NOT_FOUND_0x1e="@+id/tvWarningPleaseFillYourVerificationNow"
            NOT_FOUND_0x20="@+id/tvWarningPleaseFillYourVerificationNow"
            NOT_FOUND_0x23="1"
            style="@style/BpjstkuButton.WhiteText"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
