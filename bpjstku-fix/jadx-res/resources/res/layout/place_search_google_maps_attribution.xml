<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    gravity="0x800013"
    orientation="0"
    layout_width="-1"
    layout_height="-2"
    paddingStart="?attr/placesSpacingExtraLarge"
    paddingEnd="?attr/placesSpacingExtraLarge">
    <ImageView
        id="@+id/place_search_google_maps_attribution_image"
        paddingTop="?attr/placesSpacingLarge"
        paddingBottom="?attr/placesSpacingLarge"
        layout_width="-2"
        layout_height="-2"
        src="@drawable/google_maps_attribution_image"
        scaleType="fillEnd"
        contentDescription="@string/google_maps_attribution_image_description"/>
    <LinearLayout
        gravity="0x11"
        orientation="1"
        id="@+id/place_search_disclosure_icon"
        layout_width="@dimen/gmp_sys_measurement_tap_target"
        layout_height="@dimen/gmp_sys_measurement_tap_target">
        <ImageView
            id="@+id/place_search_disclosure_icon_image"
            layout_width="@dimen/gmp_sys_measurement_icon_size_small"
            layout_height="@dimen/gmp_sys_measurement_icon_size_small"
            src="@drawable/gs_info_vd_24"
            scaleType="fitStart"
            contentDescription="@string/place_widgets_legal_disclosures_icon_a11y_label"/>
    </LinearLayout>
</LinearLayout>
