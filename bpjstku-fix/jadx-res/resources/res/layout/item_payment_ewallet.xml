<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    clipToPadding="false"
    layout_width="-1"
    layout_height="-2"
    NOT_FOUND_0xc="0"
    NOT_FOUND_0xd="0"
    NOT_FOUND_0xe="0">
    <ImageView
        id="@+id/imgEwallet"
        background="?attr/selectableItemBackground"
        layout_width="@dimen/dimen_150dp"
        layout_height="@dimen/dimen_50dp"
        scaleType="6"
        adjustViewBounds="true"
        NOT_FOUND_0xb="3:1"
        NOT_FOUND_0xc="0"
        NOT_FOUND_0xd="0"
        NOT_FOUND_0xe="0"/>
    <ImageView
        id="@+id/imgCheckListGopay"
        visibility="2"
        layout_width="@dimen/dimen_12dp"
        layout_height="@dimen/dimen_12dp"
        layout_marginTop="@dimen/dimen_7dp"
        src="@drawable/ic_success"
        layout_marginEnd="@dimen/dimen_7dp"
        NOT_FOUND_0xc="0"
        NOT_FOUND_0xe="0"/>
    <ImageView
        id="@+id/imgCheckListShopeePay"
        visibility="2"
        layout_width="@dimen/dimen_12dp"
        layout_height="@dimen/dimen_12dp"
        layout_marginTop="@dimen/dimen_7dp"
        src="@drawable/ic_success"
        layout_marginEnd="@dimen/dimen_7dp"
        NOT_FOUND_0xc="0"
        NOT_FOUND_0xe="0"/>
</androidx.constraintlayout.widget.ConstraintLayout>
