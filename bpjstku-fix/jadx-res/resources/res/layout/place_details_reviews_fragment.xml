<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    id="@+id/reviews_tab"
    layout_width="-1"
    layout_height="-2"
    paddingStart="?attr/placesSpacingExtraLarge">
    <androidx.recyclerview.widget.RecyclerView
        id="@+id/reviews_list"
        layout_width="-1"
        layout_height="-2"
        nestedScrollingEnabled="false"
        NOT_FOUND_0xe="0"
        NOT_FOUND_0x10="0"
        NOT_FOUND_0x12="0"/>
    <ImageView
        id="@+id/about_reviews_icon"
        padding="@dimen/icon_padding_for_min_touch_target_18dp_icon"
        layout_width="@dimen/gmp_sys_measurement_tap_target"
        layout_height="@dimen/gmp_sys_measurement_tap_target"
        src="@drawable/gs_info_vd_24"
        tint="?attr/placesColorOnSurfaceVariant"
        contentDescription="@string/about_reviews_icon_content_description"
        NOT_FOUND_0xe="0"
        NOT_FOUND_0x11="@+id/reviews_list"/>
    <TextView
        textAppearance="?attr/placesTextAppearanceBodyMedium"
        textColor="?attr/placesColorOnSurface"
        id="@+id/about_reviews"
        layout_width="-2"
        layout_height="-2"
        text="@string/reviews_disclosure_title"
        paddingEnd="?attr/placesSpacingExtraSmall"
        NOT_FOUND_0xd="@+id/about_reviews_icon"
        NOT_FOUND_0xf="@+id/about_reviews_icon"
        NOT_FOUND_0x12="@+id/about_reviews_icon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
