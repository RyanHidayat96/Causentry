<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    layout_width="-1"
    layout_height="-1">
    <com.kennyc.view.MultiStateView
        id="@+id/msvVocationResult"
        layout_width="-1"
        layout_height="-1"
        NOT_FOUND_0xc="0"
        NOT_FOUND_0xd="0"
        NOT_FOUND_0xe="0"
        NOT_FOUND_0xf="0"
        NOT_FOUND_0x11="@layout/layout_default_empty"
        NOT_FOUND_0x12="@layout/layout_vocation_check_elegibility_loading"
        NOT_FOUND_0x13="0">
        <androidx.constraintlayout.widget.ConstraintLayout
            layout_width="-1"
            layout_height="-1">
            <ImageView
                id="@+id/imgVocationalRegistrationResult"
                layout_width="-2"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_100dp"
                src="@drawable/ic_success"
                NOT_FOUND_0xd="0"
                NOT_FOUND_0xe="0"
                NOT_FOUND_0x10="0"/>
            <TextView
                textSize="@dimen/text_size_20sp"
                id="@+id/tvVocationalRegistrationResult"
                layout_width="-2"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_30dp"
                text="@string/label_success"
                NOT_FOUND_0xd="0"
                NOT_FOUND_0xe="0"
                NOT_FOUND_0xf="@+id/imgVocationalRegistrationResult"
                style="@style/BpjstkuTextViewPoppins.CharcoalGrey.SemiBold"/>
            <TextView
                id="@+id/tvRegistrationResultDescription"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_38dp"
                layout_marginTop="@dimen/dimen_20dp"
                layout_marginRight="@dimen/dimen_38dp"
                text="@string/label_vocational_registation_result_description"
                textAlignment="4"
                layout_marginHorizontal="@dimen/dimen_38dp"
                NOT_FOUND_0xd="0"
                NOT_FOUND_0xe="0"
                NOT_FOUND_0xf="@+id/tvVocationalRegistrationResult"
                style="@style/BpjstkuTextViewDmSans"/>
            <TextView
                id="@+id/tvRegistrationResultInformation"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_22dp"
                layout_marginTop="@dimen/dimen_20dp"
                layout_marginRight="@dimen/dimen_22dp"
                text="@string/vocational_registration_information"
                textAlignment="4"
                layout_marginHorizontal="@dimen/dimen_22dp"
                NOT_FOUND_0xd="0"
                NOT_FOUND_0xe="0"
                NOT_FOUND_0xf="@+id/tvRegistrationResultDescription"
                style="@style/BpjstkuTextViewDmSans"/>
            <Button
                id="@+id/btnBack"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_32dp"
                layout_marginRight="@dimen/dimen_32dp"
                layout_marginBottom="@dimen/dimen_24dp"
                text="@string/action_back"
                layout_marginHorizontal="@dimen/dimen_32dp"
                NOT_FOUND_0xc="0"
                NOT_FOUND_0xd="0"
                NOT_FOUND_0xe="0"
                style="@style/BpjstkuButton.WhiteText"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.kennyc.view.MultiStateView>
</androidx.constraintlayout.widget.ConstraintLayout>
