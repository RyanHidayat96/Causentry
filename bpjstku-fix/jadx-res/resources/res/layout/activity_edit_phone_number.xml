<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    layout_width="-1"
    layout_height="-1">
    <include
        id="@+id/layout_toolbar"
        NOT_FOUND_0x25="0"
        NOT_FOUND_0x27="0"
        NOT_FOUND_0x29="0"
        layout="@layout/layout_toolbar_center"/>
    <TextView
        textSize="@dimen/text_size_12sp"
        id="@+id/tvEditPhoneNumberInstruction"
        layout_width="@dimen/dimen_350dp"
        layout_height="-2"
        layout_marginLeft="@dimen/dimen_20dp"
        layout_marginTop="@dimen/dimen_60dp"
        layout_marginRight="@dimen/dimen_20dp"
        text="@string/label_edit_phone_number_instruction"
        layout_marginHorizontal="@dimen/dimen_20dp"
        NOT_FOUND_0x25="0"
        NOT_FOUND_0x27="0"
        NOT_FOUND_0x28="@+id/layout_toolbar"
        style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
    <TextView
        textSize="@dimen/text_size_10sp"
        textStyle="0x2"
        id="@+id/tvSamplePhoneNumber"
        layout_width="@dimen/dimen_0dp"
        layout_marginTop="@dimen/dimen_8dp"
        text="@string/label_phone_example"
        NOT_FOUND_0x25="@+id/tvEditPhoneNumberInstruction"
        NOT_FOUND_0x27="@+id/tvEditPhoneNumberInstruction"
        NOT_FOUND_0x28="@+id/tvEditPhoneNumberInstruction"
        style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
    <com.google.android.material.card.MaterialCardView
        id="@+id/cvPhoneNumber"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        layout_marginTop="@dimen/dimen_28dp"
        NOT_FOUND_0x1f="@color/colorWhite"
        NOT_FOUND_0x20="@dimen/dimen_4dp"
        NOT_FOUND_0x21="@dimen/dimen_0dp"
        NOT_FOUND_0x25="@+id/tvEditPhoneNumberInstruction"
        NOT_FOUND_0x27="@+id/tvEditPhoneNumberInstruction"
        NOT_FOUND_0x28="@+id/tvSamplePhoneNumber"
        NOT_FOUND_0x2a="0"
        NOT_FOUND_0x2b="@color/colorPaleGrey"
        NOT_FOUND_0x2c="@dimen/dimen_1dp">
        <RelativeLayout
            layout_width="-1"
            layout_height="-2">
            <TextView
                textSize="@dimen/text_size_16sp"
                id="@+id/tvPrefix"
                background="@color/colorPrimary"
                paddingTop="@dimen/dimen_18dp"
                paddingBottom="@dimen/dimen_18dp"
                focusable="true"
                clickable="true"
                layout_width="-2"
                layout_height="-2"
                text="@string/label_prefix_indonesia_phone"
                drawablePadding="@dimen/dimen_2dp"
                paddingStart="@dimen/dimen_10dp"
                paddingEnd="@dimen/dimen_8dp"
                paddingVertical="@dimen/dimen_18dp"
                NOT_FOUND_0x22="@drawable/ic_arrow_down"
                NOT_FOUND_0x23="@color/white"
                style="@style/BpjstkuTextViewDmSans.White.Bold"/>
            <EditText
                id="@+id/edtPhoneNumber"
                background="@null"
                layout_width="-1"
                layout_height="-2"
                maxLines="1"
                lines="1"
                maxLength="15"
                digits="0123456789"
                layout_alignTop="@+id/tvPrefix"
                layout_alignBottom="@+id/tvPrefix"
                inputType="0x3"
                imeOptions="0x6"
                paddingStart="@dimen/dimen_18dp"
                paddingEnd="8dp"
                layout_toEndOf="@+id/tvPrefix"
                importantForAutofill="0x2"
                style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>
    <TextView
        textSize="@dimen/text_size_11sp"
        textStyle="0x2"
        id="@+id/tvNotes"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        layout_marginTop="8dp"
        text="@string/label_choose_dial_code"
        NOT_FOUND_0x25="@+id/tvEditPhoneNumberInstruction"
        NOT_FOUND_0x26="0"
        NOT_FOUND_0x27="@+id/tvEditPhoneNumberInstruction"
        NOT_FOUND_0x28="@+id/cvPhoneNumber"
        style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
    <Button
        enabled="false"
        id="@+id/btnSavePhoneNumber"
        paddingTop="@dimen/dimen_14dp"
        paddingBottom="@dimen/dimen_14dp"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        layout_marginBottom="@dimen/dimen_23dp"
        text="@string/action_save"
        paddingVertical="@dimen/dimen_14dp"
        NOT_FOUND_0x24="0"
        NOT_FOUND_0x25="@+id/cvPhoneNumber"
        NOT_FOUND_0x27="@+id/cvPhoneNumber"
        NOT_FOUND_0x2a="0"
        style="@style/BpjstkuButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
