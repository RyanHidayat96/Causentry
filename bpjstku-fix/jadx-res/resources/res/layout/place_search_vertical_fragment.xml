<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    id="@+id/place_search_vertical_card_view"
    layout_width="-1"
    layout_height="-1"
    NOT_FOUND_0x10="?attr/placesCornerRadius"
    NOT_FOUND_0x11="0dp">
    <LinearLayout
        orientation="1"
        background="?attr/placesColorSurface"
        layout_width="-1"
        layout_height="-2"
        foreground="@drawable/place_widgets_foreground">
        <LinearLayout
            orientation="1"
            id="@+id/place_search_attribution_container_top"
            layout_width="-1"
            layout_height="-2">
            <include layout="@layout/place_search_google_maps_attribution"/>
            <View
                background="?attr/placesColorOutlineDecorative"
                layout_width="-1"
                layout_height="@dimen/place_widget_border_width"/>
            <TextView
                id="@+id/place_search_text_top"
                padding="?attr/placesSpacingLarge"
                visibility="2"
                layout_width="-1"
                layout_height="-2"/>
        </LinearLayout>
        <ProgressBar
            layout_gravity="0x1"
            id="@+id/loading_indicator"
            visibility="2"
            layout_width="@dimen/gmp_sys_measurement_icon_size_small"
            layout_height="@dimen/gmp_sys_measurement_icon_size_small"
            layout_marginTop="?attr/placesSpacingLarge"
            layout_marginBottom="?attr/placesSpacingLarge"
            indeterminate="true"
            layout_marginStart="?attr/placesSpacingLarge"
            layout_marginEnd="?attr/placesSpacingLarge"
            indeterminateTint="?attr/placesColorPrimary"/>
        <androidx.recyclerview.widget.RecyclerView
            id="@+id/place_search_list_recycler_view"
            background="@android:color/transparent"
            layout_width="-1"
            layout_height="0dp"
            layout_weight="1"/>
        <LinearLayout
            orientation="1"
            id="@+id/place_search_attribution_container_bottom"
            layout_width="-1"
            layout_height="-2">
            <TextView
                id="@+id/place_search_text_bottom"
                padding="?attr/placesSpacingLarge"
                visibility="2"
                layout_width="-1"
                layout_height="-2"/>
            <View
                id="@+id/place_search_border_bottom"
                background="?attr/placesColorOutlineDecorative"
                layout_width="-1"
                layout_height="@dimen/place_widget_border_width"/>
            <include layout="@layout/place_search_google_maps_attribution"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
