<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    background="@color/colorWhite"
    layout_width="-1"
    layout_height="-1">
    <include
        id="@+id/layout_toolbar"
        NOT_FOUND_0x5="0"
        NOT_FOUND_0x6="0"
        NOT_FOUND_0x8="0"
        layout="@layout/layout_toolbar"/>
    <LinearLayout
        id="@+id/llProgress"
        layout_width="-1"
        layout_height="-2"
        NOT_FOUND_0x5="0"
        NOT_FOUND_0x6="0"
        NOT_FOUND_0x7="@+id/layout_toolbar">
        <include layout="@layout/layout_registration_progress"/>
    </LinearLayout>
    <FrameLayout
        id="@+id/nonSalariedWorkerContainer"
        layout_width="@dimen/dimen_0dp"
        layout_height="@dimen/dimen_0dp"
        NOT_FOUND_0x4="0"
        NOT_FOUND_0x5="0"
        NOT_FOUND_0x6="0"
        NOT_FOUND_0x7="@+id/llProgress"/>
</androidx.constraintlayout.widget.ConstraintLayout>
