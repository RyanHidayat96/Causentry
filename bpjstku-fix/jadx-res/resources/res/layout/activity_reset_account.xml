<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    id="@+id/main"
    layout_width="-1"
    layout_height="-1"
    fillViewport="true">
    <include
        id="@+id/layout_toolbar"
        layout_width="0dp"
        layout_height="24dp"
        NOT_FOUND_0x6="0"
        NOT_FOUND_0x7="0"
        NOT_FOUND_0x9="0"
        layout="@layout/layout_toolbar"/>
    <LinearLayout
        id="@+id/llProgress"
        visibility="2"
        layout_width="-1"
        layout_height="-2"
        NOT_FOUND_0x6="0"
        NOT_FOUND_0x7="0"
        NOT_FOUND_0x8="@+id/layout_toolbar">
        <include layout="@layout/layout_registration_progress"/>
    </LinearLayout>
    <FrameLayout
        id="@+id/salariedWorkerContainer"
        layout_width="@dimen/dimen_0dp"
        layout_height="@dimen/dimen_0dp"
        NOT_FOUND_0x5="0"
        NOT_FOUND_0x6="0"
        NOT_FOUND_0x7="0"
        NOT_FOUND_0x8="@+id/llProgress"/>
</androidx.constraintlayout.widget.ConstraintLayout>
