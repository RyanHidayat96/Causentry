<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    orientation="1"
    clickable="false"
    layout_width="-1"
    layout_height="-1">
    <ImageView
        layout_width="-1"
        layout_height="0dp"
        src="0x7f0800d3"
        scaleType="fitStart"
        layout_weight="1"/>
    <LinearLayout
        gravity="0x11"
        orientation="1"
        visibility="0"
        layout_width="-1"
        layout_height="-2">
        <com.midtrans.sdk.uikit.widgets.BoldTextView
            textSize="28sp"
            gravity="0x11"
            layout_gravity="0x1"
            id="@+id/text_maintenance_title"
            layout_width="-2"
            layout_height="-2"
            text="@string/failed_title"/>
        <com.midtrans.sdk.uikit.widgets.DefaultTextView
            textSize="@dimen/sixteen_sp"
            gravity="0x11"
            id="@+id/text_maintenance_message"
            layout_width="-2"
            layout_height="-2"
            layout_marginLeft="@dimen/thirtytwo_dp"
            layout_marginTop="@dimen/sixteen_dp"
            layout_marginRight="@dimen/thirtytwo_dp"
            layout_marginBottom="@dimen/sixteen_dp"
            text="@string/timeout_message"
            layout_marginStart="@dimen/thirtytwo_dp"
            layout_marginEnd="@dimen/thirtytwo_dp"/>
        <com.midtrans.sdk.uikit.widgets.FancyButton
            layout_gravity="0x1"
            id="@+id/button_maintenance_retry"
            paddingLeft="@dimen/sixteen_dp"
            paddingRight="@dimen/sixteen_dp"
            visibility="0"
            layout_width="-2"
            layout_height="@dimen/button_size"
            layout_marginTop="@dimen/sixteen_dp"
            layout_marginBottom="@dimen/thirtytwo_dp"
            NOT_FOUND_0x15="?attr/colorPrimary"
            NOT_FOUND_0x16="1dp"
            NOT_FOUND_0x17="@android:color/white"
            NOT_FOUND_0x18="@color/colorAccentLight"
            NOT_FOUND_0x19="?attr/colorPrimary"
            NOT_FOUND_0x1a="5dp"
            NOT_FOUND_0x1b="@string/try_again"
            NOT_FOUND_0x1c="?attr/colorPrimary"/>
    </LinearLayout>
</LinearLayout>
