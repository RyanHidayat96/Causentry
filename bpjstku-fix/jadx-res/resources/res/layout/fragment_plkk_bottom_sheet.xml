<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    background="@drawable/bottom_sheet_background"
    layout_width="-1"
    layout_height="-1">
    <androidx.constraintlayout.widget.ConstraintLayout
        layout_width="-1"
        layout_height="-2">
        <View
            id="@+id/viewTopLine"
            background="@color/colorPaleGreyFour"
            layout_width="@dimen/dimen_40dp"
            layout_height="@dimen/dimen_4dp"
            layout_marginTop="@dimen/dimen_14dp"
            NOT_FOUND_0xf="0"
            NOT_FOUND_0x10="0"
            NOT_FOUND_0x12="0"/>
        <androidx.appcompat.widget.AppCompatTextView
            textSize="@dimen/dimen_18dp"
            id="@+id/tvPlkkNearest"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_44dp"
            text="@string/label_plkk_nearest"
            layout_marginStart="@dimen/dimen_30dp"
            NOT_FOUND_0x10="0"
            NOT_FOUND_0x12="0"
            style="@style/BpjstkuTextViewPoppins.CharcoalGrey.SemiBold"/>
        <com.google.android.material.textfield.TextInputLayout
            id="@+id/tilPLKKlocation"
            background="@color/colorPaleGreyFour"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_30dp"
            layout_marginTop="@dimen/dimen_11dp"
            layout_marginRight="@dimen/dimen_30dp"
            hint="@string/hint_search_plkk"
            layout_marginHorizontal="@dimen/dimen_30dp"
            NOT_FOUND_0xf="0"
            NOT_FOUND_0x10="0"
            NOT_FOUND_0x11="@+id/tvPlkkNearest"
            style="@style/BpjstkuTextInputLayout.Search">
            <com.google.android.material.textfield.TextInputEditText
                id="@+id/edtPLKKlocation"
                style="@style/BpjstkuTextInputEditText"/>
        </com.google.android.material.textfield.TextInputLayout>
        <ScrollView
            layout_width="-1"
            layout_height="-2"
            NOT_FOUND_0xf="0"
            NOT_FOUND_0x10="0"
            NOT_FOUND_0x11="@+id/tilPLKKlocation">
            <com.kennyc.view.MultiStateView
                layout_width="-1"
                layout_height="-2"
                NOT_FOUND_0x13="@layout/default_layout"
                NOT_FOUND_0x14="@layout/default_layout"
                NOT_FOUND_0x15="@layout/default_loading_layout">
                <androidx.recyclerview.widget.RecyclerView
                    id="@+id/rvChoosePlkk"
                    layout_width="-1"
                    layout_height="-2"
                    layout_marginTop="@dimen/dimen_22dp"
                    layout_marginBottom="@dimen/dimen_22dp"
                    overScrollMode="2"
                    layout_marginVertical="@dimen/dimen_22dp"/>
            </com.kennyc.view.MultiStateView>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
