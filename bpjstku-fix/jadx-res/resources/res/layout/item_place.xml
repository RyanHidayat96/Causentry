<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    id="@+id/root"
    background="?attr/selectableItemBackground"
    layout_width="-1"
    layout_height="-2">
    <androidx.constraintlayout.widget.Guideline
        orientation="1"
        id="@+id/gdMarginStart"
        layout_width="-2"
        layout_height="-2"
        NOT_FOUND_0xe="@dimen/guide_start_margin"/>
    <androidx.constraintlayout.widget.Guideline
        orientation="1"
        id="@+id/gdContent"
        layout_width="-2"
        layout_height="-2"
        NOT_FOUND_0xe="@dimen/guide_content_margin"/>
    <androidx.constraintlayout.widget.Guideline
        orientation="1"
        id="@+id/gdMarginEnd"
        layout_width="-2"
        layout_height="-2"
        NOT_FOUND_0xf="@dimen/guide_end_margin"/>
    <ImageView
        id="@+id/ivPlaceType"
        layout_width="-2"
        layout_height="-2"
        tint="?attr/colorPrimary"
        NOT_FOUND_0xc="@+id/tvPlaceAddress"
        NOT_FOUND_0x10="@+id/gdMarginStart"
        NOT_FOUND_0x12="@+id/tvPlaceName"
        NOT_FOUND_0x13="@drawable/ic_map_marker_black_24dp"/>
    <TextView
        textAppearance="@style/TextAppearance.MaterialComponents.Body1"
        ellipsize="3"
        id="@+id/tvPlaceName"
        layout_width="0dp"
        layout_height="-2"
        layout_marginTop="@dimen/default_margin"
        maxLines="1"
        NOT_FOUND_0xd="@+id/gdMarginEnd"
        NOT_FOUND_0x10="@+id/gdContent"
        NOT_FOUND_0x12="0"/>
    <TextView
        textAppearance="@style/TextAppearance.MaterialComponents.Body2"
        textColor="?android:attr/textColorSecondary"
        ellipsize="3"
        id="@+id/tvPlaceAddress"
        layout_width="0dp"
        layout_height="-2"
        layout_marginBottom="@dimen/default_margin"
        maxLines="1"
        NOT_FOUND_0xc="0"
        NOT_FOUND_0xd="@+id/gdMarginEnd"
        NOT_FOUND_0x10="@+id/tvPlaceName"
        NOT_FOUND_0x11="@+id/tvPlaceName"/>
</androidx.constraintlayout.widget.ConstraintLayout>
