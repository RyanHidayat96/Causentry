<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    orientation="1"
    layout_width="-1"
    layout_height="-2">
    <androidx.constraintlayout.widget.ConstraintLayout
        background="@drawable/bg_rounded_white"
        padding="@dimen/dimen_20dp"
        layout_width="-1"
        layout_height="-2"
        layout_margin="@dimen/dimen_16dp">
        <ImageView
            id="@+id/imgSuccess"
            layout_width="@dimen/dimen_56dp"
            layout_height="@dimen/dimen_56dp"
            NOT_FOUND_0x11="0"
            NOT_FOUND_0x12="0"
            NOT_FOUND_0x14="0"/>
        <TextView
            textSize="@dimen/text_size_18sp"
            id="@+id/tvResultTitle"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_10dp"
            textAlignment="4"
            NOT_FOUND_0x11="0"
            NOT_FOUND_0x12="0"
            NOT_FOUND_0x13="@+id/imgSuccess"
            style="@style/BpjstkuTextViewPoppins.CharcoalGrey.SemiBold"/>
        <TextView
            id="@+id/tvResultMessage"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_30dp"
            layout_marginTop="@dimen/dimen_10dp"
            layout_marginRight="@dimen/dimen_30dp"
            lineSpacingExtra="@dimen/text_size_6sp"
            textAlignment="4"
            layout_marginHorizontal="@dimen/dimen_30dp"
            NOT_FOUND_0x11="@+id/tvResultTitle"
            NOT_FOUND_0x12="@+id/tvResultTitle"
            NOT_FOUND_0x13="@+id/tvResultTitle"
            style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
        <com.google.android.material.button.MaterialButton
            id="@+id/btnResultDialog"
            paddingTop="@dimen/dimen_14dp"
            paddingBottom="@dimen/dimen_14dp"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_18dp"
            paddingVertical="@dimen/dimen_14dp"
            NOT_FOUND_0x11="@+id/tvResultMessage"
            NOT_FOUND_0x12="@+id/tvResultMessage"
            NOT_FOUND_0x13="@+id/tvResultMessage"
            style="@style/BpjstkuButton.WhiteText"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
