<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    id="@+id/containerPaymentHistoryItem"
    background="?attr/selectableItemBackground"
    layout_width="-1"
    layout_height="-2">
    <View
        id="@+id/viewUnreadIndicator"
        layout_width="@dimen/dimen_0dp"
        layout_height="@dimen/dimen_0dp"
        NOT_FOUND_0xd="0"
        NOT_FOUND_0xe="0"
        NOT_FOUND_0x13="0"
        NOT_FOUND_0x15="0"/>
    <androidx.appcompat.widget.AppCompatImageView
        id="@+id/imgPaymentHistory"
        layout_width="@dimen/dimen_36dp"
        layout_height="@dimen/dimen_36dp"
        layout_marginStart="@dimen/dimen_21dp"
        NOT_FOUND_0xd="@+id/tvPaymentDate"
        NOT_FOUND_0x13="0"
        NOT_FOUND_0x15="@+id/tvTitlePaymentHistory"/>
    <androidx.appcompat.widget.AppCompatTextView
        textSize="@dimen/text_size_12sp"
        id="@+id/tvTitlePaymentHistory"
        layout_width="@dimen/dimen_0dp"
        layout_marginTop="@dimen/dimen_18dp"
        layout_marginStart="@dimen/dimen_12dp"
        layout_marginEnd="@dimen/dimen_10dp"
        NOT_FOUND_0xf="@+id/imgUnreadIndicator"
        NOT_FOUND_0x10="0"
        NOT_FOUND_0x12="@+id/imgPaymentHistory"
        NOT_FOUND_0x15="0"
        style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
    <androidx.appcompat.widget.AppCompatTextView
        textSize="@dimen/text_size_14sp"
        id="@+id/tvValuePayment"
        layout_width="@dimen/dimen_0dp"
        layout_marginTop="@dimen/dimen_5dp"
        layout_marginStart="@dimen/dimen_12dp"
        layout_marginEnd="@dimen/dimen_10dp"
        NOT_FOUND_0xf="@+id/imgUnreadIndicator"
        NOT_FOUND_0x10="0"
        NOT_FOUND_0x12="@+id/imgPaymentHistory"
        NOT_FOUND_0x14="@+id/tvTitlePaymentHistory"
        style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
    <ImageView
        id="@+id/imgUnreadIndicator"
        visibility="2"
        layout_width="-2"
        layout_height="-2"
        layout_marginRight="@dimen/dimen_8dp"
        src="@drawable/ic_red_dot"
        NOT_FOUND_0xd="@+id/tvValuePayment"
        NOT_FOUND_0xe="0"
        NOT_FOUND_0x11="@+id/tvValuePayment"
        NOT_FOUND_0x15="@+id/tvValuePayment"/>
    <androidx.appcompat.widget.AppCompatTextView
        textSize="@dimen/text_size_12sp"
        id="@+id/tvPaymentDate"
        layout_marginTop="@dimen/dimen_5dp"
        layout_marginBottom="@dimen/dimen_18dp"
        layout_marginStart="@dimen/dimen_12dp"
        NOT_FOUND_0xd="0"
        NOT_FOUND_0x12="@+id/imgPaymentHistory"
        NOT_FOUND_0x14="@+id/tvValuePayment"
        style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
    <TextView
        layout_width="-2"
        layout_height="-2"
        layout_marginRight="@dimen/dimen_8dp"
        drawableEnd="@drawable/ic_chevron_right"
        NOT_FOUND_0xd="0"
        NOT_FOUND_0xe="0"
        NOT_FOUND_0x15="0"/>
</androidx.constraintlayout.widget.ConstraintLayout>
