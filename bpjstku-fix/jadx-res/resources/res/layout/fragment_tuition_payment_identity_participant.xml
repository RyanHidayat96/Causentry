<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    layout_width="-1"
    layout_height="-1">
    <com.google.android.material.textfield.TextInputLayout
        id="@+id/tilIdNumber"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        layout_marginLeft="@dimen/dimen_20dp"
        layout_marginTop="@dimen/dimen_24dp"
        layout_marginRight="@dimen/dimen_20dp"
        hint="@string/hint_tuition_payment"
        layout_marginHorizontal="@dimen/dimen_20dp"
        NOT_FOUND_0x10="0"
        NOT_FOUND_0x11="0"
        NOT_FOUND_0x13="0"
        style="@style/BpjstkuTextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            maxLength="16"
            digits="0123456789"
            inputType="0x3"
            imeOptions="0x5"
            style="@style/BpjstkuTextInputEditText"/>
    </com.google.android.material.textfield.TextInputLayout>
    <TextView
        id="@+id/tvEnterPhoneNumberInstruction"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        layout_marginTop="@dimen/dimen_8dp"
        letterSpacing="0.02"
        NOT_FOUND_0x10="@+id/tilIdNumber"
        NOT_FOUND_0x11="@+id/tilIdNumber"
        NOT_FOUND_0x12="@+id/tilIdNumber"
        style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
    <com.google.android.material.button.MaterialButton
        id="@+id/btnCheckBpuIdNumber"
        layout_width="-1"
        layout_height="-2"
        layout_marginLeft="@dimen/dimen_20dp"
        layout_marginTop="@dimen/dimen_20dp"
        layout_marginRight="@dimen/dimen_20dp"
        layout_marginBottom="@dimen/dimen_20dp"
        text="@string/action_next"
        layout_marginHorizontal="@dimen/dimen_20dp"
        NOT_FOUND_0xf="0"
        NOT_FOUND_0x12="@+id/tvMerchantPaymentDescription"
        style="@style/BpjstkuButtonDmSans"/>
</androidx.constraintlayout.widget.ConstraintLayout>
