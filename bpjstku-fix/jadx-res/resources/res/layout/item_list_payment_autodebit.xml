<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    layout_width="-1"
    layout_height="-2"
    layout_marginBottom="@dimen/dimen_8dp">
    <LinearLayout
        orientation="1"
        background="@drawable/bg_item_bordered"
        paddingTop="@dimen/dimen_12dp"
        paddingBottom="@dimen/dimen_12dp"
        layout_width="-1"
        layout_height="-2"
        animateLayoutChanges="true"
        paddingVertical="@dimen/dimen_12dp"
        NOT_FOUND_0x1d="0">
        <RelativeLayout
            orientation="0"
            layout_width="-1"
            layout_height="-2">
            <ImageView
                layout_gravity="0x11"
                id="@+id/imgCategoryPayment"
                paddingLeft="@dimen/dimen_18dp"
                paddingRight="@dimen/dimen_12dp"
                layout_width="@dimen/dimen_80dp"
                layout_height="@dimen/dimen_30dp"
                layout_alignParentLeft="true"
                layout_centerVertical="true"
                layout_alignParentStart="true"
                NOT_FOUND_0x1e="0x7f08036a"/>
            <TextView
                textSize="@dimen/text_size_12sp"
                textStyle="0x1"
                textColor="@android:color/black"
                gravity="0x10"
                id="@+id/tvPaymentMethod"
                layout_width="-2"
                layout_height="-2"
                layout_marginLeft="4dp"
                text="Bank Mandiri"
                layout_toRightOf="@+id/imgCategoryPayment"
                layout_centerVertical="true"/>
            <RadioButton
                id="@+id/rbSelectedPaymentAutodebit"
                clickable="false"
                layout_width="-2"
                layout_height="-2"
                checked="false"
                minWidth="@dimen/dimen_0dp"
                minHeight="@dimen/dimen_0dp"
                layout_alignParentRight="true"
                layout_centerVertical="true"
                layout_alignParentEnd="true"
                style="@style/BpjstkuRadioButton.DmSansCoolGrey"/>
        </RelativeLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
