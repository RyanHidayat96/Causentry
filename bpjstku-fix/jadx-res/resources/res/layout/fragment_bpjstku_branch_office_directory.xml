<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    layout_width="-1"
    layout_height="-1">
    <com.google.android.material.appbar.MaterialToolbar
        id="@+id/mttbDirectoryOffice"
        background="@drawable/bg_half_rounded_white"
        layout_width="-1"
        layout_height="?attr/actionBarSize"
        NOT_FOUND_0x9="0"
        NOT_FOUND_0xa="0"
        NOT_FOUND_0xc="0">
        <TextView
            textSize="@dimen/text_size_14sp"
            id="@+id/tvToolbarTitle"
            layout_width="-2"
            layout_height="-2"
            text="Direktori Kantor Cabang"
            layout_marginEnd="@dimen/dimen_32dp"
            style="@style/BpjstkuTextViewPoppins.CharcoalGrey.Bold"/>
        <ImageView
            id="@+id/imgArrowDown"
            layout_width="-2"
            layout_height="-2"
            src="@drawable/ic_arrow_down"
            layout_marginStart="@dimen/dimen_140dp"
            NOT_FOUND_0x9="0"
            NOT_FOUND_0xa="0"/>
    </com.google.android.material.appbar.MaterialToolbar>
    <androidx.recyclerview.widget.RecyclerView
        id="@+id/rvBranchOfficeList"
        layout_width="0dp"
        layout_height="-2"
        NOT_FOUND_0x9="0"
        NOT_FOUND_0xa="0"
        NOT_FOUND_0xb="@+id/mttbDirectoryOffice"/>
</androidx.constraintlayout.widget.ConstraintLayout>
