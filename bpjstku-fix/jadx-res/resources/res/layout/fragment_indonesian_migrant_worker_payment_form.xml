<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    layout_width="-1"
    layout_height="-1"
    fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        background="@color/colorWhite"
        layout_width="-1"
        layout_height="-2">
        <com.google.android.material.textfield.TextInputLayout
            id="@+id/tilIdentityNumber"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_20dp"
            layout_marginTop="@dimen/dimen_16dp"
            layout_marginRight="@dimen/dimen_20dp"
            hint="@string/hint_number_identitiy_card"
            layout_marginHorizontal="@dimen/dimen_20dp"
            NOT_FOUND_0x16="0"
            NOT_FOUND_0x17="0"
            NOT_FOUND_0x19="0"
            style="@style/BpjstkuTextInputLayoutUnderline.Disabled">
            <com.google.android.material.textfield.TextInputEditText
                id="@+id/edtIdentityNumber"
                style="@style/BpjstkuTextInputEditTextUnderline"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            id="@+id/tilFullName"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            hint="@string/hint_full_name"
            NOT_FOUND_0x16="@+id/tilIdentityNumber"
            NOT_FOUND_0x17="@+id/tilIdentityNumber"
            NOT_FOUND_0x18="@+id/tilIdentityNumber"
            style="@style/BpjstkuTextInputLayoutUnderline.Disabled">
            <com.google.android.material.textfield.TextInputEditText
                id="@+id/edtFullname"
                style="@style/BpjstkuTextInputEditTextUnderline"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            id="@+id/tilBirthDate"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            hint="@string/hint_date_birth"
            NOT_FOUND_0x16="@+id/tilFullName"
            NOT_FOUND_0x17="@+id/tilFullName"
            NOT_FOUND_0x18="@+id/tilFullName"
            style="@style/BpjstkuTextInputLayoutUnderline.Disabled">
            <com.google.android.material.textfield.TextInputEditText
                id="@+id/edtBirthDate"
                style="@style/BpjstkuTextInputEditTextUnderline"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            id="@+id/tilGender"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            hint="@string/hint_gender"
            NOT_FOUND_0x16="@+id/tilBirthDate"
            NOT_FOUND_0x17="@+id/tilBirthDate"
            NOT_FOUND_0x18="@+id/tilBirthDate"
            style="@style/BpjstkuTextInputLayoutUnderline.Disabled">
            <com.google.android.material.textfield.TextInputEditText
                id="@+id/edtGender"
                style="@style/BpjstkuTextInputEditTextUnderline"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            id="@+id/tilMothersName"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            hint="@string/hint_mothers_name"
            NOT_FOUND_0x16="@+id/tilGender"
            NOT_FOUND_0x17="@+id/tilGender"
            NOT_FOUND_0x18="@+id/tilGender"
            style="@style/BpjstkuTextInputLayoutUnderline.Disabled">
            <com.google.android.material.textfield.TextInputEditText
                id="@+id/edtMothersName"
                style="@style/BpjstkuTextInputEditTextUnderline"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            id="@+id/tilFathersName"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            hint="@string/hint_fathers_name"
            NOT_FOUND_0x16="@+id/tilMothersName"
            NOT_FOUND_0x17="@+id/tilMothersName"
            NOT_FOUND_0x18="@+id/tilMothersName"
            style="@style/BpjstkuTextInputLayoutUnderline.Disabled">
            <com.google.android.material.textfield.TextInputEditText
                id="@+id/edtFathersName"
                style="@style/BpjstkuTextInputEditTextUnderline"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            id="@+id/tilChooseProvince"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            hint="@string/hint_province"
            NOT_FOUND_0x16="@+id/tilFathersName"
            NOT_FOUND_0x17="@+id/tilFathersName"
            NOT_FOUND_0x18="@+id/tilFathersName"
            style="@style/BpjstkuTextInputLayoutUnderline.Disabled">
            <com.google.android.material.textfield.TextInputEditText
                id="@+id/edtChoosedProvince"
                style="@style/BpjstkuTextInputEditTextUnderline"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            id="@+id/tilChooseCity"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            hint="@string/hint_city"
            NOT_FOUND_0x16="@+id/tilChooseProvince"
            NOT_FOUND_0x17="@+id/tilChooseProvince"
            NOT_FOUND_0x18="@+id/tilChooseProvince"
            style="@style/BpjstkuTextInputLayoutUnderline.Disabled">
            <com.google.android.material.textfield.TextInputEditText
                id="@+id/edtChoosedCity"
                style="@style/BpjstkuTextInputEditTextUnderline"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            id="@+id/tilBranchOffice"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            hint="@string/hint_registered_branch_office"
            NOT_FOUND_0x16="@+id/tilChooseCity"
            NOT_FOUND_0x17="@+id/tilChooseCity"
            NOT_FOUND_0x18="@+id/tilChooseCity"
            style="@style/BpjstkuTextInputLayoutUnderline.Disabled">
            <com.google.android.material.textfield.TextInputEditText
                id="@+id/edtBranchOffice"
                style="@style/BpjstkuTextInputEditTextUnderline"/>
        </com.google.android.material.textfield.TextInputLayout>
        <androidx.appcompat.widget.AppCompatTextView
            id="@+id/tvChoosedProgram"
            layout_marginTop="@dimen/dimen_24dp"
            text="@string/label_program_choosed"
            NOT_FOUND_0x17="@+id/tilBranchOffice"
            NOT_FOUND_0x18="@+id/tilBranchOffice"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey.Bold"/>
        <com.google.android.material.card.MaterialCardView
            id="@+id/cvProgramChoosed"
            background="@drawable/border_darkmint"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            NOT_FOUND_0x13="@dimen/dimen_8dp"
            NOT_FOUND_0x14="@dimen/dimen_4dp"
            NOT_FOUND_0x16="@+id/tilBranchOffice"
            NOT_FOUND_0x17="@+id/tvChoosedProgram"
            NOT_FOUND_0x18="@+id/tvChoosedProgram">
            <androidx.appcompat.widget.AppCompatImageView
                id="@+id/imgProgramChoosed"
                layout_width="@dimen/dimen_36dp"
                layout_height="@dimen/dimen_36dp"
                layout_marginTop="@dimen/dimen_19dp"
                layout_marginBottom="@dimen/dimen_19dp"
                src="@drawable/ic_people_jkk"
                layout_marginStart="@dimen/dimen_16dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                textSize="@dimen/text_size_18sp"
                layout_gravity="0x10"
                id="@+id/tvProgramChoosed"
                text="@string/label_jkk_jkm"
                layout_marginStart="67dp"
                style="@style/BpjstkuTextViewPoppins.CharcoalGrey"/>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton
            id="@+id/btnConfirmation"
            paddingTop="@dimen/dimen_14dp"
            paddingBottom="@dimen/dimen_14dp"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            layout_marginBottom="@dimen/dimen_22dp"
            text="@string/action_confirmation"
            paddingVertical="@dimen/dimen_14dp"
            NOT_FOUND_0x15="0"
            NOT_FOUND_0x16="@+id/cvProgramChoosed"
            NOT_FOUND_0x17="@+id/cvProgramChoosed"
            NOT_FOUND_0x18="@+id/cvProgramChoosed"
            NOT_FOUND_0x1a="1"
            style="@style/BpjstkuButton.WhiteText"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
