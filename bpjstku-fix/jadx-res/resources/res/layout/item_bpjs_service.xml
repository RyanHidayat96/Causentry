<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    clipToPadding="false"
    layout_width="-1"
    layout_height="-2">
    <ImageView
        id="@+id/imgService"
        background="?attr/selectableItemBackground"
        layout_width="@dimen/dimen_60dp"
        layout_height="@dimen/dimen_60dp"
        adjustViewBounds="true"
        layout_alignStart="@+id/tvServiceName"
        layout_alignEnd="@+id/tvServiceName"
        NOT_FOUND_0xb="1:1"
        NOT_FOUND_0xc="0"
        NOT_FOUND_0xd="0"
        NOT_FOUND_0xf="0"/>
    <TextView
        textSize="@dimen/text_size_11sp"
        id="@+id/tvServiceName"
        layout_marginTop="@dimen/dimen_12dp"
        textAlignment="4"
        NOT_FOUND_0xc="@+id/imgService"
        NOT_FOUND_0xd="@+id/imgService"
        NOT_FOUND_0xe="@+id/imgService"
        style="@style/BpjstkuTextViewDmSans.CharcoalGrey.Medium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
