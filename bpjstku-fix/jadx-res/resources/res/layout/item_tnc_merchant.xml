<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    paddingBottom="@dimen/dimen_8dp"
    layout_width="-1"
    layout_height="-2">
    <ImageView
        id="@+id/iconInfoProgram"
        visibility="0"
        layout_width="@dimen/dimen_16dp"
        layout_height="@dimen/dimen_16dp"
        src="@drawable/ic_success"
        NOT_FOUND_0xb="0"
        NOT_FOUND_0xd="0"/>
    <TextView
        textSize="@dimen/text_size_14sp"
        id="@+id/tvProgramTitle"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        layout_marginBottom="@dimen/dimen_4dp"
        layout_marginStart="@dimen/dimen_10dp"
        NOT_FOUND_0x9="0"
        NOT_FOUND_0xa="@+id/iconInfoProgram"
        NOT_FOUND_0xd="0"
        style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
    <TextView
        textSize="@dimen/text_size_12sp"
        id="@+id/tvProgramDescription"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        layout_marginStart="@dimen/dimen_10dp"
        NOT_FOUND_0x9="0"
        NOT_FOUND_0xa="@+id/iconInfoProgram"
        NOT_FOUND_0xc="@+id/tvProgramTitle"
        style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
</androidx.constraintlayout.widget.ConstraintLayout>
