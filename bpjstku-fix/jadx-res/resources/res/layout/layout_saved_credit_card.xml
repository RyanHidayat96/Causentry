<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    orientation="1"
    layout_width="-1"
    layout_height="-1">
    <androidx.recyclerview.widget.RecyclerView
        id="@+id/container_saved_card"
        layout_width="-1"
        layout_height="-2"/>
    <com.midtrans.sdk.uikit.widgets.FancyButton
        layout_gravity="0x1"
        id="@+id/btn_add_card"
        layout_width="-2"
        layout_height="-2"
        layout_marginTop="19dp"
        NOT_FOUND_0x6="@dimen/four_dp"
        NOT_FOUND_0x7="0x7f0802cd"
        NOT_FOUND_0x8="@string/add_new_card"
        style="@style/ButtonSecondary"/>
</LinearLayout>
