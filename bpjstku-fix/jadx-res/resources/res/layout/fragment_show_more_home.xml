<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    background="@drawable/bg_bottom_sheet"
    layout_width="-1"
    layout_height="-1">
    <androidx.appcompat.widget.AppCompatTextView
        textSize="@dimen/text_size_18sp"
        id="@+id/tvTitleBottomSheet"
        layout_marginTop="@dimen/dimen_16dp"
        text="@string/label_jmo_service"
        layout_marginStart="@dimen/dimen_30dp"
        style="@style/BpjstkuTextViewPoppins.Black.SemiBold"/>
    <View
        id="@+id/viewLineBottomSheet"
        background="@color/colorGrey"
        layout_width="-1"
        layout_height="1dp"
        layout_marginTop="@dimen/dimen_21dp"
        layout_below="@+id/tvTitleBottomSheet"/>
    <com.kennyc.view.MultiStateView
        id="@+id/msvMenu"
        layout_width="-1"
        layout_height="-1"
        layout_marginTop="@dimen/dimen_32dp"
        layout_below="@+id/viewLineBottomSheet"
        NOT_FOUND_0xe="@layout/layout_default_empty"
        NOT_FOUND_0xf="@layout/layout_default_error"
        NOT_FOUND_0x10="@layout/default_loading_layout">
        <RelativeLayout
            layout_width="-1"
            layout_height="-1">
            <androidx.recyclerview.widget.RecyclerView
                id="@+id/rvServices"
                layout_width="-1"
                layout_height="-1"
                layout_marginLeft="@dimen/dimen_25dp"
                layout_marginRight="@dimen/dimen_25dp"
                layout_marginHorizontal="@dimen/dimen_25dp"/>
        </RelativeLayout>
    </com.kennyc.view.MultiStateView>
    <com.google.android.material.button.MaterialButton
        id="@+id/btnCloseDialog"
        layout_width="-1"
        layout_height="-2"
        layout_marginLeft="@dimen/dimen_20dp"
        layout_marginTop="@dimen/dimen_20dp"
        layout_marginRight="@dimen/dimen_20dp"
        layout_marginBottom="@dimen/dimen_32dp"
        text="@string/action_dismiss"
        layout_alignParentBottom="true"
        layout_marginHorizontal="@dimen/dimen_20dp"
        style="@style/BpjstkuTextButton.WhiteBackground"/>
</RelativeLayout>
