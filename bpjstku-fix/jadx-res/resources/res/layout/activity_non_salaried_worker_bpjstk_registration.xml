<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    id="@+id/nonSalariedWorkerRegistrationContainer"
    background="@color/colorWhite"
    focusable="true"
    focusableInTouchMode="true"
    layout_width="-1"
    layout_height="-1">
    <include
        id="@+id/layout_toolbar"
        NOT_FOUND_0x18="0"
        NOT_FOUND_0x1a="0"
        NOT_FOUND_0x1c="0"
        layout="@layout/layout_toolbar"/>
    <TextView
        textSize="@dimen/text_size_16sp"
        id="@+id/tvCompleteYourPersonalData"
        layout_width="@dimen/dimen_0dp"
        layout_marginLeft="@dimen/dimen_20dp"
        layout_marginTop="@dimen/dimen_24dp"
        layout_marginRight="@dimen/dimen_20dp"
        text="@string/label_complete_your_personal_data"
        layout_marginHorizontal="@dimen/dimen_20dp"
        NOT_FOUND_0x18="0"
        NOT_FOUND_0x19="0"
        NOT_FOUND_0x1a="0"
        NOT_FOUND_0x1b="@+id/layout_toolbar"
        style="@style/BpjstkuTextViewDmSans.CharcoalGrey.Bold"/>
    <com.google.android.material.textfield.TextInputLayout
        id="@+id/tilIdNumber"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        layout_marginTop="@dimen/dimen_24dp"
        hint="@string/hint_id_number"
        NOT_FOUND_0x18="@+id/tvCompleteYourPersonalData"
        NOT_FOUND_0x1a="@+id/tvCompleteYourPersonalData"
        NOT_FOUND_0x1b="@+id/tvCompleteYourPersonalData"
        style="@style/BpjstkuTextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            maxLength="16"
            digits="0123456789"
            inputType="0x3"
            imeOptions="0x5"
            style="@style/BpjstkuTextInputEditText"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        id="@+id/tilFullName"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        layout_marginTop="@dimen/dimen_8dp"
        hint="@string/hint_fullname"
        NOT_FOUND_0x18="@+id/tilIdNumber"
        NOT_FOUND_0x1a="@+id/tilIdNumber"
        NOT_FOUND_0x1b="@+id/tilIdNumber"
        style="@style/BpjstkuTextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            inputType="0x1061"
            imeOptions="0x6"
            style="@style/BpjstkuTextInputEditText"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        id="@+id/tilBirthDate"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        layout_marginTop="@dimen/dimen_8dp"
        layout_marginBottom="@dimen/dimen_24dp"
        hint="@string/hint_birth_date"
        NOT_FOUND_0x17="@+id/btnNext"
        NOT_FOUND_0x18="@+id/tilFullName"
        NOT_FOUND_0x1a="@+id/tilFullName"
        NOT_FOUND_0x1b="@+id/tilFullName"
        NOT_FOUND_0x1d="0"
        style="@style/BpjstkuTextInputLayout.Calender">
        <com.google.android.material.textfield.TextInputEditText
            id="@+id/edtBirthDate"
            inputType="0x14"
            style="@style/BpjstkuAutoCompleteTextViewCalender"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton
        enabled="false"
        id="@+id/btnNext"
        paddingTop="@dimen/dimen_14dp"
        paddingBottom="@dimen/dimen_14dp"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        layout_marginBottom="@dimen/dimen_22dp"
        text="@string/action_next"
        paddingVertical="@dimen/dimen_14dp"
        NOT_FOUND_0x16="0"
        NOT_FOUND_0x18="@+id/tilBirthDate"
        NOT_FOUND_0x1a="@+id/tilBirthDate"
        style="@style/BpjstkuButton.WhiteText"/>
</androidx.constraintlayout.widget.ConstraintLayout>
