<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    layout_width="-1"
    layout_height="-1">
    <ImageView
        id="@+id/imgBackground"
        layout_width="@dimen/dimen_0dp"
        layout_height="@dimen/dimen_0dp"
        src="@drawable/img_background_infoprogram"
        scaleType="fitStart"
        NOT_FOUND_0xc="1:1"
        NOT_FOUND_0xd="0"
        NOT_FOUND_0xe="0"
        NOT_FOUND_0x10="0"/>
    <include
        id="@+id/layout_toolbar"
        NOT_FOUND_0xd="0"
        NOT_FOUND_0xe="0"
        NOT_FOUND_0x10="0"
        layout="@layout/layout_toolbar_center"/>
    <com.kennyc.view.MultiStateView
        id="@+id/msvEligibility"
        layout_width="@dimen/dimen_0dp"
        layout_height="@dimen/dimen_0dp"
        NOT_FOUND_0xb="0"
        NOT_FOUND_0xd="0"
        NOT_FOUND_0xe="0"
        NOT_FOUND_0xf="@+id/layout_toolbar"
        NOT_FOUND_0x11="@layout/layout_default_empty"
        NOT_FOUND_0x12="@layout/layout_vocational_eligibility_error"
        NOT_FOUND_0x13="@layout/layout_vocation_check_elegibility_loading"
        NOT_FOUND_0x14="0">
        <androidx.constraintlayout.widget.ConstraintLayout
            layout_width="-1"
            layout_height="-1">
            <ImageView
                id="@+id/imgVocationalEligibilityResult"
                layout_width="-2"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_237dp"
                src="@drawable/ic_success"
                NOT_FOUND_0xd="0"
                NOT_FOUND_0xe="0"
                NOT_FOUND_0x10="0"/>
            <TextView
                id="@+id/tvEligibilityResult"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_42dp"
                layout_marginTop="@dimen/dimen_20dp"
                layout_marginRight="@dimen/dimen_42dp"
                text="@string/label_eligibility_result"
                textAlignment="4"
                layout_marginHorizontal="@dimen/dimen_42dp"
                NOT_FOUND_0xd="0"
                NOT_FOUND_0xe="0"
                NOT_FOUND_0xf="@+id/imgVocationalEligibilityResult"
                style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
            <Button
                id="@+id/btnNext"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_44dp"
                layout_marginTop="@dimen/dimen_16dp"
                layout_marginRight="@dimen/dimen_44dp"
                text="@string/action_next"
                layout_marginHorizontal="@dimen/dimen_44dp"
                NOT_FOUND_0xd="0"
                NOT_FOUND_0xe="0"
                NOT_FOUND_0xf="@+id/tvEligibilityResult"
                style="@style/BpjstkuButton.WhiteText"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.kennyc.view.MultiStateView>
</androidx.constraintlayout.widget.ConstraintLayout>
