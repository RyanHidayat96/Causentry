<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    layout_width="-1"
    layout_height="-2">
    <ImageView
        id="@+id/rbProgramJHT"
        visibility="0"
        layout_width="@dimen/dimen_24dp"
        layout_height="@dimen/dimen_24dp"
        layout_marginTop="@dimen/dimen_17dp"
        src="@drawable/ic_radio_button_selected"
        layout_marginStart="@dimen/dimen_20dp"
        NOT_FOUND_0xd="0"
        NOT_FOUND_0xf="0"/>
    <androidx.appcompat.widget.AppCompatImageView
        id="@+id/imgProgram"
        layout_width="@dimen/dimen_30dp"
        layout_height="@dimen/dimen_30dp"
        layout_marginTop="@dimen/dimen_15dp"
        layout_marginStart="@dimen/dimen_16dp"
        NOT_FOUND_0xc="@+id/rbProgramJHT"
        NOT_FOUND_0xf="0"/>
    <androidx.appcompat.widget.AppCompatTextView
        id="@+id/tvProgramTitle"
        layout_width="@dimen/dimen_0dp"
        layout_marginTop="@dimen/dimen_18dp"
        layout_marginStart="@dimen/dimen_14dp"
        NOT_FOUND_0xb="0"
        NOT_FOUND_0xc="@+id/imgProgram"
        NOT_FOUND_0xf="0"
        style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
    <view
        layout_width="@dimen/dimen_0dp"
        layout_height="@dimen/dimen_1dp"
        layout_marginLeft="@dimen/dimen_20dp"
        layout_marginTop="@dimen/dimen_16dp"
        layout_marginRight="@dimen/dimen_20dp"
        layout_marginHorizontal="@dimen/dimen_20dp"
        NOT_FOUND_0xa="0"
        NOT_FOUND_0xd="0"
        NOT_FOUND_0xe="@+id/tvProgramTitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
