<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    background="@color/colorWhite"
    layout_width="-1"
    layout_height="-1">
    <ImageView
        id="@+id/imgBackground"
        layout_width="@dimen/dimen_0dp"
        layout_height="@dimen/dimen_0dp"
        src="@drawable/img_background_infoprogram"
        scaleType="fitStart"
        NOT_FOUND_0x7="1:1"
        NOT_FOUND_0x8="0"
        NOT_FOUND_0x9="0"
        NOT_FOUND_0xb="0"/>
    <include
        id="@+id/layout_toolbar"
        NOT_FOUND_0x8="0"
        NOT_FOUND_0x9="0"
        NOT_FOUND_0xb="0"
        layout="@layout/layout_toolbar_center"/>
    <com.kennyc.view.MultiStateView
        id="@+id/msvPromo"
        layout_width="@dimen/dimen_0dp"
        layout_height="@dimen/dimen_0dp"
        NOT_FOUND_0x6="0"
        NOT_FOUND_0x8="0"
        NOT_FOUND_0x9="0"
        NOT_FOUND_0xa="@+id/layout_toolbar"
        NOT_FOUND_0xc="@layout/layout_default_empty"
        NOT_FOUND_0xd="@layout/layout_default_error"
        NOT_FOUND_0xe="@layout/layout_default_loading">
        <androidx.recyclerview.widget.RecyclerView
            id="@+id/rvPromo"
            layout_width="-1"
            layout_height="-1"/>
    </com.kennyc.view.MultiStateView>
</androidx.constraintlayout.widget.ConstraintLayout>
