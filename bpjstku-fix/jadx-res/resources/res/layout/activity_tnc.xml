<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    background="@android:color/white"
    fitsSystemWindows="true"
    layout_width="-1"
    layout_height="-1">
    <com.google.android.material.appbar.AppBarLayout
        id="@+id/main_appbar"
        layout_width="-1"
        layout_height="-2">
        <androidx.appcompat.widget.Toolbar
            id="@+id/main_toolbar"
            background="@android:color/white"
            layout_width="-1"
            layout_height="?attr/actionBarSize"
            NOT_FOUND_0x10="0dp"
            NOT_FOUND_0x11="0dp"
            NOT_FOUND_0x12="0dp"
            style="@style/ThemeOverlay.AppCompat.ActionBar">
            <RelativeLayout
                gravity="0x11"
                orientation="0"
                layout_width="-1"
                layout_height="-1"
                layout_marginRight="@dimen/fifty_six_dp"
                layout_marginEnd="@dimen/fifty_six_dp">
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    textSize="@dimen/tool_bar_title_size"
                    textColor="@color/dark_gray"
                    gravity="right"
                    id="@+id/merchant_name"
                    layout_width="-2"
                    layout_height="-2"
                    text="@string/tnc_title"
                    layout_centerInParent="true"/>
            </RelativeLayout>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>
    <RelativeLayout
        orientation="1"
        layout_width="-1"
        layout_height="-2"
        NOT_FOUND_0x1a="@string/appbar_scrolling_view_behavior">
        <ScrollView
            layout_width="-1"
            layout_height="-2"
            layout_above="@+id/container_item_details"
            layout_alignParentTop="true">
            <include
                layout_width="-1"
                layout_height="-2"
                layout="@layout/layout_tnc_bni_point"/>
        </ScrollView>
        <View
            background="@color/light_gray"
            layout_width="-1"
            layout_height="@dimen/two_dp"
            layout_above="@+id/button_primary"/>
        <com.midtrans.sdk.uikit.widgets.FancyButton
            id="@+id/button_primary"
            layout_width="-1"
            layout_height="@dimen/button_size"
            layout_alignParentBottom="true"
            NOT_FOUND_0x13="@android:color/transparent"
            NOT_FOUND_0x14="@color/colorAccentLight"
            NOT_FOUND_0x15="@dimen/two_dp"
            NOT_FOUND_0x16="@string/ok"
            NOT_FOUND_0x17="@color/dark_gray_primer"
            NOT_FOUND_0x18="0x10"
            NOT_FOUND_0x19="0x7f07005b"/>
    </RelativeLayout>
    <include layout="@layout/layout_loading_and_badge"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
