<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    layout_width="-1"
    layout_height="-1">
    <ImageView
        id="@+id/imgBackground"
        layout_width="@dimen/dimen_0dp"
        layout_height="@dimen/dimen_0dp"
        src="@drawable/img_background_infoprogram"
        scaleType="fitStart"
        NOT_FOUND_0x6="1:1"
        NOT_FOUND_0x7="0"
        NOT_FOUND_0x8="0"
        NOT_FOUND_0xa="0"/>
    <include
        id="@+id/layout_toolbar"
        layout="@layout/layout_toolbar_center"/>
    <com.kennyc.view.MultiStateView
        layout_width="-1"
        layout_height="-2"
        layout_marginTop="@dimen/dimen_29dp"
        NOT_FOUND_0x7="0"
        NOT_FOUND_0x8="0"
        NOT_FOUND_0x9="@+id/layout_toolbar">
        <androidx.recyclerview.widget.RecyclerView
            id="@+id/rvJpnMenu"
            layout_width="-2"
            layout_height="-2"/>
    </com.kennyc.view.MultiStateView>
</androidx.constraintlayout.widget.ConstraintLayout>
