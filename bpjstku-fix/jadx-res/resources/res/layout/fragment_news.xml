<?xml version="1.0" encoding="utf-8"?>
<com.kennyc.view.MultiStateView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    id="@+id/msvContent"
    layout_width="-1"
    layout_height="-1"
    NOT_FOUND_0x21="@layout/layout_default_empty"
    NOT_FOUND_0x22="@layout/layout_default_error"
    NOT_FOUND_0x23="@layout/layout_default_loading">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        id="@+id/clNews"
        layout_width="-1"
        layout_height="-1">
        <com.google.android.material.appbar.AppBarLayout
            id="@+id/appbarNews"
            background="@android:color/transparent"
            layout_width="-1"
            layout_height="-2"
            NOT_FOUND_0x17="@dimen/dimen_0dp"
            NOT_FOUND_0x18="true">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                background="@android:color/transparent"
                layout_width="-1"
                layout_height="-2"
                NOT_FOUND_0x20="0x3">
                <LinearLayout
                    orientation="1"
                    layout_width="-1"
                    layout_height="-2">
                    <TextView
                        textSize="@dimen/text_size_18sp"
                        id="@+id/tvLatestNews"
                        layout_width="-2"
                        layout_height="-2"
                        layout_marginLeft="@dimen/dimen_20dp"
                        layout_marginTop="@dimen/dimen_16dp"
                        layout_marginRight="@dimen/dimen_20dp"
                        text="@string/label_latest_news"
                        layout_marginHorizontal="@dimen/dimen_20dp"
                        style="@style/BpjstkuTextViewPoppins.CharcoalGrey.Bold"/>
                    <com.google.android.material.card.MaterialCardView
                        id="@+id/cvLatestNews"
                        clipToPadding="false"
                        layout_width="-1"
                        layout_height="-2"
                        layout_marginLeft="@dimen/dimen_20dp"
                        layout_marginTop="@dimen/dimen_10dp"
                        layout_marginRight="@dimen/dimen_20dp"
                        layout_marginBottom="@dimen/dimen_4dp"
                        layout_marginHorizontal="@dimen/dimen_20dp"
                        NOT_FOUND_0x16="@dimen/dimen_4dp">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            background="@color/colorWhite"
                            layout_width="-1"
                            layout_height="-1">
                            <ImageView
                                id="@+id/imgNews"
                                layout_width="@dimen/dimen_0dp"
                                layout_height="@dimen/dimen_0dp"
                                scaleType="fitStart"
                                NOT_FOUND_0x1b="16:9"
                                NOT_FOUND_0x1c="0"
                                NOT_FOUND_0x1d="0"
                                NOT_FOUND_0x1f="0"/>
                            <TextView
                                textSize="@dimen/text_size_12sp"
                                id="@+id/tvNewsDate"
                                background="@drawable/bg_rounded_dark_mint"
                                paddingLeft="@dimen/dimen_6dp"
                                paddingTop="@dimen/dimen_2dp"
                                paddingRight="@dimen/dimen_6dp"
                                paddingBottom="@dimen/dimen_2dp"
                                layout_marginBottom="@dimen/dimen_14dp"
                                layout_marginStart="@dimen/dimen_14dp"
                                paddingHorizontal="@dimen/dimen_6dp"
                                paddingVertical="@dimen/dimen_2dp"
                                NOT_FOUND_0x1a="@+id/imgNews"
                                NOT_FOUND_0x1d="0"
                                style="@style/BpjstkuTextViewBarlow.White"/>
                            <TextView
                                textSize="@dimen/text_size_12sp"
                                id="@+id/tvNewsTitle"
                                layout_width="@dimen/dimen_0dp"
                                layout_height="-2"
                                layout_marginLeft="@dimen/dimen_14dp"
                                layout_marginTop="@dimen/dimen_16dp"
                                layout_marginRight="@dimen/dimen_14dp"
                                layout_marginBottom="@dimen/dimen_16dp"
                                layout_marginHorizontal="@dimen/dimen_14dp"
                                layout_marginVertical="@dimen/dimen_16dp"
                                NOT_FOUND_0x1a="0"
                                NOT_FOUND_0x1c="0"
                                NOT_FOUND_0x1d="0"
                                NOT_FOUND_0x1e="@+id/imgNews"
                                style="@style/BpjstkuTextViewBarlow.Dark.SemiBold"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <LinearLayout
            orientation="1"
            layout_width="-1"
            layout_height="-2"
            NOT_FOUND_0x19="@string/appbar_scrolling_view_behavior">
            <TextView
                textSize="@dimen/text_size_18sp"
                id="@+id/tvOtherNews"
                layout_width="-2"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_20dp"
                layout_marginTop="@dimen/dimen_8dp"
                layout_marginRight="@dimen/dimen_20dp"
                text="@string/label_other_news"
                layout_marginHorizontal="@dimen/dimen_20dp"
                style="@style/BpjstkuTextViewPoppins.CharcoalGrey.Bold"/>
            <androidx.recyclerview.widget.RecyclerView
                id="@+id/rvOtherNews"
                layout_width="-1"
                layout_height="-1"
                layout_marginLeft="@dimen/dimen_18dp"
                layout_marginTop="@dimen/dimen_22dp"
                layout_marginRight="@dimen/dimen_18dp"
                layout_marginHorizontal="@dimen/dimen_18dp"/>
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</com.kennyc.view.MultiStateView>
