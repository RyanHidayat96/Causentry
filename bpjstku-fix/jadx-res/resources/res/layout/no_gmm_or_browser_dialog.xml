<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    layout_gravity="0x11"
    orientation="1"
    background="@drawable/places_widgets_dialog_background"
    padding="?attr/placesSpacingTwoExtraLarge"
    layout_width="-2"
    layout_height="-2"
    layout_margin="?attr/placesSpacingTwoExtraLarge">
    <TextView
        textAppearance="?attr/placesTextAppearanceHeadlineMedium"
        textColor="?attr/placesColorOnSurface"
        layout_width="-2"
        layout_height="-2"
        text="@string/place_details_link_no_gmm_or_browser_error_title"/>
    <TextView
        textAppearance="?attr/placesTextAppearanceBodyMedium"
        textColor="?attr/placesColorOnSurface"
        paddingTop="?attr/placesSpacingMedium"
        paddingBottom="?attr/placesSpacingMedium"
        layout_width="-2"
        layout_height="-2"
        text="@string/place_details_link_no_gmm_or_browser_error_body"/>
    <Button
        textAppearance="?attr/placesTextAppearanceLabelLarge"
        textColor="?attr/placesColorOnSecondaryContainer"
        id="@+id/no_browser_error_ok"
        background="@drawable/places_widgets_button_background"
        paddingTop="?attr/placesSpacingExtraSmall"
        paddingBottom="?attr/placesSpacingExtraSmall"
        layout_width="-1"
        layout_height="-2"
        text="@string/place_details_link_no_gmm_or_browser_error_ok_button"
        stateListAnimator="@null"/>
</LinearLayout>
