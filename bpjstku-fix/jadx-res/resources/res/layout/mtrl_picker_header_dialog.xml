<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    layout_width="-1"
    layout_height="-2">
    <LinearLayout
        layout_gravity="0x30"
        orientation="0"
        id="@+id/mtrl_picker_header"
        paddingLeft="@dimen/mtrl_calendar_header_content_padding"
        paddingRight="@dimen/mtrl_calendar_header_content_padding"
        baselineAligned="false"
        paddingStart="@dimen/mtrl_calendar_header_content_padding"
        paddingEnd="@dimen/mtrl_calendar_header_content_padding"
        style="?attr/materialCalendarHeaderLayout">
        <FrameLayout
            id="@+id/mtrl_picker_header_title_and_selection"
            paddingLeft="@dimen/mtrl_calendar_header_text_padding"
            focusable="true"
            focusableInTouchMode="true"
            layout_width="0dp"
            layout_height="-1"
            layout_weight="1"
            paddingStart="@dimen/mtrl_calendar_header_text_padding">
            <include layout="@layout/mtrl_picker_header_title_text"/>
            <include layout="@layout/mtrl_picker_header_selection_text"/>
        </FrameLayout>
        <include layout="@layout/mtrl_picker_header_toggle"/>
    </LinearLayout>
    <View
        layout_gravity="0x50"
        layout_width="-1"
        layout_height="@dimen/mtrl_calendar_header_divider_thickness"
        style="?attr/materialCalendarHeaderDivider"/>
</merge>
