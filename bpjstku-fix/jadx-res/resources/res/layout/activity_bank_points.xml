<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    background="@android:color/white"
    fitsSystemWindows="true"
    layout_width="-1"
    layout_height="-1">
    <include layout="@layout/appbar_payment"/>
    <RelativeLayout
        orientation="1"
        layout_width="-1"
        layout_height="-2"
        NOT_FOUND_0xd="@string/appbar_scrolling_view_behavior">
        <ScrollView
            layout_width="-1"
            layout_height="-2"
            layout_above="@+id/container_item_details"
            layout_alignParentTop="true">
            <include layout="@layout/layout_bank_points"/>
        </ScrollView>
        <View
            id="@+id/background_dim"
            background="@color/dim_background"
            visibility="2"
            layout_width="-1"
            layout_height="-2"
            layout_above="@+id/container_item_details"/>
        <com.midtrans.sdk.uikit.widgets.FancyButton
            id="@+id/button_pay_without_point"
            visibility="2"
            layout_width="-2"
            layout_height="-2"
            layout_marginBottom="@dimen/sixteen_dp"
            layout_above="@+id/container_item_details"
            layout_centerHorizontal="true"
            NOT_FOUND_0xb="0x7f08025d"
            NOT_FOUND_0xc="@string/pay_without_fiesta_poin"
            style="@style/ButtonSecondary"/>
        <LinearLayout
            orientation="1"
            id="@+id/container_item_details"
            layout_width="-1"
            layout_height="-2"
            layout_above="@+id/btn_redeem_container">
            <androidx.recyclerview.widget.RecyclerView
                id="@+id/rv_transaction_detail"
                visibility="2"
                layout_width="-1"
                layout_height="-2"/>
            <View
                background="@color/light_gray"
                layout_width="-1"
                layout_height="@dimen/two_dp"/>
            <include layout="@layout/layout_total_amount"/>
        </LinearLayout>
        <View
            background="@color/light_gray"
            layout_width="-1"
            layout_height="@dimen/two_dp"
            layout_above="@+id/btn_redeem_container"/>
        <include
            id="@+id/btn_redeem_container"
            layout="@layout/layout_primary_button"/>
    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
