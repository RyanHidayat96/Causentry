<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    background="@color/colorWhite"
    layout_width="-1"
    layout_height="-1">
    <androidx.viewpager.widget.ViewPager
        id="@+id/vpOnboarding"
        layout_width="-1"
        layout_height="@dimen/dimen_0dp"
        NOT_FOUND_0x16="@+id/dotsIndicator"
        NOT_FOUND_0x17="0"
        NOT_FOUND_0x18="0"
        NOT_FOUND_0x19="0"/>
    <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
        id="@+id/dotsIndicator"
        layout_width="-2"
        layout_height="-2"
        layout_marginBottom="@dimen/dimen_24dp"
        NOT_FOUND_0x10="@color/colorCloudyBlue"
        NOT_FOUND_0x11="@dimen/dimen_6dp"
        NOT_FOUND_0x12="@dimen/dimen_6dp"
        NOT_FOUND_0x13="@dimen/dimen_6dp"
        NOT_FOUND_0x14="2.5"
        NOT_FOUND_0x16="@+id/tvNext"
        NOT_FOUND_0x17="0"
        NOT_FOUND_0x18="0"
        NOT_FOUND_0x1a="false"
        NOT_FOUND_0x1b="@color/colorDarkMint"/>
    <TextView
        id="@+id/tvSkip"
        background="?attr/selectableItemBackground"
        paddingLeft="@dimen/dimen_6dp"
        paddingTop="@dimen/dimen_4dp"
        paddingRight="@dimen/dimen_6dp"
        paddingBottom="@dimen/dimen_4dp"
        text="@string/action_skip"
        layout_marginStart="@dimen/dimen_27dp"
        paddingHorizontal="@dimen/dimen_6dp"
        paddingVertical="@dimen/dimen_4dp"
        NOT_FOUND_0x15="@+id/tvNext"
        NOT_FOUND_0x18="0"
        NOT_FOUND_0x19="@+id/tvNext"
        style="@style/BpjstkuTextViewPoppins.BattleshipGrey.SemiBold"/>
    <TextView
        id="@+id/tvNext"
        background="?attr/selectableItemBackground"
        layout_marginBottom="@dimen/dimen_30dp"
        text="@string/action_further"
        drawablePadding="@dimen/dimen_4dp"
        drawableEnd="@drawable/ic_chevron_right"
        layout_marginEnd="@dimen/dimen_24dp"
        NOT_FOUND_0x15="0"
        NOT_FOUND_0x17="0"
        style="@style/BpjstkuTextViewPoppins.DarkMint.SemiBold"/>
</androidx.constraintlayout.widget.ConstraintLayout>
