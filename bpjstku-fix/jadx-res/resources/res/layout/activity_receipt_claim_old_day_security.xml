<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    id="@+id/root_receipt"
    background="@color/white"
    visibility="0"
    layout_width="-1"
    layout_height="-1">
    <androidx.constraintlayout.widget.ConstraintLayout
        background="@color/white"
        paddingBottom="@dimen/dimen_30dp"
        layout_width="-1"
        layout_height="-2">
        <com.google.android.material.appbar.MaterialToolbar
            gravity="0x10"
            id="@+id/toolbar_evidence"
            background="@android:color/transparent"
            visibility="0"
            layout_width="-1"
            layout_height="?attr/actionBarSize"
            NOT_FOUND_0x1f="@dimen/dimen_0dp"
            NOT_FOUND_0x20="@dimen/dimen_0dp"
            NOT_FOUND_0x26="0"
            NOT_FOUND_0x2a="0"
            NOT_FOUND_0x2c="0"
            NOT_FOUND_0x2e="0x7f08017b"/>
        <ImageView
            id="@+id/imgOldDaySecurtityBackground"
            layout_width="-1"
            layout_height="@dimen/dimen_202dp"
            src="@drawable/img_background_infoprogram"
            translationX="@dimen/dimen_100dp"
            NOT_FOUND_0x24="@+id/divider"
            NOT_FOUND_0x25="1:1"
            NOT_FOUND_0x26="0"
            NOT_FOUND_0x28="1"
            NOT_FOUND_0x2a="0"
            NOT_FOUND_0x2b="@+id/toolbar_evidence"
            NOT_FOUND_0x2d="0.437"/>
        <ImageView
            id="@+id/img_jmo"
            layout_width="200dp"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_16dp"
            layout_marginTop="@dimen/dimen_16dp"
            layout_marginRight="@dimen/dimen_16dp"
            layout_marginBottom="@dimen/dimen_16dp"
            src="@drawable/ic_logo_jmo"
            layout_marginHorizontal="@dimen/dimen_16dp"
            layout_marginVertical="@dimen/dimen_16dp"
            NOT_FOUND_0x2a="0"
            NOT_FOUND_0x2b="@+id/toolbar_evidence"/>
        <TextView
            textSize="@dimen/text_size_16sp"
            id="@+id/tvNotificationClaim"
            layout_width="-1"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            text="@string/label_success_claim"
            layout_marginStart="@dimen/dimen_16dp"
            NOT_FOUND_0x2a="0"
            NOT_FOUND_0x2b="@+id/img_jmo"
            style="@style/BpjstkuTextViewPoppins.CharcoalGrey.SemiBold"/>
        <TextView
            textSize="@dimen/text_size_12sp"
            gravity="0x800003"
            id="@+id/time_status"
            visibility="0"
            layout_width="-1"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_16dp"
            layout_marginTop="@dimen/dimen_0dp"
            layout_marginRight="@dimen/dimen_16dp"
            layout_marginHorizontal="@dimen/dimen_16dp"
            NOT_FOUND_0x2b="@+id/tvNotificationClaim"
            style="@style/BpjstkuTextViewPoppins.CoolGrey"/>
        <TextView
            textSize="@dimen/text_size_12sp"
            gravity="0x800003"
            id="@+id/code_claim"
            layout_width="-1"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_16dp"
            layout_marginTop="@dimen/dimen_0dp"
            layout_marginRight="@dimen/dimen_16dp"
            layout_marginHorizontal="@dimen/dimen_16dp"
            NOT_FOUND_0x2b="@+id/time_status"
            style="@style/BpjstkuTextViewPoppins.CoolGrey"/>
        <View
            id="@+id/divider"
            background="#cccccc"
            layout_width="-1"
            layout_height="5dp"
            layout_marginTop="@dimen/dimen_16dp"
            alpha="0.5"
            NOT_FOUND_0x26="0"
            NOT_FOUND_0x2a="0"
            NOT_FOUND_0x2b="@+id/code_claim"/>
        <TextView
            textSize="@dimen/text_size_14sp"
            id="@+id/tv_bank_name"
            layout_width="-1"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_16dp"
            layout_marginTop="@dimen/dimen_20dp"
            layout_marginRight="@dimen/dimen_16dp"
            text="@string/label_recipient_bank"
            layout_marginHorizontal="@dimen/dimen_16dp"
            NOT_FOUND_0x2b="@+id/divider"
            style="@style/BpjstkuTextViewPoppins.CoolGrey"/>
        <TextView
            textSize="@dimen/text_size_14sp"
            id="@+id/tv_bank_name_value"
            layout_width="-1"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_16dp"
            layout_marginTop="@dimen/dimen_5dp"
            layout_marginRight="@dimen/dimen_16dp"
            layout_marginHorizontal="@dimen/dimen_16dp"
            NOT_FOUND_0x2b="@+id/tv_bank_name"
            style="@style/BpjstkuTextViewDmSans.Black.Bold"/>
        <TextView
            textSize="@dimen/text_size_14sp"
            id="@+id/tv_bank_account"
            layout_width="-1"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_16dp"
            layout_marginTop="@dimen/dimen_16dp"
            layout_marginRight="@dimen/dimen_16dp"
            text="@string/hint_bank_account_number"
            layout_marginHorizontal="@dimen/dimen_16dp"
            NOT_FOUND_0x2b="@+id/tv_bank_name_value"
            style="@style/BpjstkuTextViewPoppins.CoolGrey"/>
        <TextView
            textSize="@dimen/text_size_14sp"
            id="@+id/tv_bank_account_value"
            layout_width="-1"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_16dp"
            layout_marginTop="@dimen/dimen_5dp"
            layout_marginRight="@dimen/dimen_16dp"
            layout_marginHorizontal="@dimen/dimen_16dp"
            NOT_FOUND_0x2b="@+id/tv_bank_account"
            style="@style/BpjstkuTextViewDmSans.Black.Bold"/>
        <TextView
            textSize="@dimen/text_size_14sp"
            id="@+id/tv_receiver_name"
            layout_width="-1"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_16dp"
            layout_marginTop="@dimen/dimen_16dp"
            layout_marginRight="@dimen/dimen_16dp"
            text="@string/label_recipient_name"
            layout_marginHorizontal="@dimen/dimen_16dp"
            NOT_FOUND_0x2b="@+id/tv_bank_account_value"
            style="@style/BpjstkuTextViewPoppins.CoolGrey"/>
        <TextView
            textSize="@dimen/text_size_14sp"
            id="@+id/tv_receiver_name_value"
            layout_width="-1"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_16dp"
            layout_marginTop="@dimen/dimen_5dp"
            layout_marginRight="@dimen/dimen_16dp"
            layout_marginHorizontal="@dimen/dimen_16dp"
            NOT_FOUND_0x2b="@+id/tv_receiver_name"
            style="@style/BpjstkuTextViewDmSans.Black.Bold"/>
        <TextView
            textSize="@dimen/text_size_14sp"
            id="@+id/tv_number_kpj"
            layout_width="-1"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_16dp"
            layout_marginTop="@dimen/dimen_16dp"
            layout_marginRight="@dimen/dimen_16dp"
            text="@string/label_number_jamsostek"
            layout_marginHorizontal="@dimen/dimen_16dp"
            NOT_FOUND_0x2b="@+id/tv_receiver_name_value"
            style="@style/BpjstkuTextViewPoppins.CoolGrey"/>
        <TextView
            textSize="@dimen/text_size_14sp"
            id="@+id/tv_number_kpj_value"
            layout_width="-1"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_16dp"
            layout_marginTop="@dimen/dimen_5dp"
            layout_marginRight="@dimen/dimen_16dp"
            layout_marginHorizontal="@dimen/dimen_16dp"
            NOT_FOUND_0x2b="@+id/tv_number_kpj"
            style="@style/BpjstkuTextViewDmSans.Black.Bold"/>
        <TextView
            textSize="@dimen/text_size_14sp"
            id="@+id/tv_transaction"
            layout_width="-1"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_16dp"
            layout_marginTop="@dimen/dimen_16dp"
            layout_marginRight="@dimen/dimen_16dp"
            text="@string/label_nominal_transaction"
            layout_marginHorizontal="@dimen/dimen_16dp"
            NOT_FOUND_0x2b="@+id/tv_number_kpj_value"
            style="@style/BpjstkuTextViewPoppins.CoolGrey"/>
        <TextView
            textSize="@dimen/text_size_14sp"
            id="@+id/tv_transaction_value"
            layout_width="-1"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_16dp"
            layout_marginTop="@dimen/dimen_5dp"
            layout_marginRight="@dimen/dimen_16dp"
            layout_marginHorizontal="@dimen/dimen_16dp"
            NOT_FOUND_0x2b="@+id/tv_transaction"
            style="@style/BpjstkuTextViewDmSans.Black.Bold"/>
        <TextView
            textSize="@dimen/text_size_14sp"
            id="@+id/tv_status_transaction"
            layout_width="-1"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_16dp"
            layout_marginTop="@dimen/dimen_8dp"
            layout_marginRight="@dimen/dimen_16dp"
            text="@string/label_status_complaint"
            layout_marginHorizontal="@dimen/dimen_16dp"
            NOT_FOUND_0x2b="@+id/tv_transaction_value"
            style="@style/BpjstkuTextViewPoppins.CoolGrey"/>
        <TextView
            textSize="@dimen/text_size_14sp"
            textColor="@color/green_forest.primary"
            id="@+id/status_transaction_value"
            background="@drawable/bg_round_green"
            paddingLeft="@dimen/dimen_20dp"
            paddingTop="@dimen/dimen_5dp"
            paddingRight="@dimen/dimen_20dp"
            paddingBottom="@dimen/dimen_5dp"
            visibility="2"
            layout_width="-2"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_16dp"
            layout_marginTop="@dimen/dimen_5dp"
            layout_marginRight="@dimen/dimen_16dp"
            layout_marginBottom="@dimen/dimen_20dp"
            textAlignment="4"
            layout_marginHorizontal="@dimen/dimen_16dp"
            paddingHorizontal="@dimen/dimen_20dp"
            paddingVertical="@dimen/dimen_5dp"
            NOT_FOUND_0x2a="0"
            NOT_FOUND_0x2b="@+id/tv_status_transaction"
            style="@style/BpjstkuTextViewDmSans.Black.Bold"/>
        <View
            id="@+id/divider2"
            background="#cccccc"
            visibility="2"
            layout_width="-1"
            layout_height="5dp"
            layout_marginTop="@dimen/dimen_40dp"
            alpha="0.5"
            NOT_FOUND_0x26="0"
            NOT_FOUND_0x2a="0"
            NOT_FOUND_0x2b="@+id/status_transaction_value"/>
        <ImageView
            id="@+id/btnDownload"
            visibility="2"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            src="@drawable/buttonsharebold"
            foregroundGravity="0x11"
            NOT_FOUND_0x26="0"
            NOT_FOUND_0x2a="0"
            NOT_FOUND_0x2b="@+id/divider2"/>
        <ImageView
            id="@+id/imgOldDaySecurtityBackground2"
            visibility="2"
            layout_width="-1"
            layout_height="@dimen/dimen_150dp"
            src="@drawable/img_background_infoprogram"
            scaleType="fitStart"
            alpha="0.7"
            translationX="@dimen/dimen_10dp"
            translationY="@dimen/dimen_60dp"
            NOT_FOUND_0x24="0"
            NOT_FOUND_0x25="1:1"
            NOT_FOUND_0x26="0"
            NOT_FOUND_0x2a="0"
            NOT_FOUND_0x2b="@+id/divider2"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            id="@+id/footer"
            background="@color/white"
            visibility="0"
            layout_width="-1"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_20dp"
            NOT_FOUND_0x2b="@+id/status_transaction_value">
            <TextView
                textSize="@dimen/text_size_14sp"
                gravity="0x11"
                id="@+id/tv_desc_skn"
                visibility="2"
                layout_width="-1"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_16dp"
                layout_marginTop="@dimen/dimen_20dp"
                layout_marginRight="@dimen/dimen_16dp"
                text="&quot;Dana sudah ditarik dari rekening BPJS Ketenagakerjaan dan sedang diteruskan ke rekening Anda&quot;"
                textAlignment="4"
                layout_marginHorizontal="@dimen/dimen_16dp"
                style="@style/BpjstkuTextViewPoppins.CoolGrey"/>
            <com.google.android.material.button.MaterialButton
                enabled="true"
                textSize="@dimen/text_size_12sp"
                gravity="0x11"
                id="@+id/btn_download"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_30dp"
                text="@string/label_unduh"
                layout_marginStart="@dimen/dimen_16dp"
                layout_marginEnd="@dimen/dimen_0dp"
                NOT_FOUND_0x21="@drawable/ic_download_white"
                NOT_FOUND_0x22="0x2"
                NOT_FOUND_0x24="0"
                NOT_FOUND_0x27="@+id/btnShare"
                NOT_FOUND_0x2a="0"
                NOT_FOUND_0x2b="@+id/tv_desc_skn"
                NOT_FOUND_0x2d="1"
                style="@style/BpjstkuButton.WhiteText"/>
            <com.google.android.material.button.MaterialButton
                enabled="true"
                textSize="@dimen/text_size_12sp"
                gravity="0x11"
                id="@+id/btnShare"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_16dp"
                layout_marginRight="@dimen/dimen_16dp"
                text="Bagikan"
                layout_marginHorizontal="@dimen/dimen_16dp"
                NOT_FOUND_0x21="@drawable/ic_share_primary"
                NOT_FOUND_0x22="0x2"
                NOT_FOUND_0x23="@color/colorDarkMint"
                NOT_FOUND_0x24="0"
                NOT_FOUND_0x26="0"
                NOT_FOUND_0x29="@+id/btn_download"
                NOT_FOUND_0x2c="@+id/btn_download"
                NOT_FOUND_0x2d="1"
                style="@style/BpjstkuOutlinedButton"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
