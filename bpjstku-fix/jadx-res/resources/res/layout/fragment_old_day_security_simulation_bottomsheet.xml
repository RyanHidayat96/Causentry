<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    background="@drawable/bg_bottom_sheet"
    layout_width="-1"
    layout_height="-2">
    <View
        id="@+id/imgLineBottomSheet"
        background="@color/colorLineBottomSheet"
        layout_width="35dp"
        layout_height="@dimen/dimen_4dp"
        layout_marginTop="@dimen/dimen_15dp"
        layout_centerHorizontal="true"/>
    <androidx.appcompat.widget.AppCompatTextView
        textSize="@dimen/text_size_18sp"
        id="@+id/tvTitleBottomSheet"
        layout_marginTop="@dimen/dimen_16dp"
        text="@string/label_calculation_results"
        layout_below="@+id/imgLineBottomSheet"
        layout_marginStart="@dimen/dimen_30dp"
        style="@style/BpjstkuTextViewPoppins.Black.SemiBold"/>
    <androidx.recyclerview.widget.RecyclerView
        id="@+id/rvSimulationOldDaySecurity"
        layout_width="-1"
        layout_height="-2"
        layout_below="@+id/tvTitleBottomSheet"
        layout_marginStart="@dimen/dimen_30dp"
        layout_marginEnd="@dimen/dimen_30dp"/>
    <com.google.android.material.button.MaterialButton
        id="@+id/btnBack"
        paddingTop="@dimen/dimen_14dp"
        paddingBottom="@dimen/dimen_14dp"
        layout_width="-1"
        layout_height="-2"
        layout_marginTop="@dimen/dimen_20dp"
        layout_marginBottom="@dimen/dimen_22dp"
        text="@string/action_back"
        layout_below="@+id/rvSimulationOldDaySecurity"
        layout_marginStart="@dimen/dimen_30dp"
        layout_marginEnd="@dimen/dimen_30dp"
        paddingVertical="@dimen/dimen_14dp"
        style="@style/BpjstkuTextButton.WhiteBackground"/>
</RelativeLayout>
