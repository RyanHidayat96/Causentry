<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    orientation="1"
    padding="@dimen/sixteen_dp"
    layout_width="-1"
    layout_height="-2">
    <com.midtrans.sdk.uikit.widgets.DefaultTextView
        textSize="@dimen/secondary_text_size"
        textColor="@color/dark_gray"
        layout_gravity="0x3"
        paddingLeft="@dimen/eight_dp"
        layout_width="-2"
        layout_height="-2"
        text="@string/text_hint_xl_order_id"/>
    <LinearLayout
        gravity="0x10"
        layout_width="-1"
        layout_height="-2">
        <com.midtrans.sdk.uikit.widgets.DefaultTextView
            textSize="@dimen/header_text_size"
            textColor="@color/black"
            layout_gravity="0x11"
            id="@+id/text_order_id"
            background="@color/light_gray"
            padding="@dimen/eight_dp"
            layout_width="0dp"
            layout_height="-2"
            layout_marginRight="@dimen/four_dp"
            layout_weight="1"/>
        <com.midtrans.sdk.uikit.widgets.FancyButton
            layout_gravity="0x10"
            id="@+id/btn_copy_order_id"
            paddingLeft="@dimen/sixteen_dp"
            paddingRight="@dimen/sixteen_dp"
            visibility="0"
            layout_width="-2"
            layout_height="-1"
            NOT_FOUND_0x15="?attr/colorPrimary"
            NOT_FOUND_0x16="1dp"
            NOT_FOUND_0x17="@android:color/white"
            NOT_FOUND_0x18="@color/colorAccentLight"
            NOT_FOUND_0x19="?attr/colorPrimary"
            NOT_FOUND_0x1c="5dp"
            NOT_FOUND_0x1d="@string/copy"
            NOT_FOUND_0x1e="?attr/colorPrimary"/>
    </LinearLayout>
    <com.midtrans.sdk.uikit.widgets.DefaultTextView
        textSize="@dimen/secondary_text_size"
        textColor="@color/dark_gray"
        layout_width="-2"
        layout_height="-2"
        layout_marginLeft="@dimen/eight_dp"
        layout_marginTop="@dimen/sixteen_dp"
        text="@string/text_hint_xl_merchant_code"/>
    <LinearLayout
        layout_width="-1"
        layout_height="-2">
        <com.midtrans.sdk.uikit.widgets.DefaultTextView
            textSize="@dimen/header_text_size"
            textColor="@color/black"
            layout_gravity="0x11"
            id="@+id/text_merchant_code"
            background="@color/light_gray"
            padding="@dimen/eight_dp"
            layout_width="0dp"
            layout_height="-2"
            layout_marginRight="@dimen/four_dp"
            layout_weight="1"/>
        <com.midtrans.sdk.uikit.widgets.FancyButton
            layout_gravity="0x10"
            id="@+id/btn_copy_merchant_code"
            paddingLeft="@dimen/sixteen_dp"
            paddingRight="@dimen/sixteen_dp"
            visibility="0"
            layout_width="-2"
            layout_height="-1"
            NOT_FOUND_0x15="?attr/colorPrimary"
            NOT_FOUND_0x16="1dp"
            NOT_FOUND_0x17="@android:color/white"
            NOT_FOUND_0x18="@color/colorAccentLight"
            NOT_FOUND_0x19="?attr/colorPrimary"
            NOT_FOUND_0x1c="5dp"
            NOT_FOUND_0x1d="@string/copy"
            NOT_FOUND_0x1e="?attr/colorPrimary"/>
    </LinearLayout>
    <LinearLayout
        gravity="0x11"
        orientation="1"
        background="@color/faint_yellow"
        paddingLeft="@dimen/eight_dp"
        paddingTop="@dimen/sixteen_dp"
        paddingRight="@dimen/eight_dp"
        paddingBottom="@dimen/sixteen_dp"
        layout_width="-1"
        layout_height="-2"
        layout_marginTop="@dimen/sixteen_dp"
        layout_marginBottom="@dimen/sixteen_dp">
        <com.midtrans.sdk.uikit.widgets.DefaultTextView
            textColor="@color/black"
            layout_width="-2"
            layout_height="-2"
            text="@string/valid_until"/>
        <com.midtrans.sdk.uikit.widgets.SemiBoldTextView
            textSize="@dimen/secondary_text_size"
            textColor="@color/black"
            id="@+id/text_validity"
            layout_width="-2"
            layout_height="-2"
            text="@string/valid_date"/>
    </LinearLayout>
    <com.midtrans.sdk.uikit.widgets.FancyButton
        layout_gravity="0x1"
        id="@+id/button_instruction"
        padding="@dimen/eight_dp"
        visibility="0"
        layout_width="-2"
        layout_height="-1"
        layout_marginTop="@dimen/twenty_four_dp"
        NOT_FOUND_0x17="@android:color/white"
        NOT_FOUND_0x18="@color/colorAccentLight"
        NOT_FOUND_0x1a="@dimen/four_dp"
        NOT_FOUND_0x1b="0x7f080303"
        NOT_FOUND_0x1c="5dp"
        NOT_FOUND_0x1d="@string/kioson_instruction"
        style="@style/ButtonSecondary"/>
</LinearLayout>
