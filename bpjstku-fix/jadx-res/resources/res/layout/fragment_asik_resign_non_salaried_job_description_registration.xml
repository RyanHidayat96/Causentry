<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    layout_width="-1"
    layout_height="-1"
    fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        background="@color/colorWhite"
        focusable="true"
        focusableInTouchMode="true"
        layout_width="-1"
        layout_height="-2">
        <TextView
            textSize="@dimen/text_size_12sp"
            gravity="0x10"
            id="@+id/tvWarningPleaseFillYourPersonalDataNow"
            background="@drawable/bg_rounded_macaroni_and_cheese"
            padding="@dimen/dimen_14dp"
            layout_width="@dimen/dimen_0dp"
            layout_marginLeft="@dimen/dimen_20dp"
            layout_marginTop="@dimen/dimen_25dp"
            layout_marginRight="@dimen/dimen_20dp"
            text="@string/label_please_fill_your_job"
            drawablePadding="@dimen/dimen_14dp"
            drawableStart="@drawable/ic_warning"
            layout_marginHorizontal="@dimen/dimen_20dp"
            NOT_FOUND_0x21="0"
            NOT_FOUND_0x22="0"
            NOT_FOUND_0x24="0"
            style="@style/BpjstkuTextViewDmSans.White.Bold"/>
        <com.google.android.material.textfield.TextInputLayout
            id="@+id/tilChooseLocation"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_24dp"
            hint="@string/label_choose_location"
            NOT_FOUND_0x21="@+id/tvWarningPleaseFillYourPersonalDataNow"
            NOT_FOUND_0x22="@+id/tvWarningPleaseFillYourPersonalDataNow"
            NOT_FOUND_0x23="@+id/tvWarningPleaseFillYourPersonalDataNow"
            style="@style/BpjstkuTextInputLayout.GeneralDropdown">
            <com.google.android.material.textfield.TextInputEditText
                id="@+id/edtChooseLocation"
                style="@style/BpjstkuAutoCompleteTextViewDropDown"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            id="@+id/tilChooseJob"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            hint="@string/label_choose_job"
            NOT_FOUND_0x21="@+id/tilChooseLocation"
            NOT_FOUND_0x22="@+id/tilChooseLocation"
            NOT_FOUND_0x23="@+id/tilChooseLocation"
            style="@style/BpjstkuTextInputLayout.GeneralDropdown">
            <com.google.android.material.textfield.TextInputEditText
                id="@+id/edtChooseJob"
                style="@style/BpjstkuAutoCompleteTextViewDropDown"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.card.MaterialCardView
            id="@+id/cvSalary"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            layout_marginBottom="@dimen/dimen_24dp"
            NOT_FOUND_0x1c="@color/colorWhite"
            NOT_FOUND_0x1d="@dimen/dimen_4dp"
            NOT_FOUND_0x1e="@dimen/dimen_0dp"
            NOT_FOUND_0x20="@+id/btnNext"
            NOT_FOUND_0x21="@+id/tilChooseJob"
            NOT_FOUND_0x22="@+id/tilChooseJob"
            NOT_FOUND_0x23="@+id/tilChooseJob"
            NOT_FOUND_0x25="0"
            NOT_FOUND_0x26="@color/colorPaleGrey"
            NOT_FOUND_0x27="@dimen/dimen_1dp">
            <RelativeLayout
                layout_width="-1"
                layout_height="-2">
                <TextView
                    textSize="@dimen/text_size_16sp"
                    id="@+id/tvPrefixSalary"
                    background="@color/colorPaleGreyFour"
                    padding="@dimen/dimen_20dp"
                    layout_width="-2"
                    layout_height="-2"
                    text="@string/label_prefix_rupiah"
                    style="@style/BpjstkuTextViewDmSans.CharcoalGrey.Bold"/>
                <com.google.android.material.textfield.TextInputLayout
                    id="@+id/tilSalary"
                    layout_width="-1"
                    layout_height="-2"
                    hint="@string/hint_sallary"
                    layout_alignTop="@+id/tvPrefixSalary"
                    layout_alignBottom="@+id/tvPrefixSalary"
                    layout_toEndOf="@+id/tvPrefixSalary"
                    style="@style/BpjstkuTextInputLayout.Prefixed">
                    <com.google.android.material.textfield.TextInputEditText
                        id="@+id/edtSalary"
                        digits="0123456789"
                        inputType="0x2"
                        imeOptions="0x6"
                        style="@style/BpjstkuTextInputEditTextPrefixed"/>
                </com.google.android.material.textfield.TextInputLayout>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton
            id="@+id/btnNext"
            paddingTop="@dimen/dimen_14dp"
            paddingBottom="@dimen/dimen_14dp"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginBottom="@dimen/dimen_22dp"
            text="@string/action_next"
            paddingVertical="@dimen/dimen_14dp"
            NOT_FOUND_0x1f="0"
            NOT_FOUND_0x21="@+id/cvSalary"
            NOT_FOUND_0x22="@+id/cvSalary"
            NOT_FOUND_0x25="1"
            style="@style/BpjstkuButton.WhiteText"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
