<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    layout_width="-1"
    layout_height="-1">
    <androidx.cardview.widget.CardView
        id="@+id/cvWaitingCheckEligibilitas"
        background="@drawable/selector_bordered_grey_blue"
        layout_width="@dimen/dimen_197dp"
        layout_height="@dimen/dimen_156dp"
        NOT_FOUND_0xe="0"
        NOT_FOUND_0xf="0"
        NOT_FOUND_0x10="0"
        NOT_FOUND_0x11="@+id/toolbar"
        NOT_FOUND_0x12="0">
        <LinearLayout
            layout_gravity="0x11"
            orientation="1"
            layout_width="-1"
            layout_height="-2">
            <ProgressBar
                layout_gravity="0x11"
                layout_width="-2"
                layout_height="-2"
                layout_marginBottom="@dimen/dimen_16dp"/>
            <TextView
                textSize="@dimen/text_size_12sp"
                gravity="0x11"
                id="@+id/tvWaiting"
                layout_width="-1"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_25dp"
                layout_marginRight="@dimen/dimen_25dp"
                text="@string/label_please_wait"
                layout_marginHorizontal="@dimen/dimen_25dp"
                NOT_FOUND_0xf="0"
                NOT_FOUND_0x10="0"
                NOT_FOUND_0x11="@+id/imgWaiting"
                style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <TextView
        textSize="@dimen/text_size_16sp"
        id="@+id/tvCheckEligibilitasLabel"
        layout_width="-2"
        layout_height="-2"
        layout_marginTop="@dimen/dimen_16dp"
        text="@string/label_check_eligibility"
        NOT_FOUND_0xf="0"
        NOT_FOUND_0x10="0"
        NOT_FOUND_0x11="@+id/cvWaitingCheckEligibilitas"
        style="@style/BpjstkuTextViewPoppins.CharcoalGrey"/>
</androidx.constraintlayout.widget.ConstraintLayout>
