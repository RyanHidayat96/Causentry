<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    background="@color/colorWhite"
    layout_width="-1"
    layout_height="-1">
    <ImageView
        id="@+id/imgProgramBackground"
        layout_width="@dimen/dimen_0dp"
        layout_height="@dimen/dimen_0dp"
        layout_marginTop="@dimen/dimen_14dp"
        src="@drawable/img_background_infoprogram"
        scaleType="fitStart"
        NOT_FOUND_0x9="1:1"
        NOT_FOUND_0xa="0"
        NOT_FOUND_0xb="0"
        NOT_FOUND_0xd="0"/>
    <include
        id="@+id/layout_toolbar"
        layout="@layout/layout_toolbar_center"/>
    <com.kennyc.view.MultiStateView
        layout_width="@dimen/dimen_0dp"
        layout_height="@dimen/dimen_0dp"
        NOT_FOUND_0x8="0"
        NOT_FOUND_0xa="0"
        NOT_FOUND_0xb="0"
        NOT_FOUND_0xc="@+id/layout_toolbar"
        NOT_FOUND_0xe="@layout/default_error_layout"
        NOT_FOUND_0xf="@layout/default_error_layout"
        NOT_FOUND_0x10="@layout/default_loading_layout">
        <androidx.recyclerview.widget.RecyclerView
            id="@+id/rvListLoyalti"
            layout_width="-1"
            layout_height="-1"
            layout_marginTop="@dimen/dimen_36dp"
            overScrollMode="2"/>
    </com.kennyc.view.MultiStateView>
</androidx.constraintlayout.widget.ConstraintLayout>
