<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    focusable="true"
    focusableInTouchMode="true"
    layout_width="-1"
    layout_height="-1">
    <include
        id="@+id/layout_toolbar"
        NOT_FOUND_0x23="0"
        NOT_FOUND_0x24="0"
        NOT_FOUND_0x26="0"
        layout="@layout/layout_toolbar_center"/>
    <ScrollView
        layout_width="@dimen/dimen_0dp"
        layout_height="@dimen/dimen_0dp"
        fillViewport="true"
        overScrollMode="2"
        NOT_FOUND_0x22="0"
        NOT_FOUND_0x23="0"
        NOT_FOUND_0x24="0"
        NOT_FOUND_0x25="@+id/layout_toolbar">
        <androidx.constraintlayout.widget.ConstraintLayout
            layout_width="-1"
            layout_height="-2">
            <com.google.android.material.card.MaterialCardView
                id="@+id/cvWageAmount"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_20dp"
                layout_marginTop="@dimen/dimen_38dp"
                layout_marginRight="@dimen/dimen_20dp"
                layout_marginHorizontal="@dimen/dimen_20dp"
                NOT_FOUND_0x1f="@color/colorWhite"
                NOT_FOUND_0x20="@dimen/dimen_4dp"
                NOT_FOUND_0x21="@dimen/dimen_0dp"
                NOT_FOUND_0x23="0"
                NOT_FOUND_0x24="0"
                NOT_FOUND_0x26="0"
                NOT_FOUND_0x28="@color/colorPaleGrey"
                NOT_FOUND_0x29="@dimen/dimen_1dp">
                <RelativeLayout
                    layout_width="-1"
                    layout_height="-2">
                    <TextView
                        textSize="@dimen/text_size_16sp"
                        id="@+id/tvPrefixWageAmount"
                        background="@color/colorPaleGreyFour"
                        padding="@dimen/dimen_20dp"
                        layout_width="-2"
                        layout_height="-2"
                        text="@string/label_prefix_rupiah"
                        style="@style/BpjstkuTextViewDmSans.CharcoalGrey.Bold"/>
                    <com.google.android.material.textfield.TextInputLayout
                        id="@+id/tilWageAmount"
                        layout_width="-1"
                        layout_height="-2"
                        hint="@string/hint_wage_amount"
                        layout_alignTop="@+id/tvPrefixWageAmount"
                        layout_alignBottom="@+id/tvPrefixWageAmount"
                        layout_toEndOf="@+id/tvPrefixWageAmount"
                        style="@style/BpjstkuTextInputLayout.Prefixed">
                        <com.google.android.material.textfield.TextInputEditText
                            id="@+id/edtWageAmount"
                            digits="0123456789"
                            inputType="0x2"
                            imeOptions="0x5"
                            style="@style/BpjstkuTextInputEditTextPrefixed"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.textfield.TextInputLayout
                id="@+id/tilTotalYear"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                hint="@string/hint_year_amount"
                NOT_FOUND_0x23="@+id/cvWageAmount"
                NOT_FOUND_0x24="@+id/cvWageAmount"
                NOT_FOUND_0x25="@+id/cvWageAmount"
                style="@style/BpjstkuTextInputLayout">
                <com.google.android.material.textfield.TextInputEditText
                    maxLength="3"
                    inputType="0x2"
                    imeOptions="0x5"
                    style="@style/BpjstkuTextInputEditText"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.card.MaterialCardView
                id="@+id/cvStartBalance"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_8dp"
                NOT_FOUND_0x1f="@color/colorWhite"
                NOT_FOUND_0x20="@dimen/dimen_4dp"
                NOT_FOUND_0x21="@dimen/dimen_0dp"
                NOT_FOUND_0x23="@+id/tilTotalYear"
                NOT_FOUND_0x24="@+id/tilTotalYear"
                NOT_FOUND_0x25="@+id/tilTotalYear"
                NOT_FOUND_0x28="@color/colorPaleGrey"
                NOT_FOUND_0x29="@dimen/dimen_1dp">
                <RelativeLayout
                    layout_width="-1"
                    layout_height="-2">
                    <TextView
                        textSize="@dimen/text_size_16sp"
                        id="@+id/tvPrefixStartBalance"
                        background="@color/colorPaleGreyFour"
                        padding="@dimen/dimen_20dp"
                        layout_width="-2"
                        layout_height="-2"
                        text="@string/label_prefix_rupiah"
                        style="@style/BpjstkuTextViewDmSans.CharcoalGrey.Bold"/>
                    <com.google.android.material.textfield.TextInputLayout
                        id="@+id/tilBeginingBalance"
                        layout_width="-1"
                        layout_height="-2"
                        hint="@string/hint_early_balance"
                        layout_alignTop="@+id/tvPrefixStartBalance"
                        layout_alignBottom="@+id/tvPrefixStartBalance"
                        layout_toEndOf="@+id/tvPrefixStartBalance"
                        style="@style/BpjstkuTextInputLayout.Prefixed">
                        <com.google.android.material.textfield.TextInputEditText
                            id="@+id/edtBeginingBalance"
                            digits="0123456789"
                            inputType="0x2"
                            imeOptions="0x6"
                            style="@style/BpjstkuTextInputEditTextPrefixed"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.button.MaterialButton
                enabled="false"
                id="@+id/btnCalculateSimulation"
                paddingTop="@dimen/dimen_14dp"
                paddingBottom="@dimen/dimen_14dp"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                text="@string/action_calculate_simulation"
                paddingVertical="@dimen/dimen_14dp"
                NOT_FOUND_0x23="@+id/cvStartBalance"
                NOT_FOUND_0x24="@+id/cvStartBalance"
                NOT_FOUND_0x25="@+id/cvStartBalance"
                style="@style/BpjstkuButton.WhiteText"/>
            <com.google.android.material.card.MaterialCardView
                id="@+id/cvSimulationInfo"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_44dp"
                layout_marginBottom="@dimen/dimen_20dp"
                layout_marginStart="@dimen/dimen_20dp"
                layout_marginEnd="@dimen/dimen_20dp"
                NOT_FOUND_0x1f="@color/colorWhite"
                NOT_FOUND_0x20="@dimen/dimen_4dp"
                NOT_FOUND_0x21="@dimen/dimen_0dp"
                NOT_FOUND_0x22="0"
                NOT_FOUND_0x23="0"
                NOT_FOUND_0x24="0"
                NOT_FOUND_0x25="@+id/btnCalculateSimulation"
                NOT_FOUND_0x27="0"
                NOT_FOUND_0x28="@color/colorPaleGreyTwelve"
                NOT_FOUND_0x29="@dimen/dimen_1dp">
                <androidx.appcompat.widget.AppCompatImageView
                    id="@+id/ivInformation"
                    layout_width="-2"
                    layout_height="-2"
                    layout_marginTop="@dimen/dimen_13dp"
                    src="@drawable/ic_information_yellow"
                    layout_marginStart="@dimen/dimen_14dp"/>
                <androidx.appcompat.widget.AppCompatTextView
                    textSize="@dimen/text_size_12sp"
                    id="@+id/tvTitleInformation"
                    layout_width="200dp"
                    layout_marginTop="@dimen/dimen_13dp"
                    text="@string/label_title_information_simulation"
                    layout_marginStart="@dimen/dimen_57dp"
                    style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
                <androidx.appcompat.widget.AppCompatTextView
                    textSize="@dimen/text_size_12sp"
                    layout_marginTop="@dimen/dimen_54dp"
                    layout_marginBottom="@dimen/dimen_15dp"
                    text="@string/label_detail_information_simulation"
                    layout_marginStart="@dimen/dimen_57dp"
                    style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
