<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    background="@drawable/bg_rounded_bottomsheet"
    layout_width="-1"
    layout_height="-1">
    <androidx.constraintlayout.widget.ConstraintLayout
        layout_width="-1"
        layout_height="-2">
        <View
            background="@color/colorLineBottomSheet"
            layout_width="@dimen/dimen_35dp"
            layout_height="@dimen/dimen_4dp"
            layout_marginTop="@dimen/dimen_15dp"
            layout_centerHorizontal="true"
            NOT_FOUND_0x13="0"
            NOT_FOUND_0x14="0"
            NOT_FOUND_0x16="0"/>
        <TextView
            textSize="@dimen/text_size_18sp"
            id="@+id/tvTrainingRegionTitle"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_35dp"
            text="@string/label_training_region"
            layout_marginStart="@dimen/dimen_27dp"
            NOT_FOUND_0x14="0"
            NOT_FOUND_0x16="0"
            style="@style/BpjstkuTextViewPoppins.CharcoalGrey.SemiBold"/>
        <com.google.android.material.textfield.TextInputLayout
            id="@+id/tilSearchRegion"
            background="@color/colorPaleGreyFour"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_27dp"
            layout_marginTop="@dimen/dimen_11dp"
            layout_marginRight="@dimen/dimen_27dp"
            hint="@string/hint_search_training_region"
            layout_marginHorizontal="@dimen/dimen_27dp"
            NOT_FOUND_0x10="@drawable/ic_search"
            NOT_FOUND_0x11="-1"
            NOT_FOUND_0x13="0"
            NOT_FOUND_0x14="0"
            NOT_FOUND_0x15="@+id/tvTrainingRegionTitle"
            style="@style/BpjstkuTextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                inputType="0x1"
                style="@style/BpjstkuTextInputEditText"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.kennyc.view.MultiStateView
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginBottom="@dimen/dimen_20dp"
            NOT_FOUND_0x12="0"
            NOT_FOUND_0x13="0"
            NOT_FOUND_0x14="0"
            NOT_FOUND_0x15="@+id/tilSearchRegion"
            NOT_FOUND_0x17="@layout/default_error_layout"
            NOT_FOUND_0x18="@layout/default_error_layout"
            NOT_FOUND_0x19="@layout/default_loading_layout">
            <androidx.recyclerview.widget.RecyclerView
                id="@+id/rvTrainingRegion"
                layout_width="-1"
                layout_height="-1"
                overScrollMode="2"/>
        </com.kennyc.view.MultiStateView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
