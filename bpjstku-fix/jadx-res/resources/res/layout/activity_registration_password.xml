<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    background="@color/colorWhite"
    layout_width="-1"
    layout_height="-1"
    fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        id="@+id/passwordContainer"
        background="@color/colorWhite"
        focusable="true"
        focusableInTouchMode="true"
        layout_width="-1"
        layout_height="-2">
        <ImageView
            id="@+id/imgLogo"
            layout_width="@dimen/dimen_182dp"
            layout_height="@dimen/dimen_59dp"
            src="@drawable/ic_logo_jmo"
            NOT_FOUND_0x24="0"
            NOT_FOUND_0x26="0"
            NOT_FOUND_0x28="0"
            NOT_FOUND_0x2a="0"
            NOT_FOUND_0x2b="0.08"/>
        <TextView
            textSize="@dimen/text_size_24sp"
            id="@+id/tvNewPassword"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_20dp"
            layout_marginTop="@dimen/dimen_27dp"
            layout_marginRight="@dimen/dimen_20dp"
            text="@string/label_new_password"
            layout_marginHorizontal="@dimen/dimen_20dp"
            NOT_FOUND_0x26="0"
            NOT_FOUND_0x28="0"
            NOT_FOUND_0x29="@+id/imgLogo"
            NOT_FOUND_0x2b="0.2"
            style="@style/BpjstkuTextViewPoppins.CharcoalGrey.Bold"/>
        <com.google.android.material.card.MaterialCardView
            id="@+id/cvEnterPasswordWarning"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            NOT_FOUND_0x1f="@color/colorMacaroniAndCheese01"
            NOT_FOUND_0x20="@dimen/dimen_4dp"
            NOT_FOUND_0x21="@dimen/dimen_0dp"
            NOT_FOUND_0x22="true"
            NOT_FOUND_0x26="@+id/tvNewPassword"
            NOT_FOUND_0x28="@+id/tvNewPassword"
            NOT_FOUND_0x29="@+id/tvNewPassword"
            NOT_FOUND_0x2d="@color/colorWhite"
            NOT_FOUND_0x2e="@dimen/dimen_0dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                layout_width="-1"
                layout_height="-1">
                <ImageView
                    id="@+id/imgWarning1"
                    background="@drawable/ic_exclamation"
                    layout_width="-2"
                    layout_height="-2"
                    layout_marginTop="@dimen/dimen_14dp"
                    layout_marginStart="@dimen/dimen_14dp"
                    NOT_FOUND_0x28="0"
                    NOT_FOUND_0x2a="0"/>
                <TextView
                    textSize="@dimen/text_size_12sp"
                    id="@+id/tvClaimNonSalariedWorkerInfo1"
                    layout_width="@dimen/dimen_0dp"
                    layout_marginLeft="@dimen/dimen_16dp"
                    layout_marginTop="@dimen/dimen_14dp"
                    layout_marginRight="@dimen/dimen_16dp"
                    layout_marginBottom="@dimen/dimen_14dp"
                    text="@string/label_password_rules"
                    textAlignment="1"
                    layout_marginStart="@dimen/dimen_14dp"
                    layout_marginEnd="@dimen/dimen_14dp"
                    layout_marginHorizontal="@dimen/dimen_16dp"
                    NOT_FOUND_0x24="0"
                    NOT_FOUND_0x26="0"
                    NOT_FOUND_0x27="@+id/imgWarning1"
                    NOT_FOUND_0x2a="0"
                    style="@style/BpjstkuTextViewDmSans.MacaroniAndCheese.Medium"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.textfield.TextInputLayout
            id="@+id/tilPassword"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_27dp"
            hint="@string/hint_new_password"
            NOT_FOUND_0x26="@+id/cvEnterPasswordWarning"
            NOT_FOUND_0x28="@+id/cvEnterPasswordWarning"
            NOT_FOUND_0x29="@+id/cvEnterPasswordWarning"
            NOT_FOUND_0x2c="true"
            style="@style/BpjstkuTextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                maxLength="20"
                inputType="0x81"
                imeOptions="0x5"
                nextFocusForward="@+id/tilConfirmedPassword"
                style="@style/BpjstkuTextInputEditText"/>
        </com.google.android.material.textfield.TextInputLayout>
        <LinearLayout
            orientation="1"
            id="@+id/llPasswordRules"
            visibility="0"
            layout_width="-1"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_20dp"
            layout_marginRight="@dimen/dimen_20dp"
            layout_marginHorizontal="@dimen/dimen_20dp"
            NOT_FOUND_0x26="0"
            NOT_FOUND_0x28="0"
            NOT_FOUND_0x29="@+id/tilPassword">
            <TextView
                textSize="@dimen/text_size_12sp"
                layout_width="-1"
                layout_height="-2"
                text="@string/label_rules_password"
                style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
            <TextView
                textSize="@dimen/text_size_12sp"
                gravity="0x10"
                id="@+id/tvLengthValid"
                layout_width="-1"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_8dp"
                text="@string/label_password_length"
                drawablePadding="@dimen/dimen_5dp"
                NOT_FOUND_0x23="@drawable/ic_check_inactive"
                style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
            <TextView
                textSize="@dimen/text_size_12sp"
                gravity="0x10"
                id="@+id/tvUpperLowerValid"
                layout_width="-1"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_8dp"
                text="@string/label_password_upper_lower"
                drawablePadding="@dimen/dimen_5dp"
                NOT_FOUND_0x23="@drawable/ic_check_inactive"
                style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
            <TextView
                textSize="@dimen/text_size_12sp"
                gravity="0x10"
                id="@+id/tvDigitValid"
                layout_width="-1"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_8dp"
                text="@string/label_password_digit"
                drawablePadding="@dimen/dimen_5dp"
                NOT_FOUND_0x23="@drawable/ic_check_inactive"
                style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
            <TextView
                textSize="@dimen/text_size_12sp"
                gravity="0x10"
                id="@+id/tvSpecialCharValid"
                layout_width="-1"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_8dp"
                text="@string/label_password_special_char"
                drawablePadding="@dimen/dimen_5dp"
                NOT_FOUND_0x23="@drawable/ic_check_inactive"
                style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        </LinearLayout>
        <com.google.android.material.textfield.TextInputLayout
            id="@+id/tilConfirmedPassword"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_20dp"
            layout_marginTop="@dimen/dimen_16dp"
            layout_marginRight="@dimen/dimen_20dp"
            layout_marginBottom="@dimen/dimen_24dp"
            hint="@string/hint_enter_new_password"
            layout_marginHorizontal="@dimen/dimen_20dp"
            NOT_FOUND_0x25="@+id/btnNext"
            NOT_FOUND_0x26="0"
            NOT_FOUND_0x28="0"
            NOT_FOUND_0x29="@+id/llPasswordRules"
            NOT_FOUND_0x2b="0"
            NOT_FOUND_0x2c="true"
            style="@style/BpjstkuTextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                maxLength="20"
                inputType="0x81"
                imeOptions="0x6"
                style="@style/BpjstkuTextInputEditText"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton
            enabled="false"
            id="@+id/btnNext"
            paddingTop="@dimen/dimen_14dp"
            paddingBottom="@dimen/dimen_14dp"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginBottom="@dimen/dimen_22dp"
            text="@string/action_next"
            paddingVertical="@dimen/dimen_14dp"
            NOT_FOUND_0x24="0"
            NOT_FOUND_0x26="@+id/tilConfirmedPassword"
            NOT_FOUND_0x28="@+id/tilConfirmedPassword"
            style="@style/BpjstkuButton.WhiteText"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
