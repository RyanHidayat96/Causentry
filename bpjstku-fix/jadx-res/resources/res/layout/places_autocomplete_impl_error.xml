<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        layout_gravity="0x11"
        id="@+id/places_autocomplete_sad_cloud"
        layout_width="192dp"
        layout_height="120dp"
        layout_marginTop="48dp"
        NOT_FOUND_0x10="@drawable/quantum_ic_cloud_off_vd_theme_24"/>
    <TextView
        textAppearance="@style/PlacesAutocompleteErrorMessageText"
        layout_gravity="0x11"
        id="@+id/places_autocomplete_error_message"
        layout_width="-2"
        layout_height="-2"
        layout_marginTop="38dp"
        includeFontPadding="false"/>
    <FrameLayout
        layout_gravity="0x11"
        layout_width="-2"
        layout_height="-2">
        <Button
            textAppearance="@style/PlacesAutocompleteErrorButtonText"
            id="@+id/places_autocomplete_try_again"
            background="@null"
            paddingTop="20dp"
            paddingBottom="30dp"
            layout_width="-2"
            layout_height="-2"
            text="@string/places_try_again"
            includeFontPadding="false"/>
        <ProgressBar
            id="@+id/places_autocomplete_try_again_progress"
            padding="3dp"
            layout_width="@dimen/places_autocomplete_progress_size"
            layout_height="@dimen/places_autocomplete_progress_size"
            layout_marginTop="20dp"
            layout_marginBottom="30dp"
            indeterminate="true"
            indeterminateTint="@color/places_autocomplete_progress_tint"
            indeterminateTintMode="9"
            style="@style/Widget.AppCompat.ProgressBar"/>
    </FrameLayout>
</merge>
