<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    background="@color/colorWhite"
    layout_width="-1"
    layout_height="-2">
    <TextView
        textSize="@dimen/text_size_12sp"
        id="@+id/tvDateTime"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        layout_marginLeft="@dimen/dimen_20dp"
        layout_marginRight="@dimen/dimen_20dp"
        layout_marginHorizontal="@dimen/dimen_20dp"
        NOT_FOUND_0x9="0"
        NOT_FOUND_0xa="0"
        NOT_FOUND_0xc="0"
        style="@style/BpjstkuTextViewDmSans.CharcoalGrey.Bold"/>
    <androidx.recyclerview.widget.RecyclerView
        id="@+id/rvJpnSimulationResultTable"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        layout_marginTop="@dimen/dimen_12dp"
        NOT_FOUND_0x9="@+id/tvDateTime"
        NOT_FOUND_0xa="@+id/tvDateTime"
        NOT_FOUND_0xb="@+id/tvDateTime"/>
</androidx.constraintlayout.widget.ConstraintLayout>
