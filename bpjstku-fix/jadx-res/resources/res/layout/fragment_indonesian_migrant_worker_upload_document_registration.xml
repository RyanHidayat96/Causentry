<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    layout_width="-1"
    layout_height="-1"
    fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        orientation="1"
        background="@color/colorWhite"
        layout_width="-1"
        layout_height="-2">
        <TextView
            textSize="@dimen/text_size_16sp"
            id="@+id/tvIdCardUpload"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_20dp"
            layout_marginTop="@dimen/dimen_26dp"
            layout_marginRight="@dimen/dimen_20dp"
            text="@string/label_upload_photo_identity_card_or_passport"
            layout_marginHorizontal="@dimen/dimen_20dp"
            NOT_FOUND_0x19="0"
            NOT_FOUND_0x1b="0"
            NOT_FOUND_0x1d="0"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey.Bold"/>
        <androidx.cardview.widget.CardView
            id="@+id/cvIdCardUpload"
            layout_width="@dimen/dimen_0dp"
            layout_height="@dimen/dimen_100dp"
            layout_marginTop="@dimen/dimen_16dp"
            NOT_FOUND_0x14="@color/colorWhite"
            NOT_FOUND_0x15="@dimen/dimen_4dp"
            NOT_FOUND_0x16="@dimen/dimen_0dp"
            NOT_FOUND_0x19="@+id/tvIdCardUpload"
            NOT_FOUND_0x1a="0"
            NOT_FOUND_0x1b="@+id/tvIdCardUpload"
            NOT_FOUND_0x1c="@+id/tvIdCardUpload"
            NOT_FOUND_0x1f="0.42">
            <ImageView
                id="@+id/imgIdCardPhoto"
                visibility="2"
                layout_width="-2"
                layout_height="@dimen/dimen_100dp"
                src="@drawable/ic_ktp"
                scaleType="fitStart"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                id="@+id/containerIdCard"
                background="@drawable/selector_bordered_grey_blue"
                layout_width="-1"
                layout_height="-1">
                <ImageView
                    id="@+id/imgIdCardUploadIcon"
                    layout_width="@dimen/dimen_20dp"
                    layout_height="@dimen/dimen_20dp"
                    src="@drawable/ic_camera"
                    NOT_FOUND_0x17="0"
                    NOT_FOUND_0x19="0"
                    NOT_FOUND_0x1b="0"
                    NOT_FOUND_0x1d="0"
                    NOT_FOUND_0x1e="0.4"/>
                <TextView
                    textSize="@dimen/text_size_12sp"
                    id="@+id/tvIdCardUploadLabel"
                    text="@string/action_id_card_upload"
                    layout_below="@+id/imgIdCardUploadIcon"
                    NOT_FOUND_0x19="0"
                    NOT_FOUND_0x1b="0"
                    NOT_FOUND_0x1c="@+id/imgIdCardUploadIcon"
                    style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <TextView
            textSize="@dimen/text_size_12sp"
            id="@+id/tvIdCardError"
            visibility="2"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_8dp"
            text="@string/error_empty_id_card_photo"
            NOT_FOUND_0x1b="@+id/cvIdCardUpload"
            NOT_FOUND_0x1c="@+id/cvIdCardUpload"
            style="@style/BpjstkuTextViewDmSans.Reddish"/>
        <TextView
            textSize="@dimen/text_size_16sp"
            id="@+id/tvWorkAgreementLabel"
            layout_marginTop="@dimen/dimen_16dp"
            text="@string/label_upload_photo_employment_agreement"
            NOT_FOUND_0x1b="@+id/tvIdCardError"
            NOT_FOUND_0x1c="@+id/tvIdCardError"
            NOT_FOUND_0x20="@dimen/dimen_24dp"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey.Bold"/>
        <androidx.cardview.widget.CardView
            id="@+id/cvWorkAgreement"
            layout_width="@dimen/dimen_0dp"
            layout_height="@dimen/dimen_100dp"
            layout_marginTop="@dimen/dimen_16dp"
            layout_marginBottom="@dimen/dimen_32dp"
            NOT_FOUND_0x14="@color/colorWhite"
            NOT_FOUND_0x15="@dimen/dimen_4dp"
            NOT_FOUND_0x16="@dimen/dimen_0dp"
            NOT_FOUND_0x18="@+id/btnNext"
            NOT_FOUND_0x19="@+id/tvIdCardUpload"
            NOT_FOUND_0x1a="0"
            NOT_FOUND_0x1b="@+id/tvWorkAgreementLabel"
            NOT_FOUND_0x1c="@+id/tvWorkAgreementLabel"
            NOT_FOUND_0x1e="0"
            NOT_FOUND_0x1f="0.42">
            <ImageView
                id="@+id/imgWorkAgreementPhoto"
                visibility="2"
                layout_width="-2"
                layout_height="@dimen/dimen_100dp"
                src="@drawable/ic_ktp"
                scaleType="fitStart"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                id="@+id/containerWorkAgreement"
                background="@drawable/selector_bordered_grey_blue"
                layout_width="-1"
                layout_height="-1">
                <ImageView
                    id="@+id/imgWorkAgreementIcon"
                    layout_width="@dimen/dimen_20dp"
                    layout_height="@dimen/dimen_20dp"
                    src="@drawable/ic_camera"
                    NOT_FOUND_0x17="0"
                    NOT_FOUND_0x19="0"
                    NOT_FOUND_0x1b="0"
                    NOT_FOUND_0x1d="0"
                    NOT_FOUND_0x1e="0.4"/>
                <TextView
                    textSize="@dimen/text_size_12sp"
                    id="@+id/tvWorkAgreement"
                    text="@string/action_photo_employement_agrement"
                    layout_below="@+id/imgWorkAgreementIcon"
                    NOT_FOUND_0x19="0"
                    NOT_FOUND_0x1b="0"
                    NOT_FOUND_0x1c="@+id/imgWorkAgreementIcon"
                    style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <TextView
            textSize="@dimen/text_size_12sp"
            id="@+id/tvWorkAgrermentError"
            visibility="2"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_8dp"
            text="@string/error_empty_work_agreement_photo"
            NOT_FOUND_0x1b="@+id/cvWorkAgreement"
            NOT_FOUND_0x1c="@+id/cvWorkAgreement"
            style="@style/BpjstkuTextViewDmSans.Reddish"/>
        <com.google.android.material.button.MaterialButton
            id="@+id/btnNext"
            paddingTop="@dimen/dimen_14dp"
            paddingBottom="@dimen/dimen_14dp"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginBottom="@dimen/dimen_20dp"
            text="@string/action_next"
            paddingVertical="@dimen/dimen_14dp"
            NOT_FOUND_0x17="0"
            NOT_FOUND_0x19="@+id/tvIdCardUpload"
            NOT_FOUND_0x1b="@+id/tvIdCardUpload"
            style="@style/BpjstkuButton.WhiteText"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
