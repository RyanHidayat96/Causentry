<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    layout_width="-1"
    layout_height="-1">
    <ImageView
        id="@+id/imgOnboarding"
        layout_width="@dimen/dimen_0dp"
        layout_height="@dimen/dimen_0dp"
        src="0x7f0800d6"
        scaleType="fitStart"
        NOT_FOUND_0xf="@+id/cvOnboardingInfo"
        NOT_FOUND_0x10="0"
        NOT_FOUND_0x12="0"
        NOT_FOUND_0x14="0"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        orientation="1"
        id="@+id/cvOnboardingInfo"
        background="@drawable/bg_white_rounded_shadow"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        NOT_FOUND_0xe="0"
        NOT_FOUND_0x10="0"
        NOT_FOUND_0x12="0"
        NOT_FOUND_0x13="@+id/imgOnboarding">
        <TextView
            textSize="@dimen/text_size_16sp"
            id="@+id/tvTitleOnBoarding"
            layout_width="@dimen/dimen_0dp"
            layout_marginLeft="@dimen/dimen_25dp"
            layout_marginTop="@dimen/dimen_24dp"
            layout_marginRight="@dimen/dimen_25dp"
            textAlignment="4"
            layout_marginHorizontal="@dimen/dimen_25dp"
            NOT_FOUND_0x10="0"
            NOT_FOUND_0x12="0"
            NOT_FOUND_0x14="0"
            style="@style/BpjstkuTextViewPoppins.CharcoalGreyTwo.Bold"/>
        <TextView
            textSize="@dimen/text_size_16sp"
            id="@+id/tvDescOnBoarding"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            layout_marginBottom="@dimen/dimen_30dp"
            textAlignment="4"
            NOT_FOUND_0xe="0"
            NOT_FOUND_0x10="@+id/tvTitleOnBoarding"
            NOT_FOUND_0x11="0"
            NOT_FOUND_0x12="@+id/tvTitleOnBoarding"
            NOT_FOUND_0x13="@+id/tvTitleOnBoarding"
            style="@style/BpjstkuTextViewDmSans.CoolGreyTwo"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
