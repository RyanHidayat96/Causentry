<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    background="@color/colorWhite"
    layout_width="-1"
    layout_height="-1"
    fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        paddingBottom="@dimen/dimen_20dp"
        focusable="true"
        focusableInTouchMode="true"
        layout_width="-1"
        layout_height="-2">
        <com.google.android.material.textfield.TextInputLayout
            enabled="false"
            id="@+id/tilIdNumber"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_20dp"
            layout_marginTop="@dimen/dimen_16dp"
            layout_marginRight="@dimen/dimen_20dp"
            hint="@string/hint_id_number"
            layout_marginHorizontal="@dimen/dimen_20dp"
            NOT_FOUND_0x1f="0"
            NOT_FOUND_0x21="0"
            NOT_FOUND_0x23="0"
            style="@style/BpjstkuTextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                maxLength="16"
                digits="0123456789"
                inputType="0x3"
                imeOptions="0x5"
                style="@style/BpjstkuTextInputEditText"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            enabled="false"
            id="@+id/tilKPJNumber"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_8dp"
            hint="@string/hint_kpj_number"
            NOT_FOUND_0x1f="@+id/tilIdNumber"
            NOT_FOUND_0x21="@+id/tilIdNumber"
            NOT_FOUND_0x22="@+id/tilIdNumber"
            style="@style/BpjstkuTextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                maxLength="16"
                inputType="0x1001"
                imeOptions="0x5"
                style="@style/BpjstkuTextInputEditText"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            enabled="false"
            id="@+id/tilFullName"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_8dp"
            hint="@string/hint_fullname"
            NOT_FOUND_0x1f="@+id/tilKPJNumber"
            NOT_FOUND_0x21="@+id/tilKPJNumber"
            NOT_FOUND_0x22="@+id/tilKPJNumber"
            style="@style/BpjstkuTextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                inputType="0x1001"
                imeOptions="0x6"
                style="@style/BpjstkuTextInputEditText"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            enabled="false"
            id="@+id/tilBirthDate"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_8dp"
            hint="@string/hint_birth_date_on_id_card"
            NOT_FOUND_0x1f="@+id/tilFullName"
            NOT_FOUND_0x21="@+id/tilFullName"
            NOT_FOUND_0x22="@+id/tilFullName"
            style="@style/BpjstkuTextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                id="@+id/edtBirthDate"
                inputType="0x14"
                style="@style/BpjstkuTextInputEditText"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            enabled="false"
            id="@+id/tilGender"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_8dp"
            hint="@string/label_gender"
            NOT_FOUND_0x1f="@+id/tilBirthDate"
            NOT_FOUND_0x21="@+id/tilBirthDate"
            NOT_FOUND_0x22="@+id/tilBirthDate"
            style="@style/BpjstkuTextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                inputType="0x1001"
                imeOptions="0x6"
                style="@style/BpjstkuTextInputEditText"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            enabled="false"
            id="@+id/tilPhoneNumber"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            hint="@string/hint_phone_number"
            NOT_FOUND_0x1f="@+id/tilGender"
            NOT_FOUND_0x21="@+id/tilGender"
            NOT_FOUND_0x22="@+id/tilGender"
            style="@style/BpjstkuTextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                id="@+id/edtPhoneNumber"
                inputType="0x2"
                imeOptions="0x5"
                style="@style/BpjstkuTextInputEditText"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            enabled="false"
            id="@+id/tilEmail"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            hint="@string/hint_email"
            NOT_FOUND_0x1f="@+id/tilPhoneNumber"
            NOT_FOUND_0x21="@+id/tilPhoneNumber"
            NOT_FOUND_0x22="@+id/tilPhoneNumber"
            style="@style/BpjstkuTextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                inputType="0x21"
                imeOptions="0x5"
                style="@style/BpjstkuTextInputEditText"/>
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            textSize="@dimen/text_size_12sp"
            gravity="0x10"
            id="@+id/tvReminderNoSipp"
            background="@drawable/bg_rounded_macaroni_and_cheese"
            padding="@dimen/dimen_14dp"
            visibility="2"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            text="@string/label_reminder_not_sipp"
            drawablePadding="@dimen/dimen_14dp"
            drawableStart="@drawable/ic_loud_speaker_circle"
            justificationMode="1"
            NOT_FOUND_0x1f="@+id/tilEmail"
            NOT_FOUND_0x21="@+id/tilEmail"
            NOT_FOUND_0x22="@+id/tilEmail"
            style="@style/BpjstkuTextViewDmSans.White.Medium"/>
        <androidx.appcompat.widget.AppCompatCheckBox
            textSize="@dimen/text_size_12sp"
            gravity="0x30"
            id="@+id/cbAgreeTermCondition"
            paddingTop="@dimen/dimen_4dp"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            layout_marginBottom="@dimen/dimen_16dp"
            text="@string/label_statment"
            translationX="-8dp"
            justificationMode="1"
            NOT_FOUND_0x1e="@color/colorDarkMint"
            NOT_FOUND_0x1f="@+id/tilEmail"
            NOT_FOUND_0x21="@+id/tilEmail"
            NOT_FOUND_0x22="@+id/tilEmail"
            style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
        <TextView
            textSize="@dimen/text_size_14sp"
            id="@+id/tvCorrectDataConfirmation"
            visibility="2"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            text="@string/label_confirmation_data_validity"
            NOT_FOUND_0x21="@+id/tilEmail"
            NOT_FOUND_0x22="@+id/cbAgreeTermCondition"
            style="@style/BpjstkuTextViewDmSans.Black"/>
        <com.google.android.material.button.MaterialButton
            enabled="true"
            id="@+id/btnYes"
            paddingTop="@dimen/dimen_14dp"
            paddingBottom="@dimen/dimen_14dp"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_20dp"
            layout_marginTop="@dimen/dimen_20dp"
            layout_marginRight="@dimen/dimen_20dp"
            layout_marginBottom="@dimen/dimen_25dp"
            text="@string/action_next"
            layout_marginHorizontal="@dimen/dimen_20dp"
            paddingVertical="@dimen/dimen_14dp"
            NOT_FOUND_0x1f="0"
            NOT_FOUND_0x21="0"
            NOT_FOUND_0x22="@+id/cbAgreeTermCondition"
            NOT_FOUND_0x24="1"
            style="@style/BpjstkuButton.WhiteText"/>
        <com.google.android.material.button.MaterialButton
            enabled="true"
            id="@+id/btnNo"
            paddingTop="@dimen/dimen_14dp"
            paddingBottom="@dimen/dimen_14dp"
            visibility="2"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_20dp"
            layout_marginRight="@dimen/dimen_20dp"
            layout_marginBottom="@dimen/dimen_25dp"
            text="@string/action_not_confirmed"
            layout_marginHorizontal="@dimen/dimen_20dp"
            paddingVertical="@dimen/dimen_14dp"
            NOT_FOUND_0x1f="0"
            NOT_FOUND_0x20="@+id/btnYes"
            NOT_FOUND_0x23="@+id/btnYes"
            NOT_FOUND_0x24="1"
            style="@style/BpjstkuOutlinedButton"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
