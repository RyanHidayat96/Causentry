<?xml version="1.0" encoding="utf-8"?>
<com.esafirm.imagepicker.view.SquareFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    layout_width="-1"
    layout_height="-2"
    foregroundGravity="0x11">
    <ImageView
        id="@+id/image_view"
        layout_width="-1"
        layout_height="-1"
        scaleType="6"
        contentDescription="@string/ef_content_desc_image"/>
    <View
        id="@+id/view_alpha"
        background="@android:color/white"
        layout_width="-1"
        layout_height="-1"/>
    <TextView
        textSize="@dimen/ef_font_small"
        textColor="@color/ef_white"
        layout_gravity="0x50"
        id="@+id/ef_item_file_type_indicator"
        background="@color/ef_black_alpha_aa"
        paddingLeft="@dimen/ef_spacing_double"
        paddingTop="@dimen/ef_spacing_half"
        paddingRight="@dimen/ef_spacing_double"
        paddingBottom="@dimen/ef_spacing_half"
        visibility="2"
        layout_width="-2"
        layout_height="-2"
        text="@string/ef_gif"/>
</com.esafirm.imagepicker.view.SquareFrameLayout>
