<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    layout_width="-1"
    layout_height="-1">
    <TextView
        textSize="@dimen/ef_font_medium"
        id="@+id/tv_empty_images"
        padding="@dimen/ef_spacing_double"
        visibility="2"
        layout_width="-2"
        layout_height="-2"
        text="@string/ef_msg_empty_images"
        layout_centerInParent="true"/>
    <ProgressBar
        id="@+id/progress_bar"
        visibility="2"
        layout_width="100dp"
        layout_height="100dp"
        layout_centerInParent="true"/>
    <com.esafirm.imagepicker.view.SnackBarView
        id="@+id/ef_snackbar"
        background="@color/ef_black_alpha_aa"
        layout_width="-1"
        layout_height="56dp"
        layout_alignBottom="@+id/recyclerView"
        layout_alignParentBottom="true"/>
    <androidx.recyclerview.widget.RecyclerView
        id="@+id/recyclerView"
        layout_width="-1"
        layout_height="-1"/>
</RelativeLayout>
