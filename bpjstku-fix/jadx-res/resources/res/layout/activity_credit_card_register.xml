<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    background="@android:color/white"
    fitsSystemWindows="true"
    layout_width="-1"
    layout_height="-1">
    <include layout="@layout/appbar_payment"/>
    <RelativeLayout
        orientation="1"
        layout_width="-1"
        layout_height="-2"
        layout_marginTop="@dimen/thirtytwo_dp"
        NOT_FOUND_0x17="@string/appbar_scrolling_view_behavior">
        <ScrollView
            id="@+id/layout_container"
            layout_width="-1"
            layout_height="-2"
            layout_alignParentLeft="true"
            layout_alignParentTop="true"
            layout_alignParentStart="true">
            <include layout="@layout/layout_credit_card_register"/>
        </ScrollView>
        <LinearLayout
            gravity="0x10"
            orientation="0"
            background="@drawable/grey_rounded_background"
            padding="@dimen/eight_dp"
            layout_width="-1"
            layout_height="-2"
            layout_margin="@dimen/sixteen_dp"
            layout_below="@+id/layout_container">
            <ImageView
                id="@+id/cc_badge"
                layout_width="-1"
                layout_height="-2"
                layout_marginLeft="@dimen/four_dp"
                layout_marginRight="@dimen/four_dp"
                src="0x7f0800b4"
                scaleType="7"
                layout_marginStart="@dimen/four_dp"
                layout_marginEnd="@dimen/four_dp"/>
        </LinearLayout>
        <include
            id="@+id/btn_pay_container"
            layout="@layout/layout_primary_button"/>
    </RelativeLayout>
    <LinearLayout
        gravity="0x11"
        orientation="1"
        id="@+id/progress_container"
        background="@color/white"
        visibility="2"
        layout_width="-1"
        layout_height="-1"
        alpha="0.93">
        <include layout="@layout/layout_midtrans_progress"/>
    </LinearLayout>
    <include
        layout_gravity="0x800053"
        layout_width="-2"
        layout_height="-2"
        layout="@layout/layout_sandbox_badge"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
