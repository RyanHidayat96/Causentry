<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    background="@color/colorWhite"
    layout_width="-1"
    layout_height="-1"
    fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        paddingBottom="@dimen/dimen_20dp"
        focusable="true"
        focusableInTouchMode="true"
        layout_width="-1"
        layout_height="-2">
        <include
            id="@+id/layout_toolbar"
            NOT_FOUND_0x1c="0"
            NOT_FOUND_0x1d="0"
            NOT_FOUND_0x1f="0"
            layout="@layout/layout_toolbar_center"/>
        <com.google.android.material.textfield.TextInputLayout
            id="@+id/tilOccupation"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_20dp"
            layout_marginTop="@dimen/dimen_16dp"
            layout_marginRight="@dimen/dimen_20dp"
            hint="@string/hint_occupation"
            layout_marginHorizontal="@dimen/dimen_20dp"
            NOT_FOUND_0x1c="0"
            NOT_FOUND_0x1d="0"
            NOT_FOUND_0x1e="@+id/layout_toolbar"
            style="@style/BpjstkuTextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                inputType="0x1001"
                imeOptions="0x6"
                style="@style/BpjstkuTextInputEditText"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            id="@+id/tilDivisionWorkParticipant"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_8dp"
            hint="@string/hint_work_unit"
            NOT_FOUND_0x1c="@+id/tilOccupation"
            NOT_FOUND_0x1d="@+id/tilOccupation"
            NOT_FOUND_0x1e="@+id/tilOccupation"
            style="@style/BpjstkuTextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                inputType="0x1001"
                imeOptions="0x6"
                style="@style/BpjstkuTextInputEditText"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            id="@+id/tilNumberWorkAgreement"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_8dp"
            hint="@string/hint_work_agreement_number"
            NOT_FOUND_0x1c="@+id/tilDivisionWorkParticipant"
            NOT_FOUND_0x1d="@+id/tilDivisionWorkParticipant"
            NOT_FOUND_0x1e="@+id/tilDivisionWorkParticipant"
            style="@style/BpjstkuTextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                inputType="0x1001"
                imeOptions="0x6"
                style="@style/BpjstkuTextInputEditText"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            id="@+id/tilDateWorkAgreement"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_8dp"
            hint="@string/hint_date_work_agreement"
            NOT_FOUND_0x1c="@+id/tilNumberWorkAgreement"
            NOT_FOUND_0x1d="@+id/tilNumberWorkAgreement"
            NOT_FOUND_0x1e="@+id/tilNumberWorkAgreement"
            style="@style/BpjstkuTextInputLayout.Calender">
            <com.google.android.material.textfield.TextInputEditText
                id="@+id/edtDateWorkAgreement"
                inputType="0x14"
                style="@style/BpjstkuAutoCompleteTextViewCalender"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            id="@+id/tilNumberTerminationLetter"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            hint="@string/hint_id_work_termination_announcement"
            NOT_FOUND_0x1c="@+id/tilDateWorkAgreement"
            NOT_FOUND_0x1d="@+id/tilDateWorkAgreement"
            NOT_FOUND_0x1e="@+id/tilDateWorkAgreement"
            style="@style/BpjstkuTextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                inputType="0x1001"
                imeOptions="0x6"
                style="@style/BpjstkuTextInputEditText"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            id="@+id/tilDateTerminationAnnouncement"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            hint="@string/hint_date_work_termination_announcement"
            NOT_FOUND_0x1c="@+id/tilNumberTerminationLetter"
            NOT_FOUND_0x1d="@+id/tilNumberTerminationLetter"
            NOT_FOUND_0x1e="@+id/tilNumberTerminationLetter"
            style="@style/BpjstkuTextInputLayout.Calender">
            <com.google.android.material.textfield.TextInputEditText
                id="@+id/edtDateTerminationAnnouncement"
                inputType="0x14"
                style="@style/BpjstkuAutoCompleteTextViewCalender"/>
        </com.google.android.material.textfield.TextInputLayout>
        <androidx.constraintlayout.widget.Barrier
            id="@+id/barBottomLayout"
            layout_width="-2"
            layout_height="-2"
            NOT_FOUND_0x18="3"
            NOT_FOUND_0x1a="tilDateTerminationAnnouncement,tilDateWorkAgreement,tilDivisionWorkParticipant,tilNumberTerminationLetter,tilNumberWorkAgreement,tilOccupation"/>
        <androidx.constraintlayout.widget.Group
            id="@+id/groupInput"
            layout_width="-2"
            layout_height="-2"
            NOT_FOUND_0x1a="tilDateTerminationAnnouncement,tilDateWorkAgreement,tilDivisionWorkParticipant,tilNumberTerminationLetter,tilNumberWorkAgreement,tilOccupation"/>
        <androidx.appcompat.widget.AppCompatCheckBox
            textSize="@dimen/text_size_12sp"
            gravity="0x30"
            id="@+id/cbAgreeTermCondition"
            paddingTop="@dimen/dimen_4dp"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_20dp"
            layout_marginTop="@dimen/dimen_16dp"
            layout_marginRight="@dimen/dimen_20dp"
            layout_marginBottom="@dimen/dimen_16dp"
            text="@string/label_term_eclaim_work_termination"
            translationX="-8dp"
            layout_marginHorizontal="@dimen/dimen_20dp"
            justificationMode="1"
            NOT_FOUND_0x19="@color/colorDarkMint"
            NOT_FOUND_0x1c="0"
            NOT_FOUND_0x1d="0"
            NOT_FOUND_0x1e="@+id/barBottomLayout"
            style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
        <com.google.android.material.button.MaterialButton
            enabled="false"
            id="@+id/btnNext"
            paddingTop="@dimen/dimen_14dp"
            paddingBottom="@dimen/dimen_14dp"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_20dp"
            layout_marginTop="@dimen/dimen_20dp"
            layout_marginRight="@dimen/dimen_20dp"
            layout_marginBottom="@dimen/dimen_25dp"
            text="@string/action_next"
            layout_marginHorizontal="@dimen/dimen_20dp"
            paddingVertical="@dimen/dimen_14dp"
            NOT_FOUND_0x1b="0"
            NOT_FOUND_0x1c="0"
            NOT_FOUND_0x1d="0"
            NOT_FOUND_0x1e="@+id/cbAgreeTermCondition"
            NOT_FOUND_0x20="1"
            style="@style/BpjstkuButton.WhiteText"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
