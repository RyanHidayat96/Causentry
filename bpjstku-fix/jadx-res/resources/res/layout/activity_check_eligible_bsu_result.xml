<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    layout_width="-1"
    layout_height="-1">
    <ScrollView
        id="@+id/scroll_view"
        layout_width="-1"
        layout_height="-1"
        fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            id="@+id/mainContainer"
            background="@color/colorWhite"
            paddingBottom="@dimen/dimen_20dp"
            focusable="true"
            focusableInTouchMode="true"
            layout_width="-1"
            layout_height="-2">
            <include
                id="@+id/layout_toolbar"
                NOT_FOUND_0x1a="0"
                NOT_FOUND_0x1b="0"
                NOT_FOUND_0x1d="0"
                layout="@layout/layout_toolbar_center"/>
            <ImageView
                id="@+id/imgCheckEligibleResult"
                layout_width="@dimen/dimen_80dp"
                layout_height="@dimen/dimen_80dp"
                src="@drawable/ic_success"
                NOT_FOUND_0x18="0"
                NOT_FOUND_0x1a="0"
                NOT_FOUND_0x1b="0"
                NOT_FOUND_0x1c="@+id/layout_toolbar"
                NOT_FOUND_0x1e="0.1"/>
            <TextView
                textSize="@dimen/text_size_20sp"
                id="@+id/tvStatusEligible"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_20dp"
                layout_marginTop="28dp"
                layout_marginRight="@dimen/dimen_20dp"
                textAlignment="4"
                layout_marginHorizontal="@dimen/dimen_20dp"
                NOT_FOUND_0x1a="0"
                NOT_FOUND_0x1b="0"
                NOT_FOUND_0x1c="@+id/imgCheckEligibleResult"
                style="@style/BpjstkuTextViewPoppins.CharcoalGrey.SemiBold"/>
            <TextView
                textSize="@dimen/text_size_14sp"
                gravity="0x10"
                id="@+id/tvInstructionUpdateRekening"
                background="@drawable/bg_rounded_macaroni_and_cheese"
                padding="@dimen/dimen_14dp"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_20dp"
                layout_marginTop="@dimen/dimen_25dp"
                layout_marginRight="@dimen/dimen_20dp"
                text="@string/instruction_update_account_balance"
                drawablePadding="@dimen/dimen_14dp"
                drawableStart="@drawable/ic_warning"
                layout_marginHorizontal="@dimen/dimen_20dp"
                NOT_FOUND_0x1a="0"
                NOT_FOUND_0x1b="0"
                NOT_FOUND_0x1c="@+id/tvStatusEligible"
                style="@style/BpjstkuTextViewDmSans.White.Medium"/>
            <com.google.android.material.textfield.TextInputLayout
                id="@+id/tilBankName"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                hint="@string/hint_bank_name"
                NOT_FOUND_0x1a="@+id/tvStatusEligible"
                NOT_FOUND_0x1b="@+id/tvStatusEligible"
                NOT_FOUND_0x1c="@+id/tvInstructionUpdateRekening"
                style="@style/BpjstkuTextInputLayout.GeneralDropdown">
                <com.google.android.material.textfield.TextInputEditText
                    inputType="0x1001"
                    style="@style/BpjstkuAutoCompleteTextViewDropDown"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                id="@+id/tilBankAccountNumber"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                hint="@string/hint_bank_account_number"
                NOT_FOUND_0x1a="@+id/tilBankName"
                NOT_FOUND_0x1b="@+id/tilBankName"
                NOT_FOUND_0x1c="@+id/tilBankName"
                style="@style/BpjstkuTextInputLayout">
                <com.google.android.material.textfield.TextInputEditText
                    inputType="0x2"
                    imeOptions="0x5"
                    style="@style/BpjstkuTextInputEditText"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                id="@+id/tilBankAccountName"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_8dp"
                layout_marginBottom="@dimen/dimen_24dp"
                hint="@string/hint_bank_account_name"
                NOT_FOUND_0x19="@+id/btnNext"
                NOT_FOUND_0x1a="@+id/tilBankAccountNumber"
                NOT_FOUND_0x1b="@+id/tilBankAccountNumber"
                NOT_FOUND_0x1c="@+id/tilBankAccountNumber"
                NOT_FOUND_0x1e="0"
                style="@style/BpjstkuTextInputLayout">
                <com.google.android.material.textfield.TextInputEditText
                    inputType="0x1001"
                    imeOptions="0x6"
                    style="@style/BpjstkuTextInputEditText"/>
            </com.google.android.material.textfield.TextInputLayout>
            <Button
                id="@+id/btnOk"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_32dp"
                layout_marginTop="@dimen/dimen_48dp"
                layout_marginRight="@dimen/dimen_32dp"
                layout_marginBottom="@dimen/dimen_24dp"
                text="@string/action_ok"
                layout_marginHorizontal="@dimen/dimen_32dp"
                NOT_FOUND_0x18="0"
                NOT_FOUND_0x1a="0"
                NOT_FOUND_0x1b="0"
                NOT_FOUND_0x1c="@+id/tilBankAccountName"
                NOT_FOUND_0x1e="1"
                style="@style/BpjstkuButton.WhiteText"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</LinearLayout>
