            layout_width="-2"
            layout_height="-2"
            layout_marginBottom="@dimen/dimen_16dp"
            drawablePadding="@dimen/dimen_16dp"
            fontFamily="@font/dmsans_reguler"/>
    </LinearLayout>
    <LinearLayout
        orientation="0"
        id="@+id/llTuitionJakon"
        layout_width="-1"
        layout_height="-2">
