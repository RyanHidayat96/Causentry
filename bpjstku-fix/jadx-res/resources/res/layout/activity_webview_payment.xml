<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    background="@android:color/white"
    fitsSystemWindows="true"
    layout_width="-1"
    layout_height="-1">
    <include layout="@layout/appbar_payment"/>
    <RelativeLayout
        orientation="1"
        layout_width="-1"
        layout_height="-1"
        NOT_FOUND_0x9="@string/appbar_scrolling_view_behavior">
        <WebView
            id="@+id/webview_container"
            layout_width="-1"
            layout_height="-1"/>
    </RelativeLayout>
    <LinearLayout
        gravity="0x11"
        orientation="1"
        id="@+id/progress_container"
        background="@color/white"
        visibility="2"
        layout_width="-1"
        layout_height="-1">
        <include layout="@layout/layout_midtrans_progress"/>
    </LinearLayout>
    <include
        layout_gravity="0x800053"
        layout_width="-2"
        layout_height="-2"
        layout="@layout/layout_sandbox_badge"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
