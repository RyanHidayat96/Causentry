<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    orientation="1"
    layout_width="-1"
    layout_height="-2">
    <LinearLayout
        gravity="0x11"
        orientation="0"
        id="@+id/autocomplete_prediction_container"
        paddingTop="@dimen/gmp_sys_measurement_spacing_small"
        paddingBottom="@dimen/gmp_sys_measurement_spacing_small"
        layout_width="-1"
        layout_height="-2"
        paddingStart="@dimen/gmp_sys_measurement_spacing_large"
        paddingEnd="@dimen/gmp_sys_measurement_spacing_large">
        <FrameLayout
            id="@+id/list_item_icon_container"
            layout_width="@dimen/gmp_sys_measurement_icon_size_large"
            layout_height="@dimen/gmp_sys_measurement_icon_size_large"
            layout_marginEnd="@dimen/gmp_sys_measurement_spacing_medium">
            <ImageView
                id="@+id/list_item_icon_background"
                layout_width="@dimen/gmp_sys_measurement_icon_size_large"
                layout_height="@dimen/gmp_sys_measurement_icon_size_large"
                src="@drawable/autocomplete_list_item_icon_background"
                contentDescription="@null"
                importantForAccessibility="2"/>
            <ImageView
                layout_gravity="0x11"
                id="@+id/list_item_icon"
                layout_width="@dimen/gmp_sys_measurement_icon_size_small"
                layout_height="@dimen/gmp_sys_measurement_icon_size_small"
                src="@drawable/location_on_icon"
                contentDescription="@null"
                importantForAccessibility="2"/>
        </FrameLayout>
        <LinearLayout
            layout_gravity="0x11"
            orientation="1"
            id="@+id/autocomplete_prediction_text_container"
            layout_width="-1"
            layout_height="-2">
            <TextView
                textAppearance="@style/TextAppearance.Gmp.Sys.Typescale.LabelLarge"
                textColor="?attr/placesColorOnSurface"
                ellipsize="3"
                id="@+id/autocomplete_prediction_primary_text"
                layout_width="-2"
                layout_height="-2"
                singleLine="true"
                layout_weight="1"/>
            <TextView
                textAppearance="@style/TextAppearance.Gmp.Sys.Typescale.BodySmall"
                textColor="?attr/placesColorOnSurfaceVariant"
                ellipsize="3"
                id="@+id/autocomplete_prediction_secondary_text"
                layout_width="-2"
                layout_height="-2"
                singleLine="true"
                layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
    <View
        id="@+id/autocomplete_prediction_list_separator"
        background="?attr/placesColorOutlineDecorative"
        layout_width="-1"
        layout_height="@dimen/place_widget_border_width"/>
</LinearLayout>
