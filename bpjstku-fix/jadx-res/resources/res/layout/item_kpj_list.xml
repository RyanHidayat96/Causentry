<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    layout_width="-1"
    layout_height="-2">
    <ImageView
        id="@+id/imgCard"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        layout_marginTop="@dimen/dimen_20dp"
        layout_marginBottom="@dimen/dimen_20dp"
        src="@drawable/ic_card_blue"
        layout_marginVertical="@dimen/dimen_20dp"
        NOT_FOUND_0xe="1"
        NOT_FOUND_0xf="0"
        NOT_FOUND_0x11="@+id/tvKpjNumber"
        NOT_FOUND_0x15="0"/>
    <TextView
        textSize="@dimen/text_size_16sp"
        id="@+id/tvKpjNumber"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        text="@string/sample_kpj_number"
        layout_marginStart="@dimen/dimen_16dp"
        NOT_FOUND_0xc="@+id/imgCard"
        NOT_FOUND_0xe="8"
        NOT_FOUND_0x10="@+id/imgCard"
        NOT_FOUND_0x12="@+id/imgChecklist"
        NOT_FOUND_0x15="@+id/imgCard"
        style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
    <ImageView
        id="@+id/imgChecklist"
        visibility="2"
        layout_width="@dimen/dimen_0dp"
        layout_height="@dimen/dimen_24dp"
        src="@drawable/ic_success"
        NOT_FOUND_0xc="@+id/imgCard"
        NOT_FOUND_0xe="1"
        NOT_FOUND_0x10="@+id/tvKpjNumber"
        NOT_FOUND_0x12="0"
        NOT_FOUND_0x15="@+id/imgCard"/>
    <View
        background="@color/colorPaleGreyFour"
        visibility="0"
        layout_width="@dimen/dimen_0dp"
        layout_height="@dimen/dimen_1dp"
        layout_marginTop="@dimen/dimen_21dp"
        NOT_FOUND_0xd="0"
        NOT_FOUND_0x13="0"
        NOT_FOUND_0x14="@+id/imgCard"/>
</androidx.constraintlayout.widget.ConstraintLayout>
