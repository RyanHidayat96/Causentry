<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    id="@+id/root"
    background="?attr/vida_camera_screen_background_color"
    layout_width="-1"
    layout_height="-1">
    <androidx.appcompat.widget.AppCompatImageView
        id="@+id/image_view_back_arrow"
        background="@drawable/vida_ripple_effect"
        padding="@dimen/vida_layout_dim_16"
        layout_width="-2"
        layout_height="-2"
        src="@drawable/vida_keyboard_backspace_arrow"
        NOT_FOUND_0x17="@+id/title"
        NOT_FOUND_0x1b="0"
        NOT_FOUND_0x20="@+id/title"/>
    <androidx.appcompat.widget.AppCompatTextView
        textSize="?attr/vida_camera_screen_title_text_font_size"
        textColor="?attr/vida_camera_screen_title_text_color"
        ellipsize="3"
        id="@+id/title"
        padding="@dimen/vida_layout_dim_5"
        visibility="1"
        layout_width="-2"
        layout_height="-2"
        layout_marginTop="@dimen/vida_layout_dim_16"
        text="?attr/vida_camera_screen_title_text"
        maxLines="2"
        fontFamily="?attr/vida_camera_screen_title_text_font_family"
        textAlignment="4"
        layout_marginEnd="@dimen/vida_layout_dim_40"
        NOT_FOUND_0x1c="@+id/image_view_back_arrow"
        NOT_FOUND_0x1d="0"
        NOT_FOUND_0x20="0"/>
    <androidx.appcompat.widget.AppCompatTextView
        textSize="?attr/vida_camera_screen_instructions_text_font_size"
        textColor="?attr/vida_camera_screen_instruction_text_color"
        ellipsize="3"
        gravity="0x11"
        id="@+id/instructions"
        paddingLeft="@dimen/vida_layout_dim_40"
        paddingRight="@dimen/vida_layout_dim_40"
        paddingBottom="@dimen/vida_layout_dim_10"
        layout_width="-1"
        layout_height="-2"
        minHeight="@dimen/vida_layout_dim_60"
        text="?attr/vida_camera_screen_instructions_text_frame_your_face_out_of_box"
        maxLines="4"
        fontFamily="?attr/vida_camera_screen_instructions_text_font_family"
        textAlignment="4"
        NOT_FOUND_0x18="@+id/cameraPreviewView"
        NOT_FOUND_0x1b="0"
        NOT_FOUND_0x1d="0"
        NOT_FOUND_0x1f="@+id/image_view_back_arrow"
        NOT_FOUND_0x22="1"/>
    <androidx.camera.view.PreviewView
        id="@+id/cameraPreviewView"
        layout_width="@dimen/vida_layout_dim_0"
        layout_height="@dimen/vida_layout_dim_0"
        NOT_FOUND_0x18="@+id/image_view_logo"
        NOT_FOUND_0x19="3:4"
        NOT_FOUND_0x1b="0"
        NOT_FOUND_0x1d="0"
        NOT_FOUND_0x1f="@+id/instructions"/>
    <id.vida.liveness.ui.OverlayView
        id="@+id/overlay_view"
        layout_width="@dimen/vida_layout_dim_0"
        layout_height="@dimen/vida_layout_dim_0"
        NOT_FOUND_0x17="@+id/cameraPreviewView"
        NOT_FOUND_0x1b="@+id/cameraPreviewView"
        NOT_FOUND_0x1d="@+id/cameraPreviewView"
        NOT_FOUND_0x20="@+id/cameraPreviewView"/>
    <id.vida.liveness.ui.ProgressOverlayView
        id="@+id/progress_overlay_view"
        layout_width="@dimen/vida_layout_dim_0"
        layout_height="@dimen/vida_layout_dim_0"
        NOT_FOUND_0x17="@+id/overlay_view"
        NOT_FOUND_0x1b="@+id/overlay_view"
        NOT_FOUND_0x1d="@+id/overlay_view"
        NOT_FOUND_0x20="@+id/overlay_view"/>
    <androidx.appcompat.widget.AppCompatImageView
        id="@+id/image_view_green_check"
        visibility="2"
        layout_width="-2"
        layout_height="-2"
        src="@drawable/vida_detection_progress_bar_animation_green_check"
        NOT_FOUND_0x17="@+id/cameraPreviewView"
        NOT_FOUND_0x1a="@+id/cameraPreviewView"
        NOT_FOUND_0x1e="@+id/cameraPreviewView"
        NOT_FOUND_0x20="@+id/cameraPreviewView"/>
    <androidx.appcompat.widget.AppCompatImageView
        id="@+id/image_view_logo"
        layout_width="-2"
        layout_height="@dimen/vida_layout_dim_24"
        layout_marginTop="@dimen/vida_layout_dim_10"
        layout_marginBottom="@dimen/vida_layout_dim_8"
        src="?attr/vida_branding_logo"
        NOT_FOUND_0x17="0"
        NOT_FOUND_0x1a="0"
        NOT_FOUND_0x1e="0"
        NOT_FOUND_0x1f="@+id/cameraPreviewView"
        NOT_FOUND_0x21="0.9"/>
    <View
        id="@+id/progress_bar_overlay_view"
        background="@color/vida_transparent_black"
        visibility="2"
        layout_width="-1"
        layout_height="-1"
        NOT_FOUND_0x17="0"
        NOT_FOUND_0x1a="0"
        NOT_FOUND_0x1e="0"
        NOT_FOUND_0x20="0"/>
    <ProgressBar
        id="@+id/progress_bar"
        visibility="2"
        layout_width="@dimen/vida_layout_dim_72"
        layout_height="@dimen/vida_layout_dim_72"
        indeterminateDrawable="@drawable/vida_progressbar_animation"
        NOT_FOUND_0x17="0"
        NOT_FOUND_0x1a="0"
        NOT_FOUND_0x1e="0"
        NOT_FOUND_0x20="0"
        style="?android:attr/progressBarStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
