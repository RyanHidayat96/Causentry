<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    paddingTop="@dimen/dimen_16dp"
    paddingBottom="@dimen/dimen_16dp"
    layout_width="-1"
    layout_height="-2"
    paddingVertical="@dimen/dimen_16dp">
    <TextView
        textSize="@dimen/text_size_12sp"
        id="@+id/tvBalanceInformationTitle"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        layout_marginTop="@dimen/dimen_10dp"
        NOT_FOUND_0x9="0"
        NOT_FOUND_0xa="0"
        NOT_FOUND_0xc="0"
        style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
    <TextView
        textSize="@dimen/text_size_16sp"
        id="@+id/tvBalanceInformationValue"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        layout_marginTop="@dimen/dimen_6dp"
        text="@string/sample_balance_value"
        NOT_FOUND_0x9="@+id/tvBalanceInformationTitle"
        NOT_FOUND_0xa="@+id/tvBalanceInformationTitle"
        NOT_FOUND_0xb="@+id/tvBalanceInformationTitle"
        style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
</androidx.constraintlayout.widget.ConstraintLayout>
