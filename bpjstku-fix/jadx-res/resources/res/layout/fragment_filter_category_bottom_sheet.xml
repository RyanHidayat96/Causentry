<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    orientation="1"
    id="@+id/bottomSheetContainer"
    background="@drawable/bg_bottom_sheet"
    focusable="true"
    focusableInTouchMode="true"
    layout_width="-1"
    layout_height="-1">
    <View
        layout_gravity="0x1"
        id="@+id/viewTopLine"
        background="@drawable/bg_rounded_page_grey_ten"
        layout_width="@dimen/dimen_40dp"
        layout_height="@dimen/dimen_4dp"
        layout_marginTop="@dimen/dimen_15dp"/>
    <LinearLayout
        orientation="0"
        layout_width="-1"
        layout_height="-2">
        <TextView
            textSize="@dimen/text_size_18sp"
            gravity="0x11"
            id="@+id/tvTitle"
            layout_width="0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_22dp"
            layout_weight="1"
            layout_marginStart="@dimen/dimen_60dp"
            style="@style/BpjstkuTextViewPoppins.CharcoalGreyFour.SemiBold"/>
        <TextView
            textSize="@dimen/text_size_14sp"
            textStyle="0x1"
            textColor="@color/colorDarkMint"
            id="@+id/tvReset"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_22dp"
            layout_marginEnd="@dimen/dimen_35dp"
            style="@style/BpjstkuTextViewPoppins.CharcoalGreyFour.SemiBold"/>
    </LinearLayout>
    <com.kennyc.view.MultiStateView
        id="@+id/msvGeneralList"
        paddingBottom="@dimen/dimen_16dp"
        layout_width="-1"
        layout_height="-1"
        NOT_FOUND_0x22="@layout/layout_default_empty"
        NOT_FOUND_0x23="@layout/layout_default_error"
        NOT_FOUND_0x24="@layout/default_loading_layout">
        <LinearLayout
            orientation="1"
            layout_width="-1"
            layout_height="-1">
            <androidx.appcompat.widget.SearchView
                textSize="@dimen/text_size_14sp"
                id="@+id/svSearchItem"
                background="@drawable/bg_search_view"
                layout_width="-1"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_30dp"
                layout_marginTop="@dimen/dimen_16dp"
                layout_marginRight="@dimen/dimen_30dp"
                inputType="0x1001"
                fontFamily="@font/dmsans_reguler"
                layout_marginHorizontal="@dimen/dimen_30dp"
                NOT_FOUND_0x1d="false"
                NOT_FOUND_0x25="@null"
                NOT_FOUND_0x26="@string/hint_search_filter"/>
            <androidx.recyclerview.widget.RecyclerView
                id="@+id/rvItem"
                paddingLeft="@dimen/dimen_30dp"
                paddingRight="@dimen/dimen_30dp"
                layout_width="-1"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_20dp"
                layout_marginBottom="@dimen/dimen_16dp"
                paddingHorizontal="@dimen/dimen_30dp"/>
            <Button
                id="@+id/btnApply"
                paddingTop="@dimen/dimen_14dp"
                paddingBottom="@dimen/dimen_14dp"
                layout_width="-1"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_30dp"
                layout_marginTop="@dimen/dimen_28dp"
                layout_marginRight="@dimen/dimen_30dp"
                layout_marginBottom="@dimen/dimen_26dp"
                text="@string/action_apply"
                layout_marginHorizontal="@dimen/dimen_30dp"
                paddingVertical="@dimen/dimen_14dp"
                NOT_FOUND_0x1e="0"
                NOT_FOUND_0x1f="0"
                NOT_FOUND_0x20="0"
                NOT_FOUND_0x21="@+id/rgChooseSegment"
                style="@style/BpjstkuButton.WhiteText"/>
        </LinearLayout>
    </com.kennyc.view.MultiStateView>
</LinearLayout>
