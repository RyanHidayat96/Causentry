<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    layout_width="-1"
    layout_height="-1"
    paddingStart="@dimen/dialog_margin"
    paddingEnd="@dimen/dialog_margin">
    <TextView
        textAppearance="@style/TextAppearance.MaterialComponents.Body2"
        textColor="?android:attr/textColorPrimary"
        ellipsize="3"
        id="@+id/tvPlaceName"
        layout_width="0dp"
        layout_height="-2"
        layout_marginTop="@dimen/default_margin"
        maxLines="1"
        NOT_FOUND_0x10="0"
        NOT_FOUND_0x11="0"
        NOT_FOUND_0x13="0"/>
    <TextView
        textAppearance="@style/TextAppearance.MaterialComponents.Body2"
        textColor="?android:attr/textColorSecondary"
        ellipsize="3"
        id="@+id/tvPlaceAddress"
        layout_width="0dp"
        layout_height="-2"
        layout_marginTop="4dp"
        layout_marginBottom="@dimen/default_margin"
        maxLines="2"
        NOT_FOUND_0x10="0"
        NOT_FOUND_0x11="0"
        NOT_FOUND_0x12="@+id/tvPlaceName"/>
    <LinearLayout
        orientation="0"
        id="@+id/llPlaceImages"
        layout_width="0dp"
        layout_height="-2"
        layout_marginTop="@dimen/default_margin"
        NOT_FOUND_0x10="0"
        NOT_FOUND_0x11="0"
        NOT_FOUND_0x12="@+id/tvPlaceAddress">
        <ImageView
            id="@+id/ivPlacePhoto"
            visibility="2"
            layout_width="0dp"
            layout_height="@dimen/place_confirm_images_height"
            scaleType="6"
            layout_weight="0.65"
            contentDescription="@string/description_place_image"/>
        <ImageView
            id="@+id/ivPlaceMap"
            visibility="2"
            layout_width="0dp"
            layout_height="@dimen/place_confirm_images_height"
            scaleType="6"
            layout_weight="0.35"
            contentDescription="@string/description_place_map"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
