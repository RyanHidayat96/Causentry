<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    layout_width="-1"
    layout_height="-1"
    fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        layout_width="-1"
        layout_height="-1">
        <TextView
            textSize="@dimen/text_size_24sp"
            id="@+id/tvVerificationCode"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_20dp"
            layout_marginRight="@dimen/dimen_20dp"
            text="@string/label_verification_code"
            layout_marginHorizontal="@dimen/dimen_20dp"
            NOT_FOUND_0x1d="0"
            NOT_FOUND_0x1e="0"
            NOT_FOUND_0x21="0"
            NOT_FOUND_0x23="0"
            NOT_FOUND_0x24="0.2"
            style="@style/BpjstkuTextViewPoppins.CharcoalGrey.Bold"/>
        <TextView
            id="@+id/tvVerificationInstruction"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_6dp"
            text="@string/label_verification_description_phonenumber"
            letterSpacing="0.02"
            NOT_FOUND_0x1e="@+id/tvVerificationCode"
            NOT_FOUND_0x21="@+id/tvVerificationCode"
            NOT_FOUND_0x22="@+id/tvVerificationCode"
            NOT_FOUND_0x26="@dimen/text_size_20sp"
            style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
        <TextView
            textSize="@dimen/text_size_16sp"
            ellipsize="3"
            id="@+id/tvPhone"
            layout_width="@dimen/dimen_0dp"
            maxLines="1"
            layout_marginEnd="@dimen/dimen_8dp"
            NOT_FOUND_0x1d="@+id/btnChangeMethod"
            NOT_FOUND_0x1f="@+id/btnChangeMethod"
            NOT_FOUND_0x20="0"
            NOT_FOUND_0x21="@+id/tvVerificationInstruction"
            NOT_FOUND_0x23="@+id/btnChangeMethod"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey.Bold"/>
        <com.google.android.material.button.MaterialButton
            textColor="@color/colorDarkSkyBlue"
            id="@+id/btnChangeMethod"
            background="?attr/selectableItemBackground"
            layout_marginTop="@dimen/dimen_8dp"
            text="@string/label_change_email"
            NOT_FOUND_0x17="@drawable/ic_edit_email"
            NOT_FOUND_0x18="0x3"
            NOT_FOUND_0x19="@dimen/dimen_10dp"
            NOT_FOUND_0x1a="@color/colorDarkSkyBlue"
            NOT_FOUND_0x1e="@+id/tvVerificationInstruction"
            NOT_FOUND_0x22="@+id/tvVerificationInstruction"
            style="@style/BpjstkuTextButton.DarkSkyBlue.SemiBold"/>
        <com.mukesh.OtpView
            textSize="@dimen/text_size_24sp"
            textColor="@color/colorCharcoalGrey"
            id="@+id/otpVerify"
            focusable="true"
            focusableInTouchMode="true"
            layout_marginTop="@dimen/dimen_22dp"
            inputType="0x12"
            NOT_FOUND_0x1b="6"
            NOT_FOUND_0x1c="@dimen/dimen_40dp"
            NOT_FOUND_0x21="@+id/tvPhone"
            NOT_FOUND_0x22="@+id/tvPhone"
            NOT_FOUND_0x25="@color/colorSilverTwo"
            NOT_FOUND_0x27="true"
            NOT_FOUND_0x28="1"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey.Medium"/>
        <TextView
            textSize="@dimen/text_size_18sp"
            id="@+id/tvResendCode"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_28dp"
            text="@string/label_resend_code"
            NOT_FOUND_0x21="@+id/tvPhone"
            NOT_FOUND_0x22="@+id/otpVerify"
            style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
        <com.google.android.material.button.MaterialButton
            enabled="false"
            id="@+id/btnVerification"
            paddingTop="@dimen/dimen_14dp"
            paddingBottom="@dimen/dimen_14dp"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_28dp"
            text="@string/action_verification"
            paddingVertical="@dimen/dimen_14dp"
            NOT_FOUND_0x1e="@+id/btnChangeMethod"
            NOT_FOUND_0x21="@+id/tvResendCode"
            NOT_FOUND_0x22="@+id/tvResendCode"
            style="@style/BpjstkuButton.WhiteText"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
