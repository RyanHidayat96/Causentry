                paddingBottom="@dimen/dimen_14dp"
                layout_width="@dimen/dimen_48dp"
                layout_height="@dimen/dimen_48dp"
                layout_marginTop="@dimen/dimen_16dp"
                text="@string/hint_minus"
                paddingVertical="@dimen/dimen_14dp"
                NOT_FOUND_0x2d="@+id/tvChildren"
                NOT_FOUND_0x2e="@+id/tvChildren"
                NOT_FOUND_0x30="1"
                style="@style/BpjstkuButton.WhiteText"/>
