                    textSize="@dimen/dimen_20dp"
                    id="@+id/edtChildren"
                    paddingLeft="@dimen/dimen_0dp"
                    paddingTop="@dimen/dimen_12dp"
                    paddingRight="@dimen/dimen_0dp"
                    paddingBottom="@dimen/dimen_12dp"
                    maxLength="2"
                    digits="0123456789"
                    inputType="0x2"
                    imeOptions="0x5"
                    textAlignment="4"
                    paddingHorizontal="@dimen/dimen_0dp"
                    paddingVertical="@dimen/dimen_12dp"
                    style="@style/BpjstkuTextInputEditText"/>
            </com.google.android.material.textfield.TextInputLayout>
