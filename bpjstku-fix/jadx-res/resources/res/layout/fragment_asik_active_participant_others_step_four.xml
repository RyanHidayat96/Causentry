                layout_height="-2"
                layout_marginLeft="@dimen/dimen_12dp"
                layout_marginTop="@dimen/dimen_8dp"
                paddingVertical="@dimen/dimen_10dp"
                NOT_FOUND_0x2c="@+id/btnMin"
                NOT_FOUND_0x2e="@+id/tvChildren"
                style="@style/BpjstkuTextInputLayout">
