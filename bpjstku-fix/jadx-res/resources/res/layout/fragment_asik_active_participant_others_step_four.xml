<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    background="@color/colorWhite"
    layout_width="-1"
    layout_height="-1"
    fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        id="@+id/mainContainer"
        background="@color/colorWhite"
        focusable="true"
        focusableInTouchMode="true"
        layout_width="-1"
        layout_height="-2">
        <TextView
            textSize="@dimen/text_size_12sp"
            gravity="0x10"
            id="@+id/tvReminderVerifyDataPersonal"
            background="@drawable/bg_rounded_macaroni_and_cheese"
            padding="@dimen/dimen_14dp"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_20dp"
            layout_marginTop="@dimen/dimen_25dp"
            layout_marginRight="@dimen/dimen_20dp"
            text="@string/label_instruction_membership_document"
            drawablePadding="@dimen/dimen_14dp"
            drawableStart="@drawable/ic_warning"
            layout_marginHorizontal="@dimen/dimen_20dp"
            NOT_FOUND_0x2a="0"
            NOT_FOUND_0x2d="0"
            NOT_FOUND_0x2f="0"
            style="@style/BpjstkuTextViewDmSans.White.Medium"/>
        <TextView
            textSize="@dimen/text_size_16sp"
            id="@+id/tvGender"
            layout_marginTop="@dimen/dimen_16dp"
            text="@string/label_gender_participant"
            NOT_FOUND_0x2d="@+id/tvReminderVerifyDataPersonal"
            NOT_FOUND_0x2e="@+id/tvReminderVerifyDataPersonal"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey.Bold"/>
        <RadioGroup
            orientation="0"
            id="@+id/rgChooseGender"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            NOT_FOUND_0x2a="@+id/tvReminderVerifyDataPersonal"
            NOT_FOUND_0x2d="@+id/tvReminderVerifyDataPersonal"
            NOT_FOUND_0x2e="@+id/tvGender">
            <androidx.appcompat.widget.AppCompatRadioButton
                textSize="@dimen/text_size_16sp"
                id="@+id/rbMale"
                text="@string/label_male"
                style="@style/BpjstkuRadioButton.DmSansCoolGrey"/>
            <androidx.appcompat.widget.AppCompatRadioButton
                textSize="@dimen/text_size_16sp"
                id="@+id/rbFemale"
                text="@string/label_female"
                layout_marginStart="@dimen/dimen_40dp"
                style="@style/BpjstkuRadioButton.DmSansCoolGrey"/>
        </RadioGroup>
        <com.google.android.material.textfield.TextInputLayout
            id="@+id/tilAddressPostalCode"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            layout_marginBottom="@dimen/dimen_16dp"
            hint="*Kabupaten/Kecamatan/Kelurahan/Kode Pos"
            layout_marginVertical="@dimen/dimen_16dp"
            NOT_FOUND_0x2a="@+id/tvReminderVerifyDataPersonal"
            NOT_FOUND_0x2d="@+id/tvReminderVerifyDataPersonal"
            NOT_FOUND_0x2e="@+id/rgChooseGender"
            NOT_FOUND_0x30="0"
            style="@style/BpjstkuTextInputLayout.GeneralDropdown">
            <com.google.android.material.textfield.TextInputEditText
                id="@+id/edtAddressPostalCode"
                clickable="true"
                style="@style/BpjstkuAutoCompleteTextViewDropDown"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            enabled="true"
            id="@+id/tilParticipantAddress"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            hint="@string/label_alamat_mandatory"
            NOT_FOUND_0x2a="@+id/tvReminderVerifyDataPersonal"
            NOT_FOUND_0x2d="@+id/tvReminderVerifyDataPersonal"
            NOT_FOUND_0x2e="@+id/tilAddressPostalCode"
            style="@style/BpjstkuTextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
