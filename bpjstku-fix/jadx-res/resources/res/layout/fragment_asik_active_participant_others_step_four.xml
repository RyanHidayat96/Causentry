            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            hint="@string/hint_wife_name"
            NOT_FOUND_0x2a="@+id/tilMaritalStatus"
            NOT_FOUND_0x2d="@+id/tilMaritalStatus"
            NOT_FOUND_0x2e="@+id/tilMaritalStatus"
            style="@style/BpjstkuTextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                imeOptions="0x5"
                style="@style/BpjstkuTextInputEditText"/>
        </com.google.android.material.textfield.TextInputLayout>
