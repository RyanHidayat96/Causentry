<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    background="@color/colorWhite"
    layout_width="-1"
    layout_height="-1">
    <ImageView
        layout_width="-1"
        layout_height="-2"
        src="@drawable/img_background_infoprogram"
        NOT_FOUND_0x16="0"
        NOT_FOUND_0x17="0"
        NOT_FOUND_0x19="0"/>
    <include
        id="@+id/layout_toolbar"
        NOT_FOUND_0x16="0"
        NOT_FOUND_0x17="0"
        NOT_FOUND_0x19="0"
        layout="@layout/layout_toolbar_center"/>
    <com.google.android.material.card.MaterialCardView
        id="@+id/cvWorkAccidentReporting"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        layout_marginLeft="@dimen/dimen_20dp"
        layout_marginTop="@dimen/dimen_34dp"
        layout_marginRight="@dimen/dimen_20dp"
        layout_marginHorizontal="@dimen/dimen_20dp"
        NOT_FOUND_0x11="@color/colorWhite"
        NOT_FOUND_0x12="@dimen/dimen_4dp"
        NOT_FOUND_0x13="@dimen/dimen_4dp"
        NOT_FOUND_0x16="0"
        NOT_FOUND_0x17="0"
        NOT_FOUND_0x18="@+id/layout_toolbar">
        <androidx.constraintlayout.widget.ConstraintLayout
            layout_width="-1"
            layout_height="-2">
            <ImageView
                id="@+id/imgWorkAccident"
                background="@drawable/ic_icon_work_accident"
                layout_width="-2"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_18dp"
                layout_marginStart="@dimen/dimen_26dp"
                NOT_FOUND_0x17="0"
                NOT_FOUND_0x19="0"/>
            <TextView
                textSize="@dimen/text_size_14sp"
                gravity="0x10"
                id="@+id/tvWorkAccidentReporting"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_9dp"
                text="@string/title_work_accident_reporting"
                drawableEnd="@drawable/ic_chevron_right"
                layout_marginEnd="@dimen/dimen_16dp"
                NOT_FOUND_0x14="@color/colorDarkMint"
                NOT_FOUND_0x16="0"
                NOT_FOUND_0x17="@+id/imgWorkAccident"
                NOT_FOUND_0x18="@+id/imgWorkAccident"
                style="@style/BpjstkuTextViewPoppins.CharcoalGrey.SemiBold"/>
            <TextView
                textSize="@dimen/text_size_12sp"
                id="@+id/tvWorkAccidentDescription"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_3dp"
                layout_marginBottom="@dimen/dimen_21dp"
                text="@string/label_announce_accident_reporting"
                NOT_FOUND_0x15="0"
                NOT_FOUND_0x16="@+id/tvWorkAccidentReporting"
                NOT_FOUND_0x17="@+id/tvWorkAccidentReporting"
                NOT_FOUND_0x18="@+id/tvWorkAccidentReporting"
                style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        id="@+id/cvDeathReporting"
        visibility="2"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        layout_marginTop="@dimen/dimen_16dp"
        NOT_FOUND_0x11="@color/colorWhite"
        NOT_FOUND_0x12="@dimen/dimen_4dp"
        NOT_FOUND_0x13="@dimen/dimen_4dp"
        NOT_FOUND_0x16="@+id/cvWorkAccidentReporting"
        NOT_FOUND_0x17="@+id/cvWorkAccidentReporting"
        NOT_FOUND_0x18="@+id/cvWorkAccidentReporting">
        <androidx.constraintlayout.widget.ConstraintLayout
            layout_width="-1"
            layout_height="-2">
            <ImageView
                id="@+id/imgDeath"
                background="@drawable/ic_icon_death"
                layout_width="-2"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_18dp"
                layout_marginStart="@dimen/dimen_26dp"
                NOT_FOUND_0x17="0"
                NOT_FOUND_0x19="0"/>
            <TextView
                gravity="0x10"
                id="@+id/tvDeathReporting"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_9dp"
                text="@string/title_death_reporting"
                drawableEnd="@drawable/ic_chevron_right"
                layout_marginEnd="@dimen/dimen_16dp"
                NOT_FOUND_0x14="@color/colorDarkMint"
                NOT_FOUND_0x16="0"
                NOT_FOUND_0x17="@+id/imgDeath"
                NOT_FOUND_0x18="@+id/imgDeath"
                style="@style/BpjstkuTextViewPoppins.CharcoalGrey.SemiBold"/>
            <TextView
                textSize="@dimen/text_size_12sp"
                id="@+id/tvDeathReportingDescription"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_3dp"
                layout_marginBottom="@dimen/dimen_21dp"
                text="@string/label_announce_death_reporting"
                NOT_FOUND_0x15="0"
                NOT_FOUND_0x16="@+id/tvDeathReporting"
                NOT_FOUND_0x17="@+id/tvDeathReporting"
                NOT_FOUND_0x18="@+id/tvDeathReporting"
                style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
