<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    orientation="1"
    paddingBottom="@dimen/twenty_dp"
    layout_width="-1"
    layout_height="-1"
    layout_marginTop="@dimen/sixteen_dp">
    <com.midtrans.sdk.uikit.widgets.DefaultTextView
        textSize="@dimen/secondary_text_size"
        textColor="@color/black"
        paddingLeft="@dimen/sixteen_dp"
        paddingRight="@dimen/sixteen_dp"
        layout_width="-1"
        layout_height="-2"
        text="@string/danamon_online_description_1"/>
    <com.midtrans.sdk.uikit.widgets.DefaultTextView
        textSize="@dimen/secondary_text_size"
        textColor="@color/black"
        paddingLeft="@dimen/sixteen_dp"
        paddingRight="@dimen/sixteen_dp"
        layout_width="-1"
        layout_height="-2"
        layout_marginTop="@dimen/sixteen_dp"
        text="@string/danamon_online_description_2"/>
    <androidx.appcompat.widget.AppCompatButton
        gravity="0x10"
        id="@+id/instruction_toggle"
        layout_width="-1"
        layout_height="-2"
        layout_marginLeft="@dimen/eight_dp"
        layout_marginTop="@dimen/sixteen_dp"
        layout_marginRight="@dimen/sixteen_dp"
        text="@string/show_instruction"
        style="@style/ButtonSecondaryExpandable"/>
    <LinearLayout
        orientation="1"
        id="@+id/container_instruction"
        visibility="2"
        layout_width="-1"
        layout_height="-2">
        <LinearLayout
            background="@color/light_gray"
            paddingLeft="@dimen/sixteen_dp"
            paddingTop="@dimen/five_dp"
            paddingRight="@dimen/sixteen_dp"
            paddingBottom="@dimen/five_dp"
            layout_width="-1"
            layout_height="-2">
            <com.midtrans.sdk.uikit.widgets.DefaultTextView
                layout_width="@dimen/twenty_four_dp"
                layout_height="-2"
                text="@string/number_instruction1"/>
            <com.midtrans.sdk.uikit.widgets.DefaultTextView
                textSize="@dimen/secondary_text_size"
                textColor="@color/black"
                layout_width="-1"
                layout_height="-2"
                text="@string/danamon_online_instruction_step1"/>
        </LinearLayout>
        <LinearLayout
            paddingLeft="@dimen/sixteen_dp"
            paddingTop="@dimen/five_dp"
            paddingRight="@dimen/sixteen_dp"
            paddingBottom="@dimen/five_dp"
            layout_width="-1"
            layout_height="-2"
            layout_marginTop="@dimen/sixteen_dp">
            <com.midtrans.sdk.uikit.widgets.DefaultTextView
                layout_width="@dimen/twenty_four_dp"
                layout_height="-2"
                text="@string/number_instruction2"/>
            <com.midtrans.sdk.uikit.widgets.DefaultTextView
                textSize="@dimen/secondary_text_size"
                textColor="@color/black"
                layout_width="-1"
                layout_height="-2"
                text="@string/danamon_online_instruction_step2"/>
        </LinearLayout>
        <LinearLayout
            background="@color/light_gray"
            paddingLeft="@dimen/sixteen_dp"
            paddingTop="@dimen/five_dp"
            paddingRight="@dimen/sixteen_dp"
            paddingBottom="@dimen/five_dp"
            layout_width="-1"
            layout_height="-2"
            layout_marginTop="@dimen/sixteen_dp">
            <com.midtrans.sdk.uikit.widgets.DefaultTextView
                layout_width="@dimen/twenty_four_dp"
                layout_height="-2"
                text="@string/number_instruction3"/>
            <com.midtrans.sdk.uikit.widgets.DefaultTextViewWithLink
                textSize="@dimen/secondary_text_size"
                textColor="@color/black"
                background="@color/light_gray"
                layout_width="-1"
                layout_height="-2"
                text="@string/danamon_online_instruction_step3"
                lineSpacingExtra="2dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
