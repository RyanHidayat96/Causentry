<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    layout_width="-1"
    layout_height="-1">
    <include
        id="@+id/layout_toolbar"
        NOT_FOUND_0x13="0"
        NOT_FOUND_0x14="0"
        NOT_FOUND_0x16="0"
        layout="@layout/layout_toolbar_center"/>
    <TextView
        textSize="@dimen/text_size_16sp"
        id="@+id/tvOldDaySecurity"
        layout_marginTop="@dimen/dimen_36dp"
        text="@string/old_day_security"
        layout_marginStart="@dimen/dimen_20dp"
        NOT_FOUND_0x14="0"
        NOT_FOUND_0x15="@+id/layout_toolbar"
        style="@style/BpjstkuTextViewDmSans.CharcoalGrey.Bold"/>
    <TextView
        textSize="@dimen/text_size_16sp"
        id="@+id/tvKpjNumber"
        layout_marginTop="@dimen/dimen_6dp"
        text="@string/old_day_security"
        NOT_FOUND_0x14="@+id/tvOldDaySecurity"
        NOT_FOUND_0x15="@+id/tvOldDaySecurity"
        style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
    <TextView
        textSize="@dimen/text_size_16sp"
        id="@+id/tvClaimCode"
        layout_marginTop="@dimen/dimen_6dp"
        text="@string/old_day_security"
        NOT_FOUND_0x14="@+id/tvKpjNumber"
        NOT_FOUND_0x15="@+id/tvKpjNumber"
        style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
    <androidx.recyclerview.widget.RecyclerView
        id="@+id/rvClaimTrackingTimeline"
        layout_width="@dimen/dimen_0dp"
        layout_height="@dimen/dimen_0dp"
        layout_marginTop="@dimen/dimen_20dp"
        layout_marginBottom="@dimen/dimen_20dp"
        layout_marginVertical="@dimen/dimen_20dp"
        NOT_FOUND_0x12="@+id/btnBack"
        NOT_FOUND_0x13="0"
        NOT_FOUND_0x14="0"
        NOT_FOUND_0x15="@+id/tvClaimCode"/>
    <com.google.android.material.button.MaterialButton
        gravity="0x11"
        id="@+id/btnDownloadEvidenceTransaction"
        paddingTop="@dimen/dimen_8dp"
        paddingBottom="@dimen/dimen_8dp"
        visibility="2"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        layout_marginLeft="@dimen/dimen_20dp"
        layout_marginTop="@dimen/dimen_20dp"
        layout_marginRight="@dimen/dimen_20dp"
        layout_marginBottom="@dimen/dimen_20dp"
        text="@string/label_show_evidence_transfer"
        layout_marginHorizontal="@dimen/dimen_20dp"
        layout_marginVertical="@dimen/dimen_20dp"
        paddingVertical="@dimen/dimen_8dp"
        NOT_FOUND_0x12="@+id/btnBack"
        NOT_FOUND_0x13="0"
        NOT_FOUND_0x14="0"
        style="@style/BpjstkuButton.WhiteText"/>
    <com.google.android.material.button.MaterialButton
        id="@+id/btnBack"
        paddingTop="@dimen/dimen_8dp"
        paddingBottom="@dimen/dimen_8dp"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        layout_marginLeft="@dimen/dimen_20dp"
        layout_marginTop="@dimen/dimen_20dp"
        layout_marginRight="@dimen/dimen_20dp"
        layout_marginBottom="@dimen/dimen_20dp"
        text="@string/action_back"
        layout_marginHorizontal="@dimen/dimen_20dp"
        layout_marginVertical="@dimen/dimen_20dp"
        paddingVertical="@dimen/dimen_8dp"
        NOT_FOUND_0x11="0"
        NOT_FOUND_0x13="0"
        NOT_FOUND_0x14="0"
        style="@style/BpjstkuButton.WhiteText"/>
</androidx.constraintlayout.widget.ConstraintLayout>
