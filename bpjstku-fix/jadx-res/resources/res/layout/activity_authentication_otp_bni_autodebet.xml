<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    layout_width="-1"
    layout_height="-1">
    <include
        id="@+id/layout_toolbar"
        NOT_FOUND_0x15="0"
        NOT_FOUND_0x16="0"
        NOT_FOUND_0x18="0"
        layout="@layout/layout_toolbar_center"/>
    <ImageView
        id="@+id/imgIconDirectDebit"
        layout_width="-1"
        layout_height="@dimen/dimen_50dp"
        layout_marginLeft="@dimen/dimen_20dp"
        layout_marginRight="@dimen/dimen_20dp"
        src="@drawable/ic_bni_46"
        layout_marginHorizontal="@dimen/dimen_20dp"
        NOT_FOUND_0x13="0"
        NOT_FOUND_0x17="@+id/layout_toolbar"
        NOT_FOUND_0x19="0.2"/>
    <TextView
        textSize="@dimen/text_size_18sp"
        id="@+id/tvTitleMobileInstruction"
        layout_width="-2"
        layout_height="-2"
        layout_marginLeft="@dimen/dimen_20dp"
        layout_marginTop="@dimen/dimen_12dp"
        layout_marginRight="@dimen/dimen_20dp"
        text="Mobile Verification"
        layout_marginHorizontal="@dimen/dimen_20dp"
        NOT_FOUND_0x15="0"
        NOT_FOUND_0x16="0"
        NOT_FOUND_0x17="@+id/imgIconDirectDebit"
        style="@style/BpjstkuTextViewPoppins.Black.SemiBold"/>
    <TextView
        textSize="@dimen/text_size_14sp"
        id="@+id/tvDetailInstructionLineFirst"
        layout_width="-2"
        layout_height="-2"
        layout_marginLeft="@dimen/dimen_20dp"
        layout_marginTop="@dimen/dimen_12dp"
        layout_marginRight="@dimen/dimen_20dp"
        text="Silakan masukkan Kode OTP yang terkirim melalui SMS"
        layout_marginHorizontal="@dimen/dimen_20dp"
        NOT_FOUND_0x15="0"
        NOT_FOUND_0x16="0"
        NOT_FOUND_0x17="@+id/tvTitleMobileInstruction"
        style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
    <TextView
        textSize="@dimen/text_size_14sp"
        id="@+id/tvDetailInstructionLineSecond"
        layout_width="-2"
        layout_height="-2"
        layout_marginLeft="@dimen/dimen_20dp"
        layout_marginTop="@dimen/dimen_4dp"
        layout_marginRight="@dimen/dimen_20dp"
        text="pada nomor handphone yang terdaftar 08123456789"
        layout_marginHorizontal="@dimen/dimen_20dp"
        NOT_FOUND_0x15="0"
        NOT_FOUND_0x16="0"
        NOT_FOUND_0x17="@+id/tvDetailInstructionLineFirst"
        style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
    <com.mukesh.OtpView
        textSize="@dimen/text_size_24sp"
        textColor="@color/colorCharcoalGrey"
        id="@+id/otpVerify"
        focusable="true"
        focusableInTouchMode="true"
        layout_marginTop="@dimen/dimen_22dp"
        inputType="0x2002"
        NOT_FOUND_0x11="6"
        NOT_FOUND_0x12="@dimen/dimen_40dp"
        NOT_FOUND_0x15="@+id/tvDetailInstructionLineSecond"
        NOT_FOUND_0x16="@+id/tvDetailInstructionLineSecond"
        NOT_FOUND_0x17="@+id/tvDetailInstructionLineSecond"
        NOT_FOUND_0x1a="@color/colorSilverTwo"
        NOT_FOUND_0x1b="true"
        NOT_FOUND_0x1c="0"
        style="@style/BpjstkuTextViewDmSans.CharcoalGrey.Medium"/>
    <TextView
        textSize="@dimen/text_size_18sp"
        id="@+id/tvResendCode"
        visibility="0"
        layout_width="-2"
        layout_height="-2"
        layout_marginTop="@dimen/dimen_32dp"
        text="@string/label_resend_code"
        NOT_FOUND_0x15="0"
        NOT_FOUND_0x16="0"
        NOT_FOUND_0x17="@+id/otpVerify"
        style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
    <Button
        enabled="false"
        id="@+id/btnVerification"
        layout_width="-1"
        layout_height="-2"
        layout_marginLeft="@dimen/dimen_20dp"
        layout_marginRight="@dimen/dimen_20dp"
        layout_marginBottom="@dimen/dimen_24dp"
        text="@string/action_verification"
        layout_marginHorizontal="@dimen/dimen_20dp"
        NOT_FOUND_0x14="@+id/btnCancel"
        style="@style/BpjstkuButton"/>
    <Button
        id="@+id/btnCancel"
        layout_width="-1"
        layout_height="-2"
        layout_marginLeft="@dimen/dimen_20dp"
        layout_marginRight="@dimen/dimen_20dp"
        layout_marginBottom="@dimen/dimen_24dp"
        text="@string/action_just_cancel"
        layout_marginHorizontal="@dimen/dimen_20dp"
        NOT_FOUND_0x13="0"
        NOT_FOUND_0x17="@+id/tvResendCode"
        NOT_FOUND_0x19="1"
        style="@style/BpjstkuTextButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
