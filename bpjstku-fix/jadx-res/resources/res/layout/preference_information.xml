<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    gravity="0x10"
    paddingRight="?android:attr/scrollbarSize"
    layout_width="-1"
    layout_height="-2"
    minHeight="?android:attr/listPreferredItemHeight"
    paddingEnd="?android:attr/scrollbarSize">
    <RelativeLayout
        layout_width="0dp"
        layout_height="-2"
        layout_marginLeft="16sp"
        layout_marginTop="6sp"
        layout_marginRight="6sp"
        layout_marginBottom="6sp"
        layout_weight="1"
        layout_marginStart="16sp"
        layout_marginEnd="6sp">
        <TextView
            textAppearance="?android:attr/textAppearanceLarge"
            textColor="?android:attr/textColorSecondary"
            id="@android:id/title"
            layout_width="-2"
            layout_height="-2"
            singleLine="true"/>
        <TextView
            textAppearance="?android:attr/textAppearanceSmall"
            textColor="?android:attr/textColorSecondary"
            id="@android:id/summary"
            layout_width="-2"
            layout_height="-2"
            maxLines="2"
            layout_below="@android:id/title"
            layout_alignLeft="@android:id/title"
            layout_alignStart="@android:id/title"/>
    </RelativeLayout>
    <LinearLayout
        gravity="0x10"
        orientation="1"
        id="@android:id/widget_frame"
        layout_width="-2"
        layout_height="-1"/>
</LinearLayout>
