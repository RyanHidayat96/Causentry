<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    background="@drawable/bottom_sheet_background"
    layout_width="-1"
    layout_height="-1">
    <View
        id="@+id/line1"
        background="@color/colorPaleGreyTen"
        layout_width="@dimen/dimen_40dp"
        layout_height="@dimen/dimen_4dp"
        layout_marginTop="@dimen/dimen_16dp"
        NOT_FOUND_0x1b="0"
        NOT_FOUND_0x1c="0"
        NOT_FOUND_0x1e="0"/>
    <TextView
        textSize="@dimen/text_size_18sp"
        gravity="0x11"
        id="@+id/tvTitle"
        layout_width="-1"
        layout_height="-2"
        layout_marginLeft="@dimen/dimen_20dp"
        layout_marginTop="@dimen/dimen_24dp"
        layout_marginRight="@dimen/dimen_20dp"
        text="@string/label_fu_complaint"
        layout_marginHorizontal="@dimen/dimen_20dp"
        NOT_FOUND_0x1d="@+id/line1"
        style="@style/BpjstkuTextViewPoppins.CharcoalGreyFour.SemiBold"/>
    <LinearLayout
        gravity="0x11"
        orientation="0"
        id="@+id/llActivity"
        layout_width="-1"
        layout_height="-2"
        layout_marginLeft="@dimen/dimen_20dp"
        layout_marginTop="@dimen/dimen_20dp"
        layout_marginRight="@dimen/dimen_20dp"
        layout_marginHorizontal="@dimen/dimen_20dp"
        NOT_FOUND_0x1d="@+id/tvTitle">
        <TextView
            textSize="@dimen/text_size_14sp"
            layout_width="0dp"
            layout_height="-2"
            text="@string/label_activity_complaint"
            layout_weight="1"
            style="@style/BpjstkuTextViewPoppins.CoolGrey"/>
        <TextView
            textSize="@dimen/text_size_14sp"
            layout_width="-2"
            layout_height="-2"
            layout_marginStart="@dimen/dimen_5dp"
            layout_marginEnd="@dimen/dimen_5dp"
            style="@style/BpjstkuTextViewPoppins.CharcoalGreyFour.SemiBold"/>
        <TextView
            textSize="@dimen/text_size_14sp"
            id="@+id/tvAktifitas"
            layout_width="0dp"
            layout_height="-2"
            layout_weight="1"
            style="@style/BpjstkuTextViewPoppins.CharcoalGreyFour.SemiBold"/>
    </LinearLayout>
    <View
        id="@+id/line2"
        background="@color/colorPaleGreyFour"
        layout_width="-1"
        layout_height="@dimen/dimen_2dp"
        layout_marginLeft="@dimen/dimen_20dp"
        layout_marginTop="@dimen/dimen_16dp"
        layout_marginRight="@dimen/dimen_20dp"
        layout_marginHorizontal="@dimen/dimen_20dp"
        NOT_FOUND_0x1d="@+id/llActivity"/>
    <LinearLayout
        gravity="0x11"
        orientation="0"
        id="@+id/llStatusKpj"
        layout_width="-1"
        layout_height="-2"
        layout_marginLeft="@dimen/dimen_20dp"
        layout_marginTop="@dimen/dimen_16dp"
        layout_marginRight="@dimen/dimen_20dp"
        layout_marginHorizontal="@dimen/dimen_20dp"
        NOT_FOUND_0x1d="@+id/line2">
        <TextView
            textSize="@dimen/text_size_14sp"
            layout_width="0dp"
            layout_height="-2"
            text="@string/label_status_complaint"
            layout_weight="1"
            style="@style/BpjstkuTextViewPoppins.CoolGrey"/>
        <TextView
            textSize="@dimen/text_size_14sp"
            layout_width="-2"
            layout_height="-2"
            layout_marginStart="@dimen/dimen_5dp"
            layout_marginEnd="@dimen/dimen_5dp"
            style="@style/BpjstkuTextViewPoppins.CharcoalGreyFour.SemiBold"/>
        <TextView
            textSize="@dimen/text_size_14sp"
            id="@+id/tvStatus"
            layout_width="0dp"
            layout_height="-2"
            layout_weight="1"
            style="@style/BpjstkuTextViewPoppins.CharcoalGreyFour.SemiBold"/>
    </LinearLayout>
    <View
        id="@+id/line3"
        background="@color/colorPaleGreyFour"
        layout_width="-1"
        layout_height="@dimen/dimen_2dp"
        layout_marginLeft="@dimen/dimen_20dp"
        layout_marginTop="@dimen/dimen_16dp"
        layout_marginRight="@dimen/dimen_20dp"
        layout_marginHorizontal="@dimen/dimen_20dp"
        NOT_FOUND_0x1d="@+id/llStatusKpj"/>
    <TextView
        textSize="@dimen/text_size_14sp"
        id="@+id/llDesc"
        layout_width="-1"
        layout_height="-2"
        layout_marginLeft="@dimen/dimen_16dp"
        layout_marginTop="@dimen/dimen_16dp"
        layout_marginRight="@dimen/dimen_16dp"
        text="@string/label_desc_complaint"
        layout_marginHorizontal="@dimen/dimen_16dp"
        NOT_FOUND_0x1b="0"
        NOT_FOUND_0x1c="0"
        NOT_FOUND_0x1d="@+id/line3"
        style="@style/BpjstkuTextViewPoppins.CoolGrey"/>
    <TextView
        textSize="@dimen/text_size_14sp"
        id="@+id/tvContentDesc"
        layout_width="-1"
        layout_height="-2"
        layout_marginLeft="@dimen/dimen_16dp"
        layout_marginTop="@dimen/dimen_16dp"
        layout_marginRight="@dimen/dimen_16dp"
        layout_marginHorizontal="@dimen/dimen_16dp"
        NOT_FOUND_0x1b="0"
        NOT_FOUND_0x1c="0"
        NOT_FOUND_0x1d="@+id/llDesc"
        style="@style/BpjstkuTextViewPoppins.CharcoalGreyFour.SemiBold"/>
    <com.google.android.material.button.MaterialButton
        textSize="@dimen/text_size_14sp"
        id="@+id/btnBack"
        paddingLeft="@dimen/dimen_14dp"
        paddingTop="@dimen/dimen_14dp"
        paddingRight="@dimen/dimen_14dp"
        paddingBottom="@dimen/dimen_14dp"
        visibility="0"
        layout_width="-1"
        layout_height="-2"
        layout_marginLeft="@dimen/dimen_16dp"
        layout_marginTop="@dimen/dimen_16dp"
        layout_marginRight="@dimen/dimen_16dp"
        layout_marginBottom="@dimen/dimen_16dp"
        text="@string/action_back"
        textAllCaps="false"
        fontFamily="@font/poppins_semibold"
        layout_marginHorizontal="@dimen/dimen_16dp"
        layout_marginVertical="@dimen/dimen_16dp"
        paddingHorizontal="@dimen/dimen_14dp"
        paddingVertical="@dimen/dimen_14dp"
        NOT_FOUND_0x1a="0"
        NOT_FOUND_0x1b="0"
        NOT_FOUND_0x1c="0"
        NOT_FOUND_0x1d="@+id/tvContentDesc"
        NOT_FOUND_0x1f="1"
        style="@style/BpjstkuButton.WhiteText"/>
</androidx.constraintlayout.widget.ConstraintLayout>
