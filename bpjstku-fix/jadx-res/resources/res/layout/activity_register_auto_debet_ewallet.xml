<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    layout_width="-1"
    layout_height="-1">
    <include
        id="@+id/layout_toolbar"
        layout="@layout/layout_toolbar_center"/>
    <RelativeLayout
        id="@+id/containerTitleInputPhoneNumber"
        layout_width="-1"
        layout_height="-2"
        layout_marginLeft="@dimen/dimen_20dp"
        layout_marginRight="@dimen/dimen_20dp"
        layout_marginHorizontal="@dimen/dimen_20dp"
        NOT_FOUND_0x26="0"
        NOT_FOUND_0x29="@+id/layout_toolbar"
        NOT_FOUND_0x2a="0.12">
        <TextView
            textSize="@dimen/text_size_18sp"
            textColor="@android:color/black"
            gravity="0x10"
            id="@+id/tvPaymentMethod"
            layout_width="-2"
            layout_height="-2"
            text="Aktivasi E-Wallet"
            layout_alignParentLeft="true"
            layout_centerVertical="true"
            style="@style/BpjstkuTextViewPoppins.Black.SemiBold"/>
        <ImageView
            layout_gravity="0x11"
            id="@+id/imgLogo"
            paddingLeft="@dimen/dimen_12dp"
            paddingRight="@dimen/dimen_12dp"
            visibility="2"
            layout_width="@dimen/dimen_80dp"
            layout_height="@dimen/dimen_40dp"
            layout_toRightOf="@+id/tvPaymentMethod"
            layout_centerVertical="true"
            NOT_FOUND_0x2b="0x7f08023f"/>
    </RelativeLayout>
    <TextView
        id="@+id/tvEnterPhoneNumberInstruction"
        padding="@dimen/dimen_4dp"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        layout_marginTop="@dimen/dimen_8dp"
        text="Silakan masukkan nomor handphone akun ewallet anda untuk proses pendaftaran auto debit"
        letterSpacing="0.02"
        NOT_FOUND_0x27="@+id/containerTitleInputPhoneNumber"
        NOT_FOUND_0x28="@+id/containerTitleInputPhoneNumber"
        NOT_FOUND_0x29="@+id/containerTitleInputPhoneNumber"
        style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
    <com.google.android.material.card.MaterialCardView
        id="@+id/cvPhoneNumber"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        layout_marginTop="@dimen/dimen_14dp"
        NOT_FOUND_0x23="@color/colorWhite"
        NOT_FOUND_0x24="@dimen/dimen_4dp"
        NOT_FOUND_0x25="@dimen/dimen_0dp"
        NOT_FOUND_0x27="@+id/tvEnterPhoneNumberInstruction"
        NOT_FOUND_0x28="@+id/tvEnterPhoneNumberInstruction"
        NOT_FOUND_0x29="@+id/tvEnterPhoneNumberInstruction"
        NOT_FOUND_0x2a="0"
        NOT_FOUND_0x2c="@color/colorPaleGrey"
        NOT_FOUND_0x2d="@dimen/dimen_1dp">
        <RelativeLayout
            layout_width="-1"
            layout_height="-2">
            <TextView
                textSize="@dimen/text_size_16sp"
                id="@+id/tvPrefix"
                background="@color/colorPaleGreyFour"
                padding="@dimen/dimen_20dp"
                layout_width="-2"
                layout_height="-2"
                text="@string/label_prefix_indonesia_phone"
                style="@style/BpjstkuTextViewDmSans.CharcoalGrey.Bold"/>
            <EditText
                id="@+id/edtPhoneNumber"
                background="@null"
                layout_width="-1"
                layout_height="-2"
                hint=""
                maxLines="1"
                lines="1"
                maxLength="14"
                digits="0123456789"
                layout_alignTop="@+id/tvPrefix"
                layout_alignBottom="@+id/tvPrefix"
                inputType="0x3"
                imeOptions="0x6"
                paddingStart="@dimen/dimen_18dp"
                paddingEnd="8dp"
                layout_toEndOf="@+id/tvPrefix"
                importantForAutofill="0x2"
                style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>
    <Button
        id="@+id/btnNext"
        padding="@dimen/dimen_14dp"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        layout_marginLeft="@dimen/dimen_20dp"
        layout_marginRight="@dimen/dimen_20dp"
        layout_marginBottom="@dimen/dimen_18dp"
        text="@string/action_next"
        layout_marginHorizontal="@dimen/dimen_20dp"
        NOT_FOUND_0x26="0"
        NOT_FOUND_0x27="0"
        NOT_FOUND_0x28="0"
        NOT_FOUND_0x29="@+id/edtPhoneNumber"
        NOT_FOUND_0x2a="1"
        style="@style/BpjstkuButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
