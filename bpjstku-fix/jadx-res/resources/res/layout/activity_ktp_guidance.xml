<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    background="@color/colorWhite"
    fitsSystemWindows="true"
    layout_width="-1"
    layout_height="-1">
    <androidx.appcompat.widget.Toolbar
        id="@+id/toolbar"
        background="@color/colorWhite"
        layout_width="@dimen/dimen_0dp"
        layout_height="?attr/actionBarSize"
        elevation="@dimen/dimen_0dp"
        NOT_FOUND_0x1e="0"
        NOT_FOUND_0x1f="0"
        NOT_FOUND_0x21="0"
        NOT_FOUND_0x22="@drawable/ic_back_toolbar"
        NOT_FOUND_0x23="@style/BpjstkuTextViewDmSans.CharcoalGrey.Bold"/>
    <ScrollView
        id="@+id/scrollGuidance"
        layout_width="@dimen/dimen_0dp"
        layout_height="@dimen/dimen_0dp"
        fillViewport="true"
        NOT_FOUND_0x1d="@+id/btnMulaiFoto"
        NOT_FOUND_0x1e="0"
        NOT_FOUND_0x1f="0"
        NOT_FOUND_0x20="@+id/toolbar">
        <LinearLayout
            orientation="1"
            paddingBottom="@dimen/dimen_16dp"
            layout_width="-1"
            layout_height="-2">
            <androidx.appcompat.widget.AppCompatTextView
                textSize="@dimen/text_size_24sp"
                layout_width="-1"
                layout_marginLeft="@dimen/dimen_20dp"
                layout_marginTop="@dimen/dimen_48dp"
                layout_marginRight="@dimen/dimen_20dp"
                text="@string/label_panduan_foto_ktp"
                textAlignment="4"
                layout_marginHorizontal="@dimen/dimen_20dp"
                style="@style/BpjstkuTextViewDmSans.Black.Bold"/>
            <LinearLayout
                orientation="1"
                background="@drawable/bg_rounded_grey_chip"
                paddingLeft="@dimen/dimen_16dp"
                paddingTop="@dimen/dimen_16dp"
                paddingRight="@dimen/dimen_16dp"
                paddingBottom="@dimen/dimen_20dp"
                layout_width="-1"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_20dp"
                layout_marginTop="@dimen/dimen_48dp"
                layout_marginRight="@dimen/dimen_20dp"
                layout_marginStart="@dimen/dimen_30dp"
                layout_marginEnd="@dimen/dimen_30dp"
                layout_marginHorizontal="@dimen/dimen_20dp"
                paddingHorizontal="@dimen/dimen_16dp">
                <LinearLayout
                    gravity="0x11"
                    orientation="0"
                    layout_width="-1"
                    layout_height="-2"
                    layout_marginTop="@dimen/dimen_16dp">
                    <LinearLayout
                        gravity="right"
                        orientation="1"
                        layout_width="0dp"
                        layout_height="-2"
                        layout_weight="1">
                        <androidx.appcompat.widget.AppCompatImageView
                            layout_width="120dp"
                            layout_height="140dp"
                            src="@drawable/ktp_correct"
                            scaleType="fillCenter"/>
                        <LinearLayout
                            gravity="0x10"
                            orientation="0"
                            layout_width="-2"
                            layout_height="-2"
                            layout_marginTop="@dimen/dimen_8dp">
                            <ImageView
                                layout_width="@dimen/dimen_14dp"
                                layout_height="@dimen/dimen_14dp"
                                src="@drawable/ic_checklist_new"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                textSize="@dimen/text_size_13sp"
                                text="@string/label_benar"
                                layout_marginStart="@dimen/dimen_6dp"
                                style="@style/BpjstkuTextViewDmSans.DarkMint.Bold"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        gravity="right"
                        orientation="1"
                        layout_width="0dp"
                        layout_height="-2"
                        layout_weight="1">
                        <androidx.appcompat.widget.AppCompatImageView
                            layout_width="@dimen/dimen_120dp"
                            layout_height="@dimen/dimen_140dp"
                            src="@drawable/ktp_wrong"
                            scaleType="fillCenter"/>
                        <LinearLayout
                            gravity="0x10"
                            orientation="0"
                            layout_width="-2"
                            layout_height="-2"
                            layout_marginTop="@dimen/dimen_8dp">
                            <ImageView
                                layout_width="@dimen/dimen_14dp"
                                layout_height="@dimen/dimen_14dp"
                                src="@drawable/ic_cross_red_circle"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                textSize="@dimen/text_size_13sp"
                                text="@string/label_salah"
                                layout_marginStart="@dimen/dimen_6dp"
                                style="@style/BpjstkuTextViewDmSans.Reddish"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <View
                    background="@color/colorPaleGreyTwelve"
                    layout_width="-1"
                    layout_height="@dimen/dimen_1dp"
                    layout_marginTop="@dimen/dimen_16dp"/>
                <LinearLayout
                    gravity="0x10"
                    orientation="0"
                    layout_width="-1"
                    layout_height="-2"
                    layout_marginTop="@dimen/dimen_10dp">
                    <ImageView
                        layout_width="@dimen/dimen_24dp"
                        layout_height="@dimen/dimen_24dp"
                        src="@drawable/rename"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        textSize="@dimen/text_size_14sp"
                        text="@string/label_ktp_do_1"
                        layout_marginStart="@dimen/dimen_10dp"
                        style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
                </LinearLayout>
                <LinearLayout
                    gravity="0x10"
                    orientation="0"
                    layout_width="-1"
                    layout_height="-2"
                    layout_marginTop="@dimen/dimen_16dp">
                    <ImageView
                        layout_width="@dimen/dimen_24dp"
                        layout_height="@dimen/dimen_24dp"
                        src="@drawable/business_and_finance"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        textSize="@dimen/text_size_14sp"
                        text="@string/label_ktp_do_2"
                        layout_marginStart="@dimen/dimen_10dp"
                        style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
                </LinearLayout>
                <LinearLayout
                    gravity="0x10"
                    orientation="0"
                    layout_width="-1"
                    layout_height="-2"
                    layout_marginTop="@dimen/dimen_16dp">
                    <ImageView
                        layout_width="@dimen/dimen_24dp"
                        layout_height="@dimen/dimen_24dp"
                        src="@drawable/abstract_shape"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        textSize="@dimen/text_size_14sp"
                        text="@string/label_ktp_do_3"
                        layout_marginStart="@dimen/dimen_10dp"
                        style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
                </LinearLayout>
                <View
                    background="@color/colorPaleGreyTwelve"
                    layout_width="-1"
                    layout_height="@dimen/dimen_1dp"
                    layout_marginTop="@dimen/dimen_16dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <com.google.android.material.button.MaterialButton
        id="@+id/btnMulaiFoto"
        paddingTop="@dimen/dimen_14dp"
        paddingBottom="@dimen/dimen_14dp"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        layout_marginLeft="@dimen/dimen_20dp"
        layout_marginRight="@dimen/dimen_20dp"
        layout_marginBottom="@dimen/dimen_24dp"
        text="@string/label_mulai_foto"
        layout_marginHorizontal="@dimen/dimen_20dp"
        paddingVertical="@dimen/dimen_14dp"
        NOT_FOUND_0x1c="0"
        NOT_FOUND_0x1e="0"
        NOT_FOUND_0x1f="0"
        style="@style/BpjstkuButton.WhiteText"/>
</androidx.constraintlayout.widget.ConstraintLayout>
