<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    layout_gravity="0x11"
    orientation="1"
    id="@+id/autocomplete_message_container"
    layout_width="-1"
    layout_height="-2">
    <TextView
        textAppearance="@style/TextAppearance.Gmp.Sys.Typescale.BodyMedium"
        textColor="?attr/placesColorOnSurface"
        id="@+id/autocomplete_message_text_view"
        paddingTop="@dimen/gmp_sys_measurement_spacing_medium"
        paddingBottom="@dimen/gmp_sys_measurement_spacing_medium"
        focusable="true"
        layout_width="-1"
        layout_height="0dp"
        text="@string/autocomplete_no_matching_results_for_query"
        layout_weight="1"
        paddingStart="@dimen/gmp_sys_measurement_spacing_large"
        paddingEnd="@dimen/gmp_sys_measurement_spacing_large"/>
    <View
        background="?attr/placesColorOutlineDecorative"
        layout_width="-1"
        layout_height="@dimen/place_widget_border_width"/>
</LinearLayout>
