<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    layout_width="-1"
    layout_height="-1"
    fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        id="@+id/mainContainer"
        background="@color/colorWhite"
        focusable="true"
        focusableInTouchMode="true"
        layout_width="-1"
        layout_height="-2">
        <com.airbnb.lottie.LottieAnimationView
            id="@+id/animationView"
            layout_width="@dimen/dimen_0dp"
            layout_height="@dimen/dimen_48dp"
            NOT_FOUND_0x1d="0"
            NOT_FOUND_0x1f="1:1"
            NOT_FOUND_0x21="0"
            NOT_FOUND_0x22="0"
            NOT_FOUND_0x25="0"
            NOT_FOUND_0x26="0.08"
            NOT_FOUND_0x27="0.25"
            NOT_FOUND_0x29="true"
            NOT_FOUND_0x2a="true"
            NOT_FOUND_0x2b="@raw/successrecurring"/>
        <TextView
            textSize="@dimen/text_size_24sp"
            id="@+id/tvInfoPayment"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_18dp"
            text="Pembayaran Berhasil"
            NOT_FOUND_0x20="0"
            NOT_FOUND_0x23="0"
            NOT_FOUND_0x24="@+id/animationView"
            style="@style/BpjstkuTextViewPoppins.Black.SemiBold"/>
        <TextView
            textSize="@dimen/text_size_12sp"
            textStyle="0x2"
            id="@+id/tvDatePayment"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_4dp"
            NOT_FOUND_0x20="0"
            NOT_FOUND_0x23="0"
            NOT_FOUND_0x24="@+id/tvInfoPayment"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        <View
            id="@+id/viewLineDetailPayment"
            background="@color/colorPaleGrey"
            layout_width="-1"
            layout_height="@dimen/dimen_12dp"
            layout_marginTop="@dimen/dimen_32dp"
            NOT_FOUND_0x24="@+id/tvDatePayment"
            NOT_FOUND_0x28="@dimen/dimen_24dp"/>
        <TextView
            textSize="@dimen/text_size_18sp"
            id="@+id/tvTitleInfoPayment"
            layout_width="-1"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_20dp"
            layout_marginTop="@dimen/dimen_18dp"
            layout_marginRight="@dimen/dimen_20dp"
            text="Informasi Pembayaran"
            layout_marginHorizontal="@dimen/dimen_20dp"
            NOT_FOUND_0x24="@+id/viewLineDetailPayment"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey.Bold"/>
        <TextView
            textSize="@dimen/text_size_14sp"
            id="@+id/tvInfoNikPaid"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_18dp"
            text="NIK"
            layout_marginStart="@dimen/dimen_20dp"
            NOT_FOUND_0x23="0"
            NOT_FOUND_0x24="@+id/tvTitleInfoPayment"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        <TextView
            textSize="@dimen/text_size_14sp"
            id="@+id/tvInfoValueNikPaid"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_18dp"
            text="-"
            layout_marginEnd="@dimen/dimen_20dp"
            NOT_FOUND_0x20="0"
            NOT_FOUND_0x24="@+id/tvTitleInfoPayment"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        <TextView
            textSize="@dimen/text_size_14sp"
            id="@+id/tvInfoName"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_18dp"
            text="Nama"
            layout_marginStart="@dimen/dimen_20dp"
            NOT_FOUND_0x23="0"
            NOT_FOUND_0x24="@+id/tvInfoValueNikPaid"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        <TextView
            textSize="@dimen/text_size_14sp"
            id="@+id/tvInfoNameValue"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_18dp"
            text="-"
            layout_marginEnd="@dimen/dimen_20dp"
            NOT_FOUND_0x20="0"
            NOT_FOUND_0x24="@+id/tvInfoValueNikPaid"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        <TextView
            textSize="@dimen/text_size_14sp"
            id="@+id/tvInfoProgramPaid"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_18dp"
            text="Program Layanan"
            layout_marginStart="@dimen/dimen_20dp"
            NOT_FOUND_0x23="0"
            NOT_FOUND_0x24="@+id/tvInfoName"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        <TextView
            textSize="@dimen/text_size_14sp"
            id="@+id/tvInfoValueProgramPaid"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_18dp"
            text="-"
            layout_marginEnd="@dimen/dimen_20dp"
            NOT_FOUND_0x20="0"
            NOT_FOUND_0x24="@+id/tvInfoName"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        <TextView
            textSize="@dimen/text_size_14sp"
            id="@+id/tvInfoPeriods"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_18dp"
            text="Lama Perlindungan"
            layout_marginStart="@dimen/dimen_20dp"
            NOT_FOUND_0x23="0"
            NOT_FOUND_0x24="@+id/tvInfoProgramPaid"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        <TextView
            textSize="@dimen/text_size_14sp"
            id="@+id/tvValueInfoPeriods"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_18dp"
            text="-"
            layout_marginStart="@dimen/dimen_20dp"
            layout_marginEnd="@dimen/dimen_20dp"
            NOT_FOUND_0x20="0"
            NOT_FOUND_0x24="@+id/tvInfoProgramPaid"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        <LinearLayout
            orientation="0"
            id="@+id/llMethodPayment"
            paddingTop="@dimen/dimen_18dp"
            paddingBottom="@dimen/dimen_18dp"
            visibility="2"
            layout_width="-1"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_20dp"
            layout_marginRight="@dimen/dimen_20dp"
            animateLayoutChanges="true"
            layout_marginHorizontal="@dimen/dimen_20dp"
            paddingVertical="@dimen/dimen_18dp"
            NOT_FOUND_0x20="0"
            NOT_FOUND_0x23="0"
            NOT_FOUND_0x24="@+id/tvValueInfoPeriods">
            <RelativeLayout
                orientation="0"
                layout_width="-1"
                layout_height="-2">
                <TextView
                    textSize="@dimen/text_size_14sp"
                    textColor="@android:color/black"
                    gravity="0x10"
                    id="@+id/tvPaymentMethod"
                    layout_width="-2"
                    layout_height="-2"
                    text="Kanal Pembayaran"
                    layout_centerVertical="true"
                    style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
                <ImageView
                    layout_gravity="0x11"
                    id="@+id/imgCategoryPayment"
                    layout_width="@dimen/dimen_60dp"
                    layout_height="@dimen/dimen_25dp"
                    src="@drawable/bg_logo_ovo"
                    layout_centerVertical="true"
                    layout_alignParentEnd="true"/>
            </RelativeLayout>
        </LinearLayout>
        <View
            id="@+id/viewLineInfo"
            background="@color/colorPaleGrey"
            layout_width="-1"
            layout_height="@dimen/dimen_12dp"
            layout_marginTop="@dimen/dimen_32dp"
            NOT_FOUND_0x24="@+id/tvValueInfoPeriods"
            NOT_FOUND_0x28="@dimen/dimen_24dp"/>
        <TextView
            textSize="@dimen/text_size_18sp"
            id="@+id/tvTitleDetailPayment"
            layout_width="-1"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_20dp"
            layout_marginTop="@dimen/dimen_18dp"
            layout_marginRight="@dimen/dimen_20dp"
            text="Detail Pembayaran"
            layout_marginHorizontal="@dimen/dimen_20dp"
            NOT_FOUND_0x24="@+id/viewLineInfo"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey.Bold"/>
        <TextView
            textSize="@dimen/text_size_14sp"
            id="@+id/tvTitleInfoAmount"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_18dp"
            text="Tagihan"
            layout_marginStart="@dimen/dimen_20dp"
            NOT_FOUND_0x23="0"
            NOT_FOUND_0x24="@+id/tvTitleDetailPayment"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        <TextView
            textSize="@dimen/text_size_14sp"
            id="@+id/tvValueAmount"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_18dp"
            text="-"
            layout_marginEnd="@dimen/dimen_20dp"
            NOT_FOUND_0x20="0"
            NOT_FOUND_0x24="@+id/tvTitleDetailPayment"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        <TextView
            textSize="@dimen/text_size_14sp"
            id="@+id/tvTitleFeeMitra"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_18dp"
            text="Biaya Layanan Mitra"
            layout_marginStart="@dimen/dimen_20dp"
            NOT_FOUND_0x23="0"
            NOT_FOUND_0x24="@+id/tvTitleInfoAmount"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        <TextView
            textSize="@dimen/text_size_14sp"
            id="@+id/tvValueFeeMitra"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_18dp"
            text="-"
            layout_marginEnd="@dimen/dimen_20dp"
            NOT_FOUND_0x20="0"
            NOT_FOUND_0x24="@+id/tvValueAmount"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        <View
            id="@+id/viewLineTotalPayment"
            background="@color/colorPaleGrey"
            layout_width="-1"
            layout_height="@dimen/dimen_1dp"
            layout_marginTop="@dimen/dimen_18dp"
            NOT_FOUND_0x24="@+id/tvValueFeeMitra"
            NOT_FOUND_0x28="@dimen/dimen_24dp"/>
        <TextView
            textSize="@dimen/text_size_14sp"
            id="@+id/tvTotalPaid"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_18dp"
            text="Total Bayar"
            layout_marginStart="@dimen/dimen_20dp"
            NOT_FOUND_0x23="0"
            NOT_FOUND_0x24="@+id/viewLineTotalPayment"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey.Bold"/>
        <TextView
            textSize="@dimen/text_size_14sp"
            id="@+id/tvValueTotalPaid"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_18dp"
            text="-"
            layout_marginEnd="@dimen/dimen_20dp"
            NOT_FOUND_0x20="0"
            NOT_FOUND_0x24="@+id/viewLineTotalPayment"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey.Bold"/>
        <Button
            id="@+id/btnRegisterAutoDebit"
            paddingTop="@dimen/dimen_12dp"
            paddingBottom="@dimen/dimen_12dp"
            visibility="0"
            layout_width="-1"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_20dp"
            layout_marginTop="@dimen/dimen_40dp"
            layout_marginRight="@dimen/dimen_20dp"
            text="Daftar AutoDebit"
            layout_marginHorizontal="@dimen/dimen_20dp"
            paddingVertical="@dimen/dimen_12dp"
            NOT_FOUND_0x1e="@+id/btnback"
            NOT_FOUND_0x24="@+id/tvValueTotalPaid"
            style="@style/BpjstkuButton"/>
        <Button
            id="@+id/btnback"
            paddingTop="@dimen/dimen_12dp"
            paddingBottom="@dimen/dimen_12dp"
            layout_width="-1"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_20dp"
            layout_marginTop="@dimen/dimen_20dp"
            layout_marginRight="@dimen/dimen_20dp"
            layout_marginBottom="@dimen/dimen_28dp"
            text="Kembali"
            layout_marginHorizontal="@dimen/dimen_20dp"
            paddingVertical="@dimen/dimen_12dp"
            NOT_FOUND_0x1d="0"
            NOT_FOUND_0x24="@+id/tvValueTotalPaid"
            NOT_FOUND_0x26="1"
            style="@style/BpjstkuTextButton"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
