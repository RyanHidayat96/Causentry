<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    layout_width="-1"
    layout_height="-2">
    <androidx.constraintlayout.widget.ConstraintLayout
        focusable="true"
        focusableInTouchMode="true"
        layout_width="-1"
        layout_height="-2"
        layout_marginBottom="@dimen/dimen_19dp">
        <include
            id="@+id/layout_toolbar"
            layout="@layout/layout_toolbar_center"/>
        <com.google.android.material.card.MaterialCardView
            id="@+id/cvSelfieInfo"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_18dp"
            layout_marginStart="@dimen/dimen_20dp"
            layout_marginEnd="@dimen/dimen_20dp"
            NOT_FOUND_0x15="@color/colorWhite"
            NOT_FOUND_0x16="@dimen/dimen_4dp"
            NOT_FOUND_0x17="@dimen/dimen_0dp"
            NOT_FOUND_0x1a="0"
            NOT_FOUND_0x1c="0"
            NOT_FOUND_0x1d="@+id/toolbar"
            NOT_FOUND_0x21="@color/colorPaleGreyTwelve"
            NOT_FOUND_0x22="@dimen/dimen_1dp">
            <androidx.appcompat.widget.AppCompatImageView
                id="@+id/ivInformation"
                layout_width="-2"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_13dp"
                src="@drawable/ic_information_yellow"
                layout_marginStart="@dimen/dimen_14dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                textSize="@dimen/text_size_12sp"
                id="@+id/tvTitleInformation"
                layout_width="200dp"
                layout_marginTop="@dimen/dimen_13dp"
                text="@string/label_selfie_instruction"
                layout_marginStart="@dimen/dimen_57dp"
                style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
            <androidx.appcompat.widget.AppCompatTextView
                textSize="@dimen/text_size_12sp"
                layout_width="353dp"
                layout_marginTop="@dimen/dimen_50dp"
                layout_marginBottom="@dimen/dimen_15dp"
                text="@string/label_selfie_instruction_information"
                layout_marginStart="@dimen/dimen_14dp"
                style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        </com.google.android.material.card.MaterialCardView>
        <androidx.appcompat.widget.AppCompatTextView
            textSize="@dimen/text_size_12sp"
            id="@+id/tvTitleInformation1"
            layout_width="-1"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_20dp"
            layout_marginTop="@dimen/dimen_20dp"
            layout_marginRight="@dimen/dimen_20dp"
            text="@string/label_selfie_instruction_information_add"
            layout_marginHorizontal="@dimen/dimen_20dp"
            NOT_FOUND_0x1d="@+id/cvSelfieInfo"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        <androidx.appcompat.widget.AppCompatImageView
            id="@+id/imgLivenessCheck2"
            layout_width="@dimen/dimen_170dp"
            layout_height="@dimen/dimen_110dp"
            layout_marginTop="@dimen/dimen_5dp"
            layout_marginBottom="@dimen/dimen_15dp"
            src="@drawable/photo_biometric_side_cropped"
            scaleType="fillCenter"
            layout_marginStart="@dimen/dimen_20dp"
            NOT_FOUND_0x1c="0"
            NOT_FOUND_0x1d="@+id/tvTitleInformation1"/>
        <androidx.appcompat.widget.AppCompatImageView
            id="@+id/imgLivenessCheck3"
            layout_width="@dimen/dimen_110dp"
            layout_height="@dimen/dimen_110dp"
            layout_marginTop="@dimen/dimen_5dp"
            layout_marginBottom="@dimen/dimen_15dp"
            src="@drawable/photo_biometric_front_cropped"
            layout_marginStart="@dimen/dimen_20dp"
            NOT_FOUND_0x1b="@+id/imgLivenessCheck2"
            NOT_FOUND_0x1d="@+id/tvTitleInformation1"/>
        <TextView
            textSize="@dimen/text_size_16sp"
            id="@+id/tvLivenessCheck"
            layout_marginTop="@dimen/dimen_20dp"
            text="@string/label_biometrik_verification_photo"
            NOT_FOUND_0x1c="@+id/imgLivenessCheck2"
            NOT_FOUND_0x1d="@+id/imgLivenessCheck2"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey.Bold"/>
        <androidx.cardview.widget.CardView
            id="@+id/cvLivenessCheck"
            layout_width="@dimen/dimen_0dp"
            layout_height="@dimen/dimen_100dp"
            layout_marginTop="@dimen/dimen_16dp"
            layout_marginBottom="@dimen/dimen_24dp"
            NOT_FOUND_0x15="@color/colorWhite"
            NOT_FOUND_0x16="@dimen/dimen_4dp"
            NOT_FOUND_0x17="@dimen/dimen_0dp"
            NOT_FOUND_0x19="@+id/btnNext"
            NOT_FOUND_0x1c="@+id/tvLivenessCheck"
            NOT_FOUND_0x1d="@+id/tvLivenessCheck"
            NOT_FOUND_0x1f="0"
            NOT_FOUND_0x20="0.42">
            <ImageView
                id="@+id/imgSelfiePhoto"
                visibility="2"
                layout_width="-2"
                layout_height="@dimen/dimen_100dp"
                src="@drawable/ic_ktp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                background="@drawable/selector_bordered_grey_blue"
                layout_width="-1"
                layout_height="-1">
                <ImageView
                    id="@+id/imgLivenessCheck"
                    layout_width="@dimen/dimen_20dp"
                    layout_height="@dimen/dimen_20dp"
                    src="@drawable/ic_camera"
                    NOT_FOUND_0x18="0"
                    NOT_FOUND_0x1a="0"
                    NOT_FOUND_0x1c="0"
                    NOT_FOUND_0x1e="0"
                    NOT_FOUND_0x1f="0.4"/>
                <TextView
                    textSize="@dimen/text_size_12sp"
                    id="@+id/tvLivenessCheckLabel"
                    text="@string/action_get_photo"
                    NOT_FOUND_0x1a="0"
                    NOT_FOUND_0x1c="0"
                    NOT_FOUND_0x1d="@+id/imgLivenessCheck"
                    style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <com.google.android.material.button.MaterialButton
            id="@+id/btnNext"
            paddingTop="@dimen/dimen_14dp"
            paddingBottom="@dimen/dimen_14dp"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_20dp"
            layout_marginRight="@dimen/dimen_20dp"
            layout_marginBottom="@dimen/dimen_22dp"
            text="@string/action_next"
            layout_marginHorizontal="@dimen/dimen_20dp"
            paddingVertical="@dimen/dimen_14dp"
            NOT_FOUND_0x18="0"
            NOT_FOUND_0x1a="0"
            NOT_FOUND_0x1c="0"
            style="@style/BpjstkuButton.WhiteText"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
