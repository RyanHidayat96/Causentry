<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    layout_width="-1"
    layout_height="-1">
    <include
        id="@+id/layout_toolbar"
        layout="@layout/layout_toolbar"/>
    <com.kennyc.view.MultiStateView
        layout_width="@dimen/dimen_0dp"
        layout_height="@dimen/dimen_0dp"
        layout_marginTop="@dimen/dimen_20dp"
        NOT_FOUND_0x10="@+id/btnSaveEakad"
        NOT_FOUND_0x11="0"
        NOT_FOUND_0x12="0"
        NOT_FOUND_0x13="@+id/layout_toolbar"
        NOT_FOUND_0x14="@layout/default_error_layout"
        NOT_FOUND_0x15="@layout/default_error_layout"
        NOT_FOUND_0x16="@layout/default_loading_layout">
        <com.github.chrisbanes.photoview.PhotoView
            id="@+id/idPdfView"
            layout_width="-1"
            layout_height="-1"
            scaleType="fitStart"
            contentDescription="PDF Content"/>
    </com.kennyc.view.MultiStateView>
    <com.google.android.material.button.MaterialButton
        id="@+id/btnSaveEakad"
        paddingTop="@dimen/dimen_14dp"
        paddingBottom="@dimen/dimen_14dp"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        layout_marginLeft="@dimen/dimen_20dp"
        layout_marginTop="@dimen/dimen_20dp"
        layout_marginRight="@dimen/dimen_20dp"
        layout_marginBottom="@dimen/dimen_20dp"
        text="@string/action_save"
        layout_marginHorizontal="@dimen/dimen_20dp"
        layout_marginVertical="@dimen/dimen_20dp"
        paddingVertical="@dimen/dimen_14dp"
        NOT_FOUND_0xf="0"
        NOT_FOUND_0x11="0"
        NOT_FOUND_0x12="0"
        style="@style/BpjstkuButton.WhiteText"/>
</androidx.constraintlayout.widget.ConstraintLayout>
