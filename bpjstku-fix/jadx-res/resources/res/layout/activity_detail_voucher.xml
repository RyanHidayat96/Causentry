<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    layout_width="-1"
    layout_height="-1">
    <include
        id="@+id/layout_toolbar"
        layout_width="-1"
        layout_height="-2"
        layout_alignParentTop="true"
        layout_alignParentStart="true"
        layout_alignParentEnd="true"
        layout="@layout/layout_toolbar_center"/>
    <ScrollView
        layout_width="-1"
        layout_height="-1"
        fillViewport="true"
        layout_below="@+id/layout_toolbar"
        layout_alignParentBottom="true"
        overScrollMode="2"
        layout_alignParentStart="true"
        layout_alignParentEnd="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            layout_width="-1"
            layout_height="-2">
            <TextView
                textSize="@dimen/text_size_18sp"
                id="@+id/tvTitleVoucher"
                layout_width="-1"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_20dp"
                layout_marginTop="@dimen/dimen_20dp"
                layout_marginRight="@dimen/dimen_20dp"
                text="Gratis 1 Bulan Berlangganan Vision+ Premium"
                layout_marginHorizontal="@dimen/dimen_20dp"
                NOT_FOUND_0x21="0"
                NOT_FOUND_0x23="0"
                NOT_FOUND_0x25="0"
                style="@style/BpjstkuTextViewPoppins.CharcoalGrey.SemiBold"/>
            <ImageView
                id="@+id/imgVoucherBanner"
                background="@drawable/ic_placeholder_wide"
                layout_width="@dimen/dimen_0dp"
                layout_height="@dimen/dimen_0dp"
                layout_marginLeft="@dimen/dimen_20dp"
                layout_marginTop="10dp"
                layout_marginRight="@dimen/dimen_20dp"
                scaleType="6"
                layout_marginHorizontal="@dimen/dimen_20dp"
                NOT_FOUND_0x20="3:1"
                NOT_FOUND_0x21="0"
                NOT_FOUND_0x23="0"
                NOT_FOUND_0x24="@+id/tvTitleVoucher"/>
            <TextView
                textSize="@dimen/text_size_12sp"
                id="@+id/tvDescVoucher"
                layout_width="-1"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_20dp"
                layout_marginTop="@dimen/dimen_10dp"
                layout_marginRight="@dimen/dimen_20dp"
                text="@string/info_vision_plus"
                layout_marginHorizontal="@dimen/dimen_20dp"
                NOT_FOUND_0x21="0"
                NOT_FOUND_0x23="0"
                NOT_FOUND_0x24="@+id/imgVoucherBanner"
                style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
            <TextView
                textSize="@dimen/text_size_12sp"
                id="@+id/tvReedemStep"
                layout_width="-1"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_20dp"
                layout_marginTop="@dimen/dimen_20dp"
                layout_marginRight="@dimen/dimen_20dp"
                text="@string/step_reedem_voucher"
                layout_marginHorizontal="@dimen/dimen_20dp"
                NOT_FOUND_0x21="0"
                NOT_FOUND_0x23="0"
                NOT_FOUND_0x24="@+id/tvDescVoucher"
                style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
            <LinearLayout
                orientation="1"
                layout_width="-1"
                layout_height="-2"
                layout_marginLeft="@dimen/dimen_20dp"
                layout_marginRight="@dimen/dimen_20dp"
                layout_marginBottom="@dimen/dimen_20dp"
                layout_marginHorizontal="@dimen/dimen_20dp"
                NOT_FOUND_0x1f="0"
                NOT_FOUND_0x21="0"
                NOT_FOUND_0x22="1"
                NOT_FOUND_0x23="0"
                NOT_FOUND_0x24="@+id/tvReedemStep"
                NOT_FOUND_0x26="1">
                <com.google.android.material.button.MaterialButton
                    textSize="@dimen/text_size_14sp"
                    id="@+id/btnRedeem"
                    paddingLeft="@dimen/dimen_14dp"
                    paddingTop="@dimen/dimen_14dp"
                    paddingRight="@dimen/dimen_14dp"
                    paddingBottom="@dimen/dimen_14dp"
                    visibility="0"
                    layout_width="-1"
                    layout_height="-2"
                    layout_marginTop="@dimen/dimen_30dp"
                    text="@string/label_redeem_voucher"
                    textAllCaps="true"
                    fontFamily="@font/poppins_semibold"
                    paddingHorizontal="@dimen/dimen_14dp"
                    paddingVertical="@dimen/dimen_14dp"
                    style="@style/BpjstkuButton.WhiteText"/>
                <LinearLayout
                    orientation="1"
                    id="@+id/llRedeemSection"
                    visibility="2"
                    layout_width="-1"
                    layout_height="-2">
                    <TextView
                        textSize="@dimen/text_size_18sp"
                        gravity="0x11"
                        layout_width="-1"
                        layout_height="-2"
                        layout_marginTop="@dimen/dimen_8dp"
                        text="@string/label_redeem_code"
                        style="@style/BpjstkuTextViewPoppins.CharcoalGrey.SemiBold"/>
                    <TextView
                        textSize="@dimen/text_size_20sp"
                        textColor="@color/colorPrimary"
                        gravity="0x11"
                        id="@+id/tvRedeemCode"
                        background="@drawable/bg_rounded_green_border"
                        paddingTop="@dimen/dimen_9dp"
                        paddingBottom="@dimen/dimen_9dp"
                        layout_width="-1"
                        layout_height="-2"
                        layout_marginTop="@dimen/dimen_6dp"
                        text="3DXYZQ"
                        paddingVertical="@dimen/dimen_9dp"
                        style="@style/BpjstkuTextViewPoppins.DarkMint.SemiBold"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</RelativeLayout>
