<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    background="@color/colorWhite"
    layout_width="-1"
    layout_height="-1"
    fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        background="@color/colorWhite"
        layout_width="-1"
        layout_height="-2">
        <TextView
            textSize="@dimen/text_size_16sp"
            id="@+id/tvIdCardUpload"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_20dp"
            layout_marginTop="@dimen/dimen_26dp"
            layout_marginRight="@dimen/dimen_20dp"
            text="@string/label_upload_id_card_photo"
            layout_marginHorizontal="@dimen/dimen_20dp"
            NOT_FOUND_0x18="0"
            NOT_FOUND_0x1a="0"
            NOT_FOUND_0x1c="0"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey.Bold"/>
        <androidx.cardview.widget.CardView
            id="@+id/cvIdentityCardUpload"
            layout_width="@dimen/dimen_0dp"
            layout_height="@dimen/dimen_100dp"
            layout_marginTop="@dimen/dimen_16dp"
            NOT_FOUND_0x14="@color/colorWhite"
            NOT_FOUND_0x15="@dimen/dimen_4dp"
            NOT_FOUND_0x16="@dimen/dimen_0dp"
            NOT_FOUND_0x18="@+id/tvIdCardUpload"
            NOT_FOUND_0x19="0"
            NOT_FOUND_0x1a="@+id/tvIdCardUpload"
            NOT_FOUND_0x1b="@+id/tvIdCardUpload"
            NOT_FOUND_0x1e="0.42">
            <androidx.constraintlayout.widget.ConstraintLayout
                background="@drawable/selector_bordered_grey_blue"
                layout_width="-1"
                layout_height="-1">
                <ImageView
                    id="@+id/imgIdCardUpload"
                    layout_width="@dimen/dimen_20dp"
                    layout_height="@dimen/dimen_20dp"
                    src="@drawable/ic_camera"
                    NOT_FOUND_0x17="0"
                    NOT_FOUND_0x18="0"
                    NOT_FOUND_0x1a="0"
                    NOT_FOUND_0x1c="0"
                    NOT_FOUND_0x1d="0.4"/>
                <TextView
                    textSize="@dimen/text_size_12sp"
                    id="@+id/tvIdCardUploadLabel"
                    text="@string/action_id_card_upload"
                    layout_below="@+id/imgIdCardUpload"
                    NOT_FOUND_0x18="0"
                    NOT_FOUND_0x1a="0"
                    NOT_FOUND_0x1b="@+id/imgIdCardUpload"
                    style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            id="@+id/cvSelfieWithIdCard"
            layout_width="@dimen/dimen_0dp"
            layout_height="@dimen/dimen_0dp"
            NOT_FOUND_0x14="@color/colorWhite"
            NOT_FOUND_0x15="@dimen/dimen_4dp"
            NOT_FOUND_0x16="@dimen/dimen_0dp"
            NOT_FOUND_0x17="@+id/cvIdentityCardUpload"
            NOT_FOUND_0x18="@+id/tvIdCardUpload"
            NOT_FOUND_0x1c="@+id/cvIdentityCardUpload"
            NOT_FOUND_0x1e="0.42">
            <androidx.constraintlayout.widget.ConstraintLayout
                background="@drawable/selector_bordered_grey_blue"
                layout_width="-1"
                layout_height="96dp">
                <ImageView
                    id="@+id/imgSelfieWithIdCard"
                    layout_width="@dimen/dimen_20dp"
                    layout_height="@dimen/dimen_20dp"
                    src="@drawable/ic_camera"
                    NOT_FOUND_0x17="0"
                    NOT_FOUND_0x18="0"
                    NOT_FOUND_0x1a="0"
                    NOT_FOUND_0x1c="0"
                    NOT_FOUND_0x1d="0.4"/>
                <TextView
                    textSize="@dimen/text_size_12sp"
                    id="@+id/tvLivenessCheck"
                    text="@string/action_selfie_with_id_card"
                    layout_below="@+id/imgSelfieWithIdCard"
                    NOT_FOUND_0x18="0"
                    NOT_FOUND_0x1a="0"
                    NOT_FOUND_0x1b="@+id/imgSelfieWithIdCard"
                    style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <TextView
            textSize="@dimen/text_size_16sp"
            id="@+id/tvFacialVerification"
            layout_marginTop="@dimen/dimen_24dp"
            text="@string/label_facial_biometric_verification"
            NOT_FOUND_0x1a="@+id/cvIdentityCardUpload"
            NOT_FOUND_0x1b="@+id/cvIdentityCardUpload"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey.Bold"/>
        <androidx.cardview.widget.CardView
            id="@+id/cvPhotoWorkAgreement"
            layout_width="@dimen/dimen_0dp"
            layout_height="@dimen/dimen_100dp"
            layout_marginTop="@dimen/dimen_16dp"
            NOT_FOUND_0x14="@color/colorWhite"
            NOT_FOUND_0x15="@dimen/dimen_4dp"
            NOT_FOUND_0x16="@dimen/dimen_0dp"
            NOT_FOUND_0x18="@+id/cvIdentityCardUpload"
            NOT_FOUND_0x1a="@+id/cvIdentityCardUpload"
            NOT_FOUND_0x1b="@+id/tvFacialVerification"
            NOT_FOUND_0x1e="0.42">
            <androidx.constraintlayout.widget.ConstraintLayout
                background="@drawable/selector_bordered_grey_blue"
                layout_width="-1"
                layout_height="-1">
                <ImageView
                    id="@+id/imgFacialVerification"
                    layout_width="@dimen/dimen_20dp"
                    layout_height="@dimen/dimen_20dp"
                    src="@drawable/ic_camera"
                    NOT_FOUND_0x17="0"
                    NOT_FOUND_0x18="0"
                    NOT_FOUND_0x1a="0"
                    NOT_FOUND_0x1c="0"
                    NOT_FOUND_0x1d="0.4"/>
                <TextView
                    textSize="@dimen/text_size_12sp"
                    id="@+id/tvFacialVerificationLabel"
                    text="@string/action_facial_verification"
                    NOT_FOUND_0x18="0"
                    NOT_FOUND_0x1a="0"
                    NOT_FOUND_0x1b="@+id/imgFacialVerification"
                    style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <androidx.appcompat.widget.AppCompatCheckBox
            textSize="@dimen/text_size_12sp"
            gravity="0x30"
            id="@+id/cbAgreeTermCondition"
            paddingTop="@dimen/dimen_4dp"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_38dp"
            text="@string/label_agree_term_condition"
            translationX="-8dp"
            NOT_FOUND_0x13="@color/colorDarkMint"
            NOT_FOUND_0x18="@+id/tvIdCardUpload"
            NOT_FOUND_0x1a="@+id/tvIdCardUpload"
            NOT_FOUND_0x1b="@+id/cvPhotoWorkAgreement"
            style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
        <com.google.android.material.button.MaterialButton
            id="@+id/btnConfirmation"
            paddingTop="@dimen/dimen_14dp"
            paddingBottom="@dimen/dimen_14dp"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            layout_marginBottom="@dimen/dimen_22dp"
            text="@string/action_confirmation"
            paddingVertical="@dimen/dimen_14dp"
            NOT_FOUND_0x17="0"
            NOT_FOUND_0x18="@+id/tvIdCardUpload"
            NOT_FOUND_0x1a="@+id/tvIdCardUpload"
            NOT_FOUND_0x1b="@+id/cbAgreeTermCondition"
            NOT_FOUND_0x1d="1"
            style="@style/BpjstkuButton.WhiteText"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
