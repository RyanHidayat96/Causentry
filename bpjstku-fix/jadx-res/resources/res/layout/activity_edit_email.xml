<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    layout_width="-1"
    layout_height="-1">
    <include
        id="@+id/layout_toolbar"
        NOT_FOUND_0x11="0"
        NOT_FOUND_0x12="0"
        NOT_FOUND_0x14="0"
        layout="@layout/layout_toolbar_center"/>
    <TextView
        textSize="@dimen/text_size_12sp"
        id="@+id/tvEditEmailInstruction"
        layout_width="@dimen/dimen_320dp"
        layout_height="-2"
        layout_marginTop="@dimen/dimen_60dp"
        text="@string/label_edit_email_instruction"
        NOT_FOUND_0x12="@+id/tilEmail"
        NOT_FOUND_0x13="@+id/layout_toolbar"
        style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
    <com.google.android.material.textfield.TextInputLayout
        id="@+id/tilEmail"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        layout_marginLeft="@dimen/dimen_20dp"
        layout_marginTop="@dimen/dimen_24dp"
        layout_marginRight="@dimen/dimen_20dp"
        hint="@string/hint_your_new_email"
        layout_marginHorizontal="@dimen/dimen_20dp"
        NOT_FOUND_0x11="0"
        NOT_FOUND_0x12="0"
        NOT_FOUND_0x13="@+id/tvEditEmailInstruction"
        style="@style/BpjstkuTextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            id="@+id/edtEmail"
            inputType="0x21"
            style="@style/BpjstkuTextInputEditText"/>
    </com.google.android.material.textfield.TextInputLayout>
    <Button
        enabled="false"
        id="@+id/btnSaveEmail"
        paddingTop="@dimen/dimen_14dp"
        paddingBottom="@dimen/dimen_14dp"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        layout_marginTop="@dimen/dimen_19dp"
        layout_marginBottom="@dimen/dimen_23dp"
        text="@string/action_save"
        paddingVertical="@dimen/dimen_14dp"
        NOT_FOUND_0x10="0"
        NOT_FOUND_0x11="@+id/tilEmail"
        NOT_FOUND_0x12="@+id/tilEmail"
        NOT_FOUND_0x15="0"
        style="@style/BpjstkuButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
