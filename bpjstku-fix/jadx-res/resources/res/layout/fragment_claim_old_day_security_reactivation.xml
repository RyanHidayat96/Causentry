<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    background="@color/colorWhite"
    layout_width="-1"
    layout_height="-1">
    <androidx.constraintlayout.widget.ConstraintLayout
        id="@+id/clReactivation"
        visibility="0"
        layout_width="-1"
        layout_height="-2"
        layout_marginLeft="@dimen/dimen_20dp"
        layout_marginRight="@dimen/dimen_20dp"
        layout_marginHorizontal="@dimen/dimen_20dp">
        <ImageView
            id="@+id/imgBanner"
            layout_width="@dimen/dimen_0dp"
            layout_height="@dimen/dimen_0dp"
            layout_marginTop="@dimen/dimen_16dp"
            scaleType="fitStart"
            adjustViewBounds="true"
            NOT_FOUND_0x26="3:1"
            NOT_FOUND_0x27="0"
            NOT_FOUND_0x29="0"
            NOT_FOUND_0x2b="0"/>
        <TextView
            id="@+id/tvRedactionReactivation"
            layout_width="-1"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            text="@string/label_reactivation"
            NOT_FOUND_0x27="0"
            NOT_FOUND_0x29="0"
            NOT_FOUND_0x2a="@+id/imgBanner"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        <TextView
            id="@+id/tvNumberOne"
            layout_width="-1"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            text="1."
            NOT_FOUND_0x29="@+id/tvRedactionReactivation"
            NOT_FOUND_0x2a="@+id/tvRedactionReactivation"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        <TextView
            gravity="0x800007"
            id="@+id/tvQuestionReactivation"
            layout_width="-1"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            text="Jika proses pengajuan/pencairan klaim JHT Anda sudah berhasil, Apakah Bapak/Ibu bersedia mendapat perlindungan BPJS Ketenagakerjaan kembali ?"
            layout_marginStart="@dimen/dimen_16dp"
            justificationMode="1"
            NOT_FOUND_0x28="@+id/tvNumberOne"
            NOT_FOUND_0x2a="@+id/tvRedactionReactivation"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        <RadioGroup
            orientation="0"
            id="@+id/rgChooseIsBpu"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_12dp"
            NOT_FOUND_0x27="0"
            NOT_FOUND_0x29="@+id/tvQuestionReactivation"
            NOT_FOUND_0x2a="@+id/tvQuestionReactivation">
            <androidx.appcompat.widget.AppCompatRadioButton
                textSize="@dimen/text_size_14sp"
                id="@+id/rbYes"
                text="Ya"
                style="@style/BpjstkuRadioButton.DmSansCoolGrey"/>
            <androidx.appcompat.widget.AppCompatRadioButton
                textSize="@dimen/text_size_14sp"
                id="@+id/rbNo"
                text="Tidak"
                layout_marginStart="@dimen/dimen_40dp"
                style="@style/BpjstkuRadioButton.DmSansCoolGrey"/>
        </RadioGroup>
        <TextView
            id="@+id/tvNumberTwoReason"
            visibility="0"
            layout_width="-1"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            text="2."
            NOT_FOUND_0x29="@+id/tvNumberOne"
            NOT_FOUND_0x2a="@+id/rgChooseIsBpu"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        <TextView
            gravity="0x800007"
            id="@+id/tvReason"
            visibility="0"
            layout_width="-1"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            text="Silahkan pilih alasan anda"
            layout_marginStart="@dimen/dimen_16dp"
            justificationMode="1"
            NOT_FOUND_0x28="@+id/tvNumberOne"
            NOT_FOUND_0x2a="@+id/rgChooseIsBpu"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        <RadioGroup
            orientation="1"
            id="@+id/rgReason"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_12dp"
            NOT_FOUND_0x27="0"
            NOT_FOUND_0x29="@+id/tvReason"
            NOT_FOUND_0x2a="@+id/tvReason"/>
        <com.google.android.material.textfield.TextInputLayout
            id="@+id/tilReason"
            visibility="0"
            layout_width="-1"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            hint="Alasan"
            NOT_FOUND_0x27="0"
            NOT_FOUND_0x29="@+id/rgReason"
            NOT_FOUND_0x2a="@+id/rgReason"
            style="@style/BpjstkuTextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                id="@+id/edtReason"
                maxLines="5"
                lines="5"
                maxLength="150"
                inputType="0x21001"
                style="@style/BpjstkuTextInputEditText"/>
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            id="@+id/tvNumberOnes"
            layout_width="-1"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            text="2."
            NOT_FOUND_0x29="@+id/tvNumberOne"
            NOT_FOUND_0x2a="@+id/rgChooseIsBpu"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        <TextView
            gravity="0x800007"
            id="@+id/tvMemberCondition"
            layout_width="-1"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            text="Apakah Bapak/Ibu dalam kondisi sedang di rawat di rumah sakit/kritis/koma/dirawat di ICU/sakit berkepanjangan?"
            layout_marginStart="@dimen/dimen_16dp"
            justificationMode="1"
            NOT_FOUND_0x28="@+id/tvNumberOne"
            NOT_FOUND_0x2a="@+id/rgChooseIsBpu"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        <RadioGroup
            orientation="0"
            id="@+id/rgChooseCondition"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_12dp"
            NOT_FOUND_0x27="0"
            NOT_FOUND_0x29="@+id/tvMemberCondition"
            NOT_FOUND_0x2a="@+id/tvMemberCondition">
            <androidx.appcompat.widget.AppCompatRadioButton
                textSize="@dimen/text_size_14sp"
                id="@+id/rbSick"
                text="Ya"
                style="@style/BpjstkuRadioButton.DmSansCoolGrey"/>
            <androidx.appcompat.widget.AppCompatRadioButton
                textSize="@dimen/text_size_14sp"
                id="@+id/rbHealthy"
                text="Tidak"
                layout_marginStart="@dimen/dimen_40dp"
                style="@style/BpjstkuRadioButton.DmSansCoolGrey"/>
        </RadioGroup>
        <TextView
            id="@+id/tvNumberTwo"
            layout_width="-1"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            text="3."
            NOT_FOUND_0x29="@+id/tvNumberOne"
            NOT_FOUND_0x2a="@+id/rgChooseCondition"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        <TextView
            gravity="0x800007"
            id="@+id/tvQuestionWork"
            layout_width="-1"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            text="Pilih jenis kegiatan usaha yang sedang Bapak/Ibu jalani"
            layout_marginStart="@dimen/dimen_16dp"
            justificationMode="1"
            NOT_FOUND_0x28="@+id/tvNumberTwo"
            NOT_FOUND_0x2a="@+id/rgChooseCondition"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        <com.google.android.material.textfield.TextInputLayout
            id="@+id/tilChooseJobFirst"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            layout_marginBottom="15dp"
            hint="Pekerjaan 1"
            NOT_FOUND_0x25="@+id/tilChooseJobSecond"
            NOT_FOUND_0x27="0"
            NOT_FOUND_0x29="@+id/tvQuestionWork"
            NOT_FOUND_0x2a="@+id/tvQuestionWork"
            style="@style/BpjstkuTextInputLayout.GeneralDropdown">
            <com.google.android.material.textfield.TextInputEditText
                id="@+id/edtChooseJobFirst"
                style="@style/BpjstkuAutoCompleteTextViewDropDown"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            id="@+id/tilChooseJobSecond"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            hint="Pekerjaan 2 (opsional)"
            NOT_FOUND_0x27="@+id/tilChooseJobFirst"
            NOT_FOUND_0x29="@+id/tilChooseJobFirst"
            NOT_FOUND_0x2a="@+id/tilChooseJobFirst"
            style="@style/BpjstkuTextInputLayout.GeneralDropdown">
            <com.google.android.material.textfield.TextInputEditText
                id="@+id/edtChooseJobSecond"
                style="@style/BpjstkuAutoCompleteTextViewDropDown"/>
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            id="@+id/tvNumberThree"
            layout_width="-1"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            text="4."
            NOT_FOUND_0x29="@+id/tvNumberOne"
            NOT_FOUND_0x2a="@+id/tilChooseJobSecond"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        <TextView
            id="@+id/tvWorkLocation"
            layout_width="-1"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            text="Lokasi pekerjaan saat ini"
            layout_marginStart="@dimen/dimen_16dp"
            NOT_FOUND_0x28="@+id/tvNumberThree"
            NOT_FOUND_0x2a="@+id/tilChooseJobSecond"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        <com.google.android.material.textfield.TextInputLayout
            id="@+id/tilChooseLocation"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            hint="Cari Kota/Kabupaten"
            NOT_FOUND_0x27="0"
            NOT_FOUND_0x29="@+id/tvWorkLocation"
            NOT_FOUND_0x2a="@+id/tvWorkLocation"
            style="@style/BpjstkuTextInputLayout.GeneralDropdown">
            <com.google.android.material.textfield.TextInputEditText
                id="@+id/edtChooseLocation"
                style="@style/BpjstkuAutoCompleteTextViewDropDown"/>
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            id="@+id/tvNumberFour"
            layout_width="-1"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            text="5."
            NOT_FOUND_0x29="@+id/tvNumberThree"
            NOT_FOUND_0x2a="@+id/tilChooseLocation"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        <TextView
            id="@+id/tvMonthlyFee"
            layout_width="-1"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            text="Pilih jumlah iuran yang akan Bapak/Ibu bayarkan"
            layout_marginStart="@dimen/dimen_16dp"
            NOT_FOUND_0x28="@+id/tvNumberThree"
            NOT_FOUND_0x2a="@+id/tilChooseLocation"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        <RadioGroup
            orientation="1"
            id="@+id/rgMonthlyFee"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_12dp"
            NOT_FOUND_0x27="0"
            NOT_FOUND_0x29="@+id/tvMonthlyFee"
            NOT_FOUND_0x2a="@+id/tvMonthlyFee"/>
        <TextView
            id="@+id/tvNumberFive"
            layout_width="-1"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            text="6."
            NOT_FOUND_0x29="@+id/tvNumberFour"
            NOT_FOUND_0x2a="@+id/rgMonthlyFee"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        <TextView
            id="@+id/tvFamilyCardNumber"
            layout_width="-1"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            text="Isi Nomor Kartu Keluarga"
            layout_marginStart="@dimen/dimen_16dp"
            NOT_FOUND_0x28="@+id/tvNumberFour"
            NOT_FOUND_0x2a="@+id/rgMonthlyFee"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        <com.google.android.material.textfield.TextInputLayout
            id="@+id/tilFamilyCardNumber"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            hint="Nomor Kartu Keluarga"
            NOT_FOUND_0x27="0"
            NOT_FOUND_0x29="@+id/tvFamilyCardNumber"
            NOT_FOUND_0x2a="@+id/tvFamilyCardNumber"
            style="@style/BpjstkuTextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                id="@+id/edtFamilyCardNumber"
                maxLength="16"
                inputType="0x2"
                style="@style/BpjstkuTextInputEditText"/>
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            id="@+id/tvNumberSix"
            layout_width="-1"
            layout_height="-2"
            text="7."
            NOT_FOUND_0x29="@+id/tvNumberFive"
            NOT_FOUND_0x2a="@+id/tilFamilyCardNumber"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        <TextView
            id="@+id/tvCaptureImage"
            layout_width="-1"
            layout_height="-2"
            text="Upload Foto KTP"
            layout_marginStart="@dimen/dimen_16dp"
            NOT_FOUND_0x28="@+id/tvNumberFive"
            NOT_FOUND_0x2a="@+id/tilFamilyCardNumber"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        <androidx.cardview.widget.CardView
            id="@+id/cvCaptureImage"
            layout_width="@dimen/dimen_0dp"
            layout_height="@dimen/dimen_100dp"
            layout_marginTop="@dimen/dimen_16dp"
            layout_marginBottom="@dimen/dimen_24dp"
            NOT_FOUND_0x20="@color/colorWhite"
            NOT_FOUND_0x21="@dimen/dimen_4dp"
            NOT_FOUND_0x22="@dimen/dimen_0dp"
            NOT_FOUND_0x29="@+id/tvCaptureImage"
            NOT_FOUND_0x2a="@+id/tvCaptureImage"
            NOT_FOUND_0x2c="0"
            NOT_FOUND_0x2d="0.42">
            <androidx.constraintlayout.widget.ConstraintLayout
                background="@drawable/selector_bordered_grey_blue"
                layout_width="-1"
                layout_height="-1">
                <ImageButton
                    id="@+id/imgSelfiePhoto"
                    background="@drawable/selector_bordered_grey_blue"
                    layout_width="@dimen/dimen_0dp"
                    layout_height="@dimen/dimen_0dp"
                    scaleType="6"
                    contentDescription="TODO"
                    NOT_FOUND_0x24="0"
                    NOT_FOUND_0x27="0"
                    NOT_FOUND_0x29="0"
                    NOT_FOUND_0x2b="0"/>
                <ImageView
                    id="@+id/imgCapture"
                    layout_width="@dimen/dimen_20dp"
                    layout_height="@dimen/dimen_20dp"
                    src="@drawable/ic_camera"
                    NOT_FOUND_0x24="0"
                    NOT_FOUND_0x27="0"
                    NOT_FOUND_0x29="0"
                    NOT_FOUND_0x2b="0"
                    NOT_FOUND_0x2c="0.4"/>
                <TextView
                    textSize="@dimen/text_size_12sp"
                    id="@+id/tvCaptureLabel"
                    text="@string/action_get_photo"
                    NOT_FOUND_0x27="0"
                    NOT_FOUND_0x29="0"
                    NOT_FOUND_0x2a="@+id/imgCapture"
                    style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <TextView
            id="@+id/tvInfoTuition"
            layout_width="-1"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            text="Upload Foto KTP"
            layout_marginStart="@dimen/dimen_16dp"
            NOT_FOUND_0x27="0"
            NOT_FOUND_0x29="0"
            NOT_FOUND_0x2a="@+id/cvCaptureImage"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
        <androidx.appcompat.widget.AppCompatCheckBox
            textSize="@dimen/text_size_12sp"
            gravity="0x30"
            id="@+id/cbAgreeTermCondition"
            paddingTop="@dimen/dimen_4dp"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            layout_marginBottom="@dimen/dimen_16dp"
            justificationMode="1"
            NOT_FOUND_0x1f="@color/colorDarkMint"
            NOT_FOUND_0x27="0"
            NOT_FOUND_0x29="0"
            NOT_FOUND_0x2a="@+id/tvInfoTuition"
            style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
        <androidx.constraintlayout.widget.Barrier
            id="@+id/dynamicBarrier"
            layout_width="-2"
            layout_height="-2"
            NOT_FOUND_0x1e="3"
            NOT_FOUND_0x23="rgReason, tilReason, cbAgreeTermCondition"/>
        <com.google.android.material.button.MaterialButton
            enabled="true"
            id="@+id/btnNext"
            paddingTop="@dimen/dimen_14dp"
            paddingBottom="@dimen/dimen_14dp"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_22dp"
            layout_marginBottom="@dimen/dimen_22dp"
            text="@string/action_next"
            layout_marginVertical="@dimen/dimen_22dp"
            paddingVertical="@dimen/dimen_14dp"
            NOT_FOUND_0x27="0"
            NOT_FOUND_0x29="0"
            NOT_FOUND_0x2a="@+id/dynamicBarrier"
            style="@style/BpjstkuButton.WhiteText"/>
        <com.google.android.material.button.MaterialButton
            id="@+id/btnBack"
            visibility="0"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_10dp"
            layout_marginBottom="@dimen/dimen_30dp"
            text="@string/action_change_bank"
            NOT_FOUND_0x27="0"
            NOT_FOUND_0x29="0"
            NOT_FOUND_0x2a="@+id/btnNext"
            style="@style/BpjstkuOutlinedButton"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
