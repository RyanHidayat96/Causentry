<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    background="@color/colorWhite"
    padding="@dimen/dimen_16dp"
    layout_width="-1"
    layout_height="-1">
    <ImageView
        id="@+id/imgLogo"
        layout_width="@dimen/dimen_202dp"
        layout_height="@dimen/dimen_50dp"
        NOT_FOUND_0x9="0"
        NOT_FOUND_0xa="0"
        NOT_FOUND_0xb="0"
        NOT_FOUND_0xc="0"
        NOT_FOUND_0xd="@drawable/ic_logo_jmo"/>
    <TextView
        textSize="@dimen/text_size_10sp"
        id="@+id/tvInfo"
        layout_marginBottom="@dimen/dimen_32dp"
        text="@string/label_splashscreen_message"
        textAlignment="4"
        NOT_FOUND_0x9="0"
        NOT_FOUND_0xa="0"
        NOT_FOUND_0xb="0"
        style="@style/BpjstkuTextViewDmSans.SlateGrey"/>
</androidx.constraintlayout.widget.ConstraintLayout>
