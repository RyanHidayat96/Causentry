<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    orientation="1"
    fitsSystemWindows="true"
    layout_width="-1"
    layout_height="-1">
    <com.google.android.material.appbar.MaterialToolbar
        gravity="0x10"
        id="@+id/layoutToolbar"
        background="@android:color/transparent"
        layout_width="-1"
        layout_height="?attr/actionBarSize"
        NOT_FOUND_0x23="@dimen/dimen_0dp"
        NOT_FOUND_0x24="@dimen/dimen_0dp"
        NOT_FOUND_0x28="0"
        NOT_FOUND_0x2a="0"
        NOT_FOUND_0x2c="0"
        NOT_FOUND_0x2f="0x7f08017b">
        <TextView
            textSize="@dimen/text_size_18sp"
            ellipsize="3"
            gravity="0x11"
            id="@+id/tvToolbarTitle"
            padding="@dimen/dimen_5dp"
            layout_width="-1"
            layout_height="-2"
            text="Kepesertaan Jaminan Sosial Ketenagakerjaan BPU"
            layout_marginEnd="@dimen/dimen_32dp"
            style="@style/BpjstkuTextViewPoppins.CharcoalGrey.SemiBold"/>
    </com.google.android.material.appbar.MaterialToolbar>
    <ScrollView
        padding="@dimen/dimen_16dp"
        scrollbars="0x0"
        layout_width="-1"
        layout_height="-1"
        fillViewport="true"
        overScrollMode="2"
        NOT_FOUND_0x25="0"
        NOT_FOUND_0x28="0"
        NOT_FOUND_0x2a="0"
        NOT_FOUND_0x2b="@+id/layoutToolbar">
        <androidx.constraintlayout.widget.ConstraintLayout
            layout_width="-1"
            layout_height="-2">
            <ImageView
                id="@+id/imgBanner"
                layout_width="@dimen/dimen_0dp"
                layout_height="@dimen/dimen_0dp"
                layout_marginTop="@dimen/dimen_16dp"
                scaleType="fitStart"
                adjustViewBounds="true"
                NOT_FOUND_0x27="3:1"
                NOT_FOUND_0x28="0"
                NOT_FOUND_0x2a="0"
                NOT_FOUND_0x2c="0"/>
            <TextView
                id="@+id/tvRedactionReactivation"
                layout_width="-1"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                text="@string/label_reactivation"
                NOT_FOUND_0x28="0"
                NOT_FOUND_0x2a="0"
                NOT_FOUND_0x2b="@+id/imgBanner"
                style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
            <TextView
                id="@+id/tvNumberOne"
                layout_width="-1"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                text="1."
                NOT_FOUND_0x2a="@+id/tvRedactionReactivation"
                NOT_FOUND_0x2b="@+id/tvRedactionReactivation"
                style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
            <TextView
                id="@+id/tvQuestionReactivation"
                layout_width="-1"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                text="Apakah saat ini Bapak/Ibu memiliki kegiatan atau usaha ekonomi secara mandiri?"
                layout_marginStart="@dimen/dimen_16dp"
                NOT_FOUND_0x29="@+id/tvNumberOne"
                NOT_FOUND_0x2b="@+id/tvRedactionReactivation"
                style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
            <RadioGroup
                orientation="0"
                id="@+id/rgChooseIsBpu"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_12dp"
                NOT_FOUND_0x28="0"
                NOT_FOUND_0x2a="@+id/tvQuestionReactivation"
                NOT_FOUND_0x2b="@+id/tvQuestionReactivation">
                <androidx.appcompat.widget.AppCompatRadioButton
                    textSize="@dimen/text_size_14sp"
                    id="@+id/rbYes"
                    text="Ya"
                    style="@style/BpjstkuRadioButton.DmSansCoolGrey"/>
                <androidx.appcompat.widget.AppCompatRadioButton
                    textSize="@dimen/text_size_14sp"
                    id="@+id/rbNo"
                    text="Tidak"
                    layout_marginStart="@dimen/dimen_40dp"
                    style="@style/BpjstkuRadioButton.DmSansCoolGrey"/>
            </RadioGroup>
            <TextView
                id="@+id/tvNumberTwo"
                layout_width="-1"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                text="2."
                NOT_FOUND_0x2a="@+id/tvNumberOne"
                NOT_FOUND_0x2b="@+id/rgChooseIsBpu"
                style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
            <TextView
                id="@+id/tvQuestionWork"
                layout_width="-1"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                text="Pilih kegiatan atau usaha ekonomi yang sedang Bapak/Ibu jalani"
                layout_marginStart="@dimen/dimen_16dp"
                NOT_FOUND_0x29="@+id/tvNumberTwo"
                NOT_FOUND_0x2b="@+id/rgChooseIsBpu"
                style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
            <com.google.android.material.textfield.TextInputLayout
                id="@+id/tilChooseJobFirst"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                layout_marginBottom="15dp"
                hint="Pekerjaan 1"
                NOT_FOUND_0x26="@+id/tilChooseJobSecond"
                NOT_FOUND_0x28="0"
                NOT_FOUND_0x2a="@+id/tvQuestionWork"
                NOT_FOUND_0x2b="@+id/tvQuestionWork"
                style="@style/BpjstkuTextInputLayout.GeneralDropdown">
                <com.google.android.material.textfield.TextInputEditText
                    id="@+id/edtChooseJobFirst"
                    style="@style/BpjstkuAutoCompleteTextViewDropDown"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                id="@+id/tilChooseJobSecond"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                hint="Pekerjaan 2 (opsional)"
                NOT_FOUND_0x28="@+id/tilChooseJobFirst"
                NOT_FOUND_0x2a="@+id/tilChooseJobFirst"
                NOT_FOUND_0x2b="@+id/tilChooseJobFirst"
                style="@style/BpjstkuTextInputLayout.GeneralDropdown">
                <com.google.android.material.textfield.TextInputEditText
                    id="@+id/edtChooseJobSecond"
                    style="@style/BpjstkuAutoCompleteTextViewDropDown"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                id="@+id/tvNumberThree"
                layout_width="-1"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                text="3."
                NOT_FOUND_0x2a="@+id/tvNumberOne"
                NOT_FOUND_0x2b="@+id/tilChooseJobSecond"
                style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
            <TextView
                id="@+id/tvWorkLocation"
                layout_width="-1"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                text="Lokasi pekerjaan saat ini"
                layout_marginStart="@dimen/dimen_16dp"
                NOT_FOUND_0x29="@+id/tvNumberThree"
                NOT_FOUND_0x2b="@+id/tilChooseJobSecond"
                style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
            <com.google.android.material.textfield.TextInputLayout
                id="@+id/tilChooseLocation"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                hint="Cari Kota/Kabupaten"
                NOT_FOUND_0x28="0"
                NOT_FOUND_0x2a="@+id/tvWorkLocation"
                NOT_FOUND_0x2b="@+id/tvWorkLocation"
                style="@style/BpjstkuTextInputLayout.GeneralDropdown">
                <com.google.android.material.textfield.TextInputEditText
                    id="@+id/edtChooseLocation"
                    style="@style/BpjstkuAutoCompleteTextViewDropDown"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                id="@+id/tvNumberFour"
                layout_width="-1"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                text="4."
                NOT_FOUND_0x2a="@+id/tvNumberThree"
                NOT_FOUND_0x2b="@+id/tilChooseLocation"
                style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
            <TextView
                id="@+id/tvMonthlyFee"
                layout_width="-1"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                text="Pilih jumlah iuran yang akan Bapak/Ibu bayarkan"
                layout_marginStart="@dimen/dimen_16dp"
                NOT_FOUND_0x29="@+id/tvNumberThree"
                NOT_FOUND_0x2b="@+id/tilChooseLocation"
                style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
            <RadioGroup
                orientation="1"
                id="@+id/rgMonthlyFee"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_12dp"
                NOT_FOUND_0x28="0"
                NOT_FOUND_0x2a="@+id/tvMonthlyFee"
                NOT_FOUND_0x2b="@+id/tvMonthlyFee">
                <androidx.appcompat.widget.AppCompatRadioButton
                    textSize="@dimen/text_size_14sp"
                    id="@+id/rb50"
                    text="Rp. 50.400"
                    style="@style/BpjstkuRadioButton.DmSansCoolGrey"/>
                <androidx.appcompat.widget.AppCompatRadioButton
                    textSize="@dimen/text_size_14sp"
                    id="@+id/rb100"
                    text="Rp. 100.800"
                    style="@style/BpjstkuRadioButton.DmSansCoolGrey"/>
            </RadioGroup>
            <TextView
                id="@+id/tvNumberFive"
                layout_width="-1"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                text="5."
                NOT_FOUND_0x2a="@+id/tvNumberFour"
                NOT_FOUND_0x2b="@+id/rgMonthlyFee"
                style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
            <TextView
                id="@+id/tvFamilyCardNumber"
                layout_width="-1"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                text="Isi Nomor Kartu Keluarga"
                layout_marginStart="@dimen/dimen_16dp"
                NOT_FOUND_0x29="@+id/tvNumberFour"
                NOT_FOUND_0x2b="@+id/rgMonthlyFee"
                style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
            <com.google.android.material.textfield.TextInputLayout
                id="@+id/tilFamilyCardNumber"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                hint="Nomor Kartu Keluarga"
                NOT_FOUND_0x28="0"
                NOT_FOUND_0x2a="@+id/tvFamilyCardNumber"
                NOT_FOUND_0x2b="@+id/tvFamilyCardNumber"
                style="@style/BpjstkuTextInputLayout">
                <com.google.android.material.textfield.TextInputEditText
                    id="@+id/edtFamilyCardNumber"
                    maxLength="16"
                    inputType="0x2"
                    style="@style/BpjstkuTextInputEditText"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                id="@+id/tvNumberSix"
                layout_width="-1"
                layout_height="-2"
                text="6."
                NOT_FOUND_0x2a="@+id/tvNumberFive"
                NOT_FOUND_0x2b="@+id/tilFamilyCardNumber"
                style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
            <TextView
                id="@+id/tvCaptureImage"
                layout_width="-1"
                layout_height="-2"
                text="Upload Foto KTP"
                layout_marginStart="@dimen/dimen_16dp"
                NOT_FOUND_0x29="@+id/tvNumberFive"
                NOT_FOUND_0x2b="@+id/tilFamilyCardNumber"
                style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
            <androidx.cardview.widget.CardView
                id="@+id/cvCaptureImage"
                layout_width="@dimen/dimen_0dp"
                layout_height="@dimen/dimen_100dp"
                layout_marginTop="@dimen/dimen_16dp"
                layout_marginBottom="@dimen/dimen_24dp"
                NOT_FOUND_0x20="@color/colorWhite"
                NOT_FOUND_0x21="@dimen/dimen_4dp"
                NOT_FOUND_0x22="@dimen/dimen_0dp"
                NOT_FOUND_0x2a="@+id/tvCaptureImage"
                NOT_FOUND_0x2b="@+id/tvCaptureImage"
                NOT_FOUND_0x2d="0"
                NOT_FOUND_0x2e="0.42">
                <androidx.constraintlayout.widget.ConstraintLayout
                    background="@drawable/selector_bordered_grey_blue"
                    layout_width="-1"
                    layout_height="-1">
                    <ImageButton
                        id="@+id/imgSelfiePhoto"
                        background="@drawable/selector_bordered_grey_blue"
                        layout_width="@dimen/dimen_0dp"
                        layout_height="@dimen/dimen_0dp"
                        scaleType="6"
                        contentDescription="TODO"
                        NOT_FOUND_0x25="0"
                        NOT_FOUND_0x28="0"
                        NOT_FOUND_0x2a="0"
                        NOT_FOUND_0x2c="0"/>
                    <ImageView
                        id="@+id/imgCapture"
                        layout_width="@dimen/dimen_20dp"
                        layout_height="@dimen/dimen_20dp"
                        src="@drawable/ic_camera"
                        NOT_FOUND_0x25="0"
                        NOT_FOUND_0x28="0"
                        NOT_FOUND_0x2a="0"
                        NOT_FOUND_0x2c="0"
                        NOT_FOUND_0x2d="0.4"/>
                    <TextView
                        textSize="@dimen/text_size_12sp"
                        id="@+id/tvCaptureLabel"
                        text="@string/action_get_photo"
                        NOT_FOUND_0x28="0"
                        NOT_FOUND_0x2a="0"
                        NOT_FOUND_0x2b="@+id/imgCapture"
                        style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <androidx.appcompat.widget.AppCompatCheckBox
                textSize="@dimen/text_size_12sp"
                gravity="0x30"
                id="@+id/cbAgreeTermCondition"
                paddingTop="@dimen/dimen_4dp"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_16dp"
                layout_marginBottom="@dimen/dimen_16dp"
                text="Dengan ini menyatakan telah mengetahui dan memahami program BPJS Ketenagakerjaan serta setuju untuk mendaftarkan diri menjadi peserta BPJS Ketenagakerjaan dan melakukan pembayaran iuran dari saldo klaim JHT. Perlindungan dimulai sejak iuran dibayarkan."
                justificationMode="1"
                NOT_FOUND_0x1f="@color/colorDarkMint"
                NOT_FOUND_0x28="0"
                NOT_FOUND_0x2a="0"
                NOT_FOUND_0x2b="@+id/cvCaptureImage"
                style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
            <com.google.android.material.button.MaterialButton
                enabled="true"
                id="@+id/btnNext"
                paddingTop="@dimen/dimen_14dp"
                paddingBottom="@dimen/dimen_14dp"
                layout_width="@dimen/dimen_0dp"
                layout_height="-2"
                layout_marginTop="@dimen/dimen_22dp"
                layout_marginBottom="@dimen/dimen_22dp"
                text="@string/action_next"
                layout_marginVertical="@dimen/dimen_22dp"
                paddingVertical="@dimen/dimen_14dp"
                NOT_FOUND_0x28="0"
                NOT_FOUND_0x2a="0"
                NOT_FOUND_0x2b="@+id/cbAgreeTermCondition"
                style="@style/BpjstkuButton.WhiteText"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</LinearLayout>
