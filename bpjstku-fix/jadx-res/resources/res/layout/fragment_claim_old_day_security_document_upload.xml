<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    background="@color/colorWhite"
    layout_width="-1"
    layout_height="-1"
    fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        layout_width="-1"
        layout_height="-2">
        <TextView
            textSize="@dimen/text_size_16sp"
            id="@+id/tvUploadIdCard"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_27dp"
            text="@string/label_identity_card"
            layout_marginStart="@dimen/dimen_20dp"
            NOT_FOUND_0x18="0"
            NOT_FOUND_0x1a="0"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey.Bold"/>
        <androidx.cardview.widget.CardView
            id="@+id/cvIdCardUpload"
            layout_width="@dimen/dimen_0dp"
            layout_height="@dimen/dimen_100dp"
            layout_marginTop="@dimen/dimen_16dp"
            NOT_FOUND_0x12="@color/colorWhite"
            NOT_FOUND_0x13="@dimen/dimen_4dp"
            NOT_FOUND_0x14="@dimen/dimen_0dp"
            NOT_FOUND_0x18="@+id/tvUploadIdCard"
            NOT_FOUND_0x19="@+id/tvUploadIdCard"
            NOT_FOUND_0x1c="0.42">
            <ImageView
                id="@+id/imgIdPhoto"
                visibility="2"
                layout_width="-2"
                layout_height="@dimen/dimen_100dp"
                src="@drawable/ic_ktp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                background="@drawable/selector_bordered_grey_blue"
                layout_width="-1"
                layout_height="-1">
                <ImageView
                    id="@+id/imgIdCardUpload"
                    layout_width="@dimen/dimen_20dp"
                    layout_height="@dimen/dimen_20dp"
                    src="@drawable/ic_camera"
                    NOT_FOUND_0x15="0"
                    NOT_FOUND_0x17="0"
                    NOT_FOUND_0x18="0"
                    NOT_FOUND_0x1a="0"
                    NOT_FOUND_0x1b="0.4"/>
                <TextView
                    textSize="@dimen/text_size_12sp"
                    id="@+id/tvIdCardUploadLabel"
                    text="@string/action_get_photo"
                    NOT_FOUND_0x17="0"
                    NOT_FOUND_0x18="0"
                    NOT_FOUND_0x19="@+id/imgIdCardUpload"
                    style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <TextView
            textSize="@dimen/text_size_12sp"
            id="@+id/tvIdCardError"
            visibility="2"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_8dp"
            text="@string/error_empty_id_card_photo"
            NOT_FOUND_0x18="@+id/cvIdCardUpload"
            NOT_FOUND_0x19="@+id/cvIdCardUpload"
            style="@style/BpjstkuTextViewDmSans.Reddish"/>
        <TextView
            textSize="@dimen/text_size_16sp"
            id="@+id/tvUploadFamilyCard"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            text="@string/label_bpjstk_card_optional"
            NOT_FOUND_0x18="@+id/tvIdCardError"
            NOT_FOUND_0x19="@+id/tvIdCardError"
            NOT_FOUND_0x1d="@dimen/dimen_24dp"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey.Bold"/>
        <androidx.cardview.widget.CardView
            id="@+id/cvFamilyCardUpload"
            layout_width="@dimen/dimen_0dp"
            layout_height="@dimen/dimen_100dp"
            layout_marginTop="@dimen/dimen_16dp"
            NOT_FOUND_0x12="@color/colorWhite"
            NOT_FOUND_0x13="@dimen/dimen_4dp"
            NOT_FOUND_0x14="@dimen/dimen_0dp"
            NOT_FOUND_0x18="@+id/tvUploadFamilyCard"
            NOT_FOUND_0x19="@+id/tvUploadFamilyCard"
            NOT_FOUND_0x1c="0.42">
            <ImageView
                id="@+id/imgFamilyCardPhoto"
                visibility="2"
                layout_width="-2"
                layout_height="@dimen/dimen_100dp"
                src="@drawable/ic_ktp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                background="@drawable/selector_bordered_grey_blue"
                layout_width="-1"
                layout_height="-1">
                <ImageView
                    id="@+id/imgFamilyCardUpload"
                    layout_width="@dimen/dimen_20dp"
                    layout_height="@dimen/dimen_20dp"
                    src="@drawable/ic_camera"
                    NOT_FOUND_0x15="0"
                    NOT_FOUND_0x17="0"
                    NOT_FOUND_0x18="0"
                    NOT_FOUND_0x1a="0"
                    NOT_FOUND_0x1b="0.4"/>
                <TextView
                    textSize="@dimen/text_size_12sp"
                    id="@+id/tvFamilyCardLabel"
                    text="@string/action_get_photo"
                    NOT_FOUND_0x17="0"
                    NOT_FOUND_0x18="0"
                    NOT_FOUND_0x19="@+id/imgFamilyCardUpload"
                    style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <TextView
            textSize="@dimen/text_size_12sp"
            id="@+id/tvFamilyCardError"
            visibility="2"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_8dp"
            text="@string/error_empty_family_card_photo"
            NOT_FOUND_0x18="@+id/cvFamilyCardUpload"
            NOT_FOUND_0x19="@+id/cvFamilyCardUpload"
            style="@style/BpjstkuTextViewDmSans.Reddish"/>
        <TextView
            textSize="@dimen/text_size_16sp"
            id="@+id/tvUploadBpjstkCard"
            visibility="2"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            text="@string/label_bpjstk_card_optional"
            NOT_FOUND_0x18="@+id/tvFamilyCardError"
            NOT_FOUND_0x19="@+id/tvFamilyCardError"
            NOT_FOUND_0x1d="@dimen/dimen_24dp"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey.Bold"/>
        <androidx.cardview.widget.CardView
            id="@+id/cvBpjstkCardUpload"
            visibility="2"
            layout_width="@dimen/dimen_0dp"
            layout_height="@dimen/dimen_100dp"
            layout_marginTop="@dimen/dimen_16dp"
            NOT_FOUND_0x12="@color/colorWhite"
            NOT_FOUND_0x13="@dimen/dimen_4dp"
            NOT_FOUND_0x14="@dimen/dimen_0dp"
            NOT_FOUND_0x18="@+id/tvUploadBpjstkCard"
            NOT_FOUND_0x19="@+id/tvUploadBpjstkCard"
            NOT_FOUND_0x1c="0.42">
            <ImageView
                id="@+id/imgBpjstkuCardPhoto"
                visibility="2"
                layout_width="-2"
                layout_height="@dimen/dimen_100dp"
                src="@drawable/ic_ktp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                background="@drawable/selector_bordered_grey_blue"
                layout_width="-1"
                layout_height="-1">
                <ImageView
                    id="@+id/imgBpjstkCardUpload"
                    layout_width="@dimen/dimen_20dp"
                    layout_height="@dimen/dimen_20dp"
                    src="@drawable/ic_camera"
                    NOT_FOUND_0x15="0"
                    NOT_FOUND_0x17="0"
                    NOT_FOUND_0x18="0"
                    NOT_FOUND_0x1a="0"
                    NOT_FOUND_0x1b="0.4"/>
                <TextView
                    textSize="@dimen/text_size_12sp"
                    id="@+id/tvvBpjstkCardUploadLabel"
                    text="@string/action_get_photo"
                    NOT_FOUND_0x17="0"
                    NOT_FOUND_0x18="0"
                    NOT_FOUND_0x19="@+id/imgBpjstkCardUpload"
                    style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <TextView
            textSize="@dimen/text_size_16sp"
            id="@+id/tvUploadPaklaring"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_24dp"
            text="@string/label_paklaring_photo_optional"
            NOT_FOUND_0x18="@+id/tvUploadIdCard"
            NOT_FOUND_0x19="@+id/cvBpjstkCardUpload"
            style="@style/BpjstkuTextViewDmSans.CharcoalGrey.Bold"/>
        <TextView
            id="@+id/tvQuitWorkStatementFromCompanyNote"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_6dp"
            text="@string/label_quit_work_statement_form_company"
            NOT_FOUND_0x18="@+id/tvUploadIdCard"
            NOT_FOUND_0x19="@+id/tvUploadPaklaring"
            style="@style/BpjstkuTextViewDmSans.TomatoTwo"/>
        <androidx.cardview.widget.CardView
            id="@+id/cvPaklaringUpload"
            layout_width="@dimen/dimen_0dp"
            layout_height="@dimen/dimen_100dp"
            layout_marginTop="@dimen/dimen_16dp"
            layout_marginBottom="@dimen/dimen_24dp"
            NOT_FOUND_0x12="@color/colorWhite"
            NOT_FOUND_0x13="@dimen/dimen_4dp"
            NOT_FOUND_0x14="@dimen/dimen_0dp"
            NOT_FOUND_0x16="@+id/btnNext"
            NOT_FOUND_0x18="@+id/tvQuitWorkStatementFromCompanyNote"
            NOT_FOUND_0x19="@+id/tvQuitWorkStatementFromCompanyNote"
            NOT_FOUND_0x1b="0"
            NOT_FOUND_0x1c="0.42">
            <ImageView
                id="@+id/imgPaklaringPhoto"
                visibility="2"
                layout_width="-2"
                layout_height="@dimen/dimen_100dp"
                src="@drawable/ic_ktp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                background="@drawable/selector_bordered_grey_blue"
                layout_width="-1"
                layout_height="-1">
                <ImageView
                    id="@+id/imgPaklaringUpload"
                    layout_width="@dimen/dimen_20dp"
                    layout_height="@dimen/dimen_20dp"
                    src="@drawable/ic_camera"
                    NOT_FOUND_0x15="0"
                    NOT_FOUND_0x17="0"
                    NOT_FOUND_0x18="0"
                    NOT_FOUND_0x1a="0"
                    NOT_FOUND_0x1b="0.4"/>
                <TextView
                    textSize="@dimen/text_size_12sp"
                    id="@+id/tvPaklaringUpload"
                    text="@string/action_get_photo"
                    NOT_FOUND_0x17="0"
                    NOT_FOUND_0x18="0"
                    NOT_FOUND_0x19="@+id/imgPaklaringUpload"
                    style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <TextView
            textSize="@dimen/text_size_12sp"
            id="@+id/tvPaklaringError"
            visibility="2"
            layout_width="-2"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_8dp"
            text="@string/error_empty_paklaring_photo"
            NOT_FOUND_0x18="@+id/cvPaklaringUpload"
            NOT_FOUND_0x19="@+id/cvPaklaringUpload"
            style="@style/BpjstkuTextViewDmSans.Reddish"/>
        <Button
            id="@+id/btnNext"
            paddingTop="@dimen/dimen_14dp"
            paddingBottom="@dimen/dimen_14dp"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginLeft="@dimen/dimen_20dp"
            layout_marginTop="@dimen/dimen_34dp"
            layout_marginRight="@dimen/dimen_20dp"
            layout_marginBottom="@dimen/dimen_19dp"
            text="@string/action_next"
            layout_marginHorizontal="@dimen/dimen_20dp"
            paddingVertical="@dimen/dimen_14dp"
            NOT_FOUND_0x15="0"
            NOT_FOUND_0x17="0"
            NOT_FOUND_0x18="0"
            style="@style/BpjstkuButton.WhiteText"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
