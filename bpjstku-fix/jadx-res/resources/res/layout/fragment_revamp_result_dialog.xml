<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    orientation="1"
    layout_width="-1"
    layout_height="-2">
    <androidx.constraintlayout.widget.ConstraintLayout
        background="@drawable/bg_rounded_white"
        padding="@dimen/dimen_20dp"
        layout_width="-1"
        layout_height="-2"
        layout_margin="@dimen/dimen_16dp">
        <ImageView
            id="@+id/imgDialog"
            visibility="0"
            layout_width="-2"
            layout_height="-2"
            scaleType="6"
            NOT_FOUND_0x12="1:1"
            NOT_FOUND_0x13="0"
            NOT_FOUND_0x14="0"
            NOT_FOUND_0x16="0"/>
        <ImageView
            id="@+id/imgState"
            visibility="2"
            layout_width="@dimen/dimen_72dp"
            layout_height="@dimen/dimen_72dp"
            NOT_FOUND_0x13="0"
            NOT_FOUND_0x14="0"
            NOT_FOUND_0x16="0"/>
        <TextView
            textSize="@dimen/text_size_16sp"
            id="@+id/tvResultTitle"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_20dp"
            text="@string/label_title_confirm_asik_dialog"
            textAlignment="4"
            NOT_FOUND_0x13="0"
            NOT_FOUND_0x14="0"
            NOT_FOUND_0x15="@+id/imgDialog"
            style="@style/BpjstkuTextViewPoppins.CharcoalGrey.SemiBold"/>
        <TextView
            textSize="@dimen/text_size_13sp"
            id="@+id/tvResultMessage"
            layout_width="@dimen/dimen_0dp"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_16dp"
            text="@string/label_message_confirm_asik_dialog"
            textAlignment="4"
            NOT_FOUND_0x13="0"
            NOT_FOUND_0x14="0"
            NOT_FOUND_0x15="@+id/tvResultTitle"
            NOT_FOUND_0x17="@dimen/dimen_10dp"
            style="@style/BpjstkuTextViewDmSans.CoolGrey"/>
        <LinearLayout
            orientation="0"
            layout_width="-1"
            layout_height="-2"
            layout_marginTop="@dimen/dimen_20dp"
            NOT_FOUND_0x13="0"
            NOT_FOUND_0x14="0"
            NOT_FOUND_0x15="@+id/tvResultMessage">
            <com.google.android.material.button.MaterialButton
                id="@+id/btnRevampCancel"
                paddingTop="@dimen/dimen_14dp"
                paddingBottom="@dimen/dimen_14dp"
                layout_width="0dp"
                layout_height="-2"
                text="@string/action_return"
                layout_weight="1"
                layout_marginEnd="@dimen/dimen_10dp"
                paddingVertical="@dimen/dimen_14dp"
                style="@style/BpjstkuOutlinedButton"/>
            <com.google.android.material.button.MaterialButton
                id="@+id/btnRevampContinue"
                paddingTop="@dimen/dimen_14dp"
                paddingBottom="@dimen/dimen_14dp"
                layout_width="0dp"
                layout_height="-2"
                text="@string/label_Lapak_asik_dialog"
                layout_weight="1"
                paddingVertical="@dimen/dimen_14dp"
                style="@style/BpjstkuButton.WhiteText"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
