<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    background="@color/colorWhite"
    focusable="true"
    focusableInTouchMode="true"
    layout_width="-1"
    layout_height="-1">
    <include
        id="@+id/layout_toolbar"
        NOT_FOUND_0x1a="0"
        NOT_FOUND_0x1c="0"
        NOT_FOUND_0x1e="0"
        layout="@layout/layout_toolbar"/>
    <TextView
        textSize="@dimen/text_size_16sp"
        id="@+id/tvCompleteYourPersonalData"
        layout_width="@dimen/dimen_0dp"
        layout_marginLeft="@dimen/dimen_20dp"
        layout_marginTop="@dimen/dimen_24dp"
        layout_marginRight="@dimen/dimen_20dp"
        text="@string/label_complete_your_personal_data"
        layout_marginHorizontal="@dimen/dimen_20dp"
        NOT_FOUND_0x1a="0"
        NOT_FOUND_0x1b="0"
        NOT_FOUND_0x1c="0"
        NOT_FOUND_0x1d="@+id/layout_toolbar"
        style="@style/BpjstkuTextViewDmSans.CharcoalGrey.Bold"/>
    <TextView
        textSize="@dimen/text_size_16sp"
        id="@+id/tvLabelIdentity"
        layout_width="@dimen/dimen_0dp"
        layout_marginTop="@dimen/dimen_24dp"
        text="Pilih Identitas"
        NOT_FOUND_0x1a="@+id/tvCompleteYourPersonalData"
        NOT_FOUND_0x1c="@+id/tvCompleteYourPersonalData"
        NOT_FOUND_0x1d="@+id/tvCompleteYourPersonalData"
        style="@style/BpjstkuTextViewDmSans.CharcoalGrey"/>
    <RadioGroup
        orientation="0"
        id="@+id/rgChooseIdentity"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        layout_marginTop="@dimen/dimen_5dp"
        NOT_FOUND_0x1a="@+id/tvLabelIdentity"
        NOT_FOUND_0x1c="@+id/tvLabelIdentity"
        NOT_FOUND_0x1d="@+id/tvLabelIdentity">
        <RadioButton
            textSize="@dimen/text_size_16sp"
            id="@+id/rbNIK"
            checked="true"
            text="@string/label_ktp"
            style="@style/BpjstkuRadioButton.DmSansCoolGrey"/>
        <RadioButton
            textSize="@dimen/text_size_16sp"
            id="@+id/rbPaspor"
            text="@string/label_paspor"
            layout_marginStart="@dimen/dimen_60dp"
            style="@style/BpjstkuRadioButton.DmSansCoolGrey"/>
    </RadioGroup>
    <com.google.android.material.textfield.TextInputLayout
        id="@+id/tilIdentityNumber"
        visibility="0"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        layout_marginTop="@dimen/dimen_16dp"
        hint="@string/label_nik"
        NOT_FOUND_0x1a="@+id/rgChooseIdentity"
        NOT_FOUND_0x1c="@+id/rgChooseIdentity"
        NOT_FOUND_0x1d="@+id/rgChooseIdentity"
        style="@style/BpjstkuTextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            maxLength="16"
            digits="0123456789"
            inputType="0x2"
            imeOptions="0x5"
            style="@style/BpjstkuTextInputEditText"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        id="@+id/tilIdPassport"
        visibility="2"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        layout_marginTop="@dimen/dimen_16dp"
        hint="@string/hint_passport_id"
        NOT_FOUND_0x1a="@+id/rgChooseIdentity"
        NOT_FOUND_0x1c="@+id/rgChooseIdentity"
        NOT_FOUND_0x1d="@+id/tilIdentityNumber"
        style="@style/BpjstkuTextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            inputType="0x1001"
            imeOptions="0x5"
            style="@style/BpjstkuTextInputEditText"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        id="@+id/tilFullName"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        layout_marginTop="@dimen/dimen_16dp"
        hint="@string/hint_fullname"
        NOT_FOUND_0x1a="@+id/rgChooseIdentity"
        NOT_FOUND_0x1c="@+id/rgChooseIdentity"
        NOT_FOUND_0x1d="@+id/tilIdPassport"
        style="@style/BpjstkuTextInputLayout">
        <com.google.android.material.textfield.TextInputEditText
            inputType="0x1061"
            imeOptions="0x6"
            style="@style/BpjstkuTextInputEditText"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        id="@+id/tilBirthDate"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        layout_marginTop="@dimen/dimen_16dp"
        hint="@string/hint_birth_date"
        NOT_FOUND_0x1a="@+id/tilFullName"
        NOT_FOUND_0x1c="@+id/tilFullName"
        NOT_FOUND_0x1d="@+id/tilFullName"
        style="@style/BpjstkuTextInputLayout.Calender">
        <com.google.android.material.textfield.TextInputEditText
            id="@+id/edtBirthDate"
            inputType="0x14"
            style="@style/BpjstkuAutoCompleteTextViewCalender"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton
        id="@+id/btnNext"
        paddingTop="@dimen/dimen_14dp"
        paddingBottom="@dimen/dimen_14dp"
        layout_width="@dimen/dimen_0dp"
        layout_height="-2"
        layout_marginTop="@dimen/dimen_16dp"
        layout_marginBottom="@dimen/dimen_20dp"
        text="@string/action_next"
        paddingVertical="@dimen/dimen_14dp"
        NOT_FOUND_0x19="0"
        NOT_FOUND_0x1a="@+id/tilBirthDate"
        NOT_FOUND_0x1c="@+id/tilBirthDate"
        NOT_FOUND_0x1d="@+id/tilBirthDate"
        NOT_FOUND_0x1f="1"
        style="@style/BpjstkuButton.WhiteText"/>
</androidx.constraintlayout.widget.ConstraintLayout>
