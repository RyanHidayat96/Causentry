# Causentry v3.0 SELinux Policy Rules
# Space-separated Magisk/KernelSU sepolicy.rule syntax (no colons or semicolons).
#
# 1. Do NOT deny app_zygote access to selinuxfs / security_t globally.
#    app_zygote is shared across all useAppZygote="true" apps (e.g. Chrome) and
#    requires selinuxfs/context during selinux_android_setcontext(). Per-target
#    app_zygote cloaking is handled per-package in the daemon/Zygisk layer.

# 2. Permit Causentry Control UI (untrusted_app_all) to connect to causentryd's
#    Unix domain socket (.rpc.sock) across Magisk, KernelSU Next, and SUSFS.
#    causentryd enforces SO_PEERCRED UID verification so ONLY com.causentry.app or root is accepted.
allow untrusted_app_all su unix_stream_socket connectto
allow untrusted_app_all magisk unix_stream_socket connectto
allow untrusted_app_all ksu unix_stream_socket connectto
allow untrusted_app_all priv_app unix_stream_socket connectto
typeattribute ksu mlstrustedsubject
typeattribute priv_app mlstrustedsubject

# 3. Permit specialized target processes (system_server, SettingsProvider, MediaProvider)
#    to read/write the Zygisk companion-bridged policy Unix stream socket created in zygote.
allow system_server zygote unix_stream_socket { read write getattr getopt setopt shutdown }
allow system_app zygote unix_stream_socket { read write getattr getopt setopt shutdown }
allow mediaprovider_app zygote unix_stream_socket { read write getattr getopt setopt shutdown }
allow mediaprovider zygote unix_stream_socket { read write getattr getopt setopt shutdown }
typeattribute zygote mlstrustedobject
